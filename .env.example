# Application
XIANG_APP_ENV=production
XIANG_DEPLOYMENT_MODE=submission-local
XIANG_HOST=127.0.0.1
XIANG_PORT=8080
XIANG_LOG_LEVEL=INFO
XIANG_AUTH_ENABLED=true
# This permanent key stays on the FastAPI host. Use at least 32 random characters.
XIANG_APP_API_KEY=replace-with-a-long-random-value
XIANG_PUBLIC_SESSIONS_ENABLED=true
XIANG_ACCESS_TOKEN_TTL_MINUTES=20
XIANG_SESSION_ISSUE_LIMIT_PER_MINUTE=10

# Self-hosted llama.cpp endpoint on the user-controlled Radeon/ROCm machine.
# During development this may be a private tunnel URL. For the final deployment,
# run the application beside llama-server and use http://127.0.0.1:8000/v1.
XIANG_LLM_BASE_URL=http://127.0.0.1:8000/v1
XIANG_LLM_API_KEY=
XIANG_LLM_MODEL=xianglens-qwen3.6-35b-a3b-fable5-q6k
XIANG_LLM_TIMEOUT_SECONDS=180
XIANG_LLM_PROBE_ON_START=false
# Preserve the distilled model's reasoning behavior. XiangLens allocates extra output
# headroom and validates only the final content; reasoning text is never shown or stored.
XIANG_LLM_ENABLE_THINKING=true
XIANG_LLM_REASONING_BUDGET=1024

# Local application state
XIANG_SQLITE_PATH=./runtime/xianglens.sqlite3
XIANG_MILVUS_URI=./runtime/xianglens_milvus.db
XIANG_UPLOAD_DIR=./runtime/uploads
XIANG_EXPORT_DIR=./runtime/exports
XIANG_IMAGE_RETENTION=session
XIANG_SESSION_TTL_MINUTES=60

# Retrieval. "hash" is a dependency-free development baseline. Use "fastembed"
# with the semantic extra for the final semantic retrieval configuration.
XIANG_EMBEDDING_PROVIDER=hash
XIANG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
XIANG_EMBEDDING_DIMENSION=384
XIANG_RAG_TOP_K=4

# Optional runtime-only private Lens Tool. The referenced course/distillation file,
# its derivatives, and its embeddings must remain outside Git. JavaScript/TypeScript
# template-literal exports plus plain Markdown/text files are supported.
XIANG_PRIVATE_LENS_ENABLED=false
XIANG_PRIVATE_LENS_PATH=/secure/private/avatarKnowledge.ts
XIANG_PRIVATE_LENS_NAME=Private 108-Technique Lens

# Upload and browser controls
XIANG_MAX_UPLOAD_BYTES=10485760
XIANG_MAX_IMAGE_PIXELS=24000000
XIANG_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,https://ld0574.github.io
