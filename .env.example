# MPC AI Environment Configurations

# Application Settings
APP_NAME="MPC AI - Multi-source Problem Correlation AI"
APP_ENV="development"
DEBUG=True
PORT=8000

# Vector Database Configuration
CHROMA_PERSIST_DIR="./data/chroma_db"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

# LLM Provider Setup
LLM_PROVIDER="ollama" # Options: ollama (local AMD deployment), claude, openai
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3:8b-instruct"
CLAUDE_API_KEY="your_claude_api_key_here"

# Hardware Telemetry Configurations
DEFAULT_SERIAL_PORT="COM3" # On Linux: /dev/ttyUSB0
DEFAULT_BAUD_RATE=115200
MQTT_BROKER="localhost"
MQTT_PORT=1883
MQTT_TOPIC="mpc/sensors/#"
