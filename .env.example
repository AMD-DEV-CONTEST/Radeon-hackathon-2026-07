# Server Settings
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/careerpilot

# AI Provider Configuration
# Set to 'ollama' for local inference (e.g., using AMD ROCm GPU acceleration)
# Set to 'openai' for standard Cloud API
AI_PROVIDER=ollama

# Local Inference (Ollama) Settings
# By default, Ollama runs on port 11434
OLLAMA_BASE_URL=http://localhost:11434
# The model name you downloaded in Ollama (e.g., llama3, qwen2.5)
OLLAMA_MODEL=llama3

# OpenAI Cloud API Settings (If AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
