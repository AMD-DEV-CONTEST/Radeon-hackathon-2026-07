# Copy to .env and fill values
RADEON_API_KEY=your_radeon_cloud_api_key_here
# Optional aliases
OPENAI_API_KEY=your_radeon_cloud_api_key_here

# Radeon Cloud persistence (recommended on cloud instances)
# PLA_DATA_ROOT=/workspace/persistence/PrivateLocalAgent
# HF_HOME=/workspace/persistence/huggingface
# HF_ENDPOINT=https://hf-mirror.com

# Demo HTTP hardening
# PLA_ALLOW_PUBLIC=0
# PLA_DEMO_TOKEN=
# PLA_MAX_UPLOAD_MB=10
# PLA_TRUST_REMOTE_CODE=0
