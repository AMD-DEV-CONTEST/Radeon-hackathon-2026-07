# ──────────────────────────────────────────────────────────────────────────
# MKO Universal AI Agents — environment configuration template
#
# Copy this file to `.env.local` and fill in real values. NEVER commit
# `.env.local` — it is in .gitignore. The app picks these variables up on
# startup; you can also paste keys into the in-UI Settings panel, which
# persists them (still gitignored) to `data/webui_config.json`.
#
# When none of the keys below are set, the app boots in unauthenticated
# demo mode. Chats still work — they return a friendly "configure your
# provider" message instead of a real LLM response. Stripe endpoints return
# a clean 400 explaining how to enable them. The Admin panel still works
# against the seeded default password `admin123` — change it on first login.
# ──────────────────────────────────────────────────────────────────────────

# ─── LLM provider API keys ───────────────────────────────────────────────
# Also configurable in the UI Settings panel — environment variables here
# override anything the panel saved, on the next request.
GROQ_API_KEY=
HF_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Stripe (billing) ────────────────────────────────────────────────────
# Without STRIPE_SECRET_KEY the /api/stripe/create-checkout-session endpoint
# returns a 400 explaining how to enable it. The pricing UI still renders.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_ESSENTIAL=
STRIPE_PRICE_PRO=
STRIPE_PRICE_POWER=
STRIPE_PRICE_ULTIMATE=

# ─── Public base URL ─────────────────────────────────────────────────────
# Used as the default success/cancel URL prefix for Stripe redirects.
# Override to your deployed origin (e.g. https://mko.example.com).
BASE_URL=
