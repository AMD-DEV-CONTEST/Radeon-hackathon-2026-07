# GraphVoice - Voice-driven graph database query assistant
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Qwen API (via OpenAI-compatible endpoint) ---
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_LLM_MODEL=qwen-plus
QWEN_ASR_MODEL=qwen2-audio-asr-latest
QWEN_TTS_MODEL=cosyvoice-v1

# --- Hunyuan API (backup) ---
# HUNYUAN_API_KEY=your_hunyuan_key
# HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1

# --- Neo4j Database ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=test123456

# --- Agent Config ---
MAX_CONVERSATION_HISTORY=5
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# --- Logging ---
LOG_LEVEL=INFO
