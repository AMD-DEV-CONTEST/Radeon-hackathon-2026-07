# ============================================================
# Bunker Configuration — copy to .env and fill in values
# ============================================================

# Inference
BUNKER__INFERENCE__PRIMARY_MODEL=Qwen/Qwen3-30B-A3B
BUNKER__INFERENCE__SECONDARY_MODEL=meta-llama/Llama-3.1-8B-Instruct
BUNKER__INFERENCE__QUANTIZATION=gptq
BUNKER__INFERENCE__DTYPE=float16
BUNKER__INFERENCE__MAX_MODEL_LEN=32768
BUNKER__INFERENCE__VLLM_PORT=8000
BUNKER__INFERENCE__GPU_MEMORY_UTILIZATION=0.85

# Radeon Cloud API (BONUS — optional)
# Get your key at https://developer.amd.com.cn/radeon/
BUNKER__INFERENCE__RADEON_API_KEY=
BUNKER__INFERENCE__RADEON_MODEL=Qwen3-30B-A3B

# RAG
BUNKER__RAG__EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
BUNKER__RAG__CHUNK_SIZE=512
BUNKER__RAG__CHUNK_OVERLAP=50
BUNKER__RAG__TOP_K=5

# Memory
BUNKER__MEMORY__MAX_CONTEXT_TOKENS=4096

# Privacy
BUNKER__PRIVACY__ENABLE_ENCRYPTION=false
BUNKER__PRIVACY__REQUIRE_APPROVAL_FILE_WRITE=true
BUNKER__PRIVACY__REQUIRE_APPROVAL_EMAIL=true
BUNKER__PRIVACY__REQUIRE_APPROVAL_WEB_SEARCH=true

# Server
BUNKER__SERVER__PORT=7860
BUNKER__SERVER__HOST=0.0.0.0

# ROCm (set by Docker, override manually if needed)
HIP_VISIBLE_DEVICES=0
PYTORCH_HIP_ALLOC_CONF=max_split_size_mb:512
