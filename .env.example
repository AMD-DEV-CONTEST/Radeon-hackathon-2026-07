# ============================================================
# AIOps Agent 环境变量模板
#
# 用法:
#   cp .env.example .env
#   # 编辑 .env 填入实际值
#   source .env  # 或由 setup-cloud.sh 自动加载
#
# 在 AMD Cloud 上, setup-cloud.sh 会自动生成 .env
# ============================================================

# ---- LLM 推理 ----
# llama-server 地址 (本地: llama-server 跑在 127.0.0.1:8080)
LLM_BASE_URL=http://127.0.0.1:8080/v1
# API key (与 llama-server --api-key 一致)
LLM_API_KEY=CHANGE_ME
# 模型路径 (llama-server -m 参数)
LLM_MODEL=/workspace/Qwopus3.6-27B-v2-MTP-Q4_K_M.gguf

# ---- 数据库 ----
DB_PATH=./aiops.db

# ---- Web 控制台 ----
# 留空则不启用认证 (仅开发环境); 生产部署建议设置
CONSOLE_TOKEN=
# supervised: 高危操作需人工审批; autonomous: 无人值守自动执行
AUTONOMY=supervised
# 提示词语言: en / zh
PROMPT_LANGUAGE=en

# ---- 集群后端 ----
CLUSTER_BACKEND=apache

# ---- SSH (连接 Hadoop 容器) ----
SSH_USER=root
SSH_KEY_PATH=

# ---- 集群节点 ----
# 单节点直装: 只需 NODE01 (ssh_port=22)
# Docker 3节点: 设置 NODE01/02/03 (ssh_port=2222/2223/2224)
# 未设置的 NODE0X_HOST 对应的节点会自动排除
NODE01_HOST=localhost
NODE01_SSH_PORT=2222
NODE02_HOST=localhost
NODE02_SSH_PORT=2223
NODE03_HOST=localhost
NODE03_SSH_PORT=2224

# ---- 监控 ----
PROMETHEUS_URL=http://localhost:9090
ALERTMANAGER_URL=http://localhost:9093
GRAFANA_URL=http://localhost:3000
