# .env.example — copy to .env and fill in the actual keys

# Local vLLM inference service (ROCm) — Qwen3-8B primary model
LOCAL_LLM_API_KEY=Empty-key-for-local-vllm

# Local reasoning enhancement model — DeepSeek-R1-Distill-Qwen-7B (port 8002)
LOCAL_REASONING_API_KEY=Empty-key-for-local-vllm

# Local Embedding service
LOCAL_EMBED_API_KEY=Empty-key-for-local-embed

# If using a cloud API alternative (optional)
DEEPSEEK_API_KEY=
SILICON_API_KEY=