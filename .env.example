# Copy this file to .env and fill in your email details before running app.py.
# For Gmail, turn on 2-Step Verification and create an App Password.
# Use the App Password here, not your normal Gmail password.

GENAI_SMTP_HOST=smtp.gmail.com
GENAI_SMTP_PORT=587
GENAI_SMTP_USER=your_email@gmail.com
GENAI_SMTP_PASSWORD=your_16_character_app_password
GENAI_SMTP_FROM=your_email@gmail.com

# Optional: change the default admin password before the first run.
GENAI_ADMIN_PASSWORD=Gnk2005/09-07
