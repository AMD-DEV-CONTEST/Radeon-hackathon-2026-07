# Track 2 — Environment Variables
# Copy to .env and fill in values as needed

# vLLM inference endpoint
VLLM_BASE_URL=http://localhost:8000/v1
MODEL_NAME=models/qwen-trader-merged

# Backtest API endpoint
BACKTEST_API_URL=http://localhost:8080

# CN market mode (set to "1" for domestic market constraints)
CN_MARKET_MODE=1

# Agent memory directory
AGENT_MEMORY_DIR=~/.agent_memory

# Paper trading (Binance Testnet — optional, not used in CN market mode)
ENABLE_TESTNET_TRADING=false
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
DRY_RUN=true
