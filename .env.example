# FastAgentFactory unified user configuration.
# Copy this file to .env. deploy.sh reads this file; inference
# endpoints are derived in memory from the target and port settings below.

# Inference node: ssh for a remote GPU host, local for a ROCm GPU on this host.
DEPLOY_TARGET=ssh
SSH_HOST=
SSH_PORT=22
SSH_USER=root
# Leave empty when ~/.ssh or ssh-agent already selects the correct key.
SSH_KEY=

# Optional deployment overrides belong here only when the built-in values in
# deploy/defaults.env do not fit the target host. Examples:
# REMOTE_MODEL_ROOT=/data/models
# CHAT_PARALLEL_SLOTS=3
# CHAT_ADMISSION_MAX_PENDING=64
# CHAT_ADMISSION_PER_SESSION_ACTIVE=1
# CHAT_ADMISSION_QUEUE_TIMEOUT_SECONDS=300
# CHAT_ADMISSION_PRIORITY_AGING_SECONDS=30

# Required when multi-Agent collaboration is enabled. Set this to the number of
# worker model requests that the configured API provider can safely serve in parallel.
AGENTFACTORY_COLLABORATION_MAX_PARALLEL_WORKERS=

# Main Agent continuation events are retained individually for audit, then coalesced
# into one continuation run after this short window. Batch size bounds one prompt.
AGENTFACTORY_COLLABORATION_EVENT_COALESCE_WINDOW_SECONDS=0.75
AGENTFACTORY_COLLABORATION_EVENT_BATCH_LIMIT=64

# deploy.sh generates this value on first use. Keep it stable because it
# encrypts runtime AgentPackage resource values.
AGENTFACTORY_RESOURCE_MASTER_KEY=

# User-facing runtime preferences.
AGENTFACTORY_MEMORY_WRITE_INTERVAL_TURNS=3

# Native AgentPackage runtime limits.
AGENTFACTORY_AGENT_RUNTIME_INITIALIZE_TIMEOUT_SECONDS=120
AGENTFACTORY_AGENT_RUNTIME_BRIDGE_STARTUP_TIMEOUT_SECONDS=30
