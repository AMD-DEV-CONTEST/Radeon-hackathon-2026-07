# API keys for 3D / image generation providers
TRIPO_API_KEY=
MESHY_API_KEY=
RODIN_API_KEY=
REPLICATE_API_TOKEN=
STABILITY_API_KEY=

# Provider priority (comma-separated)
THREED_PROVIDER_PRIORITY=tripo,meshy,rodin

# LLM / Agent (OpenAI-compatible, e.g., OpenAI, Kimi, DeepSeek, Azure)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Set to true to use deterministic rule-based fallback instead of calling LLM
LLM_MOCK_MODE=false

# Optional local overrides
# DATABASE_URL=sqlite:///./data/dev.db
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0
