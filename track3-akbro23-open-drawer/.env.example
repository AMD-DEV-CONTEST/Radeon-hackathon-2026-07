# Copy to .env, which is gitignored, and fill in. Read by
# scripts/instance-env.sh.

# Read access is enough: https://huggingface.co/settings/tokens
# pi0.5 also needs the PaliGemma licence accepted in a browser, or its
# tokenizer 403s no matter what the token says --
# https://huggingface.co/google/paligemma-3b-pt-224
HF_TOKEN=

# https://wandb.ai/authorize -- training logs here unless --wandb.enable=false
WANDB_API_KEY=
