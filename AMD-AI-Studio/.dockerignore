# Docker 构建忽略文件
# 减少构建上下文大小，加快构建速度

# 版本控制
.git
.gitignore
.gitattributes

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# 虚拟环境
venv/
.venv/
env/

# 模型文件
*.pt
*.pth
*.bin
*.safetensors
*.onnx
models/*.gguf

# 输出目录（用 volume 持久化）
outputs/images/
outputs/videos/
outputs/gifs/
outputs/finetune/

# 系统缓存
.cache/
.DS_Store
*.log
*.lock

# 文档源码
docs/