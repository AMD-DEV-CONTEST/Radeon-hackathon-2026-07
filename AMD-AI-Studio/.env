# AMD AI Studio 环境配置（由 check_and_install.sh 自动生成 + 防 OOM 加固）
PYTHON_BIN=/opt/venv/bin/python3
VENV_DIR=/opt/venv
GPU_TYPE=amd
ROCM_VERSION=7.2.0
PROJECT_DIR=/workspace/amd-ai-studio

# === 防 OOM 全局变量 ===

# pip：禁用缓存，防止缓存爆炸
PIP_NO_CACHE_DIR=1

# 编译：限制并行编译数，防止多核编译 OOM（128核 → 最多2核并行）
MAX_JOBS=2

# 模型下载：禁用 hf-transfer（mmap 高速传输库），单线程下载
HF_HUB_ENABLE_HF_TRANSFER=0

# Node.js V8 堆上限（预留，未来可能用到）
NODE_OPTIONS="--max-old-space-size=4096"

# === 模型缓存目录（改到根分区大磁盘，/workspace 仅 20GB）===
HF_HOME=/root/.cache/huggingface
MODELSCOPE_CACHE=/root/.cache/modelscope/hub
TRANSFORMERS_CACHE=/root/.cache/huggingface
DIFFUSERS_CACHE=/root/.cache/huggingface

# === 下载源：优先使用 ModelScope（魔塔社区国内源）===
MODEL_SOURCE=modelscope
