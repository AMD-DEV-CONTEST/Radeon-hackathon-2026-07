FROM python:3.11.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    PYTHONIOENCODING=utf-8

RUN groupadd --gid 10001 creative \
    && useradd --uid 10001 --gid 10001 --no-create-home \
      --shell /usr/sbin/nologin creative

WORKDIR /workspace/creative_hub
COPY shared_contracts /workspace/shared_contracts
COPY atomic_runtime /workspace/atomic_runtime
COPY drama_factory /workspace/drama_factory
COPY analysis /workspace/analysis
COPY creative_hub /workspace/creative_hub
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
RUN export PIP_INDEX_URL="${PIP_INDEX_URL}" \
    && python -m pip install --no-cache-dir --upgrade pip==24.3.1 \
    && python -m pip install --no-cache-dir \
      /workspace/shared_contracts \
      /workspace/atomic_runtime \
      /workspace/drama_factory \
      /workspace/creative_hub \
    && python -m pip install --no-cache-dir --no-deps /workspace/analysis \
    && python -c "import atomic_runtime, creative_hub, douyin_analysis.atomic_plugin, drama, shared_contracts"

USER 10001:10001
ENTRYPOINT []
CMD ["python", "-c", "raise SystemExit('explicit Shidu runtime command required')"]
