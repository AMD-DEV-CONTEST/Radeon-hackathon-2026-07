FROM node:22.22.0-bookworm-slim AS build

WORKDIR /app
COPY consumer_web/package.json consumer_web/package-lock.json ./
RUN npm ci
COPY consumer_web ./
RUN npm run build

FROM nginx:1.27.4-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/consumer-web-nginx.conf /etc/nginx/nginx.conf
USER 101:101
ENTRYPOINT ["nginx", "-g", "daemon off;"]
