# AMD Radeon 云端原生进程模板。复制到受限权限文件后再填入真实标识和摘要。
AMD_ROOT=/persistent/douyin-amd
AMD_RUNTIME_ROOT=/workspace/amd-runtime-cache
AMD_RELEASE_DIR=${AMD_ROOT}/releases/current
AMD_PYTHON=${AMD_RUNTIME_ROOT}/venvs/app-py312/bin/python
AMD_BIN=${AMD_RUNTIME_ROOT}/venvs/app-py312/bin
AMD_PROVIDER_BIN=${AMD_RUNTIME_ROOT}/venvs/provider-py312/bin
AMD_ROCM_PYTHON=${AMD_RUNTIME_ROOT}/venvs/rocm/bin/python
AMD_COMFY_DIR=${AMD_ROOT}/comfyui/0.14.1-19236edf
AMD_WEB_DIR=${AMD_RELEASE_DIR}/consumer_web
AMD_GPU_TOTAL_VRAM_MIB=49140
AMD_MANAGE_COMFYUI=0
AMD_PERSISTENT_ROOT=/persistent/douyin-amd
AMD_COMPETITION_WORKER_ID=amd-vertical-slice-0
AMD_COMPETITION_STAGE_FACTORY=shidu_api.competition_stage_bundle:create_production_stage_functions

SHIDU_GPU_BACKEND=rocm
SHIDU_API_HOST=127.0.0.1
SHIDU_API_PORT=18082
SHIDU_PROVIDER_MCP_HOST=127.0.0.1
SHIDU_PROVIDER_MCP_PROFILE=public-keyless-v1
DRAMA_COMFY_BASE_0=http://127.0.0.1:18188
FACTORY_KEYFRAME_PROFILE=sdxl-core
SHIDU_SEARCH_MCP_ENDPOINT=http://127.0.0.1:18110/invoke
SHIDU_READER_MCP_ENDPOINT=http://127.0.0.1:18111/invoke
SHIDU_H3_AUTHORITY_ROOT=${AMD_ROOT}/authorities/h3
SHIDU_TTS_MCP_ENDPOINT=http://127.0.0.1:8788/mcp
CREATIVE_HUB_ALEMBIC_CONFIG=${AMD_RELEASE_DIR}/creative_hub/alembic.ini
CREATIVE_ORCHESTRATION_ALEMBIC_CONFIG=${AMD_RELEASE_DIR}/creative_hub/orchestration-alembic.ini

CREATIVE_HUB_POSTGRES_HOST=127.0.0.1
CREATIVE_HUB_POSTGRES_USER_FILE=${AMD_ROOT}/secrets/postgres-hub-user
CREATIVE_HUB_POSTGRES_PASSWORD_FILE=${AMD_ROOT}/secrets/postgres-hub-password
CREATIVE_HUB_POSTGRES_DB_FILE=${AMD_ROOT}/secrets/postgres-db
CREATIVE_ORCHESTRATION_POSTGRES_HOST=127.0.0.1
CREATIVE_ORCHESTRATION_POSTGRES_USER_FILE=${AMD_ROOT}/secrets/postgres-orchestration-user
CREATIVE_ORCHESTRATION_POSTGRES_PASSWORD_FILE=${AMD_ROOT}/secrets/postgres-orchestration-password
CREATIVE_ORCHESTRATION_POSTGRES_DB_FILE=${AMD_ROOT}/secrets/postgres-db
CREATIVE_HUB_MIGRATION_POSTGRES_HOST=127.0.0.1
CREATIVE_HUB_MIGRATION_POSTGRES_USER_FILE=${AMD_ROOT}/secrets/postgres-migration-user
CREATIVE_HUB_MIGRATION_POSTGRES_PASSWORD_FILE=${AMD_ROOT}/secrets/postgres-migration-password
CREATIVE_HUB_MIGRATION_POSTGRES_DB_FILE=${AMD_ROOT}/secrets/postgres-db

CREATIVE_HUB_CREDENTIAL_MASTER_KEY_FILE=${AMD_ROOT}/secrets/creative-hub-credential-master-key
SHIDU_SIGNING_SECRET_FILE=${AMD_ROOT}/secrets/shidu-signing-secret
SHIDU_PREVIOUS_SIGNING_SECRETS_FILE=${AMD_ROOT}/secrets/shidu-previous-signing-secrets
SHIDU_ZHIPU_CODING_PLAN_API_KEY_FILE=${AMD_ROOT}/secrets/shidu-zhipu-coding-plan-api-key
SHIDU_GOOGLE_BOOKS_API_KEY_FILE=${AMD_ROOT}/secrets/shidu-google-books-api-key
SHIDU_ZHIPU_API_KEY_FILE=${AMD_ROOT}/secrets/shidu-zhipu-api-key
SHIDU_ZHIPU_KEY_EPHEMERAL=0
SHIDU_QWEN_API_KEY_FILE=${AMD_ROOT}/secrets/shidu-qwen-api-key
SHIDU_AUDIO_AUTHORITY_FILE=${AMD_ROOT}/secrets/shidu-audio-authority.json
CREATIVE_HUB_COST_BUDGET_POLICY_FILE=${AMD_ROOT}/secrets/cost-budgets.json

SHIDU_PROJECT_ID=replace-with-project-uuid
SHIDU_VOICE_PRESET_REVISION_ID=replace-with-voice-preset-uuid
SHIDU_ACTOR_ID=amd-radeon-cloud
SHIDU_SERVICE_FACTORY=shidu_api.deployment:create_service
SHIDU_ARTIFACT_GATEWAY_FACTORY=shidu_api.deployment:create_artifact_gateway
CREATIVE_HUB_ARTIFACT_STORE_ROOT=${AMD_ROOT}/artifacts
FACTORY_PROJECT_ROOT=${AMD_ROOT}/projects
FACTORY_CONFIG_DIR=${AMD_RELEASE_DIR}/drama_factory/config
FACTORY_COMFY_CONFIG_FILE=${AMD_RELEASE_DIR}/drama_factory/config/comfyui.amd.yaml
FACTORY_PIPELINE_OVERRIDE_FILE=${AMD_RELEASE_DIR}/drama_factory/config/pipeline.amd.yaml
FACTORY_WORKFLOW_DIR=${AMD_RELEASE_DIR}/drama_factory/workflows
FACTORY_PROMPT_DIR=${AMD_RELEASE_DIR}/drama_factory/prompts
ANALYSIS_MODEL_ROOT=${AMD_ROOT}/models
ANALYSIS_ATOMIC_RUNTIME_ROOT=${AMD_ROOT}/analysis/atomic

# 下面是能力注册摘要，不是秘密；部署时必须替换为当前发布物计算出的 64 位 SHA-256。
AMD_KEYFRAME_MODEL_DIGEST=replace-with-keyframe-model-digest
AMD_VIDEO_MODEL_DIGEST=replace-with-video-model-digest
AMD_KEYFRAME_WORKFLOW_DIGEST=replace-with-keyframe-workflow-digest
AMD_VIDEO_WORKFLOW_DIGEST=replace-with-video-workflow-digest
AMD_KEYFRAME_NODE_ENV_DIGEST=replace-with-keyframe-node-environment-digest
AMD_VIDEO_NODE_ENV_DIGEST=replace-with-video-node-environment-digest
AMD_KEYFRAME_IMPLEMENTATION_DIGEST=replace-with-keyframe-implementation-digest
AMD_VIDEO_IMPLEMENTATION_DIGEST=replace-with-video-implementation-digest

TZ=Asia/Shanghai
LANG=C.UTF-8
