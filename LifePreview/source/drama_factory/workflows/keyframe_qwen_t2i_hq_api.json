{
  "_comment": "Qwen-Image base 纯文生图【高质量/资产模式】(ComfyUI API). 与 keyframe_qwen_t2i 同, 但【去掉 4 步 Lightning LoRA】、UNET 直连 ModelSamplingAuraFlow→CFGNorm→KSampler, 用 ~20 步 + cfg≈3(euler/simple) → 【负向提示词生效】(Lightning cfg=1 时 negative 被忽略, 故空场景去人/去文字/去烂手压不住; 本工作流恢复 CFG 引导)。专给【资产生成】(三视图/表情/服装/场景, 一次性生成, 慢点无所谓)用; 关键帧仍走 4 步 Lightning 的 keyframe_qwen_t2i。占位符: {{QWEN_T2I_CKPT}} {{POS_PROMPT}} {{NEG_PROMPT}} {{SEED}} {{WIDTH}} {{HEIGHT}} {{QWEN_STEPS}}(建议20) {{QWEN_CFG}}(建议3.0)。",
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "{{QWEN_T2I_CKPT}}", "weight_dtype": "default" }
  },
  "3": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": { "model": ["1", 0], "shift": 3.1 }
  },
  "4": {
    "class_type": "CFGNorm",
    "inputs": { "model": ["3", 0], "strength": 1.0 }
  },
  "5": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "type": "qwen_image", "device": "default" }
  },
  "6": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "qwen_image_vae.safetensors" }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["5", 0], "text": "{{POS_PROMPT}}" }
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["5", 0], "text": "{{NEG_PROMPT}}" }
  },
  "9": {
    "class_type": "EmptySD3LatentImage",
    "inputs": { "width": "{{WIDTH}}", "height": "{{HEIGHT}}", "batch_size": 1 }
  },
  "10": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["4", 0],
      "positive": ["7", 0],
      "negative": ["8", 0],
      "latent_image": ["9", 0],
      "seed": "{{SEED}}",
      "steps": "{{QWEN_STEPS}}",
      "cfg": "{{QWEN_CFG}}",
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["10", 0], "vae": ["6", 0] }
  },
  "12": {
    "class_type": "SaveImage",
    "inputs": { "images": ["11", 0], "filename_prefix": "asset_qwen_hq" }
  }
}
