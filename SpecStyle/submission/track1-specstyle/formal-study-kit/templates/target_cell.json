    {"layer": "L2", "observation_unit": "batch", "metric_id": "batch_style_consistency", "operator": "lte", "implementation_pin": {"id": "batch-style-consistency", "revision": "normalized-centroid-rms-v1", "sha256": "${BATCH_IMPLEMENTATION_SHA256}"}, "binding_pin": {"id": "${L2_BINDING_ID}", "revision": "${L2_BINDING_REVISION}", "sha256": "${L2_BINDING_SHA256}"}, "verifier_pin": {"id": "${L2_VERIFIER_ID}", "revision": "${L2_VERIFIER_REVISION}", "sha256": "${L2_VERIFIER_SHA256}"}, "preprocessor_pin": {"id": "${L2_PREPROCESSOR_ID}", "revision": "${L2_PREPROCESSOR_REVISION}", "sha256": "${L2_PREPROCESSOR_SHA256}"}},
    {"layer": "L2", "observation_unit": "item", "metric_id": "reference_style_statistics_similarity", "operator": "gte", "implementation_pin": {"id": "${L2_ITEM_IMPLEMENTATION_ID}", "revision": "${L2_ITEM_IMPLEMENTATION_REVISION}", "sha256": "${L2_ITEM_IMPLEMENTATION_SHA256}"}, "binding_pin": {"id": "${L2_BINDING_ID}", "revision": "${L2_BINDING_REVISION}", "sha256": "${L2_BINDING_SHA256}"}, "verifier_pin": {"id": "${L2_VERIFIER_ID}", "revision": "${L2_VERIFIER_REVISION}", "sha256": "${L2_VERIFIER_SHA256}"}, "preprocessor_pin": {"id": "${L2_PREPROCESSOR_ID}", "revision": "${L2_PREPROCESSOR_REVISION}", "sha256": "${L2_PREPROCESSOR_SHA256}"}},
    {"layer": "L3", "observation_unit": "item", "metric_id": "structure_edge_similarity", "operator": "gte", "implementation_pin": {"id": "${L3_IMPLEMENTATION_ID}", "revision": "${L3_IMPLEMENTATION_REVISION}", "sha256": "${L3_IMPLEMENTATION_SHA256}"}, "binding_pin": {"id": "${L3_BINDING_ID}", "revision": "${L3_BINDING_REVISION}", "sha256": "${L3_BINDING_SHA256}"}, "verifier_pin": {"id": "structure-edge-verifier", "revision": "sobel-cosine-v1", "sha256": "${L3_VERIFIER_SHA256}"}, "preprocessor_pin": {"id": "${L3_PREPROCESSOR_ID}", "revision": "${L3_PREPROCESSOR_REVISION}", "sha256": "${L3_PREPROCESSOR_SHA256}"}}
  ]
}
