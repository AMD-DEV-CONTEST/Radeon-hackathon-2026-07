{
  "schema_version": "specstyle.production.target_cell.v1",
  "style_pack_id": "${STYLE_PACK_ID}",
  "style_pack_pin": {"id": "${STYLE_PACK_PIN_ID}", "revision": "${STYLE_PACK_PIN_REVISION}", "sha256": "${STYLE_PACK_PIN_SHA256}"},
  "domain_profile": "structure_only",
  "domain_verifier_version": "${DOMAIN_VERIFIER_VERSION}",
  "output_profile": "xhs_grid",
  "output_profile_pin": {"id": "${OUTPUT_PIN_ID}", "revision": "${OUTPUT_PIN_REVISION}", "sha256": "${OUTPUT_PIN_SHA256}"},
  "generation_profile": "production",
  "compiler_pin": {"id": "${COMPILER_PIN_ID}", "revision": "${COMPILER_PIN_REVISION}", "sha256": "${COMPILER_PIN_SHA256}"},
  "rule_catalog_pin": {"id": "${RULE_CATALOG_PIN_ID}", "revision": "${RULE_CATALOG_PIN_REVISION}", "sha256": "${RULE_CATALOG_PIN_SHA256}"},
