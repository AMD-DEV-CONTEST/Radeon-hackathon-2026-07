{
  "schema_version": "specstyle.calibration.study_plan.v2",
  "study_id": "${STUDY_ID}",
  "target_cell_sha256": "${TARGET_CELL_SHA256}",
  "layer": "${L2_OR_L3}",
  "observation_unit": "${item_OR_batch}",
  "metric_id": "${METRIC_ID}",
  "operator": "${gte_OR_lte}",
  "targets": {"min_tpr": 0.9, "max_fpr": 0.1},
  "split": {"algorithm": "sha256_mod_60_20_20", "salt": "${SECRET_SPLIT_SALT}", "minimum_positive_per_split": 40, "minimum_negative_per_split": 40},
  "annotation_protocol_sha256": "${ANNOTATION_PROTOCOL_SHA256}"
}
