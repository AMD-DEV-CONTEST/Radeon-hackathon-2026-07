# MedGlass edge server environment — copy to .env and fill in.
# NEVER commit real keys. .env is gitignored.

# --- Login (optional) -------------------------------------------------------
# Default clinician account for the web UI. If no password is set, the server
# prints a one-time password to output/server.log on first boot.
MEDGLASS_LOGIN_USER=clinician
MEDGLASS_LOGIN_PASSWORD=

# --- Dashboard token gate (optional) ----------------------------------------
# Shared secret protecting patient data when the dashboard is exposed
# (e.g. through the MentraOS phone proxy). Leave empty for localhost-only use.
MEDGLASS_DASHBOARD_TOKEN=

# --- LLM backend (optional) ---------------------------------------------------
# Local backends (llama.cpp ROCm / Ollama) need no key. Only required if you
# deliberately set llm_backend=openrouter in config.json for cloud fallback.
MEDGLASS_OPENROUTER_API_KEY=
