# MedGlass — MentraOS app for Mentra Live
# Copy to .env and fill in from https://console.mentra.glass/apps

# Your app's unique identifier. Must match console.mentra.glass exactly
# (e.g. 'com.yourname.medglass').
PACKAGE_NAME=com.yourname.medglass

# API key for your app from the Developer Console.
API_KEY=replace-me

# Port the app server listens on (ngrok must point here). Default 3000.
PORT=3000

# The MedGlass edge server (Python/FastAPI) that runs vision + note generation.
# Usually localhost since it stays private behind ngrok.
MEDGLASS_URL=http://127.0.0.1:8100

# Set to 1 to also stream raw glasses audio to MedGlass for on-device whisper
# transcription (instead of MentraOS cloud STT). Cloud STT is the default.
MEDGLASS_USE_OWN_WHISPER=0

# Optional shared secret protecting patient data on the results dashboard.
# When set it is injected as X-Dashboard-Token on every proxy request, and MUST
# match MEDGLASS_DASHBOARD_TOKEN on the edge server (scripts/start_server.sh
# reads it from output/server.env). Leave empty to disable the token gate.
DASHBOARD_TOKEN=

# Your public ngrok URL (e.g. https://abc123.ngrok-free.dev). When set, the app
# shows a "Results Dashboard" link card on the phone after a note is generated.
PUBLIC_BASE_URL=
