# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/

# Models (downloaded, not committed)
models/*.bin
models/*.onnx
models/*.gguf

# Vendored builds
vendor/

# Local data & outputs (may contain PHI)
data/audio/*.wav
data/frames/
output/

# Secrets — never commit .env files
**/.env
**/.env.*
!.env.example

# Local runtime config (keep the example)
config.json
!config.example.json

# Keep empty dirs
!models/.gitkeep
