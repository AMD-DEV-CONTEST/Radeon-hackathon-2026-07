# StagePoster environment template
#
# Copy to .env at the project root and adjust. .env is gitignored — never
# commit real tokens.
#
#   cp .env.example .env
#
# Every variable below has a working default in code or scripts unless marked
# REQUIRED. Values shown are the defaults actually compiled into the binary
# (see backend/cmd/server/main.go and backend/internal/api/ai_config.go), so an
# empty .env still boots on a machine laid out like the reference host.

# ---------------------------------------------------------------------------
# Paths — where the project and its runtime data live
# ---------------------------------------------------------------------------
# Runtime data lives outside the repo so it survives redeploys. Point these at
# a persistent volume; the directories are created on first start.
STAGEPOSTER_ROOT=/workspace/poster-engine
BACKEND_ROOT=/workspace/poster-engine/backend
DB_PATH=/workspace/persistence/stageposter/data/poster.db
STORAGE_ROOT=/workspace/persistence/stageposter/storage/jobs
ASSET_STORAGE_ROOT=/workspace/persistence/stageposter/storage/assets
POSTER_OUTPUT_ROOT=/workspace/persistence/stageposter/storage/posters

# ---------------------------------------------------------------------------
# Go backend
# ---------------------------------------------------------------------------
LISTEN_ADDR=:8080

# Bearer token for the API. Empty means NO AUTH — acceptable for local dev
# only. Set a real value before exposing the backend through a tunnel.
# Clients may send it as `Authorization: Bearer <token>`, `X-Poster-Token`
# or `?token=`.
POSTER_API_TOKEN=

# Browser origin allowed to call the API. `*` is fine for local dev; pin it to
# the real frontend origin in production.
CORS_ORIGIN=*

# How often the reconcilers poll ComfyUI and advance the poster state machine.
RECONCILE_INTERVAL=2s

# ---------------------------------------------------------------------------
# Fonts — REQUIRED for Chinese posters
# ---------------------------------------------------------------------------
# Leave empty and the composer falls back to Go's built-in Latin faces, which
# have no CJK coverage: every Chinese glyph renders as a blank box. Noto CJK on
# Debian/Ubuntu ships as .ttc collections (apt install fonts-noto-cjk).
POSTER_FONT_REGULAR=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
POSTER_FONT_BOLD=/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc

# ---------------------------------------------------------------------------
# ComfyUI — image generation. Internal service, never exposed to the browser.
# ---------------------------------------------------------------------------
COMFY_ROOT=/workspace/poster-engine/ComfyUI
COMFY_VENV=/workspace/poster-engine/venv
COMFY_LISTEN=127.0.0.1
COMFY_PORT=8188
COMFY_URL=http://127.0.0.1:8188

WORKFLOW_PATH=/workspace/poster-engine/workflows/z_image_poster_v1.json
WORKFLOW_KEY=poster-text
WORKFLOW_VERSION=1.0.0

# Node IDs inside the workflow JSON that the backend overwrites per request.
# These must match the actual node keys in WORKFLOW_PATH — if they don't, the
# backend submits the template's stale hardcoded prompt instead of yours.
PROMPT_NODE_ID=57:27
SEED_NODE_ID=57:3

# Negative prompt node. The workflow now carries a real negative CLIPTextEncode
# (57:34) wired into the sampler's negative input, replacing the old
# ConditioningZeroOut. Two things must both hold for negative prompts to affect
# the image: this node is bound, AND COMFY_CFG > 1. At cfg=1 the guidance term
# cancels out and the negative branch is ignored no matter what is bound.
NEGATIVE_PROMPT_NODE_ID=57:34

# Sampler cfg override. Empty keeps the value in the workflow JSON (2).
# cfg=1 restores the original pure-turbo behaviour: fastest, but negative
# prompts become inert. Above 1 the sampler runs an extra pass per step, so
# expect roughly double the inference time.
COMFY_CFG=

# Reference-image conditioning. Filename of a Z-Image ControlNet patch inside
# ComfyUI/models/model_patches. When set, a reference asset on a request is
# uploaded to ComfyUI, run through Canny, and fed to ZImageFunControlnet, so it
# genuinely conditions the diffusion. Empty disables it: reference images then
# only reach the brief-understanding VLM call, and capabilities
# .referenceImageConditioning.available reports false.
# Adds roughly 10s per image and about 2GB VRAM while loaded.
REFERENCE_CONTROL_PATCH=Z-Image-Turbo-Fun-Controlnet-Union-2.1-lite-2602-8steps.safetensors

# ---------------------------------------------------------------------------
# vLLM / Qwen — art direction agent and vision critic.
# Internal service. NEVER expose port 8001 publicly: dev-mode endpoints below
# include sleep/wake controls with no auth.
# ---------------------------------------------------------------------------
VLLM_VENV=/workspace/poster-engine/.venv-vllm
VLM_MODEL_PATH=/workspace/poster-engine/models/Qwen3.5-9B
VLM_HOST=127.0.0.1
VLM_PORT=8001
VLM_URL=http://127.0.0.1:8001
VLM_MODEL=stageposter-vlm
VLM_API_KEY=stageposter-vlm-local
VLM_REQUEST_TIMEOUT=4m

# Put Qwen back to sleep after each call to hand VRAM back to ComfyUI.
#
# MUST stay false on ROCm 7.2 + vLLM 0.20.0: sleep/wake there dies with
# `CUDA Error: invalid argument` in cumem_allocator.cpp, and every AI endpoint
# returns 502 from then on. vLLM must also be started WITHOUT
# --enable-sleep-mode (see scripts/start-all.sh). Both services then stay
# resident on the single GPU; gpu-memory-utilization below leaves ComfyUI room.
VLM_AUTO_SLEEP=false

# ---------------------------------------------------------------------------
# vLLM tuning — sized for a single 48 GB card shared with ComfyUI
# ---------------------------------------------------------------------------
VLLM_DTYPE=float16
VLLM_GPU_MEMORY_UTILIZATION=0.65
VLLM_MAX_MODEL_LEN=4096
VLLM_MAX_NUM_SEQS=1
VLLM_MAX_BATCHED_TOKENS=4096

# Required by the sleep/wake memory coordinator on ROCm.
VLLM_ROCM_SLEEP_MEM_CHUNK_SIZE=256
VLLM_SERVER_DEV_MODE=1

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Hugging Face token, only needed to download gated model weights.
HF_TOKEN=

# Public HTTPS URL of the Cloudflare tunnel, written by the start scripts.
# Leave empty; the frontend should read its own VITE_API_BASE_URL rather than
# hardcoding a Quick Tunnel URL.
PUBLIC_API_URL=

# Image path used by cmd/aitest to exercise the vision critic by hand.
REVIEW_IMAGE=
