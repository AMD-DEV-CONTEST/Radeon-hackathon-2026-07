{
  "python.defaultInterpreterPath": "/workspace/amd-track2-agent/venvs/agent/bin/python",
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.env.linux": {
    "HF_HOME": "/workspace/amd-track2-agent/cache/huggingface",
    "TRANSFORMERS_CACHE": "/workspace/amd-track2-agent/cache/huggingface",
    "PATH": "/workspace/amd-track2-agent/tools/gh-current/bin:/workspace/amd-track2-agent/tools/npm-global/bin:/workspace/amd-track2-agent/tools/node-current/bin:${env:HOME}/.local/bin:${env:PATH}"
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/cache/**": true,
    "**/models/**": true,
    "**/venvs/**": true
  },
  "search.exclude": {
    "**/cache": true,
    "**/models": true,
    "**/venvs": true
  },
  "python.analysis.exclude": [
    "/workspace/amd-track2-agent/cache",
    "/workspace/amd-track2-agent/models",
    "/workspace/amd-track2-agent/venvs"
  ],
  "git.autofetch": false
}
