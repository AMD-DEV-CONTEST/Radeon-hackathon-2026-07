{
  "$defs": {
    "VerificationOutcome": {
      "enum": [
        "VERIFIED",
        "NEEDS_INPUT",
        "REPLAN",
        "REJECTED"
      ],
      "title": "VerificationOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checks": {
      "additionalProperties": {
        "type": "boolean"
      },
      "title": "Checks",
      "type": "object"
    },
    "execution_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execution Id"
    },
    "finding_codes": {
      "items": {
        "type": "string"
      },
      "title": "Finding Codes",
      "type": "array"
    },
    "outcome": {
      "$ref": "#/$defs/VerificationOutcome"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "safe_summary": {
      "minLength": 1,
      "title": "Safe Summary",
      "type": "string"
    },
    "verification_id": {
      "format": "uuid",
      "title": "Verification Id",
      "type": "string"
    },
    "verified_at": {
      "format": "date-time",
      "title": "Verified At",
      "type": "string"
    }
  },
  "required": [
    "verification_id",
    "run_id",
    "outcome",
    "checks",
    "safe_summary",
    "verified_at"
  ],
  "title": "VerificationReport",
  "type": "object"
}
