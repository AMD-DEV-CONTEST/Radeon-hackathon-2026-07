{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "retrieval_phase_trace.schema.v0.1.0",
  "title": "Public retrieval-phase trace contract",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "asset_id", "events"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "asset_id": {"type": "string", "minLength": 1},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["sequence", "event_type"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 0},
          "event_type": {
            "type": "string",
            "enum": [
              "current_source_retrieval",
              "current_card_changed",
              "knowledge_card_ready",
              "relation_candidate_search",
              "relation_confirmation",
              "relation_detail_retrieval",
              "relation_no_match"
            ]
          },
          "scope": {
            "type": "string",
            "enum": ["current_asset", "cross_asset_summary", "cross_asset_detail"]
          },
          "knowledge_card_version": {"type": "string"},
          "knowledge_card_hash": {"type": "string"},
          "milestone_state": {"type": "string"},
          "explicit_user_acceptance": {"type": "boolean"},
          "relation_id": {"type": "string"},
          "related_asset_id": {"type": "string"},
          "confirmed": {"type": "boolean"},
          "detail_included": {"type": "boolean"},
          "provenance_refs": {"type": "array", "items": {"type": "string"}},
          "mutated_current_statements": {"type": "boolean"},
          "current_statements_hash_before": {"type": "string"},
          "current_statements_hash_after": {"type": "string"}
        }
      }
    }
  }
}
