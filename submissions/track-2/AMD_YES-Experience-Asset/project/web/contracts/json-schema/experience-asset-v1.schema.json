        "version_id": {
          "format": "uuid",
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "user_action",
        "approved_at",
        "asset_id",
        "version_id",
        "route",
        "language",
        "route_draft_hash",
