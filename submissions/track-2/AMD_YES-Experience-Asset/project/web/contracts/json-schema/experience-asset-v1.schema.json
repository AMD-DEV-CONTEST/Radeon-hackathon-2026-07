          "type": "object"
        },
        "language": {
          "enum": [
            "zh-CN",
            "en"
          ],
          "title": "Language",
          "type": "string"
        },
        "privacy_review_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Privacy Review Hash",
          "type": "string"
