# Web status shell configuration (no secrets). Copy to `.env.local` to override.

# Data source: 'mock' (default) or 'live'.
VITE_DATA_SOURCE=mock

# Default mock scenario when VITE_DATA_SOURCE=mock.
# One of: healthy | loading | empty | failure | safe-stop | stale | terminal-failure
VITE_MOCK_SCENARIO=healthy

# Dev/preview proxy target: where /api is forwarded to (the local FastAPI backend).
# Only loopback HTTP(S) origins using localhost, 127.0.0.1, or ::1 are accepted.
VITE_PROXY_TARGET=http://127.0.0.1:8080
