{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "experience_asset.schema.v0.1.0",
  "title": "Canonical Experience Asset public structural contract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "asset_id",
    "version",
    "created_utc",
    "provenance",
    "context",
    "goal",
    "statements",
    "routes"
  ],
  "properties": {
    "asset_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^v?[0-9]+\\.[0-9]+"},
    "created_utc": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "required": ["source_kind", "adapted", "first_party_testimony"],
      "properties": {
        "source_kind": {"type": "string", "minLength": 1},
        "adapted": {"type": "boolean"},
        "first_party_testimony": {"type": "boolean"},
        "source_url": {"type": ["string", "null"]}
      }
    },
    "context": {"type": "string"},
    "goal": {"type": "string"},
    "statements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "status"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "status": {
            "type": "string",
            "enum": ["source_fact", "user_judgment", "agent_inference", "unresolved"]
          },
          "evidence_ref": {"type": ["string", "null"]},
          "presented_as_fact": {"type": "boolean"}
        }
      }
    },
    "routes": {
      "type": "object",
      "required": ["private_self", "beginner", "peer", "customer_evaluator", "public"],
      "additionalProperties": {
        "type": "object",
        "required": ["eligibility"],
        "properties": {
          "eligibility": {
            "type": "string",
            "enum": ["eligible", "ineligible", "eligible_after_privacy_approval", "blocked"]
          },
          "reason": {"type": ["string", "null"]}
        }
      }
    },
    "prior_versions": {"type": "array"},
    "relations": {"type": "array"}
  }
}
