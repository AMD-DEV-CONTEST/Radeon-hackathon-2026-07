{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "metric-record.schema.v1.0",
  "type": "object",
  "required": ["run_id", "scenario_type", "success", "terminal_state"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "scenario_type": {"enum": ["interactive", "background", "stress"]},
    "success": {"type": "boolean"},
    "terminal_state": {"type": "string", "minLength": 1},
    "error_class": {"type": ["string", "null"]},
    "ttft_ms": {"type": ["number", "null"], "minimum": 0},
    "e2e_latency_ms": {"type": ["number", "null"], "minimum": 0},
    "output_tps": {"type": ["number", "null"], "minimum": 0},
    "peak_vram_mib": {"type": ["number", "null"], "minimum": 0},
    "model_call_count": {"type": ["integer", "null"], "minimum": 0},
    "question_rounds": {"type": ["integer", "null"], "minimum": 0},
    "time_to_first_artifact_ms": {"type": ["number", "null"], "minimum": 0}
  }
}
