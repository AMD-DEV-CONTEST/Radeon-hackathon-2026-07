# OpenAI-compatible local inference endpoint.
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=EMPTY
MODEL_PATH=/workspace/amd-track2-agent/models/Qwen3.5-9B-460979c3d118
SERVED_MODEL_NAME=Qwen3.5-9B
MODEL_MANIFEST=/workspace/amd-track2-agent/repo/config/models/qwen3.5-9b.modelscope.json
MODEL_SNAPSHOT_VERIFY=1
VLLM_HOST=127.0.0.1
VLLM_PORT=8000
SERVING_PROFILE=P1-prefix-cache

# Optional Web UI. Keep it local; publish only through the approved rc-tunnel flow.
APP_HOST=127.0.0.1
APP_PORT=7860

# Keep secrets outside Git. Set HF_TOKEN only in the shell or a private .env.
HF_HOME=/workspace/amd-track2-agent/cache/huggingface
TRANSFORMERS_CACHE=/workspace/amd-track2-agent/cache/huggingface
# Radeon Cloud China cannot currently reach huggingface.co directly. Prefer a
# reviewed local/modelscope download. If using an HF-compatible mirror, set it
# only in the shell and record the source used for reproducibility.
# HF_ENDPOINT=https://<reviewed-hf-compatible-endpoint>
HF_HUB_DISABLE_XET=1

# Final P1 W7900 application values; Stage 1's historical screen used 8K/4.
VLLM_MAX_MODEL_LEN=20000
VLLM_GPU_MEMORY_UTILIZATION=0.82
VLLM_MAX_NUM_SEQS=2
VLLM_TOOL_CALL_PARSER=qwen3_coder
