          ],
          "statement_id": "c2221297-50e8-455a-825d-65306a51ebc9",
          "status": "USER_JUDGMENT",
          "text": "若未先采集基线，回滚决策将只能凭感觉。"
        },
        {
          "gap_reason": null,
          "is_visible_gap": false,
          "role": "LIMITATION",
          "source_decision_ids": [
            "870a9633-07d4-4794-89c6-e7a2779fa96c"
          ],
          "source_statement_ids": [
            "35d16a4a-f981-4a3f-9c7b-82a8cb767a44"
          ],
          "statement_id": "599d3456-b9d7-4c3d-9a73-fa59fe994f26",
          "status": "USER_JUDGMENT",
          "text": "该做法依赖稳定的流量结构，促销期不适用。"
        },
        {
          "gap_reason": null,
          "is_visible_gap": false,
          "role": "COUNTEREXAMPLE",
          "source_decision_ids": [
            "870a9633-07d4-4794-89c6-e7a2779fa96c"
