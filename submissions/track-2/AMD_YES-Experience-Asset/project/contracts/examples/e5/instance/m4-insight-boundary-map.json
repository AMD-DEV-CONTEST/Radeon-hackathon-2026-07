          "statement_id": "21483a39-df83-4eef-8688-2837e996c3c4",
          "status": "USER_JUDGMENT",
          "text": "先量化尾延迟再改缓存策略，避免改完无法判断是否变好。"
        },
        {
          "gap_reason": null,
          "is_visible_gap": false,
          "role": "SUPPORT",
