          ],
          "statement_id": "9dddc83b-68f9-4a1d-804a-88f10b2c69c2",
          "status": "USER_JUDGMENT",
          "text": "一次灰度期间流量结构骤变，基线对照失效。"
        },
        {
          "gap_reason": null,
          "is_visible_gap": false,
          "role": "APPLICABILITY",
