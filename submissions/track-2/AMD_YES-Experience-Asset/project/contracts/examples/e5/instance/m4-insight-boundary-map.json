          ],
          "statement_id": "c5f95ae1-ec3a-4c94-83c3-986282371479",
          "status": "USER_JUDGMENT",
          "text": "改动前后各采集一轮 P99，差异可归因到该次改动。"
        },
        {
          "gap_reason": null,
          "is_visible_gap": false,
          "role": "COUNTERFACTUAL",
          "source_decision_ids": [
            "870a9633-07d4-4794-89c6-e7a2779fa96c"
