{
  "$defs": {
    "InsightEntryV1": {
      "additionalProperties": false,
      "description": "One lesson together with the boundary that makes it safe to reuse.",
      "properties": {
        "insight_id": {
          "format": "uuid",
          "title": "Insight Id",
          "type": "string"
        },
        "source_decision_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Decision Ids",
          "type": "array"
        },
        "statements": {
          "items": {
            "$ref": "#/$defs/InsightStatementV1"
          },
          "minItems": 6,
          "title": "Statements",
          "type": "array"
        },
        "title": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "insight_id",
        "title",
        "source_decision_ids",
        "statements"
      ],
      "title": "InsightEntryV1",
      "type": "object"
    },
    "InsightStatementV1": {
      "additionalProperties": false,
      "description": "One role-bearing statement inside an insight entry.\n\nA statement is either grounded in canonical M3 evidence or explicitly marked\nas a visible gap. There is no third state: an ungrounded statement that does\nnot declare itself a gap renders identically to a supported one, and the\nreader has no signal that something is missing.",
      "properties": {
        "gap_reason": {
          "anyOf": [
            {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gap Reason"
        },
        "is_visible_gap": {
          "default": false,
          "title": "Is Visible Gap",
          "type": "boolean"
        },
        "role": {
          "enum": [
            "LESSON",
            "SUPPORT",
            "COUNTERFACTUAL",
            "LIMITATION",
            "COUNTEREXAMPLE",
            "APPLICABILITY"
          ],
          "title": "Role",
          "type": "string"
        },
        "source_decision_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Source Decision Ids",
          "type": "array"
        },
        "source_statement_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Source Statement Ids",
          "type": "array"
        },
        "statement_id": {
          "format": "uuid",
          "title": "Statement Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/StatementStatus"
        },
        "text": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "statement_id",
        "role",
        "text",
        "status"
      ],
      "title": "InsightStatementV1",
      "type": "object"
    },
    "StatementStatus": {
      "enum": [
        "SOURCE_FACT",
        "USER_JUDGMENT",
        "AGENT_INFERENCE",
        "UNRESOLVED"
      ],
      "title": "StatementStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Editable M4 artifact bound to one exact accepted M3 state.",
  "properties": {
    "affected_insight_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Affected Insight Ids",
      "type": "array"
    },
    "artifact_id": {
      "format": "uuid",
      "title": "Artifact Id",
      "type": "string"
    },
    "asset_id": {
      "format": "uuid",
      "title": "Asset Id",
      "type": "string"
    },
    "base_canonical_version_id": {
      "format": "uuid",
      "title": "Base Canonical Version Id",
      "type": "string"
    },
    "base_m3_artifact_id": {
      "format": "uuid",
      "title": "Base M3 Artifact Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dependency_decision_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Dependency Decision Ids",
      "type": "array"
    },
    "dependency_statement_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Dependency Statement Ids",
      "type": "array"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/InsightEntryV1"
      },
      "minItems": 1,
      "title": "Entries",
      "type": "array"
    },
    "generated_by_run_id": {
      "format": "uuid",
      "title": "Generated By Run Id",
      "type": "string"
    },
    "invalidated_by_canonical_version_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Invalidated By Canonical Version Id"
    },
    "invalidated_by_m3_artifact_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Invalidated By M3 Artifact Id"
    },
    "invalidation_reason": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Invalidation Reason"
    },
    "reusable_insight_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Reusable Insight Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "enum": [
        "NEEDS_INPUT",
        "REVIEW_READY",
        "CONFIRMED",
        "COMPLETE_WITH_GAPS",
        "INVALIDATED"
      ],
      "title": "State",
      "type": "string"
    },
    "unresolved_question_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Unresolved Question Ids",
      "type": "array"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "asset_id",
    "base_m3_artifact_id",
    "base_canonical_version_id",
    "generated_by_run_id",
    "state",
    "entries",
    "dependency_decision_ids",
    "created_at",
    "updated_at"
  ],
  "title": "InsightBoundaryMapV1",
  "type": "object"
}
