      "title": "Validation Findings",
      "type": "array"
    },
    "verification_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerificationReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "work_plan": {
      "$ref": "#/$defs/WorkPlanV1"
    }
  },
  "required": [
