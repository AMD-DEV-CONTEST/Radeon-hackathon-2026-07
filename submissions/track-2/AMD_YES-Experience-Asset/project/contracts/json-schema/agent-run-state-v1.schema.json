  "additionalProperties": false,
  "description": "Per-run agent state.\n\nThe relation fields below are a **read-only permission snapshot**, projected\nfrom the relation ledger at each policy evaluation — the same pattern as\n`permission_snapshot`. They are never the authority for relation state.\n\nTreating them as authoritative fails in two ways. Two concurrent runs on one\nasset would hold independent relation sets with no reconciliation, so\nwhichever wrote last would win. Worse, a long-running run would keep\nauthorizing detail reads from a set projected before the user corrected a\nbound asset — the exact stale access GRAG-16 exists to catch. Re-projecting\nat each evaluation keeps the permission decision tied to current canonical\nstate.",
  "properties": {
    "acceptance_checks": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Acceptance Checks",
      "type": "array"
    },
    "asset_id": {
      "format": "uuid",
      "title": "Asset Id",
      "type": "string"
    },
    "base_version_id": {
      "format": "uuid",
      "title": "Base Version Id",
      "type": "string"
    },
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "confirmed_related_asset_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Confirmed Related Asset Ids",
      "type": "array"
    },
    "confirmed_relation_bindings": {
      "items": {
        "$ref": "#/$defs/ConfirmedRelationBinding"
      },
      "title": "Confirmed Relation Bindings",
      "type": "array"
    },
    "confirmed_relation_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Confirmed Relation Ids",
      "type": "array"
    },
    "confirmed_relation_source_candidate_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Confirmed Relation Source Candidate Ids",
      "type": "array"
    },
    "current_milestone": {
      "$ref": "#/$defs/Milestone"
    },
    "knowledge_card_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Knowledge Card Hash"
    },
    "knowledge_card_version_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Knowledge Card Version Id"
    },
    "last_durable_version_id": {
      "format": "uuid",
      "title": "Last Durable Version Id",
      "type": "string"
    },
    "model_call_budget": {
      "exclusiveMinimum": 0,
      "title": "Model Call Budget",
      "type": "integer"
    },
    "model_calls_used": {
      "minimum": 0,
      "title": "Model Calls Used",
      "type": "integer"
    },
    "model_id": {
