{
  "$defs": {
    "ConfirmedAssetRelationV1": {
      "additionalProperties": false,
      "description": "A durable bilateral relation created by an explicit confirmation.\n\n`relation_id` is distinct from `source_candidate_id`: the relation is a new\ndurable object, while the candidate is the proposal it came from. Ticket 07\nchecks the source candidate against the run's candidate set, which preserves\nthe original intent — nothing can be confirmed which was never proposed —\nwithout requiring the two identifiers to be the same value.",
      "properties": {
        "confirmed_at": {
          "format": "date-time",
          "title": "Confirmed At",
          "type": "string"
        },
        "current_asset_id": {
          "format": "uuid",
          "title": "Current Asset Id",
          "type": "string"
        },
        "current_knowledge_card_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Current Knowledge Card Hash",
          "type": "string"
        },
        "current_projection_id": {
          "format": "uuid",
          "title": "Current Projection Id",
          "type": "string"
        },
        "current_version_id": {
          "format": "uuid",
          "title": "Current Version Id",
          "type": "string"
        },
        "historical_projection_id": {
          "format": "uuid",
          "title": "Historical Projection Id",
          "type": "string"
        },
        "invalidated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalidated At"
        },
        "invalidation_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalidation Reason"
        },
        "lifecycle": {
          "enum": [
            "CONFIRMED",
            "STALE",
            "INVALIDATED"
          ],
          "title": "Lifecycle",
          "type": "string"
        },
        "related_asset_id": {
          "format": "uuid",
          "title": "Related Asset Id",
          "type": "string"
        },
        "related_version_id": {
          "format": "uuid",
          "title": "Related Version Id",
          "type": "string"
        },
        "relation_id": {
          "format": "uuid",
          "title": "Relation Id",
          "type": "string"
        },
        "relation_type": {
          "$ref": "#/$defs/RelationType"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_candidate_id": {
          "format": "uuid",
          "title": "Source Candidate Id",
          "type": "string"
        }
      },
      "required": [
        "relation_id",
        "source_candidate_id",
        "relation_type",
        "current_asset_id",
        "current_version_id",
        "current_projection_id",
        "current_knowledge_card_hash",
        "related_asset_id",
        "related_version_id",
        "historical_projection_id",
        "lifecycle",
        "confirmed_at"
      ],
      "title": "ConfirmedAssetRelationV1",
      "type": "object"
    },
    "DiscoveryFailureClass": {
      "description": "Safe failure classes retained for audit.\n\nNone of these is reusable as a semantic result. Reusing one would let a\nfive-minute outage permanently erase a relation that may well exist.",
      "enum": [
        "MODEL_UNAVAILABLE",
        "MODEL_TIMED_OUT",
        "MALFORMED_MODEL_OUTPUT",
        "RUNTIME_VALIDATION_REJECTED",
        "STORAGE_CONFLICT",
        "STALE_BINDING",
        "LEASE_EXPIRED"
      ],
      "title": "DiscoveryFailureClass",
      "type": "string"
    },
    "DiscoveryOutcome": {
      "description": "Discriminated outcomes of one cross-asset discovery request.\n\n`NO_MATCH` is a semantic claim and is cached; `TECHNICAL_FAILURE` is not.\nCollapsing the two would make a temporary outage indistinguishable from a\nproven absence of relation, and the cache would then preserve the outage\npermanently.",
      "enum": [
        "NOT_READY",
        "RUNNING",
        "CANDIDATE",
        "NO_MATCH",
        "TECHNICAL_FAILURE",
        "STALE"
      ],
      "title": "DiscoveryOutcome",
      "type": "string"
    },
    "EvidenceCardRefusalReason": {
      "description": "Why a confirmed relation produced no evidence card.\n\nEach value is a whole-card refusal rather than a gap inside a rendered one.\nA card missing half its provenance still looks authoritative, and the user\nhas no way to see what was dropped — so the failure has to be the answer,\nnot a hole in one.",
      "enum": [
        "RELATION_NOT_LIVE",
        "BINDING_MISMATCH",
        "PERMISSION_REVOKED",
        "CONTENT_UNAVAILABLE",
        "PARTIAL_PROVENANCE",
        "MISSING_REFERENCES"
      ],
      "title": "EvidenceCardRefusalReason",
      "type": "string"
    },
    "EvidenceCardRefusalV1": {
      "additionalProperties": false,
      "description": "A typed refusal the caller renders as itself.\n\nDiscriminated from the card by `outcome`, so a consumer cannot mistake a\nrefusal for an empty card. That distinction is the point: a partially\nrendered card reads as complete, which is exactly the failure the refusal\nexists to prevent.",
      "properties": {
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "outcome": {
          "const": "REFUSED",
          "default": "REFUSED",
          "title": "Outcome",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/EvidenceCardRefusalReason"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unresolved_node_ids": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Node Ids",
          "type": "array"
        },
        "unresolved_refs": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Refs",
          "type": "array"
        }
      },
      "required": [
        "reason",
        "detail"
      ],
      "title": "EvidenceCardRefusalV1",
      "type": "object"
    },
    "EvidenceCardV1": {
      "additionalProperties": false,
      "description": "The rendered bilateral comparison for one confirmed relation.\n\nComposed on read like the workspace that carries it, and never serialized\nback into the Experience Asset snapshot — so producing it cannot change the\nsnapshot JSON, the statement hash, or the Knowledge Card hash.",
      "properties": {
        "boundaries": {
          "items": {
            "$ref": "#/$defs/TransferBoundaryV1"
          },
          "minItems": 1,
          "title": "Boundaries",
          "type": "array"
        },
        "card_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Card Hash",
          "type": "string"
        },
        "card_schema_version": {
          "const": "e5-evidence-card/v1",
          "default": "e5-evidence-card/v1",
          "title": "Card Schema Version",
          "type": "string"
        },
        "current_asset_id": {
          "format": "uuid",
          "title": "Current Asset Id",
          "type": "string"
        },
        "current_knowledge_card_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Current Knowledge Card Hash",
          "type": "string"
        },
        "current_version_id": {
          "format": "uuid",
          "title": "Current Version Id",
          "type": "string"
        },
        "mapped_roles": {
          "items": {
            "$ref": "#/$defs/MappedRoleEvidenceV1"
          },
          "minItems": 1,
          "title": "Mapped Roles",
          "type": "array"
        },
        "outcome": {
          "const": "RENDERED",
          "default": "RENDERED",
          "title": "Outcome",
          "type": "string"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/SideProvenanceV1"
          },
          "minItems": 2,
          "title": "Provenance",
          "type": "array"
        },
        "related_asset_id": {
          "format": "uuid",
          "title": "Related Asset Id",
          "type": "string"
        },
        "related_version_id": {
          "format": "uuid",
          "title": "Related Version Id",
          "type": "string"
        },
        "relation_id": {
          "format": "uuid",
          "title": "Relation Id",
          "type": "string"
        },
        "relation_type": {
          "$ref": "#/$defs/RelationType"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "relation_id",
        "relation_type",
        "current_asset_id",
        "current_version_id",
        "current_knowledge_card_hash",
        "related_asset_id",
        "related_version_id",
        "mapped_roles",
        "boundaries",
        "provenance",
        "card_hash"
      ],
      "title": "EvidenceCardV1",
      "type": "object"
    },
    "KnowledgeCardReadinessRecordV1": {
      "additionalProperties": false,
      "description": "Sidecar readiness record, keyed by asset, version and card hash.\n\nBinding to an exact version and hash is what makes staleness expressible. If\nreadiness pointed at the asset, a later edit would silently inherit every\nrelation built on the older text, and the user would see a confirmed\nrelation whose stated reason no longer matches what the card says.",
      "properties": {
        "accepted_at": {
          "format": "date-time",
          "title": "Accepted At",
          "type": "string"
        },
        "accepted_gap_statement_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Accepted Gap Statement Ids",
          "type": "array"
        },
        "asset_id": {
          "format": "uuid",
          "title": "Asset Id",
          "type": "string"
        },
        "explicit_user_acceptance": {
          "const": true,
          "default": true,
          "title": "Explicit User Acceptance",
          "type": "boolean"
        },
        "invalidated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalidated At"
        },
        "invalidation_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalidation Reason"
        },
        "knowledge_card_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Knowledge Card Hash",
          "type": "string"
        },
        "lifecycle": {
          "$ref": "#/$defs/ReadinessLifecycle",
          "default": "ACTIVE"
        },
        "m4_artifact_id": {
          "format": "uuid",
          "title": "M4 Artifact Id",
          "type": "string"
        },
        "milestone_state": {
          "enum": [
            "CONFIRMED",
            "COMPLETE_WITH_GAPS"
          ],
          "title": "Milestone State",
          "type": "string"
        },
        "readiness_id": {
          "format": "uuid",
          "title": "Readiness Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version_id": {
          "format": "uuid",
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": [
        "readiness_id",
        "asset_id",
        "version_id",
        "m4_artifact_id",
        "knowledge_card_hash",
        "milestone_state",
        "accepted_at"
      ],
      "title": "KnowledgeCardReadinessRecordV1",
      "type": "object"
    },
    "MappedRoleEvidenceV1": {
      "additionalProperties": false,
      "description": "One bilateral correspondence, labelled with both sides' canonical text.\n\nThe labels are the projections' own `summary_text`, copied verbatim. They\nare not regenerated, reworded or truncated: the text the user can open must\nbe the text the card shows, or the card is describing something the evidence\ndoes not say.",
      "properties": {
        "current_label": {
          "minLength": 1,
          "title": "Current Label",
          "type": "string"
        },
        "current_label_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Current Label Hash",
          "type": "string"
        },
        "current_node_id": {
          "minLength": 1,
          "title": "Current Node Id",
          "type": "string"
        },
        "current_role": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectionEdgeType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "historical_label": {
          "minLength": 1,
          "title": "Historical Label",
          "type": "string"
        },
        "historical_label_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Historical Label Hash",
          "type": "string"
        },
        "historical_node_id": {
          "minLength": 1,
          "title": "Historical Node Id",
          "type": "string"
        },
        "historical_role": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectionEdgeType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "current_node_id",
        "historical_node_id",
        "current_label",
        "historical_label",
        "current_label_hash",
        "historical_label_hash"
      ],
      "title": "MappedRoleEvidenceV1",
      "type": "object"
    },
    "ProjectionEdgeType": {
      "description": "Membership edges only.\n\nEvery edge means \"this canonical record has this member in this role\".\nStatement order, temporal proximity and semantic similarity cannot prove\ncausation, so no edge asserts it; a causal label would present the system's\nguess with the same authority as the user's own confirmed account.",
      "enum": [
        "HAS_CUE",
        "HAS_CHANGE",
        "HAS_SURPRISE",
        "HAS_CONFLICT",
        "HAS_ALTERNATIVE",
        "HAS_REASON",
        "HAS_ACTION",
        "HAS_RESULT",
        "HAS_EVIDENCE",
        "HAS_SUPPORT",
        "HAS_COUNTERFACTUAL",
        "HAS_LIMITATION",
        "HAS_COUNTEREXAMPLE",
        "HAS_APPLICABILITY"
      ],
      "title": "ProjectionEdgeType",
      "type": "string"
    },
    "ReadinessLifecycle": {
      "description": "Lifecycle of a readiness record.\n\nDeliberately not `ProjectionLifecycle`: a projection is built incrementally\nand only becomes eligible when complete, but readiness is minted whole by\none explicit user action. Reusing the projection enum let a readiness record\nclaim `CONFIRMED` while sitting in `BUILDING`, which two consumers could\nreasonably read as opposite answers to \"is this card ready\".",
      "enum": [
        "ACTIVE",
        "STALE",
        "INVALIDATED"
      ],
      "title": "ReadinessLifecycle",
      "type": "string"
    },
    "RelationCandidateDecisionV1": {
      "additionalProperties": false,
      "description": "The user's explicit decision about one exact candidate.\n\nEvery binding the decision was made against is carried so that a request\narriving with a stale card version fails closed rather than being resolved\nagainst whatever is current. Resolving it silently would grant access based\non a decision the user made about different content.",
      "properties": {
        "candidate_id": {
          "format": "uuid",
          "title": "Candidate Id",
          "type": "string"
        },
        "current_asset_id": {
          "format": "uuid",
          "title": "Current Asset Id",
          "type": "string"
        },
        "current_knowledge_card_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Current Knowledge Card Hash",
          "type": "string"
        },
        "current_version_id": {
          "format": "uuid",
          "title": "Current Version Id",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "decision_id": {
          "format": "uuid",
          "title": "Decision Id",
          "type": "string"
        },
        "related_asset_id": {
          "format": "uuid",
          "title": "Related Asset Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "user_action": {
          "enum": [
            "CONFIRM",
            "DECLINE"
          ],
          "title": "User Action",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "candidate_id",
        "current_asset_id",
        "current_version_id",
        "current_knowledge_card_hash",
        "related_asset_id",
        "user_action",
        "decided_at"
      ],
      "title": "RelationCandidateDecisionV1",
      "type": "object"
    },
    "RelationCandidateV1": {
      "additionalProperties": false,
      "description": "A validated cross-asset candidate.\n\nThis replaces the pre-E5 fixture shape, which carried a free-text\n`proposed_relation` and a flat provenance list and could not express a fixed\nrelation type, bilateral mapping, boundary nodes, projection bindings,\nfingerprint or lifecycle. Extending it is a breaking change to a symbol the\nE5→E6 handoff manifest freezes, and E6 needs the new shape before it lands.\n\n`detail_included` is pinned false: the candidate view never carries\nhistorical detail, because showing the detail before the decision would make\nthe confirmation choice moot.",
      "properties": {
        "candidate_id": {
          "format": "uuid",
          "title": "Candidate Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "current_asset_id": {
          "format": "uuid",
          "title": "Current Asset Id",
          "type": "string"
        },
        "current_boundary_node_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Current Boundary Node Ids",
          "type": "array"
        },
        "current_projection_id": {
          "format": "uuid",
          "title": "Current Projection Id",
          "type": "string"
        },
        "detail_included": {
          "const": false,
          "default": false,
          "title": "Detail Included",
          "type": "boolean"
        },
        "discovery_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Discovery Fingerprint",
          "type": "string"
        },
        "historical_boundary_node_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Historical Boundary Node Ids",
          "type": "array"
        },
        "historical_projection_id": {
          "format": "uuid",
          "title": "Historical Projection Id",
          "type": "string"
        },
        "lifecycle": {
          "$ref": "#/$defs/RelationLifecycle",
          "default": "PROPOSED"
        },
        "node_mappings": {
          "items": {
            "$ref": "#/$defs/RelationNodeMappingV1"
          },
          "minItems": 1,
          "title": "Node Mappings",
          "type": "array"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/RelationProvenanceRefV1"
          },
          "minItems": 2,
          "title": "Provenance",
          "type": "array"
        },
        "related_asset_id": {
          "format": "uuid",
          "title": "Related Asset Id",
          "type": "string"
        },
        "relation_type": {
          "$ref": "#/$defs/RelationType"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "validation_contract_version": {
          "default": "e5-relation/v1",
          "minLength": 1,
          "title": "Validation Contract Version",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "discovery_fingerprint",
        "current_asset_id",
        "current_projection_id",
        "related_asset_id",
        "historical_projection_id",
        "relation_type",
        "title",
        "summary",
        "node_mappings",
        "current_boundary_node_ids",
        "provenance",
        "created_at"
      ],
      "title": "RelationCandidateV1",
      "type": "object"
    },
    "RelationLifecycle": {
      "description": "Lifecycle of a validated candidate or a confirmed relation.\n\nRecords are append-only; invalidation moves state here rather than deleting\nthe row, because deleting it would make an invalidated relation\nindistinguishable from one that never existed.",
      "enum": [
        "PROPOSED",
        "CONFIRMED",
        "DECLINED",
        "STALE",
        "INVALIDATED"
      ],
      "title": "RelationLifecycle",
      "type": "string"
    },
    "RelationNodeMappingV1": {
      "additionalProperties": false,
      "description": "One bilateral node correspondence proposed by the model.\n\nThe model returns only supplied node identifiers. It cannot return new\nfacts, nodes, edges, provenance, scores or titles, because the Runtime can\nvalidate an identifier against a stored projection but cannot validate an\ninvented claim.\n\nA role of `None` on both sides marks a root-to-root mapping, which is what\n`SAME_THEME` claims. Roles must be absent or present together: a mapping\nthat pairs a root with a member describes a correspondence between things\nof different kinds, and no relation type defines what that would mean.",
      "properties": {
        "current_node_id": {
          "minLength": 1,
          "title": "Current Node Id",
          "type": "string"
        },
        "current_role": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectionEdgeType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "historical_node_id": {
          "minLength": 1,
          "title": "Historical Node Id",
          "type": "string"
        },
        "historical_role": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectionEdgeType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "current_node_id",
        "historical_node_id"
      ],
      "title": "RelationNodeMappingV1",
      "type": "object"
    },
    "RelationProvenanceRefV1": {
      "additionalProperties": false,
      "description": "Side-attributed provenance.\n\nThe side is explicit because a flat reference list cannot say which asset a\nreference belongs to, and a bilateral explanation that cannot be attributed\nto both sides is not bilateral.",
      "properties": {
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "side": {
          "enum": [
            "CURRENT",
            "HISTORICAL"
          ],
          "title": "Side",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "statement_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Statement Ids",
          "type": "array"
        }
      },
      "required": [
        "side",
        "node_id",
        "statement_ids"
      ],
      "title": "RelationProvenanceRefV1",
      "type": "object"
    },
    "RelationType": {
      "description": "Closed vocabulary for cross-asset relations.\n\nThe vocabulary is closed so a relation label means the same thing in a\nsession weeks later. A model-invented synonym would read as a distinct\nrelation to the user while carrying no admissibility rule behind it, so\nabstention preserves meaning better than an unmapped label.",
      "enum": [
        "SAME_THEME",
        "METHOD_REUSE",
        "COUNTEREXAMPLE",
        "SUPPLEMENT",
        "PREREQUISITE",
        "FOLLOW_UP"
      ],
      "title": "RelationType",
      "type": "string"
    },
    "SideProvenanceV1": {
      "additionalProperties": false,
      "description": "One side's provenance identifiers.\n\nThe side is explicit for the same reason it is explicit on the candidate: a\nflat reference list cannot say which asset a reference belongs to, and a\nbilateral explanation that cannot be attributed to both sides is not\nbilateral.",
      "properties": {
        "asset_id": {
          "format": "uuid",
          "title": "Asset Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "node_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Node Ids",
          "type": "array"
        },
        "projection_id": {
          "format": "uuid",
          "title": "Projection Id",
          "type": "string"
        },
        "side": {
          "enum": [
            "CURRENT",
            "HISTORICAL"
          ],
          "title": "Side",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "span_refs": {
          "items": {
            "type": "string"
          },
          "title": "Span Refs",
          "type": "array"
        },
        "statement_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Statement Ids",
          "type": "array"
        }
      },
      "required": [
        "side",
        "asset_id",
        "projection_id",
        "node_ids",
        "statement_ids"
      ],
      "title": "SideProvenanceV1",
      "type": "object"
    },
    "TransferBoundaryV1": {
      "additionalProperties": false,
      "description": "The condition under which the relation transfers, quoted from its source.\n\nA lesson drawn from one person's experience, presented without its\nlimitation and its transfer condition, reads as general advice. The user\nthen applies it in a situation the original experience never covered, and\nthe asset has actively misled them. So the boundary is quoted with the node\nit came from rather than paraphrased into the card's own voice.",
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectionEdgeType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "side": {
          "enum": [
            "CURRENT",
            "HISTORICAL"
          ],
          "title": "Side",
          "type": "string"
        }
      },
      "required": [
        "side",
        "node_id",
        "content",
        "content_hash"
      ],
      "title": "TransferBoundaryV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Read-only composition of relation state for the API.\n\nThis is what replaces the retired snapshot fields for consumers. It is\ncomposed on read and never serialized back into the Experience Asset\nsnapshot, so a relation read cannot change the snapshot JSON or its content\nhash.",
  "properties": {
    "asset_id": {
      "format": "uuid",
      "title": "Asset Id",
      "type": "string"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/RelationCandidateV1"
      },
      "title": "Candidates",
      "type": "array"
    },
    "canonical_version_id": {
      "format": "uuid",
      "title": "Canonical Version Id",
      "type": "string"
    },
    "confirmed_relations": {
      "items": {
        "$ref": "#/$defs/ConfirmedAssetRelationV1"
      },
      "title": "Confirmed Relations",
      "type": "array"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/RelationCandidateDecisionV1"
      },
      "title": "Decisions",
      "type": "array"
    },
    "discovery_outcome": {
      "$ref": "#/$defs/DiscoveryOutcome",
      "default": "NOT_READY"
    },
    "evidence_card": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceCardV1"
        },
        {
          "$ref": "#/$defs/EvidenceCardRefusalV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Card"
    },
    "failure_class": {
      "anyOf": [
        {
          "$ref": "#/$defs/DiscoveryFailureClass"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "readiness": {
      "anyOf": [
        {
          "$ref": "#/$defs/KnowledgeCardReadinessRecordV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "asset_id",
    "canonical_version_id"
  ],
  "title": "RelationWorkspaceV1",
  "type": "object"
}
