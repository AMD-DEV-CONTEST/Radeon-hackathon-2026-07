          "title": "Moment Id",
          "type": "string"
        },
        "source_statement_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Statement Ids",
          "type": "array",
          "uniqueItems": true
        },
        "surprise_statement_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Surprise Statement Ids",
          "type": "array"
        },
        "temporal_status": {
          "const": "CONFLICTING",
          "title": "Temporal Status",
          "type": "string"
        },
        "time_label": {
          "title": "Time Label",
          "type": "null"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "unresolved_reason": {
