  "description": "M2 artifact bound to one accepted M1 version and its source statements.",
  "properties": {
    "artifact_id": {
      "format": "uuid",
      "title": "Artifact Id",
      "type": "string"
    },
    "asset_id": {
      "format": "uuid",
      "title": "Asset Id",
      "type": "string"
    },
    "base_m1_version_id": {
      "format": "uuid",
      "title": "Base M1 Version Id",
      "type": "string"
    },
