      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dependency_statement_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Dependency Statement Ids",
      "type": "array",
      "uniqueItems": true
    },
    "generated_by_run_id": {
      "format": "uuid",
      "title": "Generated By Run Id",
      "type": "string"
    },
    "invalidated_by_m1_version_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Invalidated By M1 Version Id"
    },
    "invalidation_reason": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Invalidation Reason"
    },
    "moments": {
      "items": {
        "discriminator": {
          "mapping": {
            "CONFLICTING": "#/$defs/ConflictingTimeMomentV1",
            "KNOWN": "#/$defs/KnownTimeMomentV1",
            "MISSING": "#/$defs/MissingTimeMomentV1"
          },
          "propertyName": "temporal_status"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/KnownTimeMomentV1"
          },
          {
            "$ref": "#/$defs/MissingTimeMomentV1"
          },
          {
            "$ref": "#/$defs/ConflictingTimeMomentV1"
          }
        ]
      },
      "title": "Moments",
      "type": "array"
    },
    "order_basis": {
      "enum": [
        "SOURCE_ASSERTED",
        "NARRATIVE_SEQUENCE",
        "PARTIAL_ORDER"
      ],
      "title": "Order Basis",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "enum": [
        "NEEDS_INPUT",
        "REVIEW_READY",
        "CONFIRMED",
        "COMPLETE_WITH_GAPS",
        "INVALIDATED"
      ],
      "title": "State",
      "type": "string"
    },
    "unresolved_question_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Unresolved Question Ids",
      "type": "array"
    },
    "updated_at": {
