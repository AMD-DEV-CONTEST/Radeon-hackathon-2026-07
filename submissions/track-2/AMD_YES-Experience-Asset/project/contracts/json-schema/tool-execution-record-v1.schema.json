{
  "$defs": {
    "ToolExecutionStatus": {
      "enum": [
        "SUCCEEDED",
        "DENIED",
        "FAILED",
        "TIMED_OUT"
      ],
      "title": "ToolExecutionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "error_class": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Class"
    },
    "execution_id": {
      "format": "uuid",
      "title": "Execution Id",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "observation_refs": {
      "items": {
        "type": "string"
      },
      "title": "Observation Refs",
      "type": "array"
    },
    "policy_decision_id": {
      "format": "uuid",
      "title": "Policy Decision Id",
      "type": "string"
    },
    "proposal_id": {
      "format": "uuid",
      "title": "Proposal Id",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "sanitized_argument_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sanitized Argument Hash",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ToolExecutionStatus"
    },
    "tool_name": {
      "minLength": 1,
      "title": "Tool Name",
      "type": "string"
    }
  },
  "required": [
    "execution_id",
    "run_id",
    "proposal_id",
    "policy_decision_id",
    "tool_name",
    "sanitized_argument_hash",
    "status",
    "started_at",
    "finished_at"
  ],
  "title": "ToolExecutionRecord",
  "type": "object"
}
