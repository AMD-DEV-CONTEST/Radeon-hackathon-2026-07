# ── Demo Mode ───────────────────────────────────────────────
# Set to true to run without Supabase (in-memory mock data). Skips ALL auth.
# Both server and client read this variable.
#
# Note: demo mode still calls the real LLM. A public demo has no login, so the
# per-day cap can only be keyed by IP and counted in process memory, which does
# not hold across instances. /api/chat therefore refuses to serve a demo in
# production unless you accept that explicitly (see ALLOW_UNMETERED_DEMO).
NEXT_PUBLIC_DEMO_MODE=true

# Messages per IP per day in demo mode.
# DEMO_CHAT_PER_DAY=20
# Only for single-instance hosts, where the in-memory counter is actually valid.
# ALLOW_UNMETERED_DEMO=false

# ── Agent Provider ──────────────────────────────────────────
# qwen (default) | claude | openai | mtclaw | local
AGENT_PROVIDER=qwen

# ── Competition mode (optional) ──────────────────────────────
# COMPETITION_MODE=qwen     → uses Qwen Cloud (Global AI Hackathon Series)
# COMPETITION_MODE=casper   → uses Qwen + Casper blockchain tools (Casper Buildathon)
# COMPETITION_MODE=(unset)  → standard Solo Worker OS behavior

# ── LLM providers ────────────────────────────────────────────
# Qwen Cloud / DashScope (default provider)
DASHSCOPE_API_KEY=sk-xxxxxxxx
QWEN_MODEL=qwen-plus

# Anthropic Claude (used when AGENT_PROVIDER=claude)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# OpenAI (used when AGENT_PROVIDER=openai)
# OPENAI_API_KEY=sk-xxxxxxxx

# ── Local self-hosted LLM (used when AGENT_PROVIDER=local) ──
# Private deployment on a participant-controlled AMD Radeon GPU + ROCm
# endpoint. vLLM/SGLang expose an OpenAI-compatible chat endpoint, avoiding a
# commercial third-party LLM API in the inference path.
# LOCAL_LLM_BASE_URL=http://localhost:8000/v1/chat/completions
# LOCAL_LLM_API_KEY=EMPTY
# LOCAL_LLM_MODEL=Qwen/Qwen3-4B
# SOLO_LOCAL_MODE=true

# ── Casper Network (used when COMPETITION_MODE=casper) ───────
# NEXT_PUBLIC_CASPER_RPC_URL=https://api.testnet.casper.network

# ── Supabase (required when NEXT_PUBLIC_DEMO_MODE=false) ─────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Cron (required in production) ────────────────────────────
# GET /api/cron spends LLM tokens and sends email. Without a secret it is only
# reachable outside production; in production an unset secret makes it return 401.
# Vercel Cron sends `Authorization: Bearer <CRON_SECRET>`.
# CRON_SECRET=some-long-random-string
# NOTIFICATION_EMAIL=you@example.com
# NOTIFICATION_FROM_EMAIL=Solo Worker OS <notify@yourdomain.com>
# RESEND_API_KEY=re_xxxxxxxx

# ── Stripe (optional, for monetization) ──────────────────────
# All three of SECRET_KEY + PRO_PRICE_ID + WEBHOOK_SECRET must be set before
# /pricing shows a real checkout button. Any missing piece means a payment could
# not be turned into a plan, so the page falls back to a contact flow instead.
# The webhook endpoint is POST /api/stripe/webhook; subscribe it to
# checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted.
# STRIPE_SECRET_KEY=sk_live_xxxxxxxx
# STRIPE_PRO_PRICE_ID=price_xxxxxxxx
# STRIPE_TEAM_PRICE_ID=price_xxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
