# The guard rejects any non-loopback host or any port other than 8000.
VLLM_BASE_URL=http://127.0.0.1:8000/v1

# Primary model stored on the Radeon Cloud persistent volume.
# Switch to /persistent/models/Qwen2.5-VL-7B-Instruct only if the gate fails.
MODEL_ID=/persistent/models/Qwen3-VL-8B-Instruct
SERVED_MODEL_NAME=Qwen/Qwen3-VL-8B-Instruct
VLLM_EXECUTABLE=/opt/venv/bin/vllm

VLLM_HOST=127.0.0.1
VLLM_PORT=8000
VLLM_DTYPE=auto
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_IMAGES_PER_PROMPT=8
ENABLE_PREFIX_CACHING=0
FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE

# Versioned legal corpus and local-only retrieval.
LEGAL_MANIFEST_PATH=data/laws/source_manifest.json
LEGAL_CORPUS_DB=data/laws/legal_corpus.sqlite3
QDRANT_PATH=data/qdrant/legal
ORCHESTRATOR_CHECKPOINT_DB=data/checkpoints/orchestrator.sqlite3

# UI / E2E modes. mock never calls a model; local_vllm is restricted to
# http://127.0.0.1:8000/v1 and has no public API fallback.
DEMO_MODE=mock
MODEL_MODE=mock
CASE_ROOT=data/cases
REPORT_ROOT=artifacts/demo_reports
DEMO_RUNTIME_DIR=artifacts/demo_runtime
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
GRADIO_ANALYTICS_ENABLED=False

# Production/Radeon setting: bge. For a dependency-light local regression run,
# explicitly override either provider with hash/heuristic.
EMBEDDING_PROVIDER=bge
BGE_M3_MODEL_PATH=/persistent/models/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
RERANKER_PROVIDER=bge
BGE_RERANKER_MODEL_PATH=/persistent/models/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
