{
  "schema_version": 1,
  "ruleset_id": "CN-E_BICYCLE-GB17761-2024-v1",
  "jurisdiction": "中华人民共和国",
  "effective_date": "2025-09-01",
  "expiry_date": null,
  "source_law_id": "CN-GB-17761-2024",
  "rules": [
    {
      "parameter": "design_max_speed",
      "display_name": "设计最高车速",
      "aliases": ["最高设计时速", "最高设计车速", "设计最高车速", "最高车速"],
      "comparison": "max_numeric",
      "threshold": 25,
      "unit": "km/h",
      "requirement": "最高设计车速不超过25 km/h，超过25 km/h时电动机不应继续提供动力输出",
      "source_article": "6.1.1.1"
    },
    {
      "parameter": "complete_vehicle_mass",
      "display_name": "整车质量",
      "aliases": ["整车质量", "车重", "空车质量"],
      "comparison": "battery_dependent_mass",
      "threshold": 55,
      "lead_acid_threshold": 63,
      "unit": "kg",
      "requirement": "铅酸蓄电池车型整车质量不超过63 kg，其他蓄电池车型不超过55 kg",
      "source_article": "6.1.3"
    },
    {
      "parameter": "rated_motor_power",
      "display_name": "电机额定连续输出功率",
      "aliases": ["电机额定功率", "额定功率", "电机功率", "额定连续输出功率"],
      "comparison": "max_numeric",
      "threshold": 400,
      "unit": "W",
      "requirement": "电动机额定连续输出功率不超过400 W",
      "source_article": "6.3.3.1"
    },
    {
      "parameter": "nominal_battery_voltage",
      "display_name": "蓄电池标称电压",
      "aliases": ["蓄电池标称电压", "电池标称电压", "标称电压"],
      "comparison": "record_only",
      "threshold": null,
      "unit": "V",
      "requirement": "记录标称电压并结合最大输出电压、电池与整车互认及产品合格证核验；不得沿用旧版阈值自动定性",
      "source_article": "6.3.4"
    },
    {
      "parameter": "pedal_riding_capability",
      "display_name": "脚踏骑行能力",
      "aliases": ["脚踏骑行能力", "脚踏功能", "脚蹬", "脚踏装置"],
      "comparison": "conditional_boolean",
      "threshold": null,
      "unit": null,
      "requirement": "具备电助力功能的车辆应保留脚踏骑行装置；仅电驱动车型可选择设置",
      "source_article": "整车结构要求"
    },
    {
      "parameter": "anti_tamper_speed_limiter",
      "display_name": "防篡改/解除限速",
      "aliases": ["防篡改", "解除限速", "限速器改装", "控制器改装", "剪线提速"],
      "comparison": "anti_tamper",
      "threshold": null,
      "unit": null,
      "requirement": "电池组、控制器和限速器应具备防篡改设计，限速值不得被解码或改装",
      "source_article": "防篡改要求"
    },
    {
      "parameter": "vehicle_dimensions",
      "display_name": "车辆尺寸",
      "aliases": ["车体宽度", "车辆宽度", "外廓尺寸", "车辆尺寸", "车宽"],
      "comparison": "max_numeric",
      "threshold": 0.4,
      "unit": "m",
      "requirement": "车体宽度（不含车把、脚蹬、后视镜及连接杆）不超过0.40 m；其他尺寸按原始检测报告逐项核验",
      "source_article": "整车尺寸要求"
    },
    {
      "parameter": "product_certificate_ccc",
      "display_name": "产品合格证/CCC",
      "aliases": ["产品合格证", "车辆合格证", "CCC", "3C认证", "强制性产品认证"],
      "comparison": "presence_positive",
      "threshold": null,
      "unit": null,
      "requirement": "核验整车产品合格证、CCC状态、车型与实车一致性",
      "source_article": "产品一致性要求"
    },
    {
      "parameter": "registration_plate_type",
      "display_name": "号牌/登记类型",
      "aliases": ["登记类型", "号牌类型", "车辆登记", "行驶证"],
      "comparison": "record_only",
      "threshold": null,
      "unit": null,
      "requirement": "登记和号牌属于管理与法律属性判断因素，不由技术参数工具替代认定",
      "source_article": "车辆管理因素"
    },
    {
      "parameter": "vehicle_modification",
      "display_name": "是否改装",
      "aliases": ["是否改装", "改装", "加装电池", "更换控制器", "解除限速", "剪线提速"],
      "comparison": "modification",
      "threshold": null,
      "unit": null,
      "requirement": "检查解除限速、更换控制器/电池等改装事实及其与原CCC车型的一致性",
      "source_article": "防篡改与产品一致性要求"
    }
  ]
}
