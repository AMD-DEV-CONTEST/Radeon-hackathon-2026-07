        {
          "condition": "delivery_date_disputed_or_unconfirmed",
          "result": "disputed"
        }
      ],
      "confidence_policy": {
        "confirmed_trigger_required": true,
        "weak_document_date_forbidden": true,
        "human_confirmation_if_ambiguous": true
