      "rule_id": "RULE-CN-VEHICLE-NATURE-GUARDRAIL-2024",
      "title": "两轮车辆技术符合性与法律属性分离规则",
      "rule_type": "vehicle_nature.guardrail",
      "jurisdiction": "CN",
      "authority_level": "national_standard_and_case_guidance",
      "source_law_id": "CN-GB-17761-2024",
      "source_article": "技术要求及车辆属性典型案例",
      "source_url": "https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=32E5D633E04B67FB241D100CA2A4A41D",
      "retrieved_at": "2026-07-29T00:00:00+08:00",
      "version": "GB 17761-2024",
      "promulgation_date": "2024-12-31",
      "effective_date": "2025-09-01",
      "expiry_date": null,
      "status": "effective",
      "conditions": {
        "matter_type": "two_wheeler_legal_nature"
      },
      "decision_logic": {
        "technical_conformity_separate_from_legal_classification": true,
        "technical_noncompliance_implies_motor_vehicle": false,
        "definite_classification_requires_registration_or_appraisal": true,
        "allow_suspected_motor_vehicle": true,
        "allow_insufficient_evidence": true
      },
      "outputs": {
        "technical_statuses": [
          "compliant",
          "non_compliant",
          "unknown",
          "conflicting"
        ]
      },
      "exceptions": [],
      "confidence_policy": {
        "missing_registration_or_appraisal_caps_certainty": true
      },
      "supporting_authorities": [
        {
          "source_law_id": "CN-CASE-E-BIKE-ATTR-2023",
