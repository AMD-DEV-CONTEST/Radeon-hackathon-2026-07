      "rule_type": "deadline.accident_determination_review",
      "jurisdiction": "CN",
      "authority_level": "department_rule",
      "source_law_id": "CN-RULE-ACCIDENT-PROCEDURE-2017",
      "source_article": "第七十一条、第一百一十二条、第一百一十三条",
