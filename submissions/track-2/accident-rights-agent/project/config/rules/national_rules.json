      "rule_id": "RULE-CN-COMPENSATION-REGIME-2021",
      "title": "机动车交通事故民事赔偿路径",
      "rule_type": "compensation.regime",
      "jurisdiction": "CN",
      "authority_level": "law",
      "source_law_id": "CN-LAW-RTSA-2021",
      "source_article": "第七十六条",
      "source_url": "https://flk.npc.gov.cn/detail?id=ff8081817ab231eb017abd617ef70519",
      "retrieved_at": "2026-07-29T00:00:00+08:00",
      "version": "2021修正",
      "promulgation_date": "2021-04-29",
      "effective_date": "2021-04-29",
      "expiry_date": null,
      "status": "effective",
      "conditions": {
        "matter_type": "civil_compensation_route"
      },
      "decision_logic": {
        "motor_vs_motor": "allocate_by_fault",
        "motor_vs_non_motor_or_pedestrian": "apply_article_76_paragraph_2",
        "unknown_vehicle_nature": "pending_vehicle_classification"
      },
      "outputs": {
        "separate_accident_responsibility_from_civil_allocation": true
      },
      "exceptions": [
        {
          "condition": "insufficient_vehicle_or_liability_evidence",
          "result": "insufficient_evidence"
        }
      ],
      "confidence_policy": {
        "no_exact_share_without_verified_facts": true
      },
