.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Model and runtime data
models/
data/cases/
data/checkpoints/
data/smoke/generated/
data/qdrant/
data/laws/*.sqlite3
artifacts/*.json
artifacts/*.jsonl
artifacts/*.log
artifacts/*.csv
artifacts/demo_runtime/
artifacts/demo_reports/*

# Raw vLLM process logs stay with the benchmark run; derived evidence is committed.
benchmarks/results/logs/

# A reviewed example report may be force-added for a release.
!artifacts/demo_reports/.gitkeep

# Keep directories in Git
!artifacts/.gitkeep
!benchmarks/reports/.gitkeep

# Internal execution and recording working files are excluded from public submission.
docs/EXECUTION_LOG.md
docs/demo_script.md
docs/submission/demo_script.md
docs/submission/demo_recording_runbook.md
docs/submission/pull_request_draft.md
release_check/
