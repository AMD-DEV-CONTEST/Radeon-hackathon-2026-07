{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Single-series time line chart. Use with a registered dataset containing period and value columns; Xenix injects the dataset.",
  "width": 680,
  "height": 320,
  "title": {
    "text": "时间趋势",
    "anchor": "start"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#d96c1c",
        "strokeWidth": 3
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "fill": "#ffffff",
        "stroke": "#d96c1c",
        "strokeWidth": 2,
        "size": 70
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "period",
      "type": "ordinal",
      "sort": null,
      "axis": {
        "title": null,
        "labelAngle": -35,
        "labelAlign": "right",
        "domainColor": "#ddd",
        "tickColor": "#ddd"
      }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "scale": {"zero": false},
      "axis": {
        "title": null,
        "grid": true,
        "gridOpacity": 0.18,
        "domain": false,
        "tickColor": "#ddd"
      }
    },
    "tooltip": [
      {"field": "period", "type": "ordinal"},
      {"field": "value", "type": "quantitative"}
    ]
  },
  "config": {
    "view": {"stroke": null},
    "font": "Inter, system-ui, sans-serif"
  }
}
