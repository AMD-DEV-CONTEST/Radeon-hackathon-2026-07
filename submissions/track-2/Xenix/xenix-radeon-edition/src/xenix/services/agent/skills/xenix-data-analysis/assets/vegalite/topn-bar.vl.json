{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Horizontal Top-N bar chart. Use with a registered dataset containing category and value columns; Xenix injects the dataset.",
  "width": 680,
  "height": 360,
  "title": {
    "text": "Top N 类别对比",
    "subtitle": "按数值从高到低排序",
    "anchor": "start"
  },
  "mark": {
    "type": "bar",
    "color": "#d96c1c",
    "cornerRadiusEnd": 4
  },
  "encoding": {
    "y": {
      "field": "category",
      "type": "nominal",
      "sort": "-x",
      "axis": {
        "title": null,
        "labelFont": "Noto Sans SC, Inter, system-ui, sans-serif",
        "labelFontSize": 12,
        "domain": false,
        "ticks": false
      }
    },
    "x": {
      "field": "value",
      "type": "quantitative",
      "axis": {
        "title": null,
        "grid": true,
        "gridOpacity": 0.18,
        "domain": false,
        "tickColor": "#ddd"
      }
    },
    "tooltip": [
      {"field": "category", "type": "nominal"},
      {"field": "value", "type": "quantitative"}
    ]
  },
  "config": {
    "view": {"stroke": null},
    "font": "Inter, system-ui, sans-serif"
  }
}
