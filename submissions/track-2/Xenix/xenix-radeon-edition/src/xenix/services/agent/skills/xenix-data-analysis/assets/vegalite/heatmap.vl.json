{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Categorical heatmap. Use with a registered dataset containing x, y, and value columns; Xenix injects the dataset.",
  "width": 620,
  "height": 360,
  "title": {
    "text": "类别关系热力图",
    "anchor": "start"
  },
  "mark": "rect",
  "encoding": {
    "x": {
      "field": "x",
      "type": "nominal",
      "axis": {
        "title": null,
        "labelAngle": -35,
        "labelAlign": "right",
        "labelFont": "Noto Sans SC, Inter, system-ui, sans-serif",
        "labelFontSize": 11,
        "domain": false,
        "ticks": false
      }
    },
    "y": {
      "field": "y",
      "type": "nominal",
      "axis": {
        "title": null,
        "labelFont": "Noto Sans SC, Inter, system-ui, sans-serif",
        "labelFontSize": 11,
        "domain": false,
        "ticks": false
      }
    },
    "color": {
      "field": "value",
      "type": "quantitative",
      "scale": {
        "range": ["#f5efe8", "#d96c1c"],
        "zero": true
      },
      "legend": {"title": null}
    },
    "tooltip": [
      {"field": "y", "type": "nominal"},
      {"field": "x", "type": "nominal"},
      {"field": "value", "type": "quantitative"}
    ]
  },
  "config": {
    "view": {"stroke": null},
    "font": "Inter, system-ui, sans-serif"
  }
}
