# Optional media providers. Keep real keys in a local ignored file.
APIMART_API_KEY=replace-with-your-key
APIMART_BASE_URL=https://api.apimart.ai/v1
APIMART_TIMEOUT_SECONDS=60

DASHSCOPE_API_KEY=replace-with-your-key
DASHSCOPE_REGION=beijing
DASHSCOPE_WORKSPACE_ID=

# Local SSH-forwarded Qwen service on the user's Radeon GPU.
YIJIAN_CLOUD_LLM_URL=http://127.0.0.1:18082/v1
YIJIAN_CLOUD_LLM_MODEL=Yijian-Qwen3.6-27B-GoCoach
YIJIAN_MENTOR_MODEL_REVISION=qwen3.6-27b-q4-k-m-go-evidence-v1
GOMENTOR_BATCH_MENTOR_PROVIDER=cloud
GOMENTOR_BATCH_NARRATIVE_NODES=6
YIJIAN_LLM_TIMEOUT=18
YIJIAN_CHAT_TIMEOUT=30
GOMENTOR_MENTOR_BRANCH_VISITS=32

# Whole-game scan and critical-node verification.
GOMENTOR_SCAN_VISITS=32
GOMENTOR_FAST_REVIEW_VISITS=128

# Optional remote KataGo. Disabled by default.
KATAGO_REMOTE_ENABLED=0
KATAGO_REMOTE_HOST=replace-with-your-ssh-alias
KATAGO_REMOTE_PATH=/persistent/yijian/katago-v1.16.5/build/katago
KATAGO_REMOTE_MODEL=/persistent/yijian/katago-models/kata1-zhizi-b40c768nbt-s11272M-d5935M.bin.gz
KATAGO_REMOTE_CONFIG=/persistent/yijian/project/gomentor/deploy/cloud/katago_analysis_w7900.cfg
KATAGO_CHUNK_SIZE=64
