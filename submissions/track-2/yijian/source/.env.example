# Core runtime. All services bind to localhost by default.
GOMENTOR_DB=runtime/yijian.db
GOMENTOR_SCAN_VISITS=32
GOMENTOR_FAST_REVIEW_VISITS=128
GOMENTOR_FAST_REVIEW_NODES=3
GOMENTOR_MENTOR_BRANCH_VISITS=32

# Local KataGo. Download binaries and a network separately; weights are not stored in Git.
KATAGO_PATH=runtime/katago/katago.exe
KATAGO_MODEL=runtime/katago/model.bin.gz
KATAGO_CONFIG=runtime/katago/analysis.cfg
KATAGO_MODEL_SHA256=
KATAGO_MAX_VISITS=128
KATAGO_TIMEOUT=300

# OpenAI-compatible model endpoints. Empty API keys are valid for localhost-only services.
YIJIAN_LOCAL_LLM_URL=http://127.0.0.1:8081/v1
YIJIAN_LOCAL_LLM_MODEL=Qwen3-14B-Public-Repro
YIJIAN_LOCAL_LLM_API_KEY=
YIJIAN_CLOUD_LLM_URL=http://127.0.0.1:18082/v1
YIJIAN_CLOUD_LLM_MODEL=YIJIAN-Competition-27B
YIJIAN_CLOUD_LLM_API_KEY=
YIJIAN_LLM_TIMEOUT=18
YIJIAN_CHAT_TIMEOUT=30
YIJIAN_PLANNER_TIMEOUT=6
YIJIAN_AGENT_PLANNER_ENABLED=0

# Optional SSH-forwarded KataGo on a user-controlled Radeon host.
KATAGO_REMOTE_ENABLED=0
KATAGO_REMOTE_HOST=user@radeon-host
KATAGO_REMOTE_PATH=/opt/yijian/katago
KATAGO_REMOTE_MODEL=/opt/yijian/katago-model.bin.gz
KATAGO_REMOTE_CONFIG=/opt/yijian/analysis.cfg
KATAGO_CHUNK_SIZE=64
