+# you may not use this file except in compliance with the License.
+"""Small dependency-free helpers for policy latency summaries."""
+
+from __future__ import annotations
+
+from collections.abc import Iterable, Mapping
+from typing import Any
+
+
+def _percentile(values: list[float], percentile: float) -> float | None:
+    if not values:
+        return None
+    ordered = sorted(float(value) for value in values)
+    if len(ordered) == 1:
+        return ordered[0]
+    rank = (len(ordered) - 1) * percentile / 100.0
+    lower = int(rank)
+    upper = min(lower + 1, len(ordered) - 1)
+    weight = rank - lower
+    return ordered[lower] * (1.0 - weight) + ordered[upper] * weight
+
+
+def summarize_latencies(
+    latencies_ms: Iterable[float],
+    *,
+    first_call_is_cold: bool,
+) -> dict[str, float | int | None]:
+    values = [float(value) for value in latencies_ms]
+    warm = values[1:] if first_call_is_cold and values else values
+    return {
+        "count": len(values),
+        "cold_start_ms": values[0] if first_call_is_cold and values else None,
+        "warm_count": len(warm),
+        "warm_mean_ms": sum(warm) / len(warm) if warm else None,
+        "warm_p50_ms": _percentile(warm, 50.0),
+        "warm_p95_ms": _percentile(warm, 95.0),
+        "warm_p99_ms": _percentile(warm, 99.0),
+        "max_ms": max(values) if values else None,
+    }
+
+
+def summarize_policy_timing_records(
+    records: Iterable[Mapping[str, Any]],
+) -> dict[str, Any]:
+    ordered = sorted(records, key=lambda record: int(record["started_monotonic_ns"]))
+    all_latencies = [float(record["latency_ms"]) for record in ordered]
+    model_latencies = [
+        float(record["latency_ms"])
+        for record in ordered
+        if bool(record["model_inference_expected"])
+    ]
+    queued_latencies = [
+        float(record["latency_ms"])
+        for record in ordered
+        if not bool(record["model_inference_expected"])
+    ]
+    return {
+        "schema_version": 1,
+        "clock": "time.perf_counter_ns",
+        "measurement_scope": "policy.select_action only",
+        "accelerator_synchronization": "before_and_after_each_select_action",
+        "model_inference_detection": "action_queue_empty_before_select_action",
+        "queue_observed_calls": sum(bool(record["queue_observed"]) for record in ordered),
+        "select_action_calls": summarize_latencies(all_latencies, first_call_is_cold=True),
+        "model_inference_calls": summarize_latencies(model_latencies, first_call_is_cold=True),
+        "queued_action_dispatch_calls": summarize_latencies(
+            queued_latencies,
+            first_call_is_cold=False,
+        ),
+    }
