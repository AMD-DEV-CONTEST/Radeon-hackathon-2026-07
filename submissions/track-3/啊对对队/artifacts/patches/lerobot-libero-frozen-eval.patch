+def _action_queue_size(policy: nn.Module) -> int | None:
+    """Return a policy action-queue size without assuming a specific wrapper stack."""
+    pending = [policy]
+    visited: set[int] = set()
+    while pending:
+        candidate = pending.pop()
+        if candidate is None or id(candidate) in visited:
+            continue
+        visited.add(id(candidate))
+        queue = getattr(candidate, "_action_queue", None)
+        if queue is not None:
+            try:
+                return len(queue)
+            except TypeError:
+                return None
+        for attribute in ("base_model", "model", "module"):
+            wrapped = getattr(candidate, attribute, None)
+            if wrapped is not None and wrapped is not candidate:
+                pending.append(wrapped)
+    return None
+
+
+def _policy_device(policy: nn.Module) -> torch.device:
+    parameter = next(policy.parameters(), None)
+    return parameter.device if parameter is not None else torch.device("cpu")
+
+
+def _synchronize_policy_device(policy: nn.Module) -> torch.device:
+    device = _policy_device(policy)
+    if device.type == "cuda" and torch.cuda.is_available():
+        torch.cuda.synchronize(device)
+    return device
+
+
+def _reset_accelerator_memory_stats(policy: nn.Module) -> torch.device:
+    device = _synchronize_policy_device(policy)
+    if device.type == "cuda" and torch.cuda.is_available():
+        torch.cuda.reset_peak_memory_stats(device)
+    return device
+
+
+def _accelerator_memory_summary(device: torch.device) -> dict[str, Any]:
+    if device.type != "cuda" or not torch.cuda.is_available():
+        return {
+            "device": str(device),
+            "available": False,
+            "peak_allocated_bytes": None,
+            "peak_reserved_bytes": None,
+        }
+    torch.cuda.synchronize(device)
+    peak_allocated = int(torch.cuda.max_memory_allocated(device))
+    peak_reserved = int(torch.cuda.max_memory_reserved(device))
+    return {
+        "device": str(device),
+        "device_name": torch.cuda.get_device_name(device),
+        "available": True,
+        "torch_hip_version": torch.version.hip,
+        "peak_allocated_bytes": peak_allocated,
+        "peak_reserved_bytes": peak_reserved,
+        "peak_allocated_gib": peak_allocated / (1024**3),
+        "peak_reserved_gib": peak_reserved / (1024**3),
+        "measurement_scope": "policy already loaded; reset immediately before eval rollouts",
+    }
+
+
