{
    "type": "smolvla",
    "n_obs_steps": 1,
    "input_features": {
        "observation.state": {
            "type": "STATE",
            "shape": [
                43
            ]
        },
        "observation.images.overhead_rgb": {
            "type": "VISUAL",
            "shape": [
                3,
                224,
                224
            ]
        },
        "observation.images.overhead_depth_rgb": {
            "type": "VISUAL",
            "shape": [
                3,
                224,
                224
            ]
        }
    },
    "output_features": {
        "action": {
            "type": "ACTION",
            "shape": [
                19
            ]
        }
    },
    "device": "cuda",
    "use_amp": true,
    "use_peft": false,
    "push_to_hub": false,
    "repo_id": null,
    "private": null,
    "tags": null,
    "license": null,
    "pretrained_path": null,
    "pretrained_revision": null,
    "chunk_size": 30,
    "n_action_steps": 10,
    "normalization_mapping": {
        "VISUAL": "IDENTITY",
        "STATE": "MEAN_STD",
        "ACTION": "MEAN_STD"
