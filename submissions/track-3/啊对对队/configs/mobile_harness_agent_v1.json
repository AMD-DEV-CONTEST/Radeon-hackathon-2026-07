{
  "schema_version": 1,
  "protocol": "parcel-harness-agent-config-v1",
  "task_agent": {
    "agent_id": "parcel-task-agent-v1",
    "role": "task_agent",
    "provider": "adapter",
    "model": "task-planner",
    "version": "1"
  },
  "failure_analyst": {
    "agent_id": "parcel-failure-analyst-v1",
    "role": "failure_analyst",
    "provider": "local",
    "model": "deterministic-failure-taxonomy",
    "version": "1"
  },
  "independent_verifier": {
    "agent_id": "parcel-replay-verifier-v1",
    "role": "independent_verifier",
    "provider": "adapter",
    "model": "replay-evidence-verifier",
    "version": "1"
  },
  "force_limit_n": 35.0,
  "max_dataset_bytes": 25000000,
  "require_video_dataset": true,
  "control_authority": {
    "task_agent_hz": [0.1, 1.0],
    "vla_executor_hz": [3.0, 10.0],
    "servo_hz": 240,
    "agent_may_emit_servo_actions": false,
    "agent_may_override_safety": false,
    "agent_may_activate_checkpoint": false
  }
}
