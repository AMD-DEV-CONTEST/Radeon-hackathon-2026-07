  "policy_observations": [
    "observation.state",
    "observation.images.env_cam",
    "observation.images.left_wrist_cam",
    "observation.images.right_wrist_cam"
  ],
  "privileged_evaluator_state": [
    "bowl_poses",
    "bowl_linear_velocities",
    "bowl_angular_velocities",
    "left_gripper_open_fraction",
    "right_gripper_open_fraction",
    "contact_events",
    "safety_validity",
    "physics_validity"
  ],
  "baseline_distribution": {
    "contract": "configs/source-task-stack-bowls-three.json",
    "sampler": "exact_source_reset_distribution",
    "domain_randomization_enabled": false
  },
  "robustness_distribution": {
    "status": "deferred_until_baseline_gate",
    "candidate_randomization": {
      "camera_position_m": [-0.01, 0.01],
      "friction_multiplier": [0.7, 1.3],
      "mass_multiplier": [0.8, 1.2]
    },
    "evidence_boundary": "robustness episodes must be reported separately from exact-distribution baseline episodes"
