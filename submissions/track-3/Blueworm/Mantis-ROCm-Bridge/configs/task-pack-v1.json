      "g2_early": [11, 12],
      "g3_compare": [101, 102, 103, 104, 105, 106, 107, 108, 109, 110],
      "g4_confirm": [201, 202, 203, 204, 205, 206, 207, 208, 209, 210, 211, 212, 213, 214, 215, 216, 217, 218, 219, 220, 221, 222, 223, 224, 225, 226, 227, 228, 229, 230]
    },
    "promotion_rules": {
      "g3_compare": {"minimum_success_rate": 0.6, "maximum_safety_failures": 0},
      "g4_confirm": {"minimum_successes": 18, "required_episodes": 30, "maximum_safety_failures": 0}
    }
  }
