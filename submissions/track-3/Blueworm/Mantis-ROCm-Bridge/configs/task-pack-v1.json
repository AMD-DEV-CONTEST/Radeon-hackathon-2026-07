{
  "schema_version": 1,
  "task_id": "stack_bowls_three",
  "embodiment": "mantis",
  "description": "Use the Mantis dual arms to stack three bowls at the fixed target, release both grippers, and maintain a stable stack.",
  "protocol_version": "competition_strict_v1",
  "source_compatibility_protocol": "legacy_source_v1",
  "protocol_comparability": "not_directly_comparable",
  "policy_hz": 30.0,
  "max_policy_steps": 1200,
  "success_stable_frames": 12,
  "stages": [
    "reset_from_source_distribution",
    "observe_scene",
    "grasp_lowest_y_assigned_bowl",
    "place_base_bowl_at_target",
    "grasp_and_place_middle_bowl",
    "grasp_and_place_top_bowl",
    "open_both_grippers",
    "verify_stack_stability"
  ],
  "success_predicate": {
    "position_sort": "ascending_z",
    "xy_axis_alignment_tolerance_m": 0.04,
    "target_heights_m": [0.74, 0.77, 0.81],
    "height_absolute_tolerance_m": 0.02,
    "maximum_linear_speed_m_s": 0.02,
    "maximum_angular_speed_rad_s": 0.15,
    "minimum_gripper_open_fraction": 0.9,
    "objects_stable_for_policy_frames": 12,
    "no_safety_failure": true,
    "no_physics_divergence": true
