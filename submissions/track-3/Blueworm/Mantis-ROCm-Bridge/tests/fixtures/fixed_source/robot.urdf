<?xml version="1.0"?>
<robot name="fixture_full">
  <link name="base">
    <visual><geometry><mesh filename="package://fixture/meshes/base.STL"/></geometry></visual>
  </link>
  <link name="arm_link">
    <visual><geometry><mesh filename="package://fixture/meshes/arm.STL"/></geometry></visual>
  </link>
  <link name="finger_link">
    <visual><geometry><mesh filename="package://fixture/meshes/finger.STL"/></geometry></visual>
  </link>
  <link name="neck_link">
    <visual><geometry><mesh filename="package://fixture/meshes/neck.STL"/></geometry></visual>
  </link>
  <joint name="arm_joint" type="revolute">
    <parent link="base"/><child link="arm_link"/><axis xyz="0 0 1"/>
    <limit lower="-1" upper="1" effort="5" velocity="2"/>
  </joint>
  <joint name="finger_joint" type="prismatic">
    <parent link="arm_link"/><child link="finger_link"/><axis xyz="0 1 0"/>
    <limit lower="0" upper="0.04" effort="5" velocity="1"/>
  </joint>
  <joint name="neck_joint" type="revolute">
    <parent link="base"/><child link="neck_link"/><axis xyz="0 0 1"/>
    <limit lower="-1" upper="1" effort="5" velocity="1"/>
  </joint>
</robot>

