<?xml version="1.0"?>
<robot name="minimal">
  <link name="base"/>
  <link name="arm_link"/>
  <link name="finger_link"/>
  <joint name="arm_joint" type="revolute">
    <parent link="base"/>
    <child link="arm_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1" upper="1" effort="5" velocity="2"/>
  </joint>
  <joint name="finger_joint" type="prismatic">
    <parent link="arm_link"/>
    <child link="finger_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.04" effort="5" velocity="1"/>
  </joint>
</robot>

