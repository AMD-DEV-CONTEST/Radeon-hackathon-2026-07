# === LLM Configuration ===
# Option A: AMD Free Model API (recommended for quick start)
LLM_API_BASE=https://developer.amd.com.cn/radeon/api/v1
LLM_API_KEY=your_amd_api_key_here
LLM_MODEL=DeepSeek-V4-Flash

# Option B: Local vLLM on Radeon GPU (recommended for full GPU score)
# LLM_API_BASE=http://localhost:8000/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# === Server Configuration ===
API_HOST=0.0.0.0
API_PORT=8008

# === Runtime Mode ===
RUN_MODE=local
