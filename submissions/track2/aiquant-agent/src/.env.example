# === LLM Configuration ===
# Option A: Local LLM on AMD Radeon GPU (recommended for full privacy)
LLM_API_BASE=http://localhost:13305/v1
LLM_API_KEY=lemonade
LLM_MODEL=/root/.cache/lemonade/models/Qwen3-8B-GGUF/Qwen3-8B-Q4_K_M.gguf

# OpenAI-compatible config (config.py reads these)
OPENAI_API_BASE=http://localhost:13305/v1
OPENAI_API_KEY=lemonade
CHAT_MODEL=/root/.cache/lemonade/models/Qwen3-8B-GGUF/Qwen3-8B-Q4_K_M.gguf
CHAT_TOKEN_LIMIT=32768

# Option B: AMD Free Model API (quick start, no local GPU needed)
# LLM_API_BASE=https://developer.amd.com.cn/radeon/api/v1
# LLM_API_KEY=your_amd_api_key_here
# LLM_MODEL=DeepSeek-V4-Flash
# OPENAI_API_BASE=https://developer.amd.com.cn/radeon/api/v1
# OPENAI_API_KEY=your_amd_api_key_here
# CHAT_MODEL=DeepSeek-V4-Flash
# CHAT_TOKEN_LIMIT=32768

# === Server Configuration ===
API_HOST=0.0.0.0
API_PORT=8010

# === Runtime Mode ===
# local = run without Docker sandbox (recommended for Radeon Cloud)
# docker = use Docker for sandboxed backtesting
RUN_MODE=local

# === Optional: Embedding API ===
# If not set, system uses local hash embedding fallback (no external API needed)
# SILICONFLOW_API_KEY=sk-your-key-here
