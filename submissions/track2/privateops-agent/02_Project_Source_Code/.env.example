# Use development on Windows. Set rocm-local on Radeon Cloud only after the
# model server is listening on loopback in the same instance.
PRIVATEOPS_PROVIDER_MODE=development

# Example OpenAI-compatible local endpoint served by llama.cpp, vLLM, or another ROCm stack.
PRIVATEOPS_MODEL_ENDPOINT=http://127.0.0.1:8000/v1/chat/completions
PRIVATEOPS_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
PRIVATEOPS_MODEL_API_KEY=
PRIVATEOPS_REQUEST_TIMEOUT=90
PRIVATEOPS_MODEL_PORT=8000
PRIVATEOPS_MAX_MODEL_LEN=8192
PRIVATEOPS_GPU_MEMORY_UTILIZATION=0.85

# Workspace and local state boundaries.
PRIVATEOPS_WORKSPACE_DIR=.
PRIVATEOPS_KNOWLEDGE_DIR=data/knowledge
PRIVATEOPS_STATE_DIR=data/state
