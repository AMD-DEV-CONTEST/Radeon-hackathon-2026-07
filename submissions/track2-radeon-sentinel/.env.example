# Default offline mode. It never calls an external model.
SENTINEL_MODEL_MODE=mock

# OpenAI-compatible mode for Radeon Cloud shared APIs or a dedicated vLLM server.
# SENTINEL_MODEL_MODE=openai
# MODEL_BASE_URL=https://example.invalid/v1
# MODEL_API_KEY=replace-me
# MODEL_NAME=replace-me

SENTINEL_DB_PATH=artifacts/sentinel.db
SENTINEL_RUNBOOK_DIR=demo_data/runbooks
SENTINEL_INCIDENT_DIR=demo_data/incidents
SENTINEL_REQUEST_TIMEOUT_SECONDS=60
