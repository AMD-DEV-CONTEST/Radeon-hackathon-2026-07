# Code and Python runtime
PROJECT_ROOT=/workspace/amd-bigym-3dgs-opendm
OPENDM_ROOT=/workspace/amd-bigym-3dgs-opendm/third_party/opendm
BIGYM_ROOT=/workspace/amd-bigym-3dgs-opendm/third_party/bigym
BIGYM_3DGS_ROOT=/workspace/amd-bigym-3dgs-opendm/third_party/amd-bigym-3dgs-rocm
PYTHON=/workspace/amd-bigym-3dgs-opendm/.venv/bin/python

# Models and datasets
BASE_MODEL=/root/models/DM05
TRAIN_DATASET=/data/cutlery/native32
MODEL_PATH=/root/models/DM05-BiGym-CutleryLong
OFFICIAL_DEMO=/data/bigym/DishwasherUnloadCutleryLong/037e80a547f6406aab2da36e6fde2617.safetensors
THREE_DGS_SHELL_ROOT=/data/amd-bigym-3dgs-kitchen-shell
VISUAL_SHELL_PROFILE=/data/amd-bigym-3dgs-kitchen-shell/scene-shell-profile.json
OUTPUT_ROOT=/root/outputs/amd-bigym-3dgs-opendm

# AMD device selection
AMD_GPU_IDS=0
NPROC=1
PYTORCH_ROCM_ARCH=gfx1100

# Validated training defaults. Only lower MODEL_MAX_LENGTH after auditing every
# processed sample. A TunableOp database must match this exact ROCm/PyTorch,
# GPU, batch and sequence-shape profile.
MODEL_MAX_LENGTH=896
