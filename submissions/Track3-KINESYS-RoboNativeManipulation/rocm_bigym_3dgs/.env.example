# Workspace paths (do not put credentials here).
AMD_BIGYM_ROOT=/workspace/amd-bigym-3dgs
BIGYM_DIR=/workspace/amd-bigym-3dgs/src/bigym
VENV=/workspace/amd-bigym-3dgs/.venv
ROCM_ROOT=/opt/rocm-7.2.1
ROCM_WRAPPER=/workspace/amd-bigym-3dgs/toolchains/rocm-7.2.1-clang22
TORCH_EXTENSIONS_DIR=/workspace/amd-bigym-3dgs/cache/torch-extensions-gsplat
PYTORCH_ROCM_ARCH=gfx1100
HIP_VISIBLE_DEVICES=0

# User-acquired, license-compliant 3DGS shell inputs.
SHELL_WALLS=/path/to/walls_fixed_kitchen.ply
SHELL_FLOOR=/path/to/floor_perimeter.ply
SHELL_CEILING=/path/to/ceiling_lights.ply
SHELL_DIR=/workspace/amd-bigym-3dgs/assets/dl3dv-kitchen-cutlery32

# BiGym formal replay inputs and output.
REPLAY_PLAN=/path/to/cutlery32-current20-replay-plan.json
DATASET_ROOT=/workspace/amd-bigym-3dgs/output/cutlery32
