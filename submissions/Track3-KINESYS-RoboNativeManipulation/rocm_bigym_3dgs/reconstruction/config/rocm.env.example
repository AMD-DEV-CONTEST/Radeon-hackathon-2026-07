# AMD ROCm reconstruction configuration. Do not store credentials here.
AMD_BIGYM_ROOT=/workspace/amd-bigym-3dgs
ROCM_VENV=/root/opensplat-env
OPENSPLAT_SOURCE=/root/OpenSplat
OPENSPLAT_BIN=/root/OpenSplat/build/opensplat
ROCM_INCLUDE_OVERLAY=/root/rocm-include-overlay
HIP_VISIBLE_DEVICES=0

# Generated by reconstruction/bin/download_reference_data.sh after the user
# independently accepts the gated DL3DV terms.
SOURCE_ARCHIVE=/workspace/amd-bigym-3dgs/data/dl3dv-kitchen/90e70328f9196bc78c7e6c695c1e8cbb55a3c961cccf34c566966a5e2d8d8947.zip
SOURCE_REPORT=/workspace/amd-bigym-3dgs/data/dl3dv-kitchen/source.json

WORK_ROOT=/workspace/amd-bigym-3dgs/output/reconstruction-rocm
TRAIN_STEPS=15000
SAVE_EVERY=7500
DATA_FACTOR=1
VALIDATION_IMAGE=frame_00176.png
BUILD_JOBS=8

# Optional: use the patched checkout to measure the exact task workspace OBB.
BIGYM_DIR=/workspace/amd-bigym-3dgs/src/bigym
