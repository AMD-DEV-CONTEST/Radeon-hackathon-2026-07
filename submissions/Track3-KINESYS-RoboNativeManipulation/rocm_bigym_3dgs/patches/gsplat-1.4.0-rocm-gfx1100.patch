--- a/gsplat/cuda/csrc/helpers.cuh
+++ b/gsplat/cuda/csrc/helpers.cuh
@@ -4,7 +4,35 @@
 #include "types.cuh"

 #include <cooperative_groups.h>
+#if !defined(__HIP_PLATFORM_AMD__)
 #include <cooperative_groups/reduce.h>
+#else
+namespace cooperative_groups {
+template <typename T> struct plus {
+    __device__ inline T operator()(const T &a, const T &b) const { return a + b; }
+};
+template <typename T> struct greater {
+    __device__ inline T operator()(const T &a, const T &b) const { return a > b ? a : b; }
+};
+template <typename Group, typename T, typename Op>
+__device__ inline T reduce(const Group &group, T value, Op op) {
+    for (unsigned int offset = 1; offset < group.size(); offset *= 2) {
+        T other = group.shfl_down(value, offset);
+        if (group.thread_rank() + offset < group.size()) value = op(value, other);
+    }
+    return value;
+}
+template <typename ParentGroup, typename LabelT>
+__device__ inline coalesced_group labeled_partition(const ParentGroup &parent, LabelT label) {
+    const unsigned long long bits = static_cast<unsigned long long>(label);
+    coalesced_group group = binary_partition(parent, (bits & 1ull) != 0);
+    for (unsigned int bit = 1; bit < sizeof(LabelT) * 8; ++bit) {
+        group = binary_partition(group, ((bits >> bit) & 1ull) != 0);
+    }
+    return group;
+}
+} // namespace cooperative_groups
+#endif

