## Default/base-100 path: private llama.cpp on the local Radeon + ROCm runtime.
RADEONSTAY_INFERENCE_PROVIDER=local_llamacpp
RADEONSTAY_MODEL_BASE_URL=http://127.0.0.1:8000/v1
RADEONSTAY_MODEL_NAME=qwen3.6-35b-a3b-q6k
RADEONSTAY_MODEL_API_KEY=local-only
RADEONSTAY_MODEL_TIMEOUT_SECONDS=120
# Optional bonus path. Never commit the real key; keep .env mode 0600.
# When enabled, the application accepts synthetic competition data only and
# does not claim local llama.cpp/ROCm process-binding evidence.
RADEONSTAY_RADEON_CLOUD_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
RADEONSTAY_RADEON_CLOUD_MODEL=Qwen3.6-35B-A3B
RADEONSTAY_RADEON_CLOUD_API_KEY=<API_KEY>
RADEONSTAY_RADEON_CLOUD_STRUCTURED_MODE=auto
RADEONSTAY_BONUS_DEMO=0
# Optimized profile: disable Qwen thinking so constrained plans use output tokens directly.
RADEONSTAY_MODEL_ENABLE_THINKING=0
# Fuse citation selection into the constrained planner call to remove one model request.
RADEONSTAY_FUSED_PLAN_EVIDENCE=1
# llama-server launch profile; the matrix binds and records this explicit value.
GPU_LAYERS=999
# Optional sanitized C3 runtime manifest; UI never displays its filesystem path.
RADEONSTAY_RUNTIME_PROOF_PATH=
# Private per-process manifest created by serve_model.sh. Required when
# RADEONSTAY_ISOLATED_DEMO=1; use a new file inside the 0700 runtime directory.
RADEONSTAY_RUNTIME_INSTANCE_PATH=
# Optional release/demo isolation. The deployment ID is appended to the database
# filename; the evidence ID independently binds the immutable C3 runtime proof.
RADEONSTAY_ISOLATED_DEMO=0
RADEONSTAY_DEMO_RUN_ID=
RADEONSTAY_EVIDENCE_RUN_ID=
RADEONSTAY_DATABASE_PATH=runtime/radeonstay.db
RADEONSTAY_POLICY_DIR=data/policies
# REQUIRED: replace both placeholders with different random values (32+ bytes each).
# RadeonStay refuses to start with these public example secrets, even on loopback.
RADEONSTAY_AUDIT_SECRET=replace-with-a-random-local-secret
RADEONSTAY_IDENTITY_SECRET=replace-with-a-different-random-local-secret
RADEONSTAY_DETERMINISTIC_MODE=0
RADEONSTAY_HOST=127.0.0.1
RADEONSTAY_PORT=7860
# Public access is fail-closed. Set all three for a controlled loopback Tunnel
# or a non-loopback bind; public mode also removes the staff demo identity.
RADEONSTAY_PUBLIC_DEMO_ENABLED=0
RADEONSTAY_UI_USERNAME=
RADEONSTAY_UI_PASSWORD=
