# Python bytecode and cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/

# Jupyter notebooks
.ipynb_checkpoints/
*.ipynb_checkpoints/

# OMO/OpenCode runtime & continuation files
.omo/
!omo/requirements-dev.txt

# IDE & editors
.idea/
.vscode/
*.swp
*.swo
*~
.neovim/backups/

# OS-specific
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Virtual environments
venv/
env/
.venv/
ENV/
env.bak/

# Persistent/data directories (defensive - project may store local state here)
persistent/
.persistent/
data_local/

# Environment and secrets (never commit actual credentials)
.env
.env.local
.env.*.local
*.pem
*.key
*.secret

# Logs and tmp
*.log
logs/
tmp/
temp/
.tmp/
.temp/

# Agent/session runtime state (local only, never part of the source tree)
.workbuddy/

# screwshell runtime state: SQLite memory, evidence and artifact stores that
# every run writes under <workspace>/.screwshell/ -- including the demo one.
.screwshell/
demo_workspace/.screwshell/

# Throwaway diagnostic probes at the repo root (_probe_*.py, _integration_*.py).
# Anything worth keeping belongs in scripts/ or tests/, so root-level
# underscore scripts are by definition scratch work.
/_*.py

# Same rule one level down: `_test_*.py` are ad-hoc probes, not the suite.
# Real tests are tests/test_*.py (no leading underscore) and run under pytest.
_test_*.py

# Captured HTTP responses kept while poking at a running llama-server.
resp.json
