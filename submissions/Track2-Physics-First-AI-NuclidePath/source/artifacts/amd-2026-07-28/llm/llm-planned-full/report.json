    "knowledge_hits": [
      {
        "document_id": "transport_screening",
        "excerpt": "The deterministic tool evaluates a reactive Ogata–Banks analytical solution on a homogeneous saturated semi-infinite domain. A constant dissolved Cs-137 concentration is imposed at `x=0`; the initial concentration is zero for `x>0`. Retardation is `R = 1 + rho_b Kd_eff / porosity`, pore-water travel time is marked by `xR/v`, and radioactive decay acts in dissolved and sorbed phases.",
        "score": 1.03446833,
        "source_path": "/workspace/NuclidePath/src/nuclear_agent/data/knowledge/transport_screening.md",
        "source_urls": [
          "https://pubs.usgs.gov/pp/0411a/report.pdf"
        ],
        "title": "One-dimensional reactive advection–dispersion screening"
      },
      {
        "document_id": "safety_and_decay",
        "excerpt": "The adopted Cs-137 physical half-life is `30.018 ± 0.022 years`, from the 2024 DDEP re-evaluation. This is a physical literature constant; environmental transport parameters remain site-dependent. The reactive Ogata–Banks solution treats radioactive decay in dissolved and sorbed phases at the same physical decay constant.",
        "score": 0.66921195,
        "source_path": "/workspace/NuclidePath/src/nuclear_agent/data/knowledge/safety_and_decay.md",
        "source_urls": [
          "https://pubmed.ncbi.nlm.nih.gov/38290201/"
        ],
        "title": "Cs-137 decay and emergency-use limitations"
      }
    ],
    "memory_turns": 2,
