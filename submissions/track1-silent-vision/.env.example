COMMAND_BACKEND=fake
PERSISTENCE_ROOT=/workspace/persistent/silent-vision
CAPTURE_FPS=25
CAPTURE_COUNTDOWN_SECONDS=3
COMMAND_CLIP_FPS=25
COMMAND_CLIP_MIN_SECONDS=2.0
COMMAND_CLIP_MAX_SECONDS=5.0
COMMAND_CONFIDENCE_THRESHOLD=0.85
COMMAND_TOP1_MARGIN=0.20
# COMMAND_CLASSIFIER_CHECKPOINT=/workspace/persistent/silent-vision/models/fixed-phrase.pt
PROTOTYPE_FEATURE_DIM=128
PROTOTYPE_CONFIDENCE_THRESHOLD=0.82
PROTOTYPE_TOP1_MARGIN=0.12
PROTOTYPE_PREFER_PERSONAL=false
ALLOW_GLOBAL_PROFILE_WRITE=true
MOUTH_SIZE=96
MODEL_CONFIDENCE_THRESHOLD=0.55
ALLOWED_ORIGINS=http://localhost:8000
LOG_TRANSCRIPTS=false
LOG_LEVEL=INFO
DEBUG_DUMP_WINDOWS=false
# DEBUG_WINDOW_DIR=/tmp/silent-vision-debug
HOST=127.0.0.1
PORT=8000
ENABLE_MODEL_HEALTH=false
