# =============================================================================
# Find it — environment configuration
# =============================================================================
# Copy this file to `.env` and adjust the values for your local setup.  `.env`
# holds real credentials and is git-ignored; this example has placeholders only.
#
# This project reads its own `.env` from this directory (see ai_clients.py).

# =============================================================================
# VLM (Vision Language Model) Settings - used to describe video frames
# =============================================================================
# Default below points to a local Ollama instance with a vision model pulled.
# Pull it with:  ollama pull minicpm-v4.5:8b
VLM_API_URL=http://localhost:11434/v1/chat/completions
VLM_MODEL_NAME=minicpm-v4.5:8b
# Prompt for image description (currently using Chinese)
VLM_PROMPT=描述这张图片中的内容。
# Maximum dimension for image resizing (preserves aspect ratio, limits max side)
VLM_MAX_RESOLUTION=1344

# =============================================================================
# ASR (Automatic Speech Recognition) Settings - used to transcribe audio
# =============================================================================
# Default below points to a local whisper.cpp server started by the project.
# Run:  ./scripts/setup_whisper.sh  and  ./scripts/serve_whisper.sh
ASR_API_URL=http://127.0.0.1:8080/inference
# Temperature for ASR decoding
ASR_TEMPERATURE=0.0
# Temperature increment for ASR decoding
ASR_TEMPERATURE_INC=0.2
# Initial prompt for contextual biasing (leave empty if not needed)
ASR_PROMPT=
# Carry the initial prompt across audio segments
ASR_CARRY_INITIAL_PROMPT=true
# Response format (srt, json, etc.)
ASR_RESPONSE_FORMAT=srt

# =============================================================================
# Processing Settings
# =============================================================================
# Frame extraction interval in seconds (default: 1 = one frame per second)
FRAME_INTERVAL=1
# Audio chunk duration in seconds (split audio into chunks of this length)
AUDIO_CHUNK_DURATION=30

# =============================================================================
# Agentic retrieval LLM (separate from VLM/ASR used for transcription)
# =============================================================================
# Default below points to a local Ollama instance with a text model pulled.
# Pull it with:  ollama pull gpt-oss:20b
AGENT_LLM_API_URL=http://localhost:11434/v1/chat/completions
AGENT_LLM_MODEL=gpt-oss:20b
# API key for the agentic LLM service (empty for local/no-auth servers).
AGENT_LLM_API_KEY=
AGENT_LLM_TEMPERATURE=0.0
AGENT_LLM_MAX_TURNS=8
# Max tokens per agent LLM call (raise if replies get truncated mid-JSON).
AGENT_LLM_MAX_TOKENS=4096
# Retries on parse/network errors before giving up.
AGENT_LLM_MAX_RETRIES=2
# Stream the agent LLM response (SSE) and log it live in the backend.
AGENT_LLM_STREAM=true
# Tool results fed back to the model are truncated to this many chars.
AGENT_LLM_TOOL_RESULT_MAX=8000
# Set to "true" to use the mock agent client. When unset, follows MOCK_MODE.
AGENT_LLM_MOCK=

# =============================================================================
# Agentic logging
# =============================================================================
# Level for the 'agentic' logger (DEBUG shows live streamed LLM output +
# parsing details; INFO is quieter).
AGENT_LOG_LEVEL=DEBUG

# =============================================================================
# Mock Mode (set to "true" to run without real AI servers)
# =============================================================================
MOCK_MODE=false
