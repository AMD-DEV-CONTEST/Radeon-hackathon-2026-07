{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalforge.local/contracts/ir-vector-record.schema.json",
  "title": "SignalForge IR Vector Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "vector_id", "projection_id", "chunk_id", "company_id", "available_at", "authority_tier", "document_type", "rights_class", "document_sha256", "source_content_sha256", "projection_sha256", "embedding_model", "embedding_revision", "embedding_config_sha256", "dimension", "vector_sha256"],
  "properties": {
    "schema_version": {"const": "signalforge/ir-vector-record/v1"},
    "vector_id": {"type": "string", "minLength": 1},
    "projection_id": {"type": "string", "minLength": 1},
    "chunk_id": {"type": "string", "minLength": 1},
    "company_id": {"pattern": "^sec-cik:[0-9]{10}$"},
    "available_at": {"type": "string", "format": "date-time"},
    "superseded_at": {"type": "string", "format": "date-time"},
    "authority_tier": {"enum": ["B", "C", "D", "E"]},
    "document_type": {"type": "string", "minLength": 1},
    "rights_class": {"type": "string", "minLength": 1},
    "document_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "source_content_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "projection_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "embedding_model": {"type": "string", "minLength": 1},
    "embedding_revision": {"type": "string", "minLength": 1},
    "embedding_config_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "dimension": {"type": "integer", "minimum": 1},
    "vector_sha256": {"pattern": "^[0-9a-f]{64}$"}
  }
}
