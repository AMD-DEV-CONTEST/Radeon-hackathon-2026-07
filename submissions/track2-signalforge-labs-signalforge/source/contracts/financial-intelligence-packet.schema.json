{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalforge.local/contracts/financial-intelligence-packet.schema.json",
  "title": "SignalForge Financial Intelligence Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "run_id", "as_of", "calculation_receipts", "numerical_context", "model_view"],
  "properties": {
    "schema_version": {"const": "signalforge.financial-intelligence-packet/v1"},
    "packet_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "calculation_receipts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "numerical_context": {"type": "object"},
    "model_view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "packet_id", "run_id", "as_of", "metrics"],
      "properties": {
        "schema_version": {"const": "signalforge.financial-intelligence-packet/v1"},
        "packet_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "as_of": {"type": "string", "format": "date-time"},
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "not": {"required": ["value"]},
            "required": ["reference_id", "entity_id", "metric_id", "economic_meaning", "period", "period_basis", "method", "formula_version", "receipt_refs", "evidence_refs"]
          }
        },
        "relations": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
