{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalforge.dev/contracts/company-research-profile.schema.json",
  "title": "SignalForge Company Research Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "universe_id", "company_id", "cik", "display_name", "securities", "research_cluster", "peer_group", "research_role", "activation", "metrics", "source_registry_sha256", "policy_version", "as_of", "profile_sha256"],
  "properties": {
    "schema_version": {"const": "signalforge/company-research-profile/v1"},
    "profile_id": {"type": "string", "minLength": 1},
    "universe_id": {"type": "string", "minLength": 1},
    "company_id": {"type": "string", "minLength": 1},
    "cik": {"type": "string", "pattern": "^[0-9]{10}$"},
    "display_name": {"type": "string", "minLength": 1},
    "securities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/security"}},
    "research_cluster": {"type": "string", "minLength": 1},
    "peer_group": {"type": "string", "minLength": 1},
    "research_role": {"type": "string", "minLength": 1},
    "activation": {"$ref": "company-activation.schema.json"},
    "metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
    "source_registry_sha256": {"$ref": "#/$defs/sha256"},
    "policy_version": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "profile_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["security_id", "ticker", "exchange", "primary"],
      "properties": {
        "security_id": {"type": "string", "minLength": 1},
        "ticker": {"type": "string", "minLength": 1},
        "exchange": {"type": "string", "minLength": 1},
        "share_class": {"type": "string"},
        "primary": {"type": "boolean"}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "state"],
      "properties": {
        "metric_id": {"type": "string", "minLength": 1},
        "state": {"enum": ["covered", "partial", "unknown", "not_applicable", "missing", "stale", "not_comparable", "quarantined"]},
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_hashes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
        "available_at": {"type": "string", "format": "date-time"},
        "fresh_until": {"type": "string", "format": "date-time"}
      }
    }
  }
}
