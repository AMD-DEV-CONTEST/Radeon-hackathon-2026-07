{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalforge.dev/contracts/company-activation.schema.json",
  "title": "SignalForge Company Activation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "activation_id", "universe_id", "scope", "subject_id", "company_ids", "state", "policy_version", "evidence_hashes", "effective_as_of", "generated_at", "record_sha256"],
  "properties": {
    "schema_version": {"const": "signalforge/company-activation/v1"},
    "activation_id": {"type": "string", "minLength": 1},
    "universe_id": {"type": "string", "minLength": 1},
    "scope": {"enum": ["company", "peer_lane"]},
    "subject_id": {"type": "string", "minLength": 1},
    "company_ids": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "previous_state": {"$ref": "#/$defs/state"},
    "state": {"$ref": "#/$defs/state"},
    "policy_version": {"type": "string", "minLength": 1},
    "evidence_hashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "effective_as_of": {"type": "string", "format": "date-time"},
    "generated_at": {"type": "string", "format": "date-time"},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "state": {"enum": ["identity_validated", "data_ready", "metric_ready", "research_ready", "comparison_ready", "limited", "quarantined"]},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
