{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalforge.local/contracts/ir-document-v2.schema.json",
  "title": "SignalForge Investor Relations Document v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "company_id", "title", "document_type", "authority_tier", "issuer", "source_uri", "canonical_uri", "discovery_uri", "media_type", "language", "available_at", "retrieved_at", "content_sha256", "rights_class", "collector_version", "parser_version"],
  "properties": {
    "schema_version": {"const": "signalforge/investor-relations-document/v2"},
    "document_id": {"type": "string", "minLength": 1},
    "company_id": {"pattern": "^sec-cik:[0-9]{10}$"},
    "title": {"type": "string", "minLength": 1},
    "document_type": {"type": "string", "minLength": 1},
    "authority_tier": {"enum": ["B", "C", "D", "E"]},
    "issuer": {"type": "string", "minLength": 1},
    "source_uri": {"type": "string", "format": "uri"},
    "canonical_uri": {"type": "string", "format": "uri"},
    "discovery_uri": {"type": "string", "format": "uri"},
    "sec_alias_uri": {"type": "string", "format": "uri"},
    "media_type": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "published_at": {"type": "string", "format": "date-time"},
    "available_at": {"type": "string", "format": "date-time"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "effective_at": {"type": "string", "format": "date-time"},
    "superseded_at": {"type": "string", "format": "date-time"},
    "predecessor_id": {"type": "string"},
    "successor_id": {"type": "string"},
    "fiscal_period": {"type": "string"},
    "event_id": {"type": "string"},
    "speaker": {"type": "string"},
    "speaker_role": {"type": "string"},
    "audited": {"type": "boolean"},
    "filed_with_sec": {"type": "boolean"},
    "forward_looking": {"type": "boolean"},
    "promotional": {"type": "boolean"},
    "content_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "rights_class": {"type": "string", "minLength": 1},
    "collector_version": {"type": "string", "minLength": 1},
    "parser_version": {"type": "string", "minLength": 1},
    "classification_status": {"enum": ["deterministic", "reviewed", "quarantined"]},
    "classification_reasons": {"type": "array", "items": {"type": "string"}}
  }
}
