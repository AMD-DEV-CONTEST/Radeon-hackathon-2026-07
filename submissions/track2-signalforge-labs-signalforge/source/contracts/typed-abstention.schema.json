{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalforge.dev/contracts/typed-abstention.schema.json",
  "title": "SignalForge Typed Abstention",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "abstention_id", "request_id", "run_id", "code", "message", "generated_at"],
  "properties": {
    "schema_version": {"const": "signalforge/typed-abstention/v1"},
    "abstention_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "code": {"type": "string", "minLength": 1},
    "message": {"type": "string", "minLength": 1},
    "company_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "metric_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
