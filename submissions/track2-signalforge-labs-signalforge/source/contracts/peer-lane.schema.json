{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalforge.dev/contracts/peer-lane.schema.json",
  "title": "SignalForge Peer Lane",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lane_id", "universe_id", "company_ids", "comparison_type", "decision_question", "allowed_question_ids", "allowed_metric_ids", "policy_version", "evidence_hashes", "enabled", "as_of", "lane_sha256"],
  "properties": {
    "schema_version": {"const": "signalforge/peer-lane/v1"},
    "lane_id": {"type": "string", "minLength": 1},
    "universe_id": {"type": "string", "minLength": 1},
    "company_ids": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "security_ids": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "comparison_type": {"type": "string", "minLength": 1},
    "decision_question": {"type": "string", "minLength": 1},
    "allowed_question_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_metric_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "policy_version": {"type": "string", "minLength": 1},
    "evidence_hashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "enabled": {"type": "boolean"},
    "as_of": {"type": "string", "format": "date-time"},
    "lane_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
