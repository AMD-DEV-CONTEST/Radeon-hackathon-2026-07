{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalforge.local/contracts/ir-source-registry-v2.schema.json",
  "title": "SignalForge Investor Relations Source Registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "universe_id", "historical_policy", "collection_policy", "material_classes", "sources"],
  "properties": {
    "schema_version": {"const": "signalforge/investor-relations-source-registry/v2"},
    "universe_id": {"type": "string", "minLength": 1},
    "historical_policy": {
      "type": "object",
      "required": ["complete_window_start_year", "include_current_ytd", "older_history_mode", "missing_archive_behavior"],
      "additionalProperties": false,
      "properties": {
        "complete_window_start_year": {"type": "integer", "minimum": 1990},
        "include_current_ytd": {"type": "boolean"},
        "older_history_mode": {"type": "string", "minLength": 1},
        "missing_archive_behavior": {"type": "string", "minLength": 1}
      }
    },
    "collection_policy": {
      "type": "object",
      "required": ["user_agent_environment_variable", "default_requests_per_second", "max_concurrency", "max_response_bytes", "allowed_schemes", "allowed_media_types"],
      "additionalProperties": false,
      "properties": {
        "user_agent_environment_variable": {"type": "string", "minLength": 1},
        "default_requests_per_second": {"type": "number", "exclusiveMinimum": 0},
        "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 8},
        "max_response_bytes": {"type": "integer", "minimum": 1024},
        "allowed_schemes": {"type": "array", "minItems": 1, "items": {"enum": ["https"]}, "uniqueItems": true},
        "allowed_media_types": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "material_classes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["company_id", "cik", "issuer", "primary_ticker", "discovery_uri", "allowed_hosts", "robots_uri", "rights_class"],
        "properties": {
          "company_id": {"pattern": "^sec-cik:[0-9]{10}$"},
          "cik": {"pattern": "^[0-9]{10}$"},
          "issuer": {"type": "string", "minLength": 1},
          "primary_ticker": {"pattern": "^[A-Z][A-Z0-9.-]{0,9}$"},
          "ticker_aliases": {"type": "array", "items": {"pattern": "^[A-Z][A-Z0-9.-]{0,9}$"}, "uniqueItems": true},
          "discovery_uri": {"type": "string", "format": "uri", "pattern": "^https://"},
          "allowed_hosts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "restricted_host_prefixes": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "format": "uri", "pattern": "^https://"},
              "uniqueItems": true
            }
          },
          "robots_uri": {"type": "string", "format": "uri", "pattern": "^https://"},
          "rights_class": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
