{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalforge.local/contracts/ir-semantic-projection.schema.json",
  "title": "SignalForge Numerically Silent IR Semantic Projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "projection_id", "chunk_id", "document_id", "company_id", "text", "source_content_sha256", "projection_sha256", "projection_version", "numeric_span_count"],
  "properties": {
    "schema_version": {"const": "signalforge/ir-semantic-projection/v1"},
    "projection_id": {"type": "string", "minLength": 1},
    "chunk_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "company_id": {"pattern": "^sec-cik:[0-9]{10}$"},
    "text": {"type": "string", "minLength": 1},
    "source_content_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "projection_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "projection_version": {"type": "string", "minLength": 1},
    "numeric_span_count": {"type": "integer", "minimum": 0},
    "numeric_references": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
