{
  "name": "expense_claim_routing",
  "description": "Route employee expense claims for Meridian Consulting based on claim text and policy rules.",
  "example_noun": "expense claim",
  "input_field": "claim_text",
  "input_length": {
    "min": 10,
    "max": 500
  },
  "seed_docs": [
    "seeds/expense_policy.md"
  ],
  "output_schema": {
    "routing_decision": {
      "type": "enum",
      "values": [
        "auto_approve",
        "needs_manager",
        "needs_finance",
        "reject"
      ]
    },
    "spending_category": {
      "type": "enum",
      "values": [
        "travel",
        "meals",
        "client_entertainment",
        "software",
        "equipment",
        "office_supplies"
      ]
    }
  },
  "balance_field": "routing_decision",
  "datagen_guidance": "Generate diverse claims with realistic business scenarios, including edge cases like duplicate entries or non-standard expenses.",
  "facets": {
    "personas": [
      "entry-level employee",
      "mid-level manager",
      "senior director"
    ],
    "tones": [
      "formal",
      "casual",
      "urgent"
    ],
    "lengths": [
      50,
      100,
      200
    ],
    "wrinkles": [
      "missing receipt",
      "unapproved travel date",
      "non-standard vendor"
    ],
    "situations": {
      "value": [
        "business trip",
        "conference",
        "client meeting",
        "software purchase",
        "office supply order"
      ]
    }
  }
}