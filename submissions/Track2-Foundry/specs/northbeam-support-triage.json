{
  "name": "northbeam-support-triage",
  "description": "Triages Northbeam support tickets into categories and priority levels based on seed policy documents.",
  "example_noun": "ticket",
  "input_field": "ticket_content",
  "input_length": {
    "min": 10,
    "max": 2000
  },
  "seed_docs": [
    "seeds/triage_policy.md"
  ],
  "output_schema": {
    "category": {
      "type": "enum",
      "values": [
        "outage",
        "account_access",
        "billing",
        "technical_issue",
        "data_request",
        "feature_request"
      ]
    },
    "priority": {
      "type": "enum",
      "values": [
        "P1",
        "P2",
        "P3",
        "P4"
      ]
    }
  },
  "balance_field": "category",
  "datagen_guidance": "Generate tickets with realistic phrasing, varied personas, and common pain points from the triage policy.",
  "facets": {
    "personas": [
      "customer",
      "internal_team",
      "support_agent"
    ],
    "tones": [
      "urgent",
      "calm",
      "frustrated"
    ],
    "lengths": [
      "short",
      "medium",
      "long"
    ],
    "wrinkles": [
      "specific product names",
      "regional references",
      "service level mentions"
    ],
    "situations": {
      "value": [
        "service down",
        "login failed",
        "billing dispute",
        "data missing",
        "new feature request"
      ]
    }
  }
}