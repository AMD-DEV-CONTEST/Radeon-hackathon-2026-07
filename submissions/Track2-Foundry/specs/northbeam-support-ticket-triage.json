{
  "name": "northbeam-support-ticket-triage",
  "description": "Classify Northbeam support tickets into categories and assign priorities based on policy rules.",
  "example_noun": "ticket",
  "input_field": "ticket_text",
  "input_length": {
    "min": 10,
    "max": 1000
  },
  "seed_docs": [
    "seeds/triage_policy.md"
  ],
  "output_schema": {
    "category": {
      "type": "enum",
      "values": [
        "outage",
        "account_access",
        "billing",
        "technical_issue",
        "data_request",
        "feature_request"
      ]
    },
    "priority": {
      "type": "enum",
      "values": [
        "P1",
        "P2",
        "P3",
        "P4"
      ]
    }
  },
  "balance_field": "category",
  "datagen_guidance": "Generate diverse scenarios reflecting real-world ticket types and policy edge cases.",
  "facets": {
    "personas": [
      "Customer",
      "IT Staff",
      "Billing Agent",
      "Support Agent"
    ],
    "tones": [
      "urgent",
      "calm",
      "frustrated",
      "neutral"
    ],
    "lengths": [
      50,
      150,
      300
    ],
    "wrinkles": [
      "missing data",
      "contradictory statements",
      "time-sensitive language"
    ],
    "situations": {
      "outage": [
        "service down for >1 hour",
        "users unable to log in"
      ],
      "account_access": [
        "password reset requested",
        "locked account"
      ],
      "billing": [
        "invoice dispute",
        "payment failed"
      ],
      "technical_issue": [
        "app crashing",
        "slow response"
      ],
      "data_request": [
        "requesting export",
        "data access"
      ],
      "feature_request": [
        "new functionality",
        "suggestion for improvement"
      ]
    }
  }
}