{
  "name": "meridian-expense-routing",
  "description": "Route Meridian Consulting expense claims based on policy rules.",
  "example_noun": "claim",
  "input_field": "claim_text",
  "input_length": {
    "min": 10,
    "max": 500
  },
  "seed_docs": [
    "seeds/expense_policy.md"
  ],
  "output_schema": {
    "routing_decision": {
      "type": "enum",
      "values": [
        "auto_approve",
        "needs_manager",
        "needs_finance",
        "reject"
      ]
    },
    "category": {
      "type": "enum",
      "values": [
        "travel",
        "meals",
        "client_entertainment",
        "software",
        "equipment",
        "office_supplies"
      ]
    }
  },
  "balance_field": "routing_decision",
  "datagen_guidance": "Generate claims grounded in real-world expense scenarios from the policy document.",
  "facets": {
    "personas": [
      "Finance Analyst",
      "Project Manager",
      "Field Engineer",
      "Marketing Director"
    ],
    "tones": [
      "formal",
      "urgent",
      "casual",
      "technical"
    ],
    "lengths": [
      50,
      100,
      200
    ],
    "wrinkles": [
      "missing receipts",
      "excessive amounts",
      "non-standard expenses"
    ],
    "situations": {
      "value": [
        "travel claim with missing receipt",
        "meals claim over $150",
        "client entertainment with no agenda",
        "software purchase without PO",
        "equipment claim for personal use",
        "office supplies with no justification"
      ]
    }
  }
}