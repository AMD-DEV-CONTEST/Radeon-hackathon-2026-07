{
  "name": "northbeam-ticket-triage",
  "description": "Triage Northbeam support tickets into category and priority.",
  "example_noun": "ticket",
  "input_field": "ticket_text",
  "input_length": {
    "min": 50,
    "max": 1000
  },
  "seed_docs": [
    "seeds/triage_policy.md"
  ],
  "output_schema": {
    "category": {
      "type": "enum",
      "values": [
        "outage",
        "account_access",
        "billing",
        "technical_issue",
        "data_request",
        "feature_request"
      ]
    },
    "priority": {
      "type": "enum",
      "values": [
        "P1",
        "P2",
        "P3",
        "P4"
      ]
    }
  },
  "balance_field": "category",
  "datagen_guidance": "Generate realistic ticket texts with varied personas and situations.",
  "facets": {
    "personas": [
      "IT staff",
      "customer",
      "finance team",
      "support agent"
    ],
    "tones": [
      "urgent",
      "calm",
      "frustrated",
      "neutral"
    ],
    "lengths": [
      200,
      400,
      600
    ],
    "wrinkles": [
      "mention of time-sensitive issues",
      "reference to past incidents",
      "request for data access"
    ],
    "situations": {
      "value": [
        "user can't log in",
        "billing dispute",
        "system crash",
        "feature not working",
        "data access needed"
      ]
    }
  }
}