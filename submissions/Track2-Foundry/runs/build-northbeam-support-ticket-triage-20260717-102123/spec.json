{
  "name": "northbeam-support-ticket-triage",
  "description": "Triage Northbeam support tickets into category and priority.",
  "example_noun": "ticket",
  "input_field": "ticket_text",
  "input_length": {
    "min": 10,
    "max": 500
  },
  "seed_docs": [
    "seeds/triage_policy.md"
  ],
  "output_schema": {
    "category": {
      "type": "enum",
      "values": [
        "outage",
        "account_access",
        "billing",
        "technical_issue",
        "data_request",
        "feature_request"
      ]
    },
    "priority": {
      "type": "enum",
      "values": [
        "P1",
        "P2",
        "P3",
        "P4"
      ]
    }
  },
  "balance_field": "category",
  "datagen_guidance": "Generate tickets grounded in real-world support scenarios from the triage policy.",
  "facets": {
    "personas": [
      "support agent",
      "customer"
    ],
    "tones": [
      "urgent",
      "calm",
      "frustrated"
    ],
    "lengths": [
      "short",
      "detailed"
    ],
    "situations": {
      "value": [
        "network down",
        "login failed",
        "billing dispute",
        "data query",
        "new feature suggestion"
      ]
    }
  }
}