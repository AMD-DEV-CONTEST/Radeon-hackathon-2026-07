{
  "name": "policyseal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "22.x",
    "pnpm": "11.x"
  },
  "scripts": {
    "dev:web": "pnpm --filter @policyseal/web dev",
    "build:web": "pnpm --filter @policyseal/web build",
    "check:web": "pnpm --filter @policyseal/web check",
    "test:web": "pnpm --filter @policyseal/web test",
    "e2e": "bash scripts/run-e2e.sh"
  }
}
