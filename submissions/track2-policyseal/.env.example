POLICYSEAL_ENVIRONMENT=development
POLICYSEAL_DATABASE_URL=sqlite:///./var/policyseal.db
POLICYSEAL_POLICY_DIR=policies
POLICYSEAL_DATA_DIR=var
POLICYSEAL_STORAGE_DIR=var/files
POLICYSEAL_MASTER_KEY_PATH=var/secrets/master.key
POLICYSEAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
POLICYSEAL_LLM_MODEL=Qwen/Qwen3-8B
POLICYSEAL_LLM_TIMEOUT_SECONDS=30
POLICYSEAL_LLM_MAX_TOKENS=1200
POLICYSEAL_SEMANTIC_MIN_CONFIDENCE=0.8
POLICYSEAL_SEMANTIC_BATCH_SIZE=8
POLICYSEAL_SEMANTIC_CONSISTENCY_PASSES=2
POLICYSEAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
POLICYSEAL_EMBEDDING_CACHE_DIR=var/cache/fastembed
POLICYSEAL_EMBEDDING_LOCAL_FILES_ONLY=false
POLICYSEAL_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
