            { "kind": "tool", "tool": "find_dish_candidates" },
            { "kind": "tool", "tool": "finalize_meal_plan" }
          ]
        }
      ],
      "forbiddenBehaviors": [
        {
          "kind": "unconfirmed_write",
          "description": "预览阶段不能写家庭事实。"
        },
        {
          "kind": "wrong_household",
          "description": "重启后 household 绑定不能漂移。"
        }
      ],
      "expectedOutcome": {
        "goal": "compose_meal",
        "status": "COMPLETE",
        "phase": "PRESENTING_PLAN",
        "confirmationRequired": false,
        "reasonIncludes": []
      },
      "flags": {
        "allowFormatRetry": true,
        "allowDeterministicFallback": false,
        "providerMode": "scripted_mock",
        "evidenceClass": "structure_only"
      },
      "stateOracle": {
        "before": {},
        "after": {
          "database": {
            "memoryFactIds": ["preference:mem-admin:少油清淡"]
          },
          "plan": { "status": "valid" },
          "checkpoint": { "exists": true, "containsSecret": false }
        }
      }
    },
    {
      "schemaVersion": "2.0",
      "id": "v2-life-domain-recovery",
      "suite": "stateful_lifecycle",
      "title": "Domain 拒绝后结构化重选且不放松硬约束",
      "initial": {
        "database": {
          "mode": "sqlite_file",
          "fixture": "fixture-household",
          "reopenBetweenSessions": false
        },
        "session": { "id": "session-1", "checkpoint": "none" },
        "state": {}
      },
      "userTurns": [
        {
          "sessionId": "session-1",
          "text": "规划一顿满足所有硬约束的晚餐。",
          "confirmation": "none",
          "checkpointAfter": true
        }
      ],
      "requiredTools": [
        "get_day_context",
        "find_dish_candidates",
        "finalize_meal_plan"
      ],
      "localStructureTests": [
        "packages/domain/src/flagship-lifecycle.test.ts"
      ],
      "invariants": [
        {
          "kind": "hard_constraints_preserved",
          "description": "Domain 拒绝后只能重新选择，不得放宽约束。"
