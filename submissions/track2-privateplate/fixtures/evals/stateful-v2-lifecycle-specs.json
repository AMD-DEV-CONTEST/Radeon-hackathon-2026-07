        },
        {
          "kind": "minimum_disclosure",
          "description": "任务卡只披露执行所需内容。"
        },
        {
          "kind": "pending_confirmation_required",
          "description": "确认前不能发送。"
        },
        {
          "kind": "state_oracle_reached",
          "description": "最终发送对象与用户纠正一致。"
        }
      ],
      "allowedPaths": [
