    {
      "schemaVersion": "2.0",
      "id": "v2-life-permission-idempotency",
      "suite": "stateful_lifecycle",
      "title": "错误 token、过期、取消、跨 household 和重复确认都不得错写",
      "initial": {
        "database": {
          "mode": "sqlite_file",
          "fixture": "fixture-two-households",
          "reopenBetweenSessions": true
        },
        "session": { "id": "session-1", "checkpoint": "none" },
        "state": {}
      },
      "userTurns": [
        {
          "sessionId": "session-1",
          "text": "预览库存调整，然后用错误 token、过期 token、取消和重复确认分别重放。",
          "confirmation": "none",
          "checkpointAfter": true
        },
        {
          "sessionId": "session-2",
          "text": "确认当前 household 的库存调整。",
          "confirmation": "confirm",
          "checkpointAfter": true
        }
      ],
      "requiredTools": ["preview_inventory_change"],
      "localStructureTests": [
        "packages/domain/src/flagship-lifecycle.test.ts",
        "packages/domain/src/full-loop-lifecycle.test.ts",
        "apps/server/src/product-e2e-mock.test.ts"
      ],
      "invariants": [
        {
          "kind": "no_duplicate_commit",
          "description": "同一 pending action 最多成功写一次。"
        },
        {
          "kind": "cross_session_state",
          "description": "重放和跨 session 不得改变 household 绑定。"
        },
        {
          "kind": "database_unchanged_before_confirmation",
          "description": "错误、过期、取消的确认都不能写库。"
        },
        {
          "kind": "state_oracle_reached",
          "description": "只有合法 token 的一次确认改变 oracle 状态。"
        }
      ],
      "allowedPaths": [
        {
          "id": "preview-and-one-commit",
          "steps": [
            { "kind": "tool", "tool": "preview_inventory_change" },
            { "kind": "decision", "decision": "finish_turn" }
          ]
        }
      ],
      "forbiddenBehaviors": [
        {
          "kind": "duplicate_commit",
          "description": "重复确认不能第二次扣库存。"
        },
        {
          "kind": "wrong_household",
          "description": "跨 household token 不能被接受。"
        },
        {
          "kind": "unconfirmed_write",
          "description": "取消和过期 action 不能写库。"
        }
      ],
      "expectedOutcome": {
        "goal": "update_inventory",
        "status": "COMPLETE",
        "phase": "COMPLETED",
        "confirmationRequired": false,
        "reasonIncludes": []
      },
      "flags": {
        "allowFormatRetry": false,
        "allowDeterministicFallback": false,
        "providerMode": "scripted_mock",
        "evidenceClass": "structure_only"
      },
      "stateOracle": {
        "before": {},
        "after": {
          "database": { "pendingActionCount": 0 },
          "ledger": { "inventoryVersion": 2 },
          "pendingAction": {
            "status": "committed",
            "confirmationRequired": false
          },
          "checkpoint": { "exists": true, "containsSecret": false }
        }
      }
    }
  ]
