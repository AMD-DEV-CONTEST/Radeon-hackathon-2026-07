            "inventory": { "food-tofu": 0 }
          }
        }
      },
      "userTurns": [
        {
          "sessionId": "session-1",
          "text": "先只看一下库存，再预览两盒豆腐入库，确认前不要写入库存。",
          "confirmation": "none",
          "checkpointAfter": true
        }
      ],
      "requiredTools": ["get_inventory", "preview_inventory_change"],
      "rawArgumentChecks": [
        {
          "tool": "preview_inventory_change",
          "path": "foodId",
          "equals": "food-tofu"
