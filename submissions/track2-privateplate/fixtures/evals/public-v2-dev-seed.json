{
  "schemaVersion": "2.0",
  "suite": "dev_seed",
  "role": "dev_seed",
  "scenarios": [
    {
      "schemaVersion": "2.0",
      "id": "v2-dev-plan-basic",
      "suite": "dev_seed",
      "title": "读取上下文后完成一条午餐规划链",
      "initial": {
        "database": {
          "mode": "memory",
          "fixture": "seed-household",
          "reopenBetweenSessions": false
        },
        "session": { "id": "session-1", "checkpoint": "none" },
        "state": {}
      },
      "userTurns": [
        {
          "sessionId": "session-1",
          "text": "请根据三位成员今天的情况规划午餐。",
          "confirmation": "none",
          "checkpointAfter": true
        }
      ],
      "requiredTools": [
        "get_day_context",
        "find_dish_candidates",
        "finalize_meal_plan"
      ],
      "rawArgumentChecks": [
        {
          "tool": "get_day_context",
          "path": "dinerIds",
          "contains": "mem-admin"
        },
        {
          "tool": "finalize_meal_plan",
          "path": "selectedDishes",
          "contains": {
            "templateId": "tpl-tofu",
            "relativePortion": "standard"
          }
        }
      ],
      "invariants": [
        {
          "kind": "state_oracle_reached",
          "description": "规划完成后必须落到可追溯的有效计划状态。"
        },
        {
          "kind": "selected_dishes_from_candidate_set",
          "description": "模型选择的菜只能来自本轮候选集。"
        },
        {
          "kind": "raw_selection_persisted",
          "description": "模型原始选择与最终计划中的选择一致。"
        },
        {
          "kind": "hard_constraints_preserved",
          "description": "成员约束不能在规划过程中被放松。"
        }
      ],
      "allowedPaths": [
        {
          "id": "context-candidates-finalize",
          "steps": [
            { "kind": "tool", "tool": "get_day_context" },
            { "kind": "tool", "tool": "find_dish_candidates" },
            { "kind": "tool", "tool": "finalize_meal_plan" }
          ]
        },
        {
          "id": "context-ask-then-plan",
          "steps": [
            { "kind": "tool", "tool": "get_day_context" },
            { "kind": "decision", "decision": "ask_user" },
            { "kind": "tool", "tool": "find_dish_candidates" },
            { "kind": "tool", "tool": "finalize_meal_plan" }
          ]
        }
      ],
      "forbiddenBehaviors": [
        {
          "kind": "wrong_tool_arguments",
          "description": "不能把自然语言拒绝项替换成未声明的参数名。"
        },
        {
          "kind": "false_write_claim",
          "description": "只生成计划时不能声称已经扣库存。"
        }
      ],
      "expectedOutcome": {
        "goal": "compose_meal",
        "status": "COMPLETE",
        "phase": "PRESENTING_PLAN",
        "confirmationRequired": false,
        "reasonIncludes": []
      },
      "flags": {
        "allowFormatRetry": true,
        "allowDeterministicFallback": false,
        "providerMode": "local_vllm",
        "evidenceClass": "model_native"
      },
      "stateOracle": {
        "before": {},
        "after": {
          "database": { "householdId": "household-demo" },
          "plan": {
            "activePlanId": "plan-v2-1",
            "activePlanVersion": 1,
            "selectedTemplateIds": ["tpl-tofu", "tpl-cabbage"],
            "status": "valid",
            "candidateSetId": "cset-v2-1"
          },
          "checkpoint": {
            "exists": true,
            "workflowStage": "PRESENTING_PLAN",
            "candidateSetId": "cset-v2-1",
            "containsSecret": false
          }
        }
      }
    },
    {
      "schemaVersion": "2.0",
      "id": "v2-dev-revise-plan",
      "suite": "dev_seed",
      "title": "多轮修订成员后重新选择整套计划",
      "initial": {
        "database": {
          "mode": "memory",
          "fixture": "seed-household-with-plan",
          "reopenBetweenSessions": false
        },
        "session": { "id": "session-1", "checkpoint": "resume" },
        "state": {
          "plan": {
            "activePlanId": "plan-v2-1",
            "activePlanVersion": 1,
            "selectedTemplateIds": ["tpl-tofu"],
            "status": "valid",
            "candidateSetId": "cset-v2-1"
          }
        }
      },
      "userTurns": [
        {
          "sessionId": "session-1",
          "text": "把早餐成员改成三个人，并重新规划。",
          "confirmation": "none",
          "checkpointAfter": true
        },
        {
          "sessionId": "session-1",
          "text": "不要鸡腿，保留其他限制。",
          "confirmation": "none",
          "checkpointAfter": true
        }
      ],
      "requiredTools": [
        "get_day_context",
        "find_dish_candidates",
        "finalize_meal_plan"
      ],
      "rawArgumentChecks": [
        {
          "tool": "find_dish_candidates",
          "path": "rejectedFoodIds",
          "contains": "food-chicken-leg"
        }
      ],
      "invariants": [
        {
          "kind": "old_plan_superseded",
          "description": "新计划成功后旧版本必须标记为 superseded。"
        },
        {
          "kind": "selected_dishes_from_candidate_set",
          "description": "修订后的选择只能来自新的候选集。"
        },
        {
          "kind": "hard_constraints_preserved",
          "description": "新增拒绝项不能重新出现在最终计划。"
        },
        {
          "kind": "state_oracle_reached",
          "description": "最终状态必须是 version +1 的有效计划。"
        }
      ],
      "allowedPaths": [
        {
          "id": "re-read-reselect-finalize",
          "steps": [
            { "kind": "tool", "tool": "get_day_context" },
            { "kind": "tool", "tool": "find_dish_candidates" },
            { "kind": "tool", "tool": "finalize_meal_plan" }
          ]
        },
        {
          "id": "clarify-then-reselect",
          "steps": [
            { "kind": "tool", "tool": "get_day_context" },
            { "kind": "decision", "decision": "ask_user" },
            { "kind": "tool", "tool": "find_dish_candidates" },
            { "kind": "tool", "tool": "finalize_meal_plan" }
          ]
        }
      ],
      "forbiddenBehaviors": [
        {
          "kind": "wrong_tool_arguments",
          "description": "不得把旧计划的 selectedDishes 原样提交成新版本。"
        },
        {
          "kind": "partial_as_complete",
          "description": "只有重新选择并成功落盘后才能报告完整修订。"
        }
      ],
      "expectedOutcome": {
        "goal": "revise_meal",
        "status": "COMPLETE",
        "phase": "PRESENTING_PLAN",
        "confirmationRequired": false,
        "reasonIncludes": []
      },
      "flags": {
        "allowFormatRetry": true,
        "allowDeterministicFallback": false,
        "providerMode": "local_vllm",
        "evidenceClass": "model_native"
      },
      "stateOracle": {
        "before": {
          "plan": {
            "activePlanId": "plan-v2-1",
            "activePlanVersion": 1,
            "selectedTemplateIds": ["tpl-tofu"],
            "status": "valid",
            "candidateSetId": "cset-v2-1"
          }
        },
        "after": {
          "plan": {
            "activePlanId": "plan-v2-2",
            "activePlanVersion": 2,
            "selectedTemplateIds": ["tpl-tofu", "tpl-cabbage"],
            "status": "valid",
            "candidateSetId": "cset-v2-2"
          },
          "checkpoint": {
            "exists": true,
            "workflowStage": "PRESENTING_PLAN",
            "candidateSetId": "cset-v2-2",
            "containsSecret": false
          }
        }
      }
    },
    {
      "schemaVersion": "2.0",
      "id": "v2-dev-inventory-preview",
      "suite": "dev_seed",
      "title": "库存变更先预览并等待确认",
      "initial": {
        "database": {
          "mode": "memory",
          "fixture": "seed-household",
