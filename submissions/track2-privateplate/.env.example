# Copy to .env and fill in. Never commit .env or private keys.
#   cp .env.example .env

# --- Radeon Notebook SSH (for agent to run C0-B on the instance) ---
# From Profile → Active Instance → SSH access (Command / Host:Port)
RADEON_SSH_HOST=
RADEON_SSH_PORT=22
RADEON_SSH_USER=
# Path to your PRIVATE key file on this Mac (not the .pub file)
# Example: /Users/mac/.ssh/id_ed25519
RADEON_SSH_KEY_PATH=
# Optional: if you paste host key verification later
# RADEON_SSH_STRICT_HOSTKEY=accept-new

# Session metadata (fill when launching)
PRIVATEPLATE_CREDITS_BEFORE=
PRIVATEPLATE_INSTANCE_ID=

# --- Chat model (Agent tool routing) — default port 8000 ---
# PRIVATEPLATE_MODEL_ACTIVE=google/gemma-4-12B-it-qat-w4a16-ct
# PRIVATEPLATE_VLLM_BASE_URL=http://127.0.0.1:8000/v1
# PRIVATEPLATE_VLLM_API_KEY=

# --- Local RAG (embedding retrieval) — dedicated port 8001 ---
# Real RAG path used by tool retrieve_local_knowledge:
#   1) Start chat vLLM on :8000
#   2) Start embedding vLLM on :8001  (bash scripts/rag/serve-bge-small.example.sh)
#   3) npm run rag:check
#   4) export the three vars below, then npm run dev:server
#
PRIVATEPLATE_RAG_MODE=vllm
PRIVATEPLATE_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
PRIVATEPLATE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# PRIVATEPLATE_EMBEDDING_DIMS=512
#
# Offline unit tests / no embedding GPU:
# PRIVATEPLATE_RAG_OFFLINE=yes
