# Application
APP_NAME=AgentVox
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agentvox

# Security
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Paths
UPLOAD_DIR=uploads
LOG_DIR=logs
LOG_LEVEL=INFO

# WebSocket realtime
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_HEARTBEAT_TIMEOUT_SECONDS=90

# Future OpenAI / LLM (disabled)
LLM_ENABLED=false
OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# Future Redis (disabled)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Future Celery (disabled)
CELERY_ENABLED=false
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Future AMD APIs (disabled)
AMD_API_ENABLED=false
# AMD_API_BASE_URL=
# AMD_API_KEY=

# Future LangSmith (disabled)
LANGSMITH_ENABLED=false
LANGSMITH_PROJECT=agentvox
# LANGSMITH_API_KEY=
