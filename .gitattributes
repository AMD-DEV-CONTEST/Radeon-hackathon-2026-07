# 自训 LoRA 权重走 Git LFS（185MB，超过 GitHub 100MB 单文件限制）
*.safetensors filter=lfs diff=lfs merge=lfs -text

# 文本文件统一 LF，避免跨平台换行噪音
*.py   text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf

# 二进制文件禁止任何换行转换（否则 PDF/PPTX/PNG 会被损坏）
*.pdf  binary
*.pptx binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.zip  binary
*.mp4  binary
