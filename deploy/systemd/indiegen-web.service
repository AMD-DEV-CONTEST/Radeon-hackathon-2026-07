[Unit]
Description=IndieGen Web (FastAPI)
After=network.target comfyui.service

[Service]
Type=simple
WorkingDirectory=/root/game
Environment=COMFY_URL=http://127.0.0.1:8188
ExecStart=/root/game/ComfyUI/.venv/bin/python -m uvicorn server.app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
