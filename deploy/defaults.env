# FastAgentFactory 内部部署默认值。用户配置统一写入根目录 .env；不要复制或直接编辑本文件。
# ssh：推理节点位于另一台机器；local：AMD GPU 与 Web 位于同一台 Linux 主机。
DEPLOY_TARGET=ssh

# 仅 DEPLOY_TARGET=ssh 时填写；SSH_KEY 可留空交给 ssh-agent 选择。
SSH_HOST=
SSH_PORT=22
SSH_USER=root
SSH_KEY=

# 远端工作目录。若实例提供持久卷，请把模型、状态和 llama.cpp 路径改到持久卷挂载点。
REMOTE_PROJECT_ROOT=/root/FastAgentFactory
REMOTE_STATE_ROOT=/root/.fastagentfactory
# 已有实例可单独指定正在使用的模型池数据库；留空时使用 REMOTE_STATE_ROOT/model_pool/factory.sqlite。
REMOTE_MODEL_POOL_STORE=
REMOTE_MODEL_ROOT=/root/models
REMOTE_LLAMA_SOURCE_ROOT=/root/fastagentfactory-llama-sources
REMOTE_LLAMA_RUNTIME_ROOT=/root/.fastagentfactory/llama
REMOTE_STABLE_DIFFUSION_CPP_DIR=/root/stable-diffusion.cpp

# 两套 llama.cpp 与 stable-diffusion.cpp 完整源码均随 FastAgentFactory 仓库交付。
# AMD 目录当前与官方基线实现一致，后续算子优化只进入 AMD 目录。
LOCAL_LLAMA_OFFICIAL_DIR=vendor/llama.cpp-official
LOCAL_LLAMA_AMD_DIR=vendor/llama.cpp-amd
LOCAL_STABLE_DIFFUSION_CPP_DIR=vendor/stable-diffusion.cpp
LLAMA_OFFICIAL_REVISION=f955e394bf94e01e5e36186d13c985727e5ef5b5
LLAMA_OFFICIAL_BUILD_NUMBER=10022
LLAMA_AMD_BASE_REVISION=f955e394bf94e01e5e36186d13c985727e5ef5b5
LLAMA_AMD_BASE_BUILD_NUMBER=10022
LLAMA_DEFAULT_IMPLEMENTATION=amd
STABLE_DIFFUSION_CPP_REVISION=833369da848e8e2f960fe1896a825e3a08ef9733

# 国内下载源。Chat GGUF 走 Hugging Face 国内镜像，Embedding 走 ModelScope。
PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
HF_ENDPOINT=https://hf-mirror.com
CHAT_MODEL_REPOSITORY=SC117/Qwen3.6-35B-A3B-uncensored-heretic-Native-MTP-Preserved-APEX-GGUF
CHAT_MODEL_REVISION=dc1e5523d5924b641adb0fabb4ecde27fc261b0b
CHAT_MODEL_FILENAME=Qwen3.6-35B-A3B-uncensored-heretic-Native-MTP-Preserved-APEX-I-Quality.gguf
CHAT_MODEL_SHA256=31a6a415d4de270cdd2128103a671202f4b92b6eb30c5f87934f3b06fc2a55cc
CHAT_MODEL_SIZE_BYTES=23514746272
CHAT_MMPROJ_FILENAME=mmproj-Qwen3.6-35B-A3B-uncensored-heretic-Native-MTP-Preserved-APEX-F16.gguf
CHAT_MMPROJ_SHA256=c8e702344a81f8c226a914aa980ed6e1f604bce9374f1fed8e65c896908af414
CHAT_MMPROJ_SIZE_BYTES=899283072
EMBEDDING_MODEL_ID=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=master

# FLUX.1-dev Q4_0 四件套，使用 ModelScope 国内直链并固定 SHA256。
IMAGE_MODEL_URL=https://modelscope.cn/models/city96/FLUX.1-dev-gguf/resolve/master/flux1-dev-Q4_0.gguf
IMAGE_MODEL_FILENAME=flux1-dev-Q4_0.gguf
IMAGE_MODEL_SHA256=2867e9575640d80ccbcbf65010659a4d09e676a034637bc37eac7f2531c46e90
IMAGE_MODEL_SIZE_BYTES=6791167136
IMAGE_VAE_URL=https://modelscope.cn/models/black-forest-labs/FLUX.1-dev/resolve/master/ae.safetensors
IMAGE_VAE_FILENAME=ae.safetensors
IMAGE_VAE_SHA256=afc8e28272cd15db3919bacdb6918ce9c1ed22e96cb12c4d5ed0fba823529e38
IMAGE_VAE_SIZE_BYTES=335304388
IMAGE_CLIP_L_URL=https://modelscope.cn/models/comfyanonymous/flux_text_encoders/resolve/master/clip_l.safetensors
IMAGE_CLIP_L_FILENAME=clip_l.safetensors
IMAGE_CLIP_L_SHA256=660c6f5b1abae9dc498ac2d21e1347d2abdb0cf6c0c0c8576cd796491d9a6cdd
IMAGE_CLIP_L_SIZE_BYTES=246144152
IMAGE_T5XXL_URL=https://modelscope.cn/models/comfyanonymous/flux_text_encoders/resolve/master/t5xxl_fp16.safetensors
IMAGE_T5XXL_FILENAME=t5xxl_fp16.safetensors
IMAGE_T5XXL_SHA256=6e480b09fae049a72d2a8c5fbccb8d3e92febeb233bbe9dfe7256958a9167635
IMAGE_T5XXL_SIZE_BYTES=9787841024

# 推理 Profile。上下文、并发和 KV 类型会进入远端 llama-server 启动参数。
CHAT_PROFILE_ID=qwen3_6_35b_a3b_apex_i_quality_chat
CHAT_SERVED_MODEL_NAME=Qwen3.6-35B-A3B-APEX-I-Quality
CHAT_NATIVE_CONTEXT_TOKENS=262144
CHAT_YARN_MAX_CONTEXT_TOKENS=1010000
CHAT_CONTEXT_SIZE=256000
CHAT_MAX_OUTPUT_TOKENS=32768
CHAT_COMPRESSION_THRESHOLD=220000
CHAT_GPU_LAYERS=99
CHAT_PARALLEL_SLOTS=3
CHAT_ADMISSION_MAX_PENDING=64
CHAT_ADMISSION_PER_SESSION_ACTIVE=1
CHAT_ADMISSION_QUEUE_TIMEOUT_SECONDS=300
CHAT_ADMISSION_PRIORITY_AGING_SECONDS=30
CHAT_CACHE_TYPE_K=q8_0
CHAT_CACHE_TYPE_V=q8_0
CHAT_FLASH_ATTENTION=1
# MTP 使用 GGUF 内保留的 NextN 预测层；启动后会通过 llama-server slots 验证是否实际启用。
CHAT_MTP_ENABLED=1
CHAT_MTP_MAX_DRAFT_TOKENS=3
CHAT_MTP_MIN_DRAFT_TOKENS=0
CHAT_MTP_MIN_ACCEPTANCE_PROBABILITY=0.0
CHAT_MTP_BACKEND_SAMPLING=1
CHAT_REASONING_SUPPORTED=1

EMBEDDING_PROFILE_ID=bge_m3_embedding
EMBEDDING_SERVED_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TRUST_REMOTE_CODE=0

IMAGE_PROFILE_ID=flux1_dev_q4_0_image
IMAGE_SERVED_MODEL_NAME=FLUX.1-dev-Q4_0
IMAGE_ENABLED=1
IMAGE_DIFFUSION_FLASH_ATTENTION=1
IMAGE_EAGER_LOAD=1
IMAGE_CLIP_ON_CPU=1
IMAGE_VAE_TILING=1
IMAGE_OFFLOAD_TO_CPU=0
IMAGE_MAX_VRAM_GIB=
IMAGE_STREAM_LAYERS=
IMAGE_DEFAULT_WIDTH=1024
IMAGE_DEFAULT_HEIGHT=1024
IMAGE_DEFAULT_STEPS=20
IMAGE_DEFAULT_CFG_SCALE=1.0
IMAGE_RESIDENCY_POLICY=coexist_if_fit
IMAGE_TIMEOUT_SECONDS=900

# 三个服务只监听远端回环地址，由 SSH 隧道转发到本机。
REMOTE_CHAT_PORT=8003
REMOTE_EMBEDDING_PORT=8002
REMOTE_TELEMETRY_PORT=8004
REMOTE_IMAGE_PORT=8005
LOCAL_CHAT_PORT=18003
LOCAL_EMBEDDING_PORT=18002
LOCAL_TELEMETRY_PORT=18004
LOCAL_IMAGE_PORT=18005

# 仅在远端缺少 cmake/ninja/curl 等普通构建工具时安装；不会升级 ROCm、PyTorch 或驱动。
REMOTE_INSTALL_BUILD_TOOLS=1
# 远端所有 HTTPS 客户端共用的系统 CA bundle。探测到证书链损坏或缺失时允许重建并按需重装 ca-certificates。
REMOTE_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
REMOTE_REPAIR_CA_TRUST=1
REMOTE_CA_PROBE_URL=https://pypi.tuna.tsinghua.edu.cn/simple/

# ROCm/PyTorch 准备策略。脚本始终先探查现有环境；仅在缺失时安装用户态组件。
# GPU 驱动和 /dev/kfd 必须由云平台提供，无法在工作空间容器内补装。
REMOTE_INSTALL_ROCM_USERSPACE=1
ROCM_USERSPACE_PACKAGES='rocminfo rocm-hip-sdk rocprofiler-sdk'
REMOTE_INSTALL_PYTORCH=1
# 比赛镜像预装的 HIP PyTorch 环境；脚本会将其接入项目隔离 venv，不复制或替换 Torch。
PYTORCH_RUNTIME_PYTHON=/opt/venv/bin/python
# 远端推理 bundle 的最小 Python 依赖；不会安装完整 FastAgentFactory 项目。
REMOTE_INFERENCE_PYTHON_PACKAGES='fastapi>=0.115 uvicorn[standard]>=0.30 httpx[socks]>=0.27 pydantic>=2.8 gguf>=0.10 modelscope>=1.25,<2 sentence-transformers>=3,<6 transformers>=4.51,<6'
# 镜像环境不可用时的后备安装源。默认比赛镜像使用 ROCm 7.2。
# 其他 ROCm 版本必须在根目录 .env 中覆盖为对应的官方 wheel 源和匹配发布组。
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/rocm7.2
PYTORCH_PACKAGES='torch==2.11.0+rocm7.2 torchvision==0.26.0+rocm7.2 torchaudio==2.11.0+rocm7.2'
