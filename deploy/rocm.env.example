# Build inputs. Select a Radeon-compatible ROCm image that already contains PyTorch HIP.
ROCM_RUNTIME_BASE_IMAGE=
PYPI_INDEX_URL=
AGENTFACTORY_ROCM_RUNTIME_IMAGE=
LLAMA_CPP_REPOSITORY=https://github.com/ggml-org/llama.cpp.git
LLAMA_CPP_REVISION=

# Host model registry and model files. Paths must be absolute on the AMD GPU host.
AGENTFACTORY_MODEL_POOL_DIR=
AGENTFACTORY_MODEL_ROOT=
AGENTFACTORY_CHAT_PROFILE_ID=
AGENTFACTORY_EMBEDDING_PROFILE_ID=

# Internal loopback services.
AGENTFACTORY_LOCAL_INFERENCE_PORT=
AGENTFACTORY_LOCAL_EMBEDDING_PORT=
AGENTFACTORY_LOCAL_INFERENCE_ENDPOINT=
AGENTFACTORY_LOCAL_EMBEDDING_ENDPOINT=

# Resolve these ids from the target host's video and render groups.
ROCM_VIDEO_GROUP_ID=
ROCM_RENDER_GROUP_ID=
