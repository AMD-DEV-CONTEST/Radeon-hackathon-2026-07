{
  "name": "botversex",
  "private": true,
  "version": "0.1.0",
  "description": "BotverseX unified monorepo (platform + realtime + contracts)",
  "scripts": {
    "dev:web": "pnpm --filter @botversex/web dev",
    "dev:realtime": "cd apps/realtime && python run_api.py",
    "dev:api": "cd apps/api && uvicorn app.main:app --reload --port 8000",
    "dev:all": "docker compose -f infra/docker/docker-compose.dev.yml up --build"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  }
}
