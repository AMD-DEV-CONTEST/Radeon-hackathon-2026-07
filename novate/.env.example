# Copy this file to `.env` and adjust as needed.

# LLM server — Radeon Cloud vLLM Dedicated Model API (OpenAI-compatible).
# Get these three values from Radeon Cloud after launching a
# "Deploy Type = vLLM Model API" template (see scripts/deploy_notes.md).
NOVA_LLM_BASE_URL=https://radeon-global.anruicloud.com/spaces/<id>/8000/v1
NOVA_LLM_MODEL_NAME=<model-name-you-passed-to-vllm-serve>
NOVA_LLM_API_KEY=<api-key-shown-in-instance-details>
NOVA_LLM_TEMPERATURE=0.3
NOVA_LLM_MAX_TOKENS=512

# Embeddings
NOVA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
NOVA_EMBEDDING_DEVICE=cuda   # ROCm exposes GPUs to torch under the "cuda" device string

# Paths
NOVA_DATA_DIR=data/sample_docs
NOVA_VECTOR_DB_DIR=chroma_db
NOVA_COLLECTION_NAME=nova_knowledge_base

# RAG
NOVA_RAG_TOP_K=4
NOVA_RAG_CHUNK_SIZE=800
NOVA_RAG_CHUNK_OVERLAP=120

# Memory
NOVA_MEMORY_MAX_TURNS=8

# Privacy
NOVA_ENABLE_SHELL_TOOL=false
