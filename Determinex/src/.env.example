# Determinex — environment variables
# Copy to .env and fill in your values. Never commit .env.

# ── Cloud API keys (all optional — system uses local Ollama models if missing) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# ── AMD Radeon GPU (ROCm) ───────────────────────────────────────────────────
# Path A — your own dedicated Radeon Cloud vLLM instance (model amd/qwen-coder-7b).
# Launch at radeon-global.anruicloud.com with Deploy Type = "vLLM Model API";
# the ready dialog shows both values below. They are per-instance and stop
# working when you destroy the instance, so re-copy them on each launch.
AMD_BASE_URL=
AMD_API_KEY=

# Path B — AMD's free shared Token Factory endpoint (models amd/qwen3-35b,
# amd/deepseek-flash). Separate variable on purpose: this is a different
# operator on a different host, and a dedicated-instance key must never be
# sent there. Key from https://developer.amd.com.cn/radeon/modelapis
AMD_FREE_API_KEY=


# Alt key names some scripts honor in addition to the standard ones above.
# Set these if you want per-tool routing without touching the canonical keys.
# DETERMINEX_ANTHROPIC_KEY=
# DETERMINEX_DEEPSEEK_KEY=

# ── Vanguard vault encryption key (auto-generated on first run if missing) ─────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DETERMINEX_FERNET_KEY=

# ── System config ─────────────────────────────────────────────────────────────
DEFAULT_LOCAL_MODEL=ollama/qwen2.5-coder:1.5b
DEFAULT_CLOUD_MODEL=claude-sonnet-4-6

# ── Model routing (override litellm_config.yaml assignments) ──────────────────
# Current canonical generation: v11/v6/v5. Update register_models.{ps1,sh}
# in lockstep with these names.
DETERMINEX_SENTINEL_MODEL=ollama/determinex-sentinel-v5-dsl
DETERMINEX_ENGINEER_MODEL=ollama/determinex-engineer-v11-dsl
DETERMINEX_OBSERVER_MODEL=ollama/determinex-observer-v6-dsl
DETERMINEX_LEVIATHAN_MODEL=determinex-leviathan:v1

# Override specific role models without rewriting litellm_config.yaml.
# DETERMINEX_BUILDER_MODEL=ollama/determinex-engineer-v11-dsl
# DETERMINEX_OBSERVER_MODEL=ollama/determinex-observer-v6-dsl
# DETERMINEX_DEEPSEEK_MODEL=deepseek-v4-flash
# DETERMINEX_ANTHROPIC_MODEL=claude-sonnet-4-6
# DETERMINEX_CLAUDE_MODEL=claude-opus-4-6
# DETERMINEX_GEMINI_MODEL=gemini-3-flash-preview

# ── Inference backend (which client to use for cloud calls) ───────────────────
# anthropic | deepseek | openrouter
# DETERMINEX_INFERENCE_BACKEND=deepseek
# DETERMINEX_ARCHITECT_BACKEND=anthropic
# DETERMINEX_BUILDER_BACKEND=deepseek

# ── Local builder (Config E — privacy-sovereign, no cloud code leakage) ───────
# Enable to route the Builder role through a local Ollama/vLLM endpoint instead
# of cloud APIs. See docs/PROJECT_CLOAK.md.
# DETERMINEX_LOCAL_BUILDER=1
# DETERMINEX_LOCAL_BUILDER_MODEL=qwen2.5-coder:14b-instruct-q4_K_M
# DETERMINEX_LOCAL_SWARM=1            # parallel builder instances (future)
# DETERMINEX_VLLM_URL=http://localhost:8000
# DETERMINEX_VLLM_MODEL=qwen2.5-coder-7b-instruct

# ── HuggingFace cache (used by determinex_projector.py for base model extraction) ──
# Defaults to ~/.cache/huggingface — set to a fast SSD path for large models.
# DETERMINEX_HF_CACHE_DIR=/path/to/hf_cache

# ── Local paths ───────────────────────────────────────────────────────────────
# Project root. Defaults to the directory containing the script being run.
# Scripts that write logs/state under DETERMINEX_ROOT/logs honor this.
# DETERMINEX_ROOT=/path/to/your/determinex/checkout
# DETERMINEX_PYTHON=/path/to/python
# LLAMA_CPP_DIR=/path/to/llama.cpp

# Where GGUFs and Rosetta weights live. Defaults to ~/determinex-models
# Set this if your models are on a secondary drive or non-default path.
# Example (Windows secondary drive): DETERMINEX_MODELS_DIR=T:/determinex-models
# Example (Linux/Mac NAS mount):     DETERMINEX_MODELS_DIR=/mnt/data/determinex-models
# DETERMINEX_MODELS_DIR=/path/to/model/storage

# SWE-bench data directory. Defaults to ~/determinex-swebench
# DETERMINEX_SWEBENCH_DIR=/path/to/determinex-swebench
# DETERMINEX_SWEBENCH_REPOS=/path/to/pre-cloned/swebench/repos

# ProgramBench checkout (T:/Dev/ProgramBench by default on Ryan's rig)
# PROGRAMBENCH_DIR=/path/to/ProgramBench

# ── Ollama endpoint ───────────────────────────────────────────────────────────
# Override to point at a remote GPU rig on your LAN.
# OLLAMA_HOST=http://192.168.1.50:11434
# DETERMINEX_OLLAMA_URL=http://localhost:11434
# OLLAMA_MODELS=T:/OllamaModels        # alt model-storage root (Windows secondary drive)

# ── Registry ──────────────────────────────────────────────────────────────────
# Override Rosetta registry endpoint (enterprise / self-hosted).
# DETERMINEX_REGISTRY_URL=https://your-mirror.example.com/registry.json

# Disable all network calls (registry updates, API models).
# DETERMINEX_OFFLINE=1

# ── Cloud fallback gate ───────────────────────────────────────────────────────
# By default, Determinex is fully local. If any role resolves to a cloud/* model
# (e.g. because litellm_config.yaml is missing or a fallback chain fires),
# the call will be BLOCKED and a clear error displayed instead of silently
# burning API credits or failing with a confusing key-not-found error.
#
# Set to 1 ONLY if you have API keys configured above and want cloud fallback:
# DETERMINEX_ALLOW_CLOUD_FALLBACK=1

# ── Project Cloak (privacy obfuscation for cloud calls) ───────────────────────
# DETERMINEX_CLOAK=1                  # turn on AST obfuscation for outbound code
# DETERMINEX_CLOAK_AUDIT=1            # log every API request for post-run audit
# DETERMINEX_CLOAK_SAVE_PAYLOADS=1    # persist full prompts/responses (audit only)
# DETERMINEX_NO_ROSETTA=1             # ablation control — disable Rosetta latent bridge

# ── Budget guard (caps cloud spend on mass runs) ──────────────────────────────
# All values in USD per run unless noted.
# DETERMINEX_BUDGET_MAX_USD=1.50
# DETERMINEX_BUDGET_MAX_CALLS=60
# DETERMINEX_BUDGET_MAX_PER_TASK=3

# ── Tunnel vision / chrono (offline reasoning helpers) ────────────────────────
# DETERMINEX_TUNNEL_VISION_PATH=
# DETERMINEX_TUNNEL_VISION_TTL_S=86400
# DETERMINEX_CHRONO_DB=
# DETERMINEX_CHRONO_DAEMON_INTERVAL_S=120
# DETERMINEX_N_PREFIX=                # corpus-generation prefix override

# ── Timeouts (override defaults for slow RunPod boxes / large models) ─────────
# DETERMINEX_GGUF_MAX_WAIT_S=7200     # 2h cap on remote GGUF conversion polling
# DETERMINEX_ROSETTA_MAX_WAIT_S=14400 # 4h cap on remote Rosetta training polling

# ── Benchmark monitoring ──────────────────────────────────────────────────────
BENCHMARK_CHECK_INTERVAL_HOURS=6
BENCHMARK_SOURCE=artificialanalysis

# ── RunPod (set before running runpod/ scripts or tonight_launch.*) ──────────
# RUNPOD_HOST=your.pod.ip.address
# RUNPOD_PORT=22
# RUNPOD_KEY=~/.ssh/id_runpod

# ── HuggingFace (required for training runs) ──────────────────────────────────
# HF_TOKEN=hf_...

# ── Telemetry / outcome sharing (off by default) ──────────────────────────────
# DETERMINEX_SHARE_OUTCOMES=1         # send anonymized solve/fail signals (no code)

# ── DataHub Context Platform ──────────────────────────────────────────────────
# DATAHUB_GQL_URL=http://localhost:8080/api/graphql
# DATAHUB_PAT=
# DATAHUB_MOCK_MODE=0

# ── Credential aliases ────────────────────────────────────────────────────────
# The same token often has more than one conventional name, and a mismatch is
# SILENT: the provider just reports itself unavailable and the model is skipped.
# scripts/determinex_providers.py fills the canonical name from any of these, and
# never overwrites one you set explicitly.
#   HUGGINGFACE_API_KEY  <- HF_TOKEN, HUGGINGFACE_TOKEN, HUGGING_FACE_HUB_TOKEN
#   OPENAI_API_KEY       <- OPENAI_KEY
#   ANTHROPIC_API_KEY    <- CLAUDE_API_KEY
#   GEMINI_API_KEY       <- GOOGLE_API_KEY, GOOGLE_GENAI_API_KEY
#   GITHUB_TOKEN         <- GH_TOKEN

# ── Adding a model this build does not know about ─────────────────────────────
# Do it in the IDE (model picker -> "Add a model"): give it a model id and, for a
# provider we have never heard of, an OpenAI-compatible base URL. Entries live in
# models_registry.json in the app data dir and are picked up by the engine at
# import. Store the API key HERE and reference it by NAME in that form -- never
# paste a key into the registry, which is plain JSON on disk.
# DETERMINEX_MODELS_REGISTRY=              # override the registry path (testing)
