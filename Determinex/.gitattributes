# verify.sh and demo_run.sh are the two things a judge is invited to run, so their line
# endings are not a style preference. A shell script stored with CRLF dies on Linux and macOS
# with "bad interpreter: /usr/bin/env bash^M" - the script would fail before executing a single
# check, on the exact machines it exists to run on. Pin LF regardless of the committer's
# core.autocrlf.
*.sh text eol=lf
