# 2SOE - environment variables. Copy to .env before `docker compose up`.

# Token for direct workflow execution (required by the measurement bench).
# Generate with: openssl rand -hex 24
EXEC_TOKEN=

# Database (decision journal + user accounts)
PG_PASSWORD=changeme_2sin

# Signing secret for session tokens
JWT_SECRET=dev_secret_change_in_prod

# Model served by vLLM (interchangeable: the core does not depend on it)
VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
VLLM_URL=http://vllm:8000/v1/chat/completions

# Output formats for generated documents
FORMATS_ACTE=docx,pdf

# Debug traces (0 = off; they expose business data - development only)
TRACE_PROMPT=0
TRACE_PRIMITIVES=0

# --- OPTIONAL: official French legal channel (Legifrance) ---
# Absent, the system runs on its local verified corpus.
# To enable, create secrets/openlegi.env with your own token:
#   OPENLEGI_TOKEN=your_token

# --- HARDWARE / INFERENCE ---
# Defaults match the validated configuration: 2x Radeon AI PRO R9700 (gfx1201).
# Public image, credits: github.com/kyuz0/amd-r9700-vllm-toolboxes
VLLM_IMAGE=docker.io/kyuz0/vllm-therock-gfx1201:latest

# Number of GPUs (tensor parallelism). Set to 1 for a single GPU.
VLLM_TP=2

# ROCm architecture of the target GPU (gfx1201 = R9700).
ROCM_ARCH=gfx1201

# Generation budget for extracting document variables.
# A model that answers directly (Mistral): 300 is enough.
# A reasoning model (gpt-oss): 900, otherwise it is cut off before answering.
EXTRACT_MAX_TOKENS=900
