FROM python:3.12-slim
# LibreOffice Writer, sans interface : la conversion docx -> pdf passait par le
# conteneur Hermes, seul a le detenir. Le PDF n'est JAMAIS fabrique a la main --
# il derive du docx bien forme, seule methode qui preserve mise en page et
# accents.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates \
        libreoffice-writer-nogui libreoffice-core-nogui \
        fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
WORKDIR /opt/2sin-stack/relay
EXPOSE 8787
CMD ["python3", "/opt/2sin-stack/relay/2sin-relay.py"]
