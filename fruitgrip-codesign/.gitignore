# --- Generated artifacts (eval results, videos, scripted-demo frames) ---
outputs/

# Auto-generated per-design gripper MJCF cache (regenerated on demand by
# gripper_gen.py for every candidate a search/eval touches -- hundreds of
# files, not meant to be committed; see gripper_gen.clear_cache()).
assets/robots/franka/generated/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.ipynb_checkpoints/

# --- Credentials / secrets -- never commit these ---
*.pem
*id_ed25519*
*id_rsa*
.ssh/
**/api_key*
**/*token*
.env
*.env

# Cached third-party vendor sources for scripts/build_artifact_demo.py --
# re-fetched from unpkg on demand, not meant to be committed.
scripts/.artifact_vendor_cache/

# --- Tooling / OS / editor ---
.DS_Store
.vscode/
.idea/
*.swp
MUJOCO_LOG.TXT

# Stray debug renders occasionally written next to the code (or at repo root
# by ad-hoc smoke tests).
franka_fruit_pick/**/*.png
/world_cam.png
/wrist_cam.png

# Large binary demo output -- link from demo/video_link.md instead of
# committing, unless small enough to check in directly.
*.mp4
*.mov

# NOTE: assets/ and datasets/ are intentionally NOT ignored (beyond the
# generated/ cache above) -- they are bundled so the demo runs out of the box.
# They hold large binaries; if you push them to GitHub, use git-lfs
# (https://git-lfs.com/) or host them separately and document the download step.

# Stray one-off MuJoCo scene-builder test artifact (bakes in absolute local paths).
franka_fruit_pick/codesign/mujoco_repl/generated/
