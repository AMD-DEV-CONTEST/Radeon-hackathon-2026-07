{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radeon-hackathon/track2/dsl/strategy-schema.json",
  "title": "Crypto Trading Strategy DSL",
  "description": "YAML-based strategy specification generated by LLM, validated before transpilation to Freqtrade IStrategy",
  "type": "object",
  "required": ["strategy"],
  "properties": {
    "strategy": {
      "type": "object",
      "required": ["name", "market", "indicators", "entry", "exit", "risk"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "description": "Strategy class name (valid Python identifier)"
        },
        "market": {
          "type": "object",
          "required": ["exchange", "pair", "timeframe"],
          "properties": {
            "exchange": {
              "type": "string",
              "enum": ["binance", "okx", "bybit", "kraken", "gate"]
            },
            "pair": {
              "type": "string",
              "pattern": "^[A-Z]+/[A-Z]+$",
              "description": "Trading pair, e.g. BTC/USDT"
            },
            "timeframe": {
              "type": "string",
              "enum": ["1m", "5m", "15m", "30m", "1h", "4h", "1d", "1w"]
            }
          }
        },
        "indicators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "type", "params"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "description": "Variable name for the indicator (snake_case)"
              },
              "type": {
                "type": "string",
                "enum": [
                  "SMA", "EMA", "RSI", "MACD", "ATR", "BollingerBands",
                  "Stochastic", "ADX", "CCI", "OBV", "VWAP", "WMA",
                  "HMA", "ZLEMA", "Supertrend", "ICHIMOKU"
                ],
                "description": "Indicator type"
              },
              "params": {
                "type": "object",
                "properties": {
                  "period": { "type": "integer", "minimum": 1, "maximum": 500 },
                  "field": {
                    "type": "string",
                    "enum": ["open", "high", "low", "close", "volume"],
                    "default": "close"
                  },
                  "fast_period": { "type": "integer", "minimum": 1 },
                  "slow_period": { "type": "integer", "minimum": 1 },
                  "signal_period": { "type": "integer", "minimum": 1 },
                  "std_dev": { "type": "number", "minimum": 0.1, "default": 2.0 },
                  "multiplier": { "type": "number", "minimum": 0.1 }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "entry": {
          "type": "object",
          "required": ["long"],
          "properties": {
            "long": {
              "type": ["string", "null"],
              "description": "Boolean expression for long entry signal, or null"
            },
            "short": {
              "type": ["string", "null"],
              "description": "Boolean expression for short entry signal, or null",
              "default": null
            }
          },
          "additionalProperties": false
        },
        "exit": {
          "type": "object",
          "properties": {
            "long": {
              "type": ["string", "null"],
              "description": "Boolean expression for long exit signal, or null",
              "default": null
            },
            "short": {
              "type": ["string", "null"],
              "description": "Boolean expression for short exit signal, or null",
              "default": null
            }
          },
          "additionalProperties": false
        },
        "risk": {
          "type": "object",
          "required": ["stop_loss", "max_open_trades", "stake_amount"],
          "properties": {
            "stop_loss": {
              "type": "number",
              "minimum": -0.5,
              "maximum": 0,
              "description": "Stop loss as negative ratio, e.g. -0.03 = 3% loss"
            },
            "take_profit": {
              "type": "number",
              "minimum": 0,
              "description": "Take profit ratio, e.g. 0.06 = 6% gain"
            },
            "trailing_stop": { "type": "boolean", "default": false },
            "trailing_stop_positive": {
              "type": "number",
              "minimum": 0,
              "default": 0.0,
              "description": "Trailing stop offset when in profit"
            },
            "trailing_stop_positive_offset": {
              "type": "number",
              "minimum": 0,
              "default": 0.0
            },
            "max_open_trades": { "type": "integer", "minimum": 1, "maximum": 20 },
            "stake_amount": {
              "type": ["number", "string"],
              "description": "Position size (number) or 'unlimited'",
              "default": 0.1
            },
            "time_in_trade": {
              "type": "object",
              "properties": {
                "max_minutes": { "type": "integer", "minimum": 1 },
                "max_hours": { "type": "integer", "minimum": 1 },
                "max_days": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
