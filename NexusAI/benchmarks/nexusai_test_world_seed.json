  "source_chunks": [
    {
      "id": "0ac74435-f071-440b-bba3-cd94c1ba4fa4",
      "source_id": "6d2df795-7f40-496d-af7b-180a2b168c4a",
      "world_id": "5b52e514-a87a-4225-888d-89d02678732d",
      "chunk_index": 0,
      "text": "NexusAI Test World Aria is a researcher living in Kochi. Aria works with a software engineer named Noah. Together, Aria and Noah created a project called NexusAI. NexusAI is an intelligent platform designed to transform documents into structured knowledge. The project contains a system called MemoryWeaver, which organizes memories and personal events. It also contains WorldForge, which represents characters, places, and relationships as a knowledge graph. On July 10, 2026, Aria visited the Nexus Research Lab in Bengaluru. During the visit, she met Dr. Maya Rao, the director of the laboratory. Maya introduced Aria to a prototype AI system called Aurora. Aurora is connected to NexusAI. Noah maintains the NexusAI backend. Aria leads the research team. Maya advises the NexusAI project. The Nexus Research Lab is located in Bengaluru. Aria lives in Kochi. Noah frequently travels between Kochi and Bengaluru. This document is intended to test the NexusAI Universal Ingestion Engine.",
      "metadata": "{}"
    },
    {
      "id": "d3b55a9c-aa86-4781-9686-23d916461170",
      "source_id": "4d403715-d963-4109-8232-e3d49b895def",
