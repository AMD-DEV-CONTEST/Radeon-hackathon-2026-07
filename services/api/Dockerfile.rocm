# ROCm 版后端镜像
# 用法：docker build -f services/api/Dockerfile.rocm -t 3dgenerateflow-api-rocm .
FROM rocm/pytorch:rocm6.0_ubuntu22.04_py3.10_pytorch_2.3.1

WORKDIR /app

# 系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libsm6 libxext6 libxrender-dev libgomp1 \
    libgl1-mesa-glx libgl1-mesa-dev \
    git wget curl \
    && rm -rf /var/lib/apt/lists/*

# 安装 Python 依赖（torch 已在 base image 中）
COPY services/api/requirements-rocm.txt ./requirements-rocm.txt
RUN pip install --no-cache-dir -r requirements-rocm.txt

# 复制代码
COPY services/api /app
COPY shared /app/shared

ENV PYTHONPATH=/app
ENV HIP_VISIBLE_DEVICES=0

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
