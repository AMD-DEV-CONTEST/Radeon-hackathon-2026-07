+}
+
+void BackgroundCaptureService::MediaUploaderTask(bool audio) {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE && CONFIG_BACKGROUND_CAPTURE_AUDIO_ENABLE
+    const char* media_name = audio ? "audio" : "photo";
+    uint32_t& failures = audio ? audio_upload_failures_ : photo_upload_failures_;
+    bool& retry_needed = audio ? audio_retry_needed_ : photo_retry_needed_;
+    ESP_LOGI(TAG, "SD %s uploader task started", media_name);
+    while (running_.load()) {
+        if (media_upload_auth_failed_.load()) {
+            vTaskDelay(pdMS_TO_TICKS(1000));
+            continue;
+        }
+
+        retry_needed = false;
+        bool progressed = false;
+        if (audio) {
+            progressed = UploadNextAudioFileFromSd();
+        } else if (photo_batch_mode_) {
+            progressed = UploadNextPhotoBatchFromSd();
+        } else {
+            progressed = UploadNextPhotoFileFromSd();
+        }
+        if (!audio && !photo_batch_mode_ &&
+            concurrent_http_failures_.load() >= kConcurrentHttpFailuresBeforeBatch) {
+            photo_batch_mode_ = true;
+            photo_batch_healthy_uploads_ = 0;
+            photo_batch_wait_started_us_ = 0;
+            photo_batch_waiting_count_ = 0;
+            concurrent_http_failures_.store(0);
+            concurrent_http_healthy_uploads_.store(0);
+            failures = 0;
+            ESP_LOGW(TAG,
+                     "Switch photo uploader to batches of %u after concurrent HTTP failures",
+                     static_cast<unsigned>(kPhotoUploadBatchSize));
+        }
+        if (retry_needed) {
+            failures++;
+            static constexpr uint32_t kRetryBackoffMs[] = {
+                1000, 2000, 4000, 8000, 15000,
+            };
+            const size_t retry_index = std::min<size_t>(
+                failures - 1, sizeof(kRetryBackoffMs) / sizeof(kRetryBackoffMs[0]) - 1);
+            const uint32_t base_ms = kRetryBackoffMs[retry_index];
+            const uint32_t jitter_ms = esp_random() % std::max<uint32_t>(1, base_ms / 5);
+            ESP_LOGW(TAG, "SD %s upload retry in %u ms, failures=%u", media_name,
+                     static_cast<unsigned>(base_ms + jitter_ms),
+                     static_cast<unsigned>(failures));
+            vTaskDelay(pdMS_TO_TICKS(base_ms + jitter_ms));
+        } else if (progressed) {
+            failures = 0;
+            taskYIELD();
+        } else {
+            failures = 0;
+            vTaskDelay(pdMS_TO_TICKS(500));
+        }
+    }
+    ESP_LOGI(TAG, "SD %s uploader task stopped", media_name);
+#else
+    (void)audio;
+#endif
+}
