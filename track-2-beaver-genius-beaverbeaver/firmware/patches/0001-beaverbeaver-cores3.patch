+uint32_t BackgroundCaptureService::GetFailureDelayMs() const {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE
+    const uint32_t base_delay_ms = CONFIG_BACKGROUND_CAPTURE_RETRY_INTERVAL_MS;
+    const uint32_t max_delay_ms = CONFIG_BACKGROUND_CAPTURE_MAX_BACKOFF_MS;
+    const uint32_t shift = std::min<uint32_t>(consecutive_failures_ - 1, 4);
+    return std::min<uint32_t>(base_delay_ms << shift, max_delay_ms);
+#else
+    return 0;
+#endif
+}
+
+bool BackgroundCaptureService::UploadFile(
+    const std::string& url, const std::string& filename, const std::string& content_type,
+    const std::string& data, const std::vector<std::pair<std::string, std::string>>& fields) {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE
+#if CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_ENABLE
+    (void)url;
+    (void)filename;
+    return UploadBeaverFile(content_type, data, fields);
+#endif
+    if (url.empty()) {
+        ESP_LOGI(TAG, "Captured background file %s: %u bytes", filename.c_str(),
+                 static_cast<unsigned>(data.size()));
+        return true;
+    }
+
+    auto network = Board::GetInstance().GetNetwork();
+    if (network == nullptr) {
+        ESP_LOGW(TAG, "No network available for background upload");
+        return false;
+    }
+
+    const std::string boundary = "----XIAOZHI_BACKGROUND_CAPTURE_BOUNDARY";
+    auto http = network->CreateHttp(3);
+    const uint32_t upload_timeout_ms = GetMediaUploadTimeoutMs(content_type);
+    http->SetTimeout(upload_timeout_ms);
+    http->SetKeepAlive(false);
+    http->SetHeader("Content-Type", "multipart/form-data; boundary=" + boundary);
+
+    std::vector<std::string> field_parts;
+    field_parts.reserve(fields.size());
+    size_t content_length = data.size();
+    for (const auto& field : fields) {
+        std::string field_part;
+        field_part += "--" + boundary + "\r\n";
+        field_part += "Content-Disposition: form-data; name=\"" + field.first + "\"\r\n\r\n";
+        field_part += field.second + "\r\n";
+        content_length += field_part.size();
+        field_parts.emplace_back(std::move(field_part));
+    }
+
+    std::string file_header;
+    file_header += "--" + boundary + "\r\n";
+    file_header +=
+        "Content-Disposition: form-data; name=\"file\"; filename=\"" + filename + "\"\r\n";
+    file_header += "Content-Type: " + content_type + "\r\n\r\n";
+
+    std::string footer;
+    footer += "\r\n--" + boundary + "--\r\n";
+
+    content_length += file_header.size() + footer.size();
+    http->SetHeader("Content-Length", std::to_string(content_length));
+
+    ESP_LOGI(TAG, "Upload background file %s: file=%u content_length=%u timeout=%u url=%s",
+             filename.c_str(), static_cast<unsigned>(data.size()),
+             static_cast<unsigned>(content_length),
+             static_cast<unsigned>(CONFIG_BACKGROUND_CAPTURE_UPLOAD_TIMEOUT_MS), url.c_str());
+
+    if (!http->Open("POST", url)) {
+        ESP_LOGW(TAG, "Failed to open background upload URL: %s", url.c_str());
+        return false;
+    }
+
+    auto write_part = [&http](const char* buffer, size_t size) -> bool {
+        if (size == 0) {
+            return true;
+        }
+        return http->Write(buffer, size) == static_cast<int>(size);
+    };
+
+    for (const auto& field_part : field_parts) {
+        if (!write_part(field_part.c_str(), field_part.size())) {
+            ESP_LOGW(TAG, "Background upload failed while sending field");
+            http->Close();
+            return false;
+        }
+    }
+    if (!write_part(file_header.c_str(), file_header.size()) ||
+        !write_part(data.data(), data.size()) || !write_part(footer.c_str(), footer.size())) {
+        ESP_LOGW(TAG, "Background upload failed while sending file body");
+        http->Close();
+        return false;
+    }
+
+    const int status_code = http->GetStatusCode();
+    http->Close();
+
+    if (status_code < 200 || status_code >= 300) {
+        ESP_LOGW(TAG, "Background upload failed, status=%d", status_code);
+        return false;
+    }
+
+    ESP_LOGI(TAG, "Uploaded background file %s: %u bytes content_length=%u", filename.c_str(),
+             static_cast<unsigned>(data.size()), static_cast<unsigned>(content_length));
+    return true;
+#else
+    (void)url;
+    (void)filename;
+    (void)content_type;
+    (void)data;
+    (void)fields;
+    return false;
+#endif
+}
+
+bool BackgroundCaptureService::UploadBeaverFile(
+    const std::string& content_type, const std::string& data,
+    const std::vector<std::pair<std::string, std::string>>& fields, int* response_status) {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE && CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_ENABLE
+    if (response_status != nullptr) {
+        *response_status = 0;
+    }
+    if (data.empty() || device_id_.empty() || boot_id_.empty() || audio_stream_id_.empty() ||
+        photo_stream_id_.empty()) {
+        return false;
+    }
+
+    std::string base_url = CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_GATEWAY_URL;
+    while (!base_url.empty() && base_url.back() == '/') {
+        base_url.pop_back();
+    }
+    const std::string url = base_url + "/api/v1/media/upload";
+    const bool is_audio = content_type == "audio/wav";
+
+    auto network = Board::GetInstance().GetNetwork();
+    if (network == nullptr) {
+        ESP_LOGW(TAG, "No network available for Beaver Memory upload");
+        return false;
+    }
+    ActiveUploadGuard upload_guard(active_media_uploads_, media_upload_overlap_epoch_);
+
+    // Audio and photo use distinct connection IDs so modem-backed NetworkInterface
+    // implementations do not alias two simultaneous transports. EspNetwork ignores the ID but
+    // still creates independent TCP clients.
+    auto http = network->CreateHttp(is_audio ? 3 : 4);
+    const uint32_t upload_timeout_ms = GetMediaUploadTimeoutMs(content_type);
+    http->SetTimeout(upload_timeout_ms);
+    http->SetKeepAlive(false);
+    const std::string authorization =
+        "Bearer " + std::string(CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_DEVICE_TOKEN);
+    http->SetHeader("Authorization", authorization);
+    http->SetHeader("Content-Type", "application/octet-stream");
+    http->SetHeader("Content-Length", std::to_string(data.size()));
+    std::string upload_device_id = device_id_;
+    std::string upload_boot_id = boot_id_;
+    std::string upload_stream_id = is_audio ? audio_stream_id_ : photo_stream_id_;
+    GetUploadField(fields, "device_id", upload_device_id);
+    GetUploadField(fields, "boot_id", upload_boot_id);
+    GetUploadField(fields, "stream_id", upload_stream_id);
+    http->SetHeader("X-Device-Id", upload_device_id);
+    http->SetHeader("X-Stream-Id", upload_stream_id);
+
+    std::string sequence = "0";
+    GetUploadField(fields, "sequence", sequence);
+    http->SetHeader("X-Sequence", sequence);
+
+    int64_t monotonic_ms = esp_timer_get_time() / 1000;
+    GetUploadFieldInt64(fields, "record_start_uptime_ms", monotonic_ms);
+    const int64_t now_monotonic_ms = esp_timer_get_time() / 1000;
+    if (monotonic_ms < 0 ||
+        (upload_boot_id == boot_id_ && monotonic_ms > now_monotonic_ms)) {
+        const std::string invalid_monotonic = std::to_string(monotonic_ms);
+        const std::string current_monotonic = std::to_string(now_monotonic_ms);
+        ESP_LOGW(TAG,
+                 "Reject invalid Beaver Memory monotonic timestamp: value=%s now=%s; "
+                 "using current clock",
+                 invalid_monotonic.c_str(), current_monotonic.c_str());
+        monotonic_ms = now_monotonic_ms;
+    }
+    http->SetHeader("X-Monotonic-Ms", std::to_string(monotonic_ms));
+
+    int64_t captured_at_ms = 0;
+    std::string clock_synced = "0";
+    GetUploadField(fields, "clock_synced", clock_synced);
+    if (clock_synced == "1" &&
+        GetUploadFieldInt64(fields, "captured_at_ms", captured_at_ms) && captured_at_ms > 0) {
+        http->SetHeader("X-Captured-At-Ms", std::to_string(captured_at_ms));
+    }
+
+    std::string sha256;
+    std::string duration_ms;
+    std::string filename;
+    std::string media_type;
+    if (GetUploadField(fields, "sha256", sha256) && !sha256.empty()) {
+        http->SetHeader("X-Content-Sha256", sha256);
+    }
+    http->SetHeader("X-Clock-Synced", clock_synced == "1" ? "true" : "false");
+    if (GetUploadField(fields, "duration_ms", duration_ms)) {
+        http->SetHeader("X-Duration-Ms", duration_ms);
+    }
+    if (GetUploadField(fields, "filename", filename) && !filename.empty()) {
+        http->SetHeader("X-Filename", filename);
+    }
+    if (GetUploadField(fields, "media_type", media_type) && !media_type.empty()) {
+        http->SetHeader("X-Media-Type", media_type);
+    }
+    http->SetHeader("X-Boot-Id", upload_boot_id);
+    http->SetHeader("X-Content-Length", std::to_string(data.size()));
+
+    ESP_LOGI(TAG, "Upload Beaver Memory %s: sequence=%s bytes=%u timeout_ms=%u url=%s",
+             is_audio ? "audio" : "photo", sequence.c_str(),
+             static_cast<unsigned>(data.size()), static_cast<unsigned>(upload_timeout_ms),
+             url.c_str());
+    if (!http->Open("POST", url)) {
+        ESP_LOGW(TAG, "Failed to open Beaver Memory endpoint: %s", url.c_str());
+        if (upload_guard.overlapped()) {
+            RecordConcurrentHttpFailure(concurrent_http_failures_,
+                                        concurrent_http_healthy_uploads_);
+        }
+        return false;
+    }
+    const int written = http->Write(data.data(), data.size());
+    int status_code = 0;
+    bool response_complete = false;
+    std::string response_body;
+    if (written == static_cast<int>(data.size())) {
+        status_code = http->GetStatusCode();
+        if (status_code > 0) {
+            const size_t expected_response_bytes = http->GetBodyLength();
+            response_body = http->ReadAll();
+            response_complete =
+                expected_response_bytes == 0 || response_body.size() == expected_response_bytes;
+            if (!response_complete) {
+                ESP_LOGW(TAG,
+                         "Incomplete Beaver Memory %s response: expected=%u received=%u",
+                         is_audio ? "audio" : "photo",
+                         static_cast<unsigned>(expected_response_bytes),
+                         static_cast<unsigned>(response_body.size()));
+            }
+        }
+    }
+    http->Close();
+    if (response_status != nullptr) {
+        *response_status = status_code;
+    }
+    if (status_code == 401) {
+        media_upload_auth_failed_.store(true);
+    }
+    // If the peer closed the socket, ReadAll() synchronized with its disconnect callback. Give
+    // the TCP receive task one scheduling point to publish its exit before HttpClient destruction.
+    vTaskDelay(1);
+    bool semantic_ack = false;
+    std::string ack_status;
+    if (!response_body.empty()) {
+        cJSON* ack = cJSON_Parse(response_body.c_str());
+        if (ack != nullptr) {
+            cJSON* status = cJSON_GetObjectItem(ack, "status");
+            if (cJSON_IsString(status) && status->valuestring != nullptr) {
+                ack_status = status->valuestring;
+                semantic_ack = (status_code == 201 && ack_status == "accepted") ||
+                               (status_code == 200 && ack_status == "already_accepted");
+            }
+            cJSON_Delete(ack);
+        }
+    }
+    if (written != static_cast<int>(data.size()) || !response_complete || !semantic_ack) {
+        ESP_LOGW(TAG,
+                 "Beaver Memory %s upload failed: written=%d status=%d "
+                 "response_complete=%d ack=%s",
+                 is_audio ? "audio" : "photo", written, status_code,
+                 response_complete ? 1 : 0,
+                 ack_status.empty() ? "missing-or-invalid" : ack_status.c_str());
+        if (upload_guard.overlapped()) {
+            RecordConcurrentHttpFailure(concurrent_http_failures_,
+                                        concurrent_http_healthy_uploads_);
+        }
+        return false;
+    }
+    if (upload_guard.overlapped()) {
+        RecordConcurrentHttpSuccess(concurrent_http_failures_,
+                                    concurrent_http_healthy_uploads_);
+    }
+    if (is_audio && upload_boot_id == boot_id_ && upload_stream_id == audio_stream_id_) {
+        audio_stream_active_.store(true);
+    }
+    ESP_LOGI(TAG, "Beaver Memory %s accepted: status=%d ack=%s response_bytes=%u",
+             is_audio ? "audio" : "photo", status_code,
+             ack_status.c_str(),
+             static_cast<unsigned>(response_body.size()));
+    return true;
+#else
+    (void)content_type;
+    (void)data;
+    (void)fields;
+    (void)response_status;
+    return false;
+#endif
+}
+
+bool BackgroundCaptureService::UploadBeaverPhotoBatch(
+    const std::vector<PhotoBatchUploadItem>& items,
+    std::vector<PhotoBatchAck>& acknowledgements, int* response_status) {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE && CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_ENABLE
+    acknowledgements.clear();
+    if (response_status != nullptr) {
+        *response_status = 0;
+    }
+    if (items.empty() || items.size() > kPhotoUploadBatchSize) {
+        return false;
+    }
+
+    std::string upload_device_id;
+    std::string upload_boot_id;
+    std::string upload_stream_id;
+    cJSON* manifest_root = cJSON_CreateObject();
+    cJSON_AddNumberToObject(manifest_root, "version", 1);
+    cJSON* manifest_items = cJSON_AddArrayToObject(manifest_root, "items");
+    size_t media_bytes = 0;
+    bool manifest_ok = manifest_root != nullptr && manifest_items != nullptr;
+    for (const auto& item : items) {
+        std::string item_device_id;
+        std::string item_boot_id;
+        std::string item_stream_id;
+        std::string filename;
+        std::string media_type;
+        std::string sha256;
+        std::string clock_synced;
+        int64_t monotonic_ms = 0;
+        int64_t captured_at_ms = 0;
+        int64_t duration_ms = 0;
+        manifest_ok = manifest_ok &&
+                      GetUploadField(item.fields, "device_id", item_device_id) &&
+                      GetUploadField(item.fields, "boot_id", item_boot_id) &&
+                      GetUploadField(item.fields, "stream_id", item_stream_id) &&
+                      GetUploadField(item.fields, "filename", filename) &&
+                      GetUploadField(item.fields, "media_type", media_type) &&
+                      GetUploadField(item.fields, "sha256", sha256) &&
+                      GetUploadField(item.fields, "clock_synced", clock_synced) &&
+                      GetUploadFieldInt64(item.fields, "record_start_uptime_ms", monotonic_ms) &&
+                      GetUploadFieldInt64(item.fields, "duration_ms", duration_ms);
+        GetUploadFieldInt64(item.fields, "captured_at_ms", captured_at_ms);
+        if (!manifest_ok || media_type != "image/jpeg") {
+            break;
+        }
+        if (upload_device_id.empty()) {
+            upload_device_id = item_device_id;
+            upload_boot_id = item_boot_id;
+            upload_stream_id = item_stream_id;
+        } else if (item_device_id != upload_device_id || item_boot_id != upload_boot_id ||
+                   item_stream_id != upload_stream_id) {
+            manifest_ok = false;
+            break;
+        }
+
+        cJSON* json_item = cJSON_CreateObject();
+        cJSON_AddNumberToObject(json_item, "sequence", static_cast<double>(item.sequence));
+        if (clock_synced == "1" && captured_at_ms > 0) {
+            cJSON_AddNumberToObject(json_item, "captured_at_ms",
+                                    static_cast<double>(captured_at_ms));
+        } else {
+            cJSON_AddNullToObject(json_item, "captured_at_ms");
+        }
+        cJSON_AddNumberToObject(json_item, "monotonic_ms", static_cast<double>(monotonic_ms));
+        cJSON_AddBoolToObject(json_item, "clock_synced", clock_synced == "1");
+        cJSON_AddNumberToObject(json_item, "duration_ms", static_cast<double>(duration_ms));
+        cJSON_AddStringToObject(json_item, "filename", filename.c_str());
+        cJSON_AddStringToObject(json_item, "media_type", media_type.c_str());
+        cJSON_AddNumberToObject(json_item, "content_length",
+                                static_cast<double>(item.content_length));
+        cJSON_AddStringToObject(json_item, "sha256", sha256.c_str());
+        cJSON_AddItemToArray(manifest_items, json_item);
+        media_bytes += item.content_length;
+    }
+    const std::string manifest = manifest_ok ? JsonToString(manifest_root) : std::string();
+    cJSON_Delete(manifest_root);
+    if (manifest.empty() || manifest.size() > UINT32_MAX) {
+        return false;
+    }
+
+    std::string prefix(8, '\0');
+    prefix.replace(0, 4, "BMB1", 4);
+    SetU32(prefix, 4, static_cast<uint32_t>(manifest.size()));
+    const size_t content_length = prefix.size() + manifest.size() + media_bytes;
+
+    auto network = Board::GetInstance().GetNetwork();
+    if (network == nullptr) {
+        return false;
+    }
+    ActiveUploadGuard upload_guard(active_media_uploads_, media_upload_overlap_epoch_);
+    std::string base_url = CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_GATEWAY_URL;
+    while (!base_url.empty() && base_url.back() == '/') {
+        base_url.pop_back();
+    }
+    const std::string url = base_url + "/api/v1/media/upload-batch";
+    auto http = network->CreateHttp(4);
+    const uint32_t upload_timeout_ms = GetMediaUploadTimeoutMs("image/jpeg");
+    http->SetTimeout(upload_timeout_ms);
+    http->SetKeepAlive(false);
+    http->SetHeader(
+        "Authorization",
+        "Bearer " + std::string(CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_DEVICE_TOKEN));
+    http->SetHeader("Content-Type", "application/vnd.beaver.media-batch");
+    http->SetHeader("Content-Length", std::to_string(content_length));
+    http->SetHeader("X-Device-Id", upload_device_id);
+    http->SetHeader("X-Boot-Id", upload_boot_id);
+    http->SetHeader("X-Stream-Id", upload_stream_id);
+    http->SetHeader("X-Batch-Count", std::to_string(items.size()));
+    http->SetHeader("X-Batch-Content-Length", std::to_string(content_length));
+
+    ESP_LOGI(TAG, "Upload Beaver Memory photo batch: items=%u bytes=%u timeout_ms=%u",
+             static_cast<unsigned>(items.size()), static_cast<unsigned>(content_length),
+             static_cast<unsigned>(upload_timeout_ms));
+    if (!http->Open("POST", url)) {
+        if (upload_guard.overlapped()) {
+            RecordConcurrentHttpFailure(concurrent_http_failures_,
+                                        concurrent_http_healthy_uploads_);
+        }
+        return false;
+    }
+
+    bool write_ok = http->Write(prefix.data(), prefix.size()) == static_cast<int>(prefix.size()) &&
+                    http->Write(manifest.data(), manifest.size()) ==
+                        static_cast<int>(manifest.size());
+    for (const auto& item : items) {
+        if (!write_ok) {
+            break;
+        }
+        FILE* file = nullptr;
+        while (running_.load() && file == nullptr) {
+            SdSpiAccessGuard sd_guard;
+            if (sd_guard.ok()) {
+                file = fopen(item.path.c_str(), "rb");
+                if (file == nullptr) {
+                    write_ok = false;
+                    break;
+                }
+            } else {
+                vTaskDelay(1);
+            }
+        }
+        std::vector<char> chunk(std::min(kPhotoUploadChunkBytes, item.content_length));
+        size_t remaining = item.content_length;
+        while (write_ok && running_.load() && remaining > 0) {
+            const size_t requested = std::min(chunk.size(), remaining);
+            size_t read_size = 0;
+            bool read_attempted = false;
+            while (running_.load() && !read_attempted) {
+                SdSpiAccessGuard sd_guard;
+                if (sd_guard.ok()) {
+                    read_size = fread(chunk.data(), 1, requested, file);
+                    read_attempted = true;
+                } else {
+                    vTaskDelay(1);
+                }
+            }
+            if (!read_attempted || read_size != requested ||
+                http->Write(chunk.data(), read_size) != static_cast<int>(read_size)) {
+                write_ok = false;
+                break;
+            }
+            remaining -= read_size;
+        }
+        bool closed = file == nullptr;
+        while (running_.load() && !closed) {
+            SdSpiAccessGuard sd_guard;
+            if (sd_guard.ok()) {
+                const int close_result = fclose(file);
+                closed = true;
+                write_ok = write_ok && close_result == 0;
+            } else {
+                vTaskDelay(1);
+            }
+        }
+        write_ok = write_ok && remaining == 0 && closed;
+    }
+
+    int status_code = 0;
+    bool response_complete = false;
+    std::string response_body;
+    if (write_ok) {
+        status_code = http->GetStatusCode();
+        if (status_code > 0) {
+            const size_t expected_response_bytes = http->GetBodyLength();
+            response_body = http->ReadAll();
+            response_complete =
+                expected_response_bytes == 0 || response_body.size() == expected_response_bytes;
+        }
+    }
+    http->Close();
+    vTaskDelay(1);
+    if (response_status != nullptr) {
+        *response_status = status_code;
+    }
+    if (status_code == 401) {
+        media_upload_auth_failed_.store(true);
+    }
+
+    bool semantic_ack = false;
+    if (write_ok && response_complete && (status_code == 200 || status_code == 207) &&
+        !response_body.empty()) {
+        cJSON* response = cJSON_Parse(response_body.c_str());
+        cJSON* response_items =
+            response == nullptr ? nullptr : cJSON_GetObjectItem(response, "items");
+        if (cJSON_IsArray(response_items)) {
+            cJSON* response_item = nullptr;
+            cJSON_ArrayForEach(response_item, response_items) {
+                cJSON* sequence = cJSON_GetObjectItem(response_item, "sequence");
+                cJSON* item_status = cJSON_GetObjectItem(response_item, "status");
+                cJSON* retry = cJSON_GetObjectItem(response_item, "retry");
+                if (!cJSON_IsNumber(sequence) || !cJSON_IsString(item_status) ||
+                    item_status->valuestring == nullptr) {
+                    continue;
+                }
+                PhotoBatchAck ack;
+                ack.sequence = static_cast<uint64_t>(sequence->valuedouble);
+                ack.status = item_status->valuestring;
+                ack.retry = cJSON_IsBool(retry) ? cJSON_IsTrue(retry) : true;
+                acknowledgements.emplace_back(std::move(ack));
+            }
+            semantic_ack = !acknowledgements.empty();
+        }
+        cJSON_Delete(response);
+    }
+    if (!semantic_ack) {
+        if (upload_guard.overlapped()) {
+            RecordConcurrentHttpFailure(concurrent_http_failures_,
+                                        concurrent_http_healthy_uploads_);
+        }
+        ESP_LOGW(TAG,
+                 "Beaver Memory photo batch failed: status=%d write_ok=%d response_complete=%d",
+                 status_code, write_ok ? 1 : 0, response_complete ? 1 : 0);
+        return false;
+    }
+    if (upload_guard.overlapped()) {
+        RecordConcurrentHttpSuccess(concurrent_http_failures_,
+                                    concurrent_http_healthy_uploads_);
+    }
+    ESP_LOGI(TAG, "Beaver Memory photo batch acknowledged: status=%d items=%u", status_code,
+             static_cast<unsigned>(acknowledgements.size()));
+    return true;
+#else
+    (void)items;
+    (void)acknowledgements;
+    (void)response_status;
+    return false;
+#endif
+}
