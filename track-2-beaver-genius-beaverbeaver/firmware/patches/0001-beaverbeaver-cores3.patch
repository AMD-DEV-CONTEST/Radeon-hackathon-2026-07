+void BackgroundCaptureService::PhotoSdUploaderTaskEntry(void* arg) {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE && CONFIG_BACKGROUND_CAPTURE_AUDIO_ENABLE
+    auto* service = static_cast<BackgroundCaptureService*>(arg);
