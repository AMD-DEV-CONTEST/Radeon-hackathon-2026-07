+void PrepareSdSpiBusForMount() {
+#ifdef CONFIG_BOARD_TYPE_M5STACK_CORE_S3
+    // CoreS3 shares GPIO35 between LCD D/C and SD MISO. The LCD driver leaves it
+    // as an output, so switch it back before SDSPI probes the card.
+    gpio_set_direction(GPIO_NUM_35, GPIO_MODE_INPUT);
+    gpio_set_pull_mode(GPIO_NUM_35, GPIO_PULLUP_ONLY);
+    gpio_set_direction(GPIO_NUM_4, GPIO_MODE_OUTPUT);
+    gpio_set_level(GPIO_NUM_4, 1);
+    gpio_set_pull_mode(GPIO_NUM_4, GPIO_PULLUP_ONLY);
+    vTaskDelay(pdMS_TO_TICKS(20));
+#endif
+}
+
+void RestoreLcdSpiBusAfterSd() {
+#ifdef CONFIG_BOARD_TYPE_M5STACK_CORE_S3
+    // Give GPIO35 back to the LCD D/C line after each SD transaction window.
+    gpio_set_pull_mode(GPIO_NUM_35, GPIO_FLOATING);
+    gpio_set_direction(GPIO_NUM_35, GPIO_MODE_OUTPUT);
+#endif
+}
