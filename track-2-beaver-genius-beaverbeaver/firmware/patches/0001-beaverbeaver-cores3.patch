+                                      uint32_t& elapsed_us, uint32_t& buffer_index) {
+    std::lock_guard<std::mutex> lock(frame_mutex_);
+
+    bytes_used = 0;
+    buffer_len = 0;
+    elapsed_us = 0;
+    buffer_index = 0;
+
+    if (encoder_thread_.joinable()) {
+        encoder_thread_.join();
+    }
+
+    if (!streaming_on_ || video_fd_ < 0) {
+        return false;
+    }
+
+    struct v4l2_buffer buf = {};
+    buf.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+    buf.memory = V4L2_MEMORY_MMAP;
+
+    const int64_t start_us = esp_timer_get_time();
+    if (ioctl(video_fd_, VIDIOC_DQBUF, &buf) != 0) {
+        ESP_LOGE(TAG, "Raw test VIDIOC_DQBUF failed");
+        return false;
+    }
+    const int64_t done_us = esp_timer_get_time();
+
+    bytes_used = buf.bytesused;
+    buffer_index = buf.index;
+    if (buf.index < mmap_buffers_.size()) {
+        buffer_len = mmap_buffers_[buf.index].length;
+    }
+    elapsed_us = static_cast<uint32_t>(done_us - start_us);
+
+    if (ioctl(video_fd_, VIDIOC_QBUF, &buf) != 0) {
+        ESP_LOGE(TAG, "Raw test VIDIOC_QBUF failed");
+        return false;
+    }
+
+    return true;
+}
+
+bool EspVideo::CaptureToJpeg(std::string& jpeg_data, bool show_preview) {
+    jpeg_data.clear();
+    ReserveJpegOutputBuffer(jpeg_data);
+    const int64_t start_us = esp_timer_get_time();
+    if (!CaptureFrame(show_preview)) {
+        return false;
+    }
+    const int64_t frame_done_us = esp_timer_get_time();
+
+    std::lock_guard<std::mutex> lock(frame_mutex_);
+    if (frame_.data == nullptr || frame_.len == 0) {
+        return false;
+    }
+
+    uint16_t w = frame_.width ? frame_.width : 320;
+    uint16_t h = frame_.height ? frame_.height : 240;
+    bool ok = image_to_jpeg_cb(
+        frame_.data, frame_.len, w, h, frame_.format, 60,
+        [](void* arg, size_t index, const void* data, size_t len) -> size_t {
+            auto jpeg_data = static_cast<std::string*>(arg);
+            if (data != nullptr && len > 0) {
+                jpeg_data->append(static_cast<const char*>(data), len);
+            }
+            return len;
+        },
+        &jpeg_data);
+    const int64_t encode_done_us = esp_timer_get_time();
+    ESP_LOGI(TAG,
+             "JPEG timing: raw_ms=%u encode_ms=%u total_ms=%u raw_bytes=%u jpeg_bytes=%u "
+             "size=%ux%u ok=%d",
+             static_cast<unsigned>((frame_done_us - start_us) / 1000),
+             static_cast<unsigned>((encode_done_us - frame_done_us) / 1000),
+             static_cast<unsigned>((encode_done_us - start_us) / 1000),
+             static_cast<unsigned>(frame_.len), static_cast<unsigned>(jpeg_data.size()),
+             static_cast<unsigned>(w), static_cast<unsigned>(h), ok ? 1 : 0);
+    return ok;
+}
+
+void EspVideo::ReleaseCaptureResources() {
+    if (encoder_thread_.joinable()) {
+        encoder_thread_.join();
+    }
+
+    std::lock_guard<std::mutex> lock(frame_mutex_);
+    if (frame_.data) {
+        heap_caps_free(frame_.data);
+        frame_.data = nullptr;
+    }
+    frame_.len = 0;
+    // Width and height describe the configured V4L2 output format, not ownership of the
+    // per-frame data buffer. Keep them across captures so subsequent JPEG encodes do not have
+    // to guess a hard-coded resolution after the first frame is released.
+    frame_.format = 0;
+}
