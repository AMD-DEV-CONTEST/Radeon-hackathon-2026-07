+
+void BackgroundCaptureService::RunRecoveryCycle() {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE
+    if (CONFIG_BACKGROUND_CAPTURE_RECOVERY_EVERY_FRAMES <= 0 ||
+        capture_count_ % CONFIG_BACKGROUND_CAPTURE_RECOVERY_EVERY_FRAMES != 0) {
+        return;
+    }
+
+    const size_t free_internal = heap_caps_get_free_size(MALLOC_CAP_INTERNAL);
+    const size_t total_internal = heap_caps_get_total_size(MALLOC_CAP_INTERNAL);
+    const size_t largest_internal = heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL);
+    const size_t free_spiram = heap_caps_get_free_size(MALLOC_CAP_SPIRAM);
+    const size_t total_spiram = heap_caps_get_total_size(MALLOC_CAP_SPIRAM);
+    const size_t largest_spiram = heap_caps_get_largest_free_block(MALLOC_CAP_SPIRAM);
+    const uint32_t internal_free_pct = PercentTimes10(free_internal, total_internal);
+    const uint32_t internal_largest_pct = PercentTimes10(largest_internal, total_internal);
+    const uint32_t spiram_free_pct = PercentTimes10(free_spiram, total_spiram);
+    const uint32_t spiram_largest_pct = PercentTimes10(largest_spiram, total_spiram);
+    ESP_LOGI(TAG,
+             "Background recovery: frames=%u internal_free=%u/%u %u.%u%% "
+             "internal_largest=%u %u.%u%% spiram_free=%u/%u %u.%u%% "
+             "spiram_largest=%u %u.%u%%",
+             static_cast<unsigned>(capture_count_), static_cast<unsigned>(free_internal),
+             static_cast<unsigned>(total_internal), static_cast<unsigned>(internal_free_pct / 10),
+             static_cast<unsigned>(internal_free_pct % 10), static_cast<unsigned>(largest_internal),
+             static_cast<unsigned>(internal_largest_pct / 10),
+             static_cast<unsigned>(internal_largest_pct % 10), static_cast<unsigned>(free_spiram),
+             static_cast<unsigned>(total_spiram), static_cast<unsigned>(spiram_free_pct / 10),
+             static_cast<unsigned>(spiram_free_pct % 10), static_cast<unsigned>(largest_spiram),
+             static_cast<unsigned>(spiram_largest_pct / 10),
+             static_cast<unsigned>(spiram_largest_pct % 10));
+
+    vTaskDelay(pdMS_TO_TICKS(CONFIG_BACKGROUND_CAPTURE_RECOVERY_DELAY_MS));
+#endif
+}
