+void BackgroundCaptureService::InitializeBeaverIdentity() {
+#if CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_ENABLE
+    if (identity_initialized_) {
+        return;
+    }
+    std::string compact_mac = SystemInfo::GetMacAddress();
+    compact_mac.erase(std::remove(compact_mac.begin(), compact_mac.end(), ':'), compact_mac.end());
+    device_id_ = std::string(BOARD_NAME) + "-" + compact_mac;
+
+    char boot_id[40];
+    snprintf(boot_id, sizeof(boot_id), "%08lx%08lx%08lx%08lx",
+             static_cast<unsigned long>(esp_random()), static_cast<unsigned long>(esp_random()),
+             static_cast<unsigned long>(esp_random()), static_cast<unsigned long>(esp_random()));
+    boot_id_ = boot_id;
+    audio_stream_id_ = "microphone-main";
+    photo_stream_id_ = "camera-main";
+    audio_sequence_.store(0);
+    photo_sequence_.store(0);
+    media_upload_auth_failed_.store(false);
+    active_media_uploads_.store(0);
+    media_upload_overlap_epoch_.store(0);
+    concurrent_http_failures_.store(0);
+    concurrent_http_healthy_uploads_.store(0);
+    photo_batch_mode_ = false;
+    photo_batch_healthy_uploads_ = 0;
+    photo_batch_wait_started_us_ = 0;
+    photo_batch_waiting_count_ = 0;
+    audio_stream_active_.store(false);
+    audio_stream_segments_.store(esp_random() % 9000000U);
+    photo_stream_segments_.store(esp_random() % 9000000U);
+    {
+        std::lock_guard<std::mutex> lock(audio_pending_mutex_);
+        pending_audio_sd_paths_.clear();
+        pending_photo_sd_paths_.clear();
+    }
+    identity_initialized_ = true;
+    ESP_LOGI(TAG,
+             "Beaver Memory identity: device_id=%s boot_id=%s audio_stream_id=%s "
+             "photo_stream_id=%s",
+             device_id_.c_str(), boot_id_.c_str(), audio_stream_id_.c_str(),
+             photo_stream_id_.c_str());
+#endif
+}
+
+void BackgroundCaptureService::Start() {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE
+    if (running_.exchange(true)) {
+        return;
+    }
+
+    InitializeBeaverIdentity();
+    StartAudioStreamTasks();
+    if (EnsureAudioSdQueue()) {
+        StartMediaUploaderTasks();
+    }
+
+#if CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_ENABLE
+    auto control_result = xTaskCreate(&BackgroundCaptureService::BeaverControlTaskEntry,
+                                      "beaver_control", 6144, this,
+                                      CONFIG_BACKGROUND_CAPTURE_TASK_PRIORITY + 1,
+                                      &beaver_control_task_handle_);
+    if (control_result != pdPASS) {
+        beaver_control_task_handle_ = nullptr;
+        ESP_LOGE(TAG, "Failed to create Beaver Memory control task");
+    }
+#endif
+
+    auto result = xTaskCreate(&BackgroundCaptureService::TaskEntry, "bg_capture",
+                              CONFIG_BACKGROUND_CAPTURE_TASK_STACK_SIZE, this,
+                              CONFIG_BACKGROUND_CAPTURE_TASK_PRIORITY, &task_handle_);
+    if (result != pdPASS) {
+        running_.store(false);
+        task_handle_ = nullptr;
+        ESP_LOGE(TAG, "Failed to create background capture task");
+    }
+#endif
+}
+
+void BackgroundCaptureService::Stop() {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE
+    if (!running_.exchange(false)) {
+        return;
+    }
+
+    Application::GetInstance().GetAudioService().SetAudioInputTapCallback(nullptr);
+
+    while (task_handle_ != nullptr) {
+        vTaskDelay(pdMS_TO_TICKS(20));
+    }
+    while (audio_record_task_handle_ != nullptr || audio_writer_task_handle_ != nullptr) {
+        vTaskDelay(pdMS_TO_TICKS(20));
+    }
+    while (audio_upload_in_progress_.load() || audio_sd_uploader_running_.load() ||
+           photo_sd_uploader_running_.load()) {
+        vTaskDelay(pdMS_TO_TICKS(20));
+    }
+#if CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_ENABLE
+    if (audio_stream_active_.load()) {
+        EndBeaverAudioStream("shutdown");
+    }
+    if (beaver_websocket_ != nullptr) {
+        beaver_websocket_->Close();
+    }
+#endif
+    while (beaver_control_task_handle_ != nullptr) {
+        vTaskDelay(pdMS_TO_TICKS(20));
+    }
+    if (audio_ringbuf_ != nullptr) {
+        if (audio_ringbuf_with_caps_) {
+            vRingbufferDeleteWithCaps(audio_ringbuf_);
+        } else {
+            vRingbufferDelete(audio_ringbuf_);
+        }
+        audio_ringbuf_ = nullptr;
+        audio_ringbuf_with_caps_ = false;
+    }
+    audio_stream_tasks_started_.store(false);
+#endif
+}
