+
+bool BackgroundCaptureService::ConnectBeaverControl() {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE && CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_ENABLE
+    auto network = Board::GetInstance().GetNetwork();
+    if (network == nullptr) {
+        return false;
+    }
+
+    beaver_websocket_ = network->CreateWebSocket(2);
+    if (beaver_websocket_ == nullptr) {
+        return false;
+    }
+
+    std::string authorization =
+        "Bearer " + std::string(CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_DEVICE_TOKEN);
+    beaver_websocket_->SetHeader("Authorization", authorization.c_str());
+    beaver_websocket_->SetReceiveBufferSize(4096);
+    beaver_websocket_->OnData([](const char* data, size_t len, bool binary) {
+        if (binary) {
+            return;
+        }
+        auto* root = cJSON_ParseWithLength(data, len);
+        auto* type = root == nullptr ? nullptr : cJSON_GetObjectItem(root, "type");
+        if (cJSON_IsString(type)) {
+            ESP_LOGD(TAG, "Beaver control response: %s", type->valuestring);
+        }
+        cJSON_Delete(root);
+    });
+    beaver_websocket_->OnDisconnected([this]() {
+        beaver_connected_.store(false);
+        ESP_LOGW(TAG, "Beaver Memory control WebSocket disconnected");
+    });
+    beaver_websocket_->OnError([this](int error) {
+        beaver_connected_.store(false);
+        ESP_LOGW(TAG, "Beaver Memory control WebSocket error=%d", error);
+    });
+
+    const std::string url = GatewayWebSocketUrl();
+    if (!beaver_websocket_->Connect(url.c_str())) {
+        ESP_LOGW(TAG, "Failed to connect Beaver Memory control WebSocket, error=%d",
+                 beaver_websocket_->GetLastError());
+        beaver_websocket_.reset();
+        return false;
+    }
+
+    cJSON* hello = cJSON_CreateObject();
+    cJSON_AddStringToObject(hello, "type", "hello");
+    cJSON_AddStringToObject(hello, "device_id", device_id_.c_str());
+    // Keep stream_id as a boot-scoped control-session identifier for older gateways. Media
+    // uploads use their own stable stream IDs and carry boot_id separately.
+    cJSON_AddStringToObject(hello, "stream_id", boot_id_.c_str());
+    cJSON_AddStringToObject(hello, "boot_id", boot_id_.c_str());
+    const std::string client = SystemInfo::GetUserAgent();
+    cJSON_AddStringToObject(hello, "client", client.c_str());
+    cJSON* caps = cJSON_AddArrayToObject(hello, "caps");
+    cJSON_AddItemToArray(caps, cJSON_CreateString("audio.command_upload"));
+    cJSON_AddItemToArray(caps, cJSON_CreateString("camera.snapshot"));
+    cJSON_AddItemToArray(caps, cJSON_CreateString("capture.continuous"));
+    const std::string payload = JsonToString(hello);
+    cJSON_Delete(hello);
+
+    if (payload.empty() || !beaver_websocket_->Send(payload)) {
+        ESP_LOGW(TAG, "Failed to send Beaver Memory hello");
+        beaver_websocket_.reset();
+        return false;
+    }
+    beaver_connected_.store(true);
+    ESP_LOGI(TAG, "Beaver Memory control WebSocket connected: %s", url.c_str());
+    return SendBeaverHeartbeat();
+#else
+    return false;
+#endif
+}
+
+bool BackgroundCaptureService::SendBeaverHeartbeat() {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE && CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_ENABLE
+    if (beaver_websocket_ == nullptr || !beaver_websocket_->IsConnected()) {
+        return false;
+    }
+
+    cJSON* heartbeat = cJSON_CreateObject();
+    cJSON_AddStringToObject(heartbeat, "type", "heartbeat");
+    cJSON_AddStringToObject(heartbeat, "device_id", device_id_.c_str());
+    cJSON_AddStringToObject(heartbeat, "stream_id", boot_id_.c_str());
+    cJSON_AddStringToObject(heartbeat, "boot_id", boot_id_.c_str());
+    cJSON_AddNumberToObject(heartbeat, "uptime_ms",
+                           static_cast<double>(esp_timer_get_time() / 1000));
+    cJSON_AddBoolToObject(heartbeat, "memory_capture_active", running_.load());
+
+    int level = 0;
+    bool charging = false;
+    bool discharging = false;
+    if (Board::GetInstance().GetBatteryLevel(level, charging, discharging)) {
+        cJSON* battery = cJSON_CreateObject();
+        cJSON_AddItemToObject(heartbeat, "battery", battery);
+        cJSON_AddNumberToObject(battery, "percent", std::clamp(level, 0, 100));
+        cJSON_AddBoolToObject(battery, "external_power", charging || !discharging);
+        cJSON_AddBoolToObject(battery, "charging", charging);
+    }
+
+    const std::string payload = JsonToString(heartbeat);
+    cJSON_Delete(heartbeat);
+    if (payload.empty() || !beaver_websocket_->Send(payload)) {
+        beaver_connected_.store(false);
+        return false;
+    }
+    beaver_websocket_->Ping();
+    return true;
+#else
+    return false;
+#endif
+}
+
+bool BackgroundCaptureService::EndBeaverAudioStream(const char* reason) {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE && CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_ENABLE
+    if (!audio_stream_active_.load() || device_id_.empty() || boot_id_.empty() ||
+        audio_stream_id_.empty()) {
+        return true;
+    }
+
+    auto network = Board::GetInstance().GetNetwork();
+    if (network == nullptr) {
+        return false;
+    }
+
+    std::string base_url = CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_GATEWAY_URL;
+    while (!base_url.empty() && base_url.back() == '/') {
+        base_url.pop_back();
+    }
+    const std::string url = base_url + "/api/v1/media/end";
+    auto http = network->CreateHttp(3);
+    http->SetTimeout(GetMediaUploadTimeoutMs("audio/wav"));
+    http->SetKeepAlive(false);
+    http->SetHeader(
+        "Authorization",
+        "Bearer " + std::string(CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_DEVICE_TOKEN));
+    http->SetHeader("Content-Length", "0");
+    http->SetHeader("X-Device-Id", device_id_);
+    http->SetHeader("X-Boot-Id", boot_id_);
+    http->SetHeader("X-Monotonic-Ms",
+                    std::to_string(static_cast<int64_t>(esp_timer_get_time() / 1000)));
+    http->SetHeader("X-Reason", reason == nullptr ? "shutdown" : reason);
+
+    if (!http->Open("POST", url)) {
+        ESP_LOGW(TAG, "Failed to open Beaver Memory audio/end endpoint");
+        return false;
+    }
+    const int status_code = http->GetStatusCode();
+    const size_t expected_response_bytes = status_code > 0 ? http->GetBodyLength() : 0;
+    const std::string response_body = status_code > 0 ? http->ReadAll() : std::string();
+    const bool response_complete =
+        expected_response_bytes == 0 || response_body.size() == expected_response_bytes;
+    http->Close();
+    vTaskDelay(1);
+
+    const bool ok = status_code == 200 && response_complete;
+    ESP_LOGI(TAG, "Beaver Memory audio stream end: reason=%s status=%d ok=%d",
+             reason == nullptr ? "shutdown" : reason, status_code, ok ? 1 : 0);
+    if (ok) {
+        audio_stream_active_.store(false);
+    }
+    return ok;
+#else
+    (void)reason;
+    return false;
+#endif
+}
+
+void BackgroundCaptureService::BeaverControlTask() {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE && CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_ENABLE
+    constexpr uint32_t kHeartbeatMs = 15000;
+    constexpr uint32_t kReconnectMs = 5000;
+    while (running_.load()) {
+        if (!beaver_connected_.load() || beaver_websocket_ == nullptr ||
+            !beaver_websocket_->IsConnected()) {
+            beaver_connected_.store(false);
+            beaver_websocket_.reset();
+            if (!ConnectBeaverControl()) {
+                uint32_t waited_ms = 0;
+                while (running_.load() && waited_ms < kReconnectMs) {
+                    vTaskDelay(pdMS_TO_TICKS(250));
+                    waited_ms += 250;
+                }
+                continue;
+            }
+        }
+
+        uint32_t waited_ms = 0;
+        while (running_.load() && beaver_connected_.load() && waited_ms < kHeartbeatMs) {
+            vTaskDelay(pdMS_TO_TICKS(250));
+            waited_ms += 250;
+        }
+        if (running_.load() && beaver_connected_.load() && !SendBeaverHeartbeat()) {
+            ESP_LOGW(TAG, "Failed to send Beaver Memory heartbeat");
+        }
+    }
+    beaver_connected_.store(false);
+    beaver_websocket_.reset();
+    ESP_LOGI(TAG, "Beaver Memory control task stopped");
+#endif
+}
+
+void BackgroundCaptureService::AudioUploadTaskEntry(void* arg) {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE && CONFIG_BACKGROUND_CAPTURE_AUDIO_ENABLE
+    auto* job = static_cast<AudioUploadJob*>(arg);
+    auto* service = job->service;
+    const int64_t upload_start_us = esp_timer_get_time();
+    const std::string upload_filename = BuildAudioUploadFilename(job->fields);
+    bool upload_ok = service->UploadFile(CONFIG_BACKGROUND_CAPTURE_AUDIO_UPLOAD_URL, upload_filename,
+                                         "audio/wav", job->audio_wav, job->fields);
+    const char* upload_status =
+        upload_ok ? (CONFIG_BACKGROUND_CAPTURE_AUDIO_UPLOAD_URL[0] == '\0' ? "disabled" : "ok")
+                  : "failed";
+    if (!upload_ok) {
+        ESP_LOGW(TAG, "Background audio captured but async upload failed");
+    }
+
+    const int64_t upload_done_us = esp_timer_get_time();
+    ESP_LOGI(TAG,
+             "Background audio throughput: bytes=%u duration_ms=%u capture_ms=%u "
+             "upload_ms=%u total_ms=%u upload=%s async=1",
+             static_cast<unsigned>(job->audio_wav.size()),
+             static_cast<unsigned>(CONFIG_BACKGROUND_CAPTURE_AUDIO_DURATION_MS),
+             static_cast<unsigned>((job->capture_done_us - job->audio_start_us) / 1000),
+             static_cast<unsigned>((upload_done_us - upload_start_us) / 1000),
+             static_cast<unsigned>((upload_done_us - job->audio_start_us) / 1000), upload_status);
+
+    service->audio_upload_in_progress_.store(false);
+    delete job;
+#else
+    (void)arg;
+#endif
+    vTaskDelete(nullptr);
+}
+
+void BackgroundCaptureService::Run() {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE
+    ESP_LOGI(TAG, "Background capture task started");
+    capture_count_ = 0;
+
+    while (running_.load()) {
+        if (!IsCaptureAllowed()) {
+            DelayWithStateCheck(1000);
+            continue;
+        }
+
+        const int64_t cycle_start_us = esp_timer_get_time();
+        if (!CaptureAndSendMemorySlice()) {
+            consecutive_failures_++;
+            auto delay_ms = GetFailureDelayMs();
+            ESP_LOGW(TAG, "Background capture retry in %u ms, failures=%u", delay_ms,
+                     consecutive_failures_);
+            DelayWithStateCheck(delay_ms);
+            continue;
+        }
+
+        consecutive_failures_ = 0;
+        capture_count_++;
+        RunRecoveryCycle();
+        uint32_t target_period_ms = CONFIG_BACKGROUND_CAPTURE_INTERVAL_MS;
+#if CONFIG_BACKGROUND_CAPTURE_AUDIO_ENABLE
+        if (audio_stream_tasks_started_.load() &&
+            CONFIG_BACKGROUND_CAPTURE_IMAGE_EVERY_FRAMES <= 0) {
+            target_period_ms = std::max<uint32_t>(target_period_ms, 1000);
+        }
+#endif
+        const uint32_t elapsed_ms = static_cast<uint32_t>(
+            std::max<int64_t>(0, esp_timer_get_time() - cycle_start_us) / 1000);
+        const uint32_t delay_ms =
+            elapsed_ms < target_period_ms ? target_period_ms - elapsed_ms : 0;
+        ESP_LOGD(TAG, "Background capture schedule: work_ms=%u delay_ms=%u period_ms=%u",
+                 static_cast<unsigned>(elapsed_ms), static_cast<unsigned>(delay_ms),
+                 static_cast<unsigned>(target_period_ms));
+        DelayWithStateCheck(delay_ms);
+    }
+
+    ESP_LOGI(TAG, "Background capture task stopped");
+#endif
+}
+
+bool BackgroundCaptureService::IsCaptureAllowed() const {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE
+    auto& app = Application::GetInstance();
+    const auto state = app.GetDeviceState();
+    return running_.load() &&
+           (state == kDeviceStateIdle || state == kDeviceStateConnecting ||
+            state == kDeviceStateListening || state == kDeviceStateThinking ||
+            state == kDeviceStateSpeaking);
+#else
+    return false;
+#endif
+}
+
+bool BackgroundCaptureService::IsDirectAudioCaptureAllowed() const {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE
+    auto& app = Application::GetInstance();
+    const auto state = app.GetDeviceState();
+    auto& audio_service = app.GetAudioService();
+    return running_.load() &&
+           !audio_service.IsWakeWordRunning() &&
+           !audio_service.IsAudioProcessorRunning() &&
+           !audio_service.IsAudioTestingRunning() &&
+           (state == kDeviceStateIdle || state == kDeviceStateConnecting ||
+            state == kDeviceStateThinking);
+#else
+    return false;
+#endif
+}
+
+bool BackgroundCaptureService::DelayWithStateCheck(uint32_t delay_ms) const {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE
+    if (delay_ms == 0) {
+        taskYIELD();
+        return running_.load();
+    }
+
+    uint32_t elapsed_ms = 0;
+    while (running_.load() && elapsed_ms < delay_ms) {
+        const uint32_t step_ms = std::min<uint32_t>(delay_ms - elapsed_ms, 200);
+        vTaskDelay(pdMS_TO_TICKS(step_ms));
+        elapsed_ms += step_ms;
+        if (!IsCaptureAllowed()) {
+            return false;
+        }
+    }
+    return running_.load();
+#else
+    (void)delay_ms;
+    return false;
+#endif
+}
+
+bool BackgroundCaptureService::CaptureAndSendMemorySlice() {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE
+    const uint32_t slice_index = capture_count_ + 1;
+    bool did_work = false;
+
+#if CONFIG_BACKGROUND_CAPTURE_IMAGE_EVERY_FRAMES > 0
+    if (slice_index == 1 || slice_index % CONFIG_BACKGROUND_CAPTURE_IMAGE_EVERY_FRAMES == 0) {
+#if CONFIG_BACKGROUND_CAPTURE_RAW_CAMERA_TEST
+        ESP_LOGD(TAG, "Background raw camera capture due: tick=%u every=%u",
+                 static_cast<unsigned>(slice_index),
+                 static_cast<unsigned>(CONFIG_BACKGROUND_CAPTURE_IMAGE_EVERY_FRAMES));
+#else
+        ESP_LOGI(TAG, "Background image capture due: tick=%u every=%u",
+                 static_cast<unsigned>(slice_index),
+                 static_cast<unsigned>(CONFIG_BACKGROUND_CAPTURE_IMAGE_EVERY_FRAMES));
+#endif
+        if (!CaptureAndSendFrame()) {
+            return false;
+        }
+        did_work = true;
+
+        if (!IsCaptureAllowed()) {
+            return true;
+        }
+    }
+#endif
+
+#if CONFIG_BACKGROUND_CAPTURE_AUDIO_ENABLE
+    if (!audio_stream_tasks_started_.load() && CONFIG_BACKGROUND_CAPTURE_AUDIO_DURATION_MS > 0 &&
+        CONFIG_BACKGROUND_CAPTURE_AUDIO_EVERY_FRAMES > 0 &&
+        (slice_index == 1 || slice_index % CONFIG_BACKGROUND_CAPTURE_AUDIO_EVERY_FRAMES == 0)) {
+        ESP_LOGI(TAG, "Background audio capture due: tick=%u every=%u",
+                 static_cast<unsigned>(slice_index),
+                 static_cast<unsigned>(CONFIG_BACKGROUND_CAPTURE_AUDIO_EVERY_FRAMES));
+        if (!CaptureAndSendAudio()) {
+            ESP_LOGW(TAG, "Background audio capture failed, keep image capture running");
+        }
+        did_work = true;
+
+        if (!IsCaptureAllowed()) {
+            return true;
+        }
+    }
+#endif
+
+    if (!did_work) {
+        ESP_LOGD(TAG, "No background capture due: tick=%u", static_cast<unsigned>(slice_index));
+    }
+    return true;
+#else
+    return false;
+#endif
+}
+
+bool BackgroundCaptureService::CaptureAndSendFrame() {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE
+    if (!IsCaptureAllowed()) {
+        return true;
+    }
+
+    const size_t free_internal_heap = heap_caps_get_free_size(MALLOC_CAP_INTERNAL);
+    if (free_internal_heap < CONFIG_BACKGROUND_CAPTURE_MIN_FREE_INTERNAL_HEAP) {
+        ESP_LOGW(TAG, "Skip background capture, low internal heap: free=%u threshold=%u",
+                 static_cast<unsigned>(free_internal_heap),
+                 static_cast<unsigned>(CONFIG_BACKGROUND_CAPTURE_MIN_FREE_INTERNAL_HEAP));
+        return true;
+    }
+
+    auto camera = Board::GetInstance().GetCamera();
+    if (camera == nullptr) {
+        ESP_LOGW(TAG, "No camera available for background capture");
+        return false;
+    }
+
+#if CONFIG_BACKGROUND_CAPTURE_RAW_CAMERA_TEST
+    size_t bytes_used = 0;
+    size_t buffer_len = 0;
+    uint32_t elapsed_us = 0;
+    uint32_t buffer_index = 0;
+    if (!camera->CaptureRawFrameForTest(bytes_used, buffer_len, elapsed_us, buffer_index)) {
+        ESP_LOGW(TAG, "Raw camera throughput test is not available or failed");
+        return false;
+    }
+
+    static int64_t raw_window_start_us = 0;
+    static uint32_t raw_window_frames = 0;
+    static uint64_t raw_window_dqbuf_us = 0;
+
+    const int64_t now_us = esp_timer_get_time();
+    if (raw_window_start_us == 0) {
+        raw_window_start_us = now_us;
+    }
+    raw_window_frames++;
+    raw_window_dqbuf_us += elapsed_us;
+
+    const int64_t window_us = now_us - raw_window_start_us;
+    if (raw_window_frames >= 60 || window_us >= 2000000) {
+        const uint32_t raw_fps_times10 =
+            window_us > 0
+                ? static_cast<uint32_t>(
+                      (static_cast<uint64_t>(raw_window_frames) * 10000000ULL + window_us / 2) /
+                      window_us)
+                : 0;
+        const uint32_t avg_dqbuf_us =
+            raw_window_frames > 0 ? static_cast<uint32_t>(raw_window_dqbuf_us / raw_window_frames)
+                                  : 0;
+        ESP_LOGI(TAG,
+                 "Background raw camera throughput: frames=%u window_ms=%u "
+                 "raw_fps=%u.%u avg_dqbuf_us=%u last_buffer=%u bytes_used=%u "
+                 "buffer_len=%u",
+                 static_cast<unsigned>(raw_window_frames), static_cast<unsigned>(window_us / 1000),
+                 static_cast<unsigned>(raw_fps_times10 / 10),
+                 static_cast<unsigned>(raw_fps_times10 % 10), static_cast<unsigned>(avg_dqbuf_us),
+                 static_cast<unsigned>(buffer_index), static_cast<unsigned>(bytes_used),
+                 static_cast<unsigned>(buffer_len));
+        raw_window_start_us = now_us;
+        raw_window_frames = 0;
+        raw_window_dqbuf_us = 0;
+    }
+    return true;
+#endif
+
+    auto& audio_service = Application::GetInstance().GetAudioService();
+    const bool wake_word_was_running = audio_service.IsWakeWordRunning();
+#if CONFIG_BACKGROUND_CAPTURE_PAUSE_WAKE_WORD
+    if (wake_word_was_running) {
+        audio_service.EnableWakeWordDetection(false);
+        vTaskDelay(pdMS_TO_TICKS(50));
+    }
+#endif
+
+    const int64_t frame_start_us = esp_timer_get_time();
+    std::string jpeg_data;
+    if (!camera->CaptureToJpeg(jpeg_data, false)) {
+        const uint32_t capture_ms =
+            static_cast<uint32_t>((esp_timer_get_time() - frame_start_us) / 1000);
+        ESP_LOGW(TAG, "Background image capture failed: capture_ms=%u",
+                 static_cast<unsigned>(capture_ms));
+        ESP_LOGW(TAG, "Failed to capture background frame");
+        camera->ReleaseCaptureResources();
+#if CONFIG_BACKGROUND_CAPTURE_PAUSE_WAKE_WORD
+        if (wake_word_was_running && running_.load() &&
+            Application::GetInstance().GetDeviceState() == kDeviceStateIdle) {
+            audio_service.EnableWakeWordDetection(true);
+        }
+#endif
+        return false;
+    }
+
+    const int64_t capture_done_us = esp_timer_get_time();
+    if (jpeg_data.empty()) {
+        ESP_LOGW(TAG, "Captured empty background frame");
+        camera->ReleaseCaptureResources();
+#if CONFIG_BACKGROUND_CAPTURE_PAUSE_WAKE_WORD
+        if (wake_word_was_running && running_.load() &&
+            Application::GetInstance().GetDeviceState() == kDeviceStateIdle) {
+            audio_service.EnableWakeWordDetection(true);
+        }
+#endif
+        return false;
+    }
+
+#if !CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_ENABLE
+    std::vector<std::pair<std::string, std::string>> image_fields;
+    bool upload_ok = false;
+#endif
+    const char* upload_status = "skipped";
+    const uint64_t image_sequence = photo_sequence_.fetch_add(1);
+    std::string photo_sd_path;
+    if (SavePhotoToSd(jpeg_data, frame_start_us / 1000, image_sequence, photo_sd_path)) {
+#if !CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_ENABLE
+        upload_ok = true;
+#endif
+        upload_status = "queued_sd";
+        StartMediaUploaderTasks();
+    } else {
+#if CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_ENABLE
+        upload_status = "queue_failed";
+        ESP_LOGE(TAG, "Reliable photo queue unavailable; skip direct upload");
+#else
+        if (!BuildImageUploadFields(capture_count_ + 1, image_fields)) {
+        ESP_LOGW(TAG, "Background frame captured but Memory Gateway fields are incomplete");
+        } else {
+            image_fields.emplace_back("sequence", std::to_string(image_sequence));
+            const std::string upload_filename = BuildImageUploadFilename();
+            upload_ok = UploadFile(CONFIG_BACKGROUND_CAPTURE_IMAGE_UPLOAD_URL, upload_filename,
+                                   "image/jpeg", jpeg_data, image_fields);
+            upload_status = upload_ok
+                                ? (CONFIG_BACKGROUND_CAPTURE_IMAGE_UPLOAD_URL[0] == '\0'
+                                       ? "disabled"
+                                       : "ok")
+                                : "failed";
+            if (!upload_ok) {
+                ESP_LOGW(TAG, "Background frame captured but upload failed");
+            }
+        }
+#endif
+    }
+
+    const int64_t upload_done_us = esp_timer_get_time();
+    const int64_t capture_us = capture_done_us - frame_start_us;
+    const int64_t upload_us = upload_done_us - capture_done_us;
+    const int64_t total_us = upload_done_us - frame_start_us;
+    const uint32_t camera_fps_times10 =
+        capture_us > 0 ? static_cast<uint32_t>((10000000LL + capture_us / 2) / capture_us) : 0;
+    const uint32_t fps_times10 =
+        total_us > 0 ? static_cast<uint32_t>((10000000LL + total_us / 2) / total_us) : 0;
+    ESP_LOGI(TAG,
+             "Background image throughput: bytes=%u capture_ms=%u upload_ms=%u "
+             "total_ms=%u camera_fps=%u.%u fps=%u.%u upload=%s",
+             static_cast<unsigned>(jpeg_data.size()), static_cast<unsigned>(capture_us / 1000),
+             static_cast<unsigned>(upload_us / 1000), static_cast<unsigned>(total_us / 1000),
+             static_cast<unsigned>(camera_fps_times10 / 10),
+             static_cast<unsigned>(camera_fps_times10 % 10),
+             static_cast<unsigned>(fps_times10 / 10), static_cast<unsigned>(fps_times10 % 10),
+             upload_status);
+
+    std::string().swap(jpeg_data);
+    camera->ReleaseCaptureResources();
+#if CONFIG_BACKGROUND_CAPTURE_PAUSE_WAKE_WORD
+    if (wake_word_was_running && running_.load() &&
+        Application::GetInstance().GetDeviceState() == kDeviceStateIdle) {
+        audio_service.EnableWakeWordDetection(true);
+    }
+#endif
+    return true;
+#else
+    return false;
+#endif
+}
+
+bool BackgroundCaptureService::CaptureAndSendAudio() {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE && CONFIG_BACKGROUND_CAPTURE_AUDIO_ENABLE
+    if (!IsDirectAudioCaptureAllowed()) {
+        ESP_LOGI(TAG, "Skip background audio, device is busy");
+        return true;
+    }
+
+    const size_t free_internal_heap = heap_caps_get_free_size(MALLOC_CAP_INTERNAL);
+    if (free_internal_heap < CONFIG_BACKGROUND_CAPTURE_AUDIO_MIN_FREE_INTERNAL_HEAP) {
+        ESP_LOGW(TAG, "Skip background audio, low internal heap: free=%u threshold=%u",
+                 static_cast<unsigned>(free_internal_heap),
+                 static_cast<unsigned>(CONFIG_BACKGROUND_CAPTURE_AUDIO_MIN_FREE_INTERNAL_HEAP));
+        return true;
+    }
+
+    ESP_LOGI(TAG, "Capture background audio: duration=%u ms upload=%s",
+             static_cast<unsigned>(CONFIG_BACKGROUND_CAPTURE_AUDIO_DURATION_MS),
+             CONFIG_BACKGROUND_CAPTURE_AUDIO_UPLOAD_URL);
+
+    const int64_t audio_start_us = esp_timer_get_time();
+    std::string audio_wav;
+    if (!EncodeAudioWav(audio_wav)) {
+        ReleaseAudioResources(audio_wav);
+        return false;
+    }
+    const int64_t capture_done_us = esp_timer_get_time();
+
+    if (audio_wav.empty()) {
+        ESP_LOGW(TAG, "Captured empty background audio");
+        ReleaseAudioResources(audio_wav);
+        return false;
+    }
+
+    std::vector<std::pair<std::string, std::string>> audio_fields;
+    if (!BuildAudioUploadFields(capture_count_ + 1, audio_fields)) {
+        ESP_LOGW(TAG, "Background audio captured but Memory Gateway fields are incomplete");
+        ReleaseAudioResources(audio_wav);
+        return true;
+    }
+#if CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_ENABLE
+    const uint64_t audio_sequence = audio_sequence_.fetch_add(1);
+    const int64_t record_start_ms = audio_start_us / 1000;
+    const int64_t record_end_ms = capture_done_us / 1000;
+    constexpr int64_t kWavBytesPerSecond = 16000 * sizeof(int16_t);
+    const int64_t duration_ms = audio_wav.size() > 44
+                                    ? static_cast<int64_t>(audio_wav.size() - 44) * 1000 /
+                                          kWavBytesPerSecond
+                                    : 0;
+    const bool clock_synced = IsSystemTimeValid();
+    const int64_t now_uptime_ms = esp_timer_get_time() / 1000;
+    const int64_t captured_at_ms =
+        clock_synced ? GetWallTimeMs() - std::max<int64_t>(0, now_uptime_ms - record_start_ms) : 0;
+    SetUploadField(audio_fields, "device_id", device_id_);
+    SetUploadField(audio_fields, "boot_id", boot_id_);
+    SetUploadField(audio_fields, "stream_id", audio_stream_id_);
+    SetUploadField(audio_fields, "sequence", std::to_string(audio_sequence));
+    SetUploadField(audio_fields, "record_start_uptime_ms", std::to_string(record_start_ms));
+    SetUploadField(audio_fields, "record_end_uptime_ms", std::to_string(record_end_ms));
+    SetUploadField(audio_fields, "captured_at_ms", std::to_string(captured_at_ms));
+    SetUploadField(audio_fields, "clock_synced", clock_synced ? "1" : "0");
+    SetUploadField(audio_fields, "duration_ms", std::to_string(duration_ms));
+    SetUploadField(audio_fields, "content_length", std::to_string(audio_wav.size()));
+    SetUploadField(audio_fields, "sha256", Sha256Hex(audio_wav));
+    SetUploadField(audio_fields, "filename",
+                   BuildReliableFilename("audio", "wav", captured_at_ms, record_start_ms,
+                                         audio_sequence));
+    SetUploadField(audio_fields, "media_type", "audio/wav");
+#else
+    const uint64_t audio_sequence = audio_sequence_.fetch_add(1);
+    audio_fields.emplace_back("sequence", std::to_string(audio_sequence));
+#endif
+
+    std::string sd_path;
+    const int64_t sd_queue_start_us = esp_timer_get_time();
+    if (SaveAudioToSd(audio_wav, audio_start_us / 1000, capture_done_us / 1000,
+                      audio_sequence, sd_path)) {
+        const int64_t sd_queue_done_us = esp_timer_get_time();
+        const size_t queued_bytes = audio_wav.size();
+        {
+            std::lock_guard<std::mutex> lock(audio_pending_mutex_);
+            pending_audio_sd_paths_.push_back(sd_path);
+        }
+        ESP_LOGI(TAG, "Queued background audio on SD: path=%s bytes=%u", sd_path.c_str(),
+                 static_cast<unsigned>(queued_bytes));
+        ReleaseAudioResources(audio_wav);
+        StartMediaUploaderTasks();
+        ESP_LOGI(TAG,
+                 "Background audio throughput: bytes=%u duration_ms=%u capture_ms=%u "
+                 "sd_queue_ms=%u upload_ms=0 total_ms=%u upload=queued_sd async=1",
+                 static_cast<unsigned>(queued_bytes),
+                 static_cast<unsigned>(CONFIG_BACKGROUND_CAPTURE_AUDIO_DURATION_MS),
+                 static_cast<unsigned>((capture_done_us - audio_start_us) / 1000),
+                 static_cast<unsigned>((sd_queue_done_us - sd_queue_start_us) / 1000),
+                 static_cast<unsigned>((sd_queue_done_us - audio_start_us) / 1000));
+        return true;
+    }
+
+#if CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_ENABLE
+    ESP_LOGE(TAG, "Reliable audio queue unavailable; skip direct upload");
+    ReleaseAudioResources(audio_wav);
+    return false;
+#else
+    ESP_LOGW(TAG, "SD audio queue unavailable, fallback to in-memory async upload");
+    if (!StartAudioUploadTask(std::move(audio_wav), std::move(audio_fields), audio_start_us,
+                              capture_done_us)) {
+        const int64_t upload_done_us = esp_timer_get_time();
+        ESP_LOGW(
+            TAG,
+            "Background audio upload skipped: previous upload is still running or task creation "
+            "failed");
+        ESP_LOGI(TAG,
+                 "Background audio throughput: bytes=%u duration_ms=%u capture_ms=%u "
+                 "upload_ms=%u total_ms=%u upload=dropped async=1",
+                 static_cast<unsigned>(audio_wav.size()),
+                 static_cast<unsigned>(CONFIG_BACKGROUND_CAPTURE_AUDIO_DURATION_MS),
+                 static_cast<unsigned>((capture_done_us - audio_start_us) / 1000),
+                 static_cast<unsigned>((upload_done_us - capture_done_us) / 1000),
+                 static_cast<unsigned>((upload_done_us - audio_start_us) / 1000));
+        ReleaseAudioResources(audio_wav);
+    }
+    return true;
+#endif
+#else
+    return false;
+#endif
+}
+
+bool BackgroundCaptureService::StartAudioUploadTask(
+    std::string&& audio_wav, std::vector<std::pair<std::string, std::string>>&& fields,
+    int64_t audio_start_us, int64_t capture_done_us) {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE && CONFIG_BACKGROUND_CAPTURE_AUDIO_ENABLE
+    if (audio_upload_in_progress_.exchange(true)) {
+        return false;
+    }
+
+    auto* job = new (std::nothrow) AudioUploadJob();
+    if (job == nullptr) {
+        audio_upload_in_progress_.store(false);
+        return false;
+    }
+    job->service = this;
+    job->audio_wav = std::move(audio_wav);
+    job->fields = std::move(fields);
+    job->audio_start_us = audio_start_us;
+    job->capture_done_us = capture_done_us;
+
+    BaseType_t result = xTaskCreate(&BackgroundCaptureService::AudioUploadTaskEntry,
+                                    "bg_audio_upload", 6144, job, tskIDLE_PRIORITY + 1, nullptr);
+    if (result != pdPASS) {
+        delete job;
+        audio_upload_in_progress_.store(false);
+        return false;
+    }
+
+    ESP_LOGI(TAG, "Queued background audio upload: bytes=%u async=1",
+             static_cast<unsigned>(job->audio_wav.size()));
+    return true;
+#else
+    (void)audio_wav;
+    (void)fields;
+    (void)audio_start_us;
+    (void)capture_done_us;
+    return false;
+#endif
+}
+
+bool BackgroundCaptureService::EnsureAudioSdQueue() {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE && CONFIG_BACKGROUND_CAPTURE_AUDIO_ENABLE
+    std::lock_guard<std::mutex> lock(audio_sd_mutex_);
+    if (audio_sd_checked_ && audio_sd_ready_) {
+        return audio_sd_ready_;
+    }
+    audio_sd_checked_ = true;
+
+    esp_vfs_fat_sdmmc_mount_config_t mount_config = {
+        .format_if_mount_failed = false,
+        .max_files = 8,
+        .allocation_unit_size = 16 * 1024,
+        .disk_status_check_enable = false,
+    };
+
+    sdmmc_host_t host = SDSPI_HOST_DEFAULT();
+    host.slot = SPI3_HOST;
+    host.max_freq_khz = 10000;
+
+    sdspi_device_config_t slot_config = SDSPI_DEVICE_CONFIG_DEFAULT();
+    slot_config.host_id = SPI3_HOST;
+    slot_config.gpio_cs = GPIO_NUM_4;
+    slot_config.gpio_cd = SDSPI_SLOT_NO_CD;
+    slot_config.gpio_wp = SDSPI_SLOT_NO_WP;
+    slot_config.gpio_int = SDSPI_SLOT_NO_INT;
+
+    {
+        SdSpiAccessGuard sd_guard;
+        if (!sd_guard.ok()) {
+            audio_sd_ready_ = false;
+            return false;
+        }
+        esp_err_t err = esp_vfs_fat_sdspi_mount(kAudioSdMountPoint, &host, &slot_config,
+                                                &mount_config, &g_audio_sd_card);
+        if (err != ESP_OK) {
+            ESP_LOGW(TAG, "SD audio queue mount failed: %s", esp_err_to_name(err));
+            audio_sd_ready_ = false;
+            return false;
+        }
+
+        errno = 0;
+        if (mkdir(kAudioSdQueueDir, 0775) != 0 && errno != EEXIST) {
+            ESP_LOGW(TAG, "Failed to create SD audio queue dir: %s errno=%d %s", kAudioSdQueueDir,
+                     errno, strerror(errno));
+            audio_sd_ready_ = false;
+            return false;
+        }
+        errno = 0;
+        if (mkdir(kPhotoSdQueueDir, 0775) != 0 && errno != EEXIST) {
+            ESP_LOGW(TAG, "Failed to create SD photo queue dir: %s errno=%d %s",
+                     kPhotoSdQueueDir, errno, strerror(errno));
+            audio_sd_ready_ = false;
+            return false;
+        }
+        struct stat queue_stat = {};
+        if (stat(kAudioSdQueueDir, &queue_stat) != 0 || !S_ISDIR(queue_stat.st_mode)) {
+            ESP_LOGW(TAG, "SD audio queue dir is unavailable: %s errno=%d %s", kAudioSdQueueDir,
+                     errno, strerror(errno));
+            audio_sd_ready_ = false;
+            return false;
+        }
+        struct stat photo_queue_stat = {};
+        if (stat(kPhotoSdQueueDir, &photo_queue_stat) != 0 ||
+            !S_ISDIR(photo_queue_stat.st_mode)) {
+            ESP_LOGW(TAG, "SD photo queue dir is unavailable: %s errno=%d %s", kPhotoSdQueueDir,
+                     errno, strerror(errno));
+            audio_sd_ready_ = false;
+            return false;
+        }
+    }
+    audio_sd_ready_ = true;
+    ESP_LOGI(TAG, "SD audio queue mounted: %s", kAudioSdQueueDir);
+    return true;
+#else
+    return false;
+#endif
+}
+
+bool BackgroundCaptureService::SaveAudioToSd(const std::string& audio_wav,
+                                             int64_t record_start_ms,
+                                             int64_t record_end_ms,
+                                             uint64_t sequence,
+                                             std::string& path) {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE && CONFIG_BACKGROUND_CAPTURE_AUDIO_ENABLE
+    if (!EnsureAudioSdQueue()) {
+        return false;
+    }
+
+    SdSpiAccessGuard sd_guard;
+    if (!sd_guard.ok()) {
+        return false;
+    }
+    for (int attempt = 0; attempt < 8; ++attempt) {
+        char basename[9];
+        snprintf(basename, sizeof(basename), "A%07lx",
+                 static_cast<unsigned long>(esp_random() & 0x0fffffff));
+        path = std::string(kAudioSdQueueDir) + "/" + basename + ".WAV";
+        struct stat existing = {};
+        if (stat(path.c_str(), &existing) != 0 && errno == ENOENT) {
+            break;
+        }
+        path.clear();
+    }
+    if (path.empty()) {
+        return false;
+    }
+
+    const std::string temp_path = ReplaceExtension(path, ".tmp");
+    FILE* file = fopen(temp_path.c_str(), "wb");
+    if (file == nullptr) {
+        ESP_LOGW(TAG, "Failed to open SD audio file for write: %s", path.c_str());
+        return false;
+    }
+
+    const size_t written = fwrite(audio_wav.data(), 1, audio_wav.size(), file);
+    const bool flushed = written == audio_wav.size() && fflush(file) == 0;
+    const bool synced = flushed && fsync(fileno(file)) == 0;
+    const int close_result = fclose(file);
+    if (written != audio_wav.size() || !flushed || !synced || close_result != 0) {
+        ESP_LOGW(TAG, "Failed to write SD audio file: path=%s written=%u expected=%u", path.c_str(),
+                 static_cast<unsigned>(written), static_cast<unsigned>(audio_wav.size()));
+        unlink(temp_path.c_str());
+        return false;
+    }
+
+#if CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_ENABLE
+    const std::string metadata_path = ReplaceExtension(path, ".txt");
+    const bool clock_synced = IsSystemTimeValid();
+    const int64_t now_uptime_ms = esp_timer_get_time() / 1000;
+    const int64_t captured_at_ms =
+        clock_synced ? GetWallTimeMs() - std::max<int64_t>(0, now_uptime_ms - record_start_ms) : 0;
+    constexpr int64_t kWavBytesPerSecond = 16000 * sizeof(int16_t);
+    const int64_t duration_ms = audio_wav.size() > 44
+                                    ? static_cast<int64_t>(audio_wav.size() - 44) * 1000 /
+                                          kWavBytesPerSecond
+                                    : 0;
+    const std::string filename =
+        BuildReliableFilename("audio", "wav", captured_at_ms, record_start_ms, sequence);
+    std::vector<std::pair<std::string, std::string>> fields;
+    fields.emplace_back("kind", "background_audio");
+    fields.emplace_back("device_id", device_id_);
+    fields.emplace_back("boot_id", boot_id_);
+    fields.emplace_back("stream_id", audio_stream_id_);
+    fields.emplace_back("sequence", std::to_string(sequence));
+    fields.emplace_back("record_start_uptime_ms", std::to_string(record_start_ms));
+    fields.emplace_back("record_end_uptime_ms", std::to_string(record_end_ms));
+    fields.emplace_back("record_duration_ms", std::to_string(duration_ms));
+    fields.emplace_back("captured_at_ms", std::to_string(captured_at_ms));
+    fields.emplace_back("clock_synced", clock_synced ? "1" : "0");
+    fields.emplace_back("duration_ms", std::to_string(duration_ms));
+    fields.emplace_back("content_length", std::to_string(audio_wav.size()));
+    fields.emplace_back("sha256", Sha256Hex(audio_wav));
+    fields.emplace_back("filename", filename);
+    fields.emplace_back("media_type", "audio/wav");
+    if (!WriteSmallTextFileAtomic(metadata_path, SerializeUploadFields(fields))) {
+        ESP_LOGW(TAG, "Failed to write complete audio metadata: %s", metadata_path.c_str());
+        unlink(temp_path.c_str());
+        return false;
+    }
+#endif
+
+    if (rename(temp_path.c_str(), path.c_str()) != 0) {
+        unlink(temp_path.c_str());
+        unlink(ReplaceExtension(path, ".txt").c_str());
+        return false;
+    }
+
+    return true;
+#else
+    (void)audio_wav;
+    (void)record_start_ms;
+    (void)record_end_ms;
+    (void)sequence;
+    (void)path;
+    return false;
+#endif
+}
+
+bool BackgroundCaptureService::SavePhotoToSd(const std::string& jpeg,
+                                             int64_t captured_uptime_ms,
+                                             uint64_t sequence,
+                                             std::string& path) {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE
+    if (jpeg.empty() || !EnsureAudioSdQueue()) {
+        return false;
+    }
+
+    const bool clock_synced = IsSystemTimeValid();
+    const int64_t now_uptime_ms = esp_timer_get_time() / 1000;
+    const int64_t captured_at_ms =
+        clock_synced ? GetWallTimeMs() - std::max<int64_t>(0, now_uptime_ms - captured_uptime_ms)
+                     : 0;
+    const std::string filename =
+        BuildReliableFilename("image", "jpg", captured_at_ms, captured_uptime_ms, sequence);
+    const std::string sha256 = Sha256Hex(jpeg);
+    if (sha256.empty()) {
+        return false;
+    }
+
+    SdSpiAccessGuard sd_guard;
+    if (!sd_guard.ok()) {
+        return false;
+    }
+    for (int attempt = 0; attempt < 8; ++attempt) {
+        char basename[9];
+        const uint32_t serial = (photo_stream_segments_.fetch_add(1) + 1) % 10000000U;
+        snprintf(basename, sizeof(basename), "P%07lu", static_cast<unsigned long>(serial));
+        path = std::string(kPhotoSdQueueDir) + "/" + basename + ".JPG";
+        struct stat existing = {};
+        if (stat(path.c_str(), &existing) != 0 && errno == ENOENT) {
+            break;
+        }
+        path.clear();
+    }
+    if (path.empty()) {
+        return false;
+    }
+
+    const std::string temp_path = ReplaceExtension(path, ".tmp");
+    const std::string metadata_path = ReplaceExtension(path, ".txt");
+    FILE* file = fopen(temp_path.c_str(), "wb");
+    if (file == nullptr) {
+        return false;
+    }
+    const bool wrote = fwrite(jpeg.data(), 1, jpeg.size(), file) == jpeg.size();
+    const bool flushed = wrote && fflush(file) == 0;
+    const bool synced = flushed && fsync(fileno(file)) == 0;
+    const bool closed = fclose(file) == 0;
+    if (!wrote || !flushed || !synced || !closed) {
+        unlink(temp_path.c_str());
+        return false;
+    }
+
+    std::vector<std::pair<std::string, std::string>> fields;
+    fields.emplace_back("kind", "background_image");
+    fields.emplace_back("device_id", device_id_);
+    fields.emplace_back("boot_id", boot_id_);
+    fields.emplace_back("stream_id", photo_stream_id_);
+    fields.emplace_back("sequence", std::to_string(sequence));
+    fields.emplace_back("record_start_uptime_ms", std::to_string(captured_uptime_ms));
+    fields.emplace_back("captured_at_ms", std::to_string(captured_at_ms));
+    fields.emplace_back("clock_synced", clock_synced ? "1" : "0");
+    fields.emplace_back("duration_ms", "0");
+    fields.emplace_back("content_length", std::to_string(jpeg.size()));
+    fields.emplace_back("sha256", sha256);
+    fields.emplace_back("filename", filename);
+    fields.emplace_back("media_type", "image/jpeg");
+    if (!WriteSmallTextFileAtomic(metadata_path, SerializeUploadFields(fields)) ||
+        rename(temp_path.c_str(), path.c_str()) != 0) {
+        unlink(temp_path.c_str());
+        unlink(metadata_path.c_str());
+        return false;
+    }
+    {
+        std::lock_guard<std::mutex> lock(audio_pending_mutex_);
+        pending_photo_sd_paths_.push_back(path);
+    }
+    ESP_LOGI(TAG, "Queued background photo on SD: path=%s bytes=%u sequence=%llu",
+             path.c_str(), static_cast<unsigned>(jpeg.size()),
+             static_cast<unsigned long long>(sequence));
+    return true;
+#else
+    (void)jpeg;
+    (void)captured_uptime_ms;
+    (void)sequence;
+    (void)path;
+    return false;
+#endif
+}
+
+bool BackgroundCaptureService::StartMediaUploaderTasks() {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE && CONFIG_BACKGROUND_CAPTURE_AUDIO_ENABLE
+    bool audio_started = true;
+    if (!audio_sd_uploader_running_.exchange(true)) {
+        BaseType_t result = xTaskCreate(&BackgroundCaptureService::AudioSdUploaderTaskEntry,
+                                        "bg_audio_upload", 6144, this, tskIDLE_PRIORITY + 1,
+                                        nullptr);
+        if (result != pdPASS) {
+            audio_sd_uploader_running_.store(false);
+            audio_started = false;
+            ESP_LOGW(TAG, "Failed to create SD audio uploader task");
+        }
+    }
+
+    bool photo_started = true;
+    if (!photo_sd_uploader_running_.exchange(true)) {
+        BaseType_t result = xTaskCreate(&BackgroundCaptureService::PhotoSdUploaderTaskEntry,
+                                        "bg_photo_upload", 6144, this, tskIDLE_PRIORITY + 1,
+                                        nullptr);
+        if (result != pdPASS) {
+            photo_sd_uploader_running_.store(false);
+            photo_started = false;
+            ESP_LOGW(TAG, "Failed to create SD photo uploader task");
+        }
+    }
+    return audio_started && photo_started;
+#else
+    return false;
+#endif
+}
