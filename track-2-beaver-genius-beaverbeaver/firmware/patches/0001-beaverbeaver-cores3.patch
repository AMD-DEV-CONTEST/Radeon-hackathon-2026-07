+std::string SerializeUploadFields(
+    const std::vector<std::pair<std::string, std::string>>& fields) {
+    std::string metadata;
+    for (const auto& field : fields) {
+        metadata += field.first + "=" + field.second + "\n";
+    }
+    return metadata;
+}
+
+bool WriteSmallTextFileAtomic(const std::string& path, const std::string& data) {
+    const std::string temp_path = ReplaceExtension(path, ".mtt");
+    FILE* file = fopen(temp_path.c_str(), "wb");
+    if (file == nullptr) {
+        return false;
+    }
+    const bool wrote = fwrite(data.data(), 1, data.size(), file) == data.size();
+    const bool flushed = wrote && fflush(file) == 0;
+    const bool synced = flushed && fsync(fileno(file)) == 0;
+    const bool closed = fclose(file) == 0;
+    if (!wrote || !flushed || !synced || !closed) {
+        unlink(temp_path.c_str());
+        return false;
+    }
+    unlink(path.c_str());
+    if (rename(temp_path.c_str(), path.c_str()) != 0) {
+        unlink(temp_path.c_str());
+        return false;
+    }
+    return true;
+}
+
+std::string PaddedDecimal(uint64_t value, size_t width) {
+    std::string text = std::to_string(value);
+    if (text.size() < width) {
+        text.insert(0, width - text.size(), '0');
+    }
+    return text;
+}
+
+std::string BuildReliableFilename(const char* prefix, const char* extension,
+                                  int64_t captured_at_ms, int64_t monotonic_ms,
+                                  uint32_t sequence) {
+    ConfigureBeijingTimezone();
+    if (captured_at_ms > 0) {
+        time_t captured_sec = static_cast<time_t>(captured_at_ms / 1000);
+        struct tm timeinfo = {};
+        localtime_r(&captured_sec, &timeinfo);
+        char time_part[32];
+        strftime(time_part, sizeof(time_part), "%Y%m%d_%H%M%S", &timeinfo);
+        return std::string(prefix) + "_" + time_part + "_" +
+               PaddedDecimal(static_cast<uint64_t>(captured_at_ms % 1000), 3) + "_" +
+               PaddedDecimal(sequence, 6) + "." + extension;
+    }
+    return std::string(prefix) + "_u" + std::to_string(monotonic_ms) + "_" +
+           PaddedDecimal(sequence, 6) + "." + extension;
+}
+
+bool IsPermanentUploadStatus(int status) {
+    return status == 400 || status == 401 || status == 403 || status == 409 || status == 413 ||
+           status == 415 || status == 422;
