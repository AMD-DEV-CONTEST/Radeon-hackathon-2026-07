+void AddDeviceTimeFields(std::vector<std::pair<std::string, std::string>>& fields) {
+    std::string iso_time;
+    const bool time_valid = IsSystemTimeValid(&iso_time);
+    fields.emplace_back("device_time_valid", time_valid ? "1" : "0");
+    if (time_valid) {
+        fields.emplace_back("device_time_iso", iso_time);
+    }
+    fields.emplace_back("device_upload_uptime_ms",
+                        std::to_string(static_cast<int64_t>(esp_timer_get_time() / 1000)));
+}
