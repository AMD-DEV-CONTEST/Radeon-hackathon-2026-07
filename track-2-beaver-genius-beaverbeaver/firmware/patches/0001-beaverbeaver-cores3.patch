+void SetUploadField(std::vector<std::pair<std::string, std::string>>& fields,
+                    const std::string& key, const std::string& value) {
+    for (auto& field : fields) {
+        if (field.first == key) {
+            field.second = value;
+            return;
+        }
+    }
+    fields.emplace_back(key, value);
+}
