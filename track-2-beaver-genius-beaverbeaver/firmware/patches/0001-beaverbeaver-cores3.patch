+class ActiveUploadGuard {
+public:
+    ActiveUploadGuard(std::atomic<uint32_t>& active_uploads,
+                      std::atomic<uint32_t>& overlap_epoch)
+        : active_uploads_(active_uploads),
+          overlap_epoch_(overlap_epoch),
+          start_epoch_(overlap_epoch_.load()) {
+        overlapped_on_entry_ = active_uploads_.fetch_add(1) > 0;
+        if (overlapped_on_entry_) {
+            overlap_epoch_.fetch_add(1);
+        }
+    }
+
+    ~ActiveUploadGuard() { active_uploads_.fetch_sub(1); }
+
+    bool overlapped() const {
+        return overlapped_on_entry_ || overlap_epoch_.load() != start_epoch_;
+    }
+
+private:
+    std::atomic<uint32_t>& active_uploads_;
+    std::atomic<uint32_t>& overlap_epoch_;
+    uint32_t start_epoch_ = 0;
+    bool overlapped_on_entry_ = false;
+};
+
+void RecordConcurrentHttpFailure(std::atomic<uint32_t>& failures,
+                                 std::atomic<uint32_t>& healthy_uploads) {
+    failures.fetch_add(1);
+    healthy_uploads.store(0);
+}
+
+void RecordConcurrentHttpSuccess(std::atomic<uint32_t>& failures,
+                                 std::atomic<uint32_t>& healthy_uploads) {
+    if (failures.load() == 0) {
+        healthy_uploads.store(0);
+        return;
+    }
+    const uint32_t successes = healthy_uploads.fetch_add(1) + 1;
+    if (successes >= kConcurrentHttpSuccessesToClearFailures) {
+        failures.store(0);
+        healthy_uploads.store(0);
+    }
+}
