+
+bool BackgroundCaptureService::StartAudioStreamTasks() {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE && CONFIG_BACKGROUND_CAPTURE_AUDIO_ENABLE
+    if (CONFIG_BACKGROUND_CAPTURE_AUDIO_DURATION_MS <= 0 ||
+        CONFIG_BACKGROUND_CAPTURE_AUDIO_EVERY_FRAMES <= 0) {
+        return false;
+    }
+    if (audio_stream_tasks_started_.load()) {
+        return true;
+    }
+
+    audio_ringbuf_ = xRingbufferCreateWithCaps(kAudioRingBufferBytes, RINGBUF_TYPE_NOSPLIT,
+                                               MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    audio_ringbuf_with_caps_ = audio_ringbuf_ != nullptr;
+    if (audio_ringbuf_ == nullptr) {
+        audio_ringbuf_ = xRingbufferCreate(kAudioRingBufferBytes, RINGBUF_TYPE_NOSPLIT);
+        audio_ringbuf_with_caps_ = false;
+    }
+    if (audio_ringbuf_ == nullptr) {
+        ESP_LOGW(TAG, "Failed to create background audio ring buffer, fallback to sync capture");
+        return false;
+    }
+
+    ResetAudioTapState();
+    Application::GetInstance().GetAudioService().SetAudioInputTapCallback(
+        [this](const std::vector<int16_t>& pcm, size_t requested_samples) {
+            HandleAudioInputTap(pcm, requested_samples);
+        });
+
+    BaseType_t writer_result =
+        xTaskCreate(&BackgroundCaptureService::AudioWriterTaskEntry, "bg_audio_writer", 8192, this,
+                    CONFIG_BACKGROUND_CAPTURE_TASK_PRIORITY + 1, &audio_writer_task_handle_);
+    BaseType_t record_result =
+        xTaskCreate(&BackgroundCaptureService::AudioRecordTaskEntry, "bg_audio_record", 4096, this,
+                    CONFIG_BACKGROUND_CAPTURE_TASK_PRIORITY + 4, &audio_record_task_handle_);
+    if (writer_result != pdPASS || record_result != pdPASS) {
+        ESP_LOGW(TAG, "Failed to create background audio stream tasks");
+        running_.store(false);
+        return false;
+    }
+
+    audio_stream_tasks_started_.store(true);
+    ESP_LOGI(TAG,
+             "Background audio streaming enabled: ring=%u bytes ring_ms=%u segment_ms=%u "
+             "voice_trigger=%d preroll_ms=%u hangover_ms=%u",
+             static_cast<unsigned>(kAudioRingBufferBytes),
+             static_cast<unsigned>(kAudioRingBufferBytes * 1000 / (16000 * sizeof(int16_t))),
+             static_cast<unsigned>(CONFIG_BACKGROUND_CAPTURE_AUDIO_DURATION_MS),
+             CONFIG_BACKGROUND_CAPTURE_AUDIO_VAD_ENABLE ? 1 : 0, static_cast<unsigned>(kAudioVadPreRollMs),
+             static_cast<unsigned>(kAudioVadHangoverMs));
+    return true;
+#else
+    return false;
+#endif
+}
+
+void BackgroundCaptureService::ResetAudioTapState() {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE && CONFIG_BACKGROUND_CAPTURE_AUDIO_ENABLE
+    constexpr uint32_t sample_rate = 16000;
+    constexpr int samples_per_chunk = 480;
+    constexpr uint32_t chunk_ms = samples_per_chunk * 1000 / sample_rate;
+    const size_t pre_roll_chunks = std::max<size_t>(1, kAudioVadPreRollMs / chunk_ms);
+
+    audio_pre_roll_.clear();
+    audio_pre_roll_.resize(pre_roll_chunks);
+    audio_pre_roll_next_ = 0;
+    audio_pre_roll_full_ = false;
+    audio_voice_active_ = !CONFIG_BACKGROUND_CAPTURE_AUDIO_VAD_ENABLE;
+    audio_silence_chunks_ = 0;
+    audio_voice_candidate_chunks_ = 0;
+    audio_noise_floor_ = 200;
+    audio_channel_summary_logged_ = false;
+#endif
+}
+
+bool BackgroundCaptureService::SendAudioPcmToRingBuffer(const int16_t* data, size_t sample_count) {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE && CONFIG_BACKGROUND_CAPTURE_AUDIO_ENABLE
+    if (audio_ringbuf_ == nullptr || data == nullptr || sample_count == 0) {
+        return false;
+    }
+    const size_t pcm_bytes = sample_count * sizeof(int16_t);
+    if (xRingbufferSend(audio_ringbuf_, data, pcm_bytes, 0) == pdTRUE) {
+        return true;
+    }
+    const uint32_t drops = audio_ring_drops_.fetch_add(1) + 1;
+    if (drops == 1 || drops % 100 == 0) {
+        ESP_LOGW(TAG, "Background audio ring buffer full, dropped chunks=%u",
+                 static_cast<unsigned>(drops));
+    }
+    return false;
+#else
+    (void)data;
+    (void)sample_count;
+    return false;
+#endif
+}
+
+void BackgroundCaptureService::HandleAudioInputTap(const std::vector<int16_t>& pcm,
+                                                   size_t requested_samples) {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE && CONFIG_BACKGROUND_CAPTURE_AUDIO_ENABLE
+    if (Application::GetInstance().GetDeviceState() == kDeviceStateSpeaking) {
+        return;
+    }
+    if (!running_.load() || audio_ringbuf_ == nullptr || requested_samples == 0 || pcm.empty()) {
+        return;
+    }
+
+    std::vector<int16_t> mono;
+    const size_t requested_size = requested_samples;
+    if (pcm.size() == requested_size) {
+        mono = pcm;
+    } else {
+        const size_t channel_count = pcm.size() / requested_size;
+        if (channel_count > 1 && pcm.size() == requested_size * channel_count) {
+            constexpr size_t selected_channel = 0;
+            std::string channel_summary;
+            for (size_t channel = 0; channel < channel_count; ++channel) {
+                const AudioVadMetrics channel_metrics =
+                    CalculateAudioVadMetricsForChannel(pcm, requested_size, channel_count, channel);
+                if (!audio_channel_summary_logged_) {
+                    channel_summary += " ch";
+                    channel_summary += std::to_string(channel);
+                    channel_summary += "=";
+                    channel_summary += std::to_string(channel_metrics.avg_abs);
+                    channel_summary += "/";
+                    channel_summary += std::to_string(channel_metrics.peak_abs);
+                }
+            }
+            if (!audio_channel_summary_logged_) {
+                ESP_LOGI(TAG, "Background audio channel select: channels=%u selected=%u%s",
+                         static_cast<unsigned>(channel_count),
+                         static_cast<unsigned>(selected_channel), channel_summary.c_str());
+                audio_channel_summary_logged_ = true;
+            }
+            mono.resize(requested_size);
+            for (size_t sample = 0; sample < requested_size; ++sample) {
+                mono[sample] = pcm[sample * channel_count + selected_channel];
+            }
+        } else {
+            mono.assign(pcm.begin(), pcm.begin() + std::min(pcm.size(), requested_size));
+        }
+    }
+
+    if (mono.size() > requested_size) {
+        mono.resize(requested_size);
+    }
+    if (mono.empty()) {
+        return;
+    }
+
+    if (!CONFIG_BACKGROUND_CAPTURE_AUDIO_VAD_ENABLE) {
+        SendAudioPcmToRingBuffer(mono.data(), mono.size());
+        return;
+    }
+
+    constexpr uint32_t sample_rate = 16000;
+    constexpr int samples_per_chunk = 480;
+    constexpr uint32_t chunk_ms = samples_per_chunk * 1000 / sample_rate;
+    const uint32_t hangover_chunks = std::max<uint32_t>(1, kAudioVadHangoverMs / chunk_ms);
+
+    auto remember_pre_roll = [this](const std::vector<int16_t>& chunk) {
+        if (audio_pre_roll_.empty()) {
+            return;
+        }
+        audio_pre_roll_[audio_pre_roll_next_] = chunk;
+        audio_pre_roll_next_ = (audio_pre_roll_next_ + 1) % audio_pre_roll_.size();
+        if (audio_pre_roll_next_ == 0) {
+            audio_pre_roll_full_ = true;
+        }
+    };
+
+    auto flush_pre_roll = [this]() {
+        if (audio_pre_roll_.empty()) {
+            return;
+        }
+        const size_t count = audio_pre_roll_full_ ? audio_pre_roll_.size() : audio_pre_roll_next_;
+        const size_t first = audio_pre_roll_full_ ? audio_pre_roll_next_ : 0;
+        for (size_t i = 0; i < count; ++i) {
+            const auto& chunk = audio_pre_roll_[(first + i) % audio_pre_roll_.size()];
+            if (!chunk.empty()) {
+                SendAudioPcmToRingBuffer(chunk.data(), chunk.size());
+            }
+        }
+    };
+
+    const AudioVadMetrics metrics = CalculateAudioVadMetrics(mono.data(), mono.size());
+    const uint32_t dynamic_avg_threshold =
+        std::max<uint32_t>(kAudioVadMinStartAvg, audio_noise_floor_ * 3 + 200);
+    const uint32_t dynamic_peak_threshold =
+        std::max<uint32_t>(kAudioVadMinStartPeak, audio_noise_floor_ * 8);
+    const bool has_voice =
+        metrics.avg_abs >= dynamic_avg_threshold || metrics.peak_abs >= dynamic_peak_threshold;
+
+    if (!audio_voice_active_ && !has_voice) {
+        audio_voice_candidate_chunks_ = 0;
+        audio_noise_floor_ = std::min<uint32_t>(4000, (audio_noise_floor_ * 31 + metrics.avg_abs) / 32);
+        remember_pre_roll(mono);
+        return;
+    }
+
+    if (!audio_voice_active_ && has_voice) {
+        audio_voice_candidate_chunks_++;
+        remember_pre_roll(mono);
+        if (audio_voice_candidate_chunks_ < kAudioVadStartConfirmChunks) {
+            return;
+        }
+        audio_voice_active_ = true;
+        audio_silence_chunks_ = 0;
+        audio_voice_candidate_chunks_ = 0;
+        flush_pre_roll();
+        ESP_LOGI(TAG,
+                 "Background audio voice start: avg=%u peak=%u noise=%u threshold=%u/%u "
+                 "confirm_chunks=%u",
+                 static_cast<unsigned>(metrics.avg_abs), static_cast<unsigned>(metrics.peak_abs),
+                 static_cast<unsigned>(audio_noise_floor_),
+                 static_cast<unsigned>(dynamic_avg_threshold),
+                 static_cast<unsigned>(dynamic_peak_threshold),
+                 static_cast<unsigned>(kAudioVadStartConfirmChunks));
+        return;
+    }
+
+    if (has_voice) {
+        audio_silence_chunks_ = 0;
+        SendAudioPcmToRingBuffer(mono.data(), mono.size());
+    } else if (audio_silence_chunks_ < hangover_chunks) {
+        audio_silence_chunks_++;
+        SendAudioPcmToRingBuffer(mono.data(), mono.size());
+    } else {
+        audio_voice_active_ = false;
+        audio_silence_chunks_ = 0;
+        audio_voice_candidate_chunks_ = 0;
+        audio_noise_floor_ = std::min<uint32_t>(4000, (audio_noise_floor_ * 15 + metrics.avg_abs) / 16);
+        remember_pre_roll(mono);
+        ESP_LOGI(TAG, "Background audio voice stop: avg=%u peak=%u noise=%u",
+                 static_cast<unsigned>(metrics.avg_abs), static_cast<unsigned>(metrics.peak_abs),
+                 static_cast<unsigned>(audio_noise_floor_));
+    }
+#else
+    (void)pcm;
+    (void)requested_samples;
+#endif
+}
+
+void BackgroundCaptureService::AudioRecordTask() {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE && CONFIG_BACKGROUND_CAPTURE_AUDIO_ENABLE
+    auto& audio_service = Application::GetInstance().GetAudioService();
+    constexpr uint32_t sample_rate = 16000;
+    constexpr int samples_per_chunk = 480;
+    std::vector<int16_t> pcm;
+    pcm.reserve(samples_per_chunk * 2);
+
+    while (running_.load()) {
+        if (!IsDirectAudioCaptureAllowed()) {
+            vTaskDelay(pdMS_TO_TICKS(100));
+            continue;
+        }
+
+        // Read only when the main input path is not running. ReadAudioData() will invoke the
+        // audio input tap, so this task must not write to the ring buffer directly.
+        if (!audio_service.ReadAudioData(pcm, sample_rate, samples_per_chunk)) {
+            ESP_LOGW(TAG, "Failed to read background audio frame");
+            vTaskDelay(pdMS_TO_TICKS(10));
+        }
+    }
+    ESP_LOGI(TAG, "Background audio record task stopped");
+#endif
+}
+
+void BackgroundCaptureService::AudioWriterTask() {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE && CONFIG_BACKGROUND_CAPTURE_AUDIO_ENABLE
+    constexpr uint32_t sample_rate = 16000;
+    constexpr uint16_t channels = 1;
+    constexpr uint16_t bits_per_sample = 16;
+    const uint32_t target_samples =
+        std::max<uint32_t>(1, CONFIG_BACKGROUND_CAPTURE_AUDIO_DURATION_MS * sample_rate / 1000);
+
+    FILE* file = nullptr;
+    std::string temp_path;
+    std::string final_path;
+    std::string header;
+    uint32_t segment_samples = 0;
+    uint32_t segment_start_drops = 0;
+    uint64_t segment_sequence = 0;
+    int64_t segment_start_us = 0;
+    int64_t segment_start_uptime_ms = 0;
+    std::vector<uint8_t> write_buffer;
+    write_buffer.reserve(kAudioSdWriteBatchBytes);
+
+    auto flush_write_buffer = [&]() -> bool {
+        if (write_buffer.empty()) {
+            return true;
+        }
+        if (file == nullptr) {
+            write_buffer.clear();
+            return false;
+        }
+        SdSpiAccessGuard sd_guard;
+        const bool ok = sd_guard.ok() && fwrite(write_buffer.data(), 1, write_buffer.size(),
+                                                file) == write_buffer.size();
+        write_buffer.clear();
+        return ok;
+    };
+
+    auto close_segment = [&](bool publish) {
+        if (file == nullptr) {
+            return;
+        }
+        bool ok = true;
+        if (publish) {
+            ok = flush_write_buffer();
+            if (!ok) {
+                ESP_LOGW(TAG, "Failed to flush background audio segment data: %s",
+                         temp_path.c_str());
+            }
+        } else {
+            write_buffer.clear();
+        }
+
+        SdSpiAccessGuard sd_guard;
+        if (!sd_guard.ok()) {
+            ESP_LOGW(TAG, "Skip closing background audio segment, SD bus is busy: %s",
+                     temp_path.c_str());
+            return;
+        }
+        const uint32_t data_size = segment_samples * sizeof(int16_t);
+        WriteWavHeader(header, sample_rate, channels, bits_per_sample, data_size);
+        if (ok && (fseek(file, 0, SEEK_SET) != 0 ||
+                   fwrite(header.data(), 1, header.size(), file) != header.size())) {
+            ESP_LOGW(TAG, "Failed to finalize background audio segment: %s", temp_path.c_str());
+            ok = false;
+        }
+        if (ok && (fflush(file) != 0 || fsync(fileno(file)) != 0)) {
+            ESP_LOGW(TAG, "Failed to sync background audio segment: %s", temp_path.c_str());
+            ok = false;
+        }
+        if (fclose(file) != 0) {
+            ESP_LOGW(TAG, "Failed to close background audio segment: %s", temp_path.c_str());
+            ok = false;
+        }
+        file = nullptr;
+
+        if (publish && ok && segment_samples > 0) {
+            const size_t bytes = 44 + data_size;
+            const std::string sha256 = Sha256File(temp_path);
+            if (sha256.empty()) {
+                ESP_LOGW(TAG, "Failed to hash completed background audio segment: %s",
+                         temp_path.c_str());
+                ok = false;
+            }
+            const uint32_t segment_ms =
+                static_cast<uint32_t>((esp_timer_get_time() - segment_start_us) / 1000);
+            const int64_t segment_end_uptime_ms = esp_timer_get_time() / 1000;
+            const int64_t duration_ms = segment_samples * 1000 / sample_rate;
+            const bool clock_synced = IsSystemTimeValid();
+            const int64_t captured_at_ms =
+                clock_synced
+                    ? GetWallTimeMs() -
+                          std::max<int64_t>(0, segment_end_uptime_ms - segment_start_uptime_ms)
+                    : 0;
+            const std::string filename = BuildReliableFilename(
+                "audio", "wav", captured_at_ms, segment_start_uptime_ms, segment_sequence);
+            const std::string metadata_path = ReplaceExtension(final_path, ".txt");
+            std::vector<std::pair<std::string, std::string>> fields;
+            fields.emplace_back("kind", "background_audio");
+            fields.emplace_back("device_id", device_id_);
+            fields.emplace_back("boot_id", boot_id_);
+            fields.emplace_back("stream_id", audio_stream_id_);
+            fields.emplace_back("sequence", std::to_string(segment_sequence));
+            fields.emplace_back("record_start_uptime_ms",
+                                std::to_string(segment_start_uptime_ms));
+            fields.emplace_back("record_end_uptime_ms", std::to_string(segment_end_uptime_ms));
+            fields.emplace_back("record_duration_ms", std::to_string(duration_ms));
+            fields.emplace_back("captured_at_ms", std::to_string(captured_at_ms));
+            fields.emplace_back("clock_synced", clock_synced ? "1" : "0");
+            fields.emplace_back("duration_ms", std::to_string(duration_ms));
+            fields.emplace_back("content_length", std::to_string(bytes));
+            fields.emplace_back("sha256", sha256);
+            fields.emplace_back("filename", filename);
+            fields.emplace_back("media_type", "audio/wav");
+            if (ok && WriteSmallTextFileAtomic(metadata_path, SerializeUploadFields(fields)) &&
+                rename(temp_path.c_str(), final_path.c_str()) == 0) {
+                {
+                    std::lock_guard<std::mutex> lock(audio_pending_mutex_);
+                    pending_audio_sd_paths_.push_back(final_path);
+                }
+                const uint32_t total_drops = audio_ring_drops_.load();
+                const uint32_t segment_drops = total_drops - segment_start_drops;
+                ESP_LOGI(TAG,
+                         "Queued background audio on SD: path=%s bytes=%u samples=%u "
+                         "segment_ms=%u streaming=1 segment_drops=%u total_drops=%u "
+                         "writer_stack_min_free=%u",
+                         final_path.c_str(), static_cast<unsigned>(bytes),
+                         static_cast<unsigned>(segment_samples), static_cast<unsigned>(segment_ms),
+                         static_cast<unsigned>(segment_drops), static_cast<unsigned>(total_drops),
+                         static_cast<unsigned>(uxTaskGetStackHighWaterMark(nullptr)));
+                StartMediaUploaderTasks();
+            } else {
+                ESP_LOGW(TAG, "Failed to publish background audio segment: %s", final_path.c_str());
+                unlink(temp_path.c_str());
+                unlink(metadata_path.c_str());
+            }
+        } else {
+            unlink(temp_path.c_str());
+        }
+        temp_path.clear();
+        final_path.clear();
+        segment_samples = 0;
+        segment_start_drops = audio_ring_drops_.load();
+        segment_start_us = 0;
+        segment_start_uptime_ms = 0;
+        segment_sequence = 0;
+    };
+
+    auto open_segment = [&]() -> bool {
+        if (!EnsureAudioSdQueue()) {
+            return false;
+        }
+        SdSpiAccessGuard sd_guard;
+        if (!sd_guard.ok()) {
+            return false;
+        }
+        for (int attempt = 0; attempt < 8; ++attempt) {
+            const uint32_t serial = audio_stream_segments_.fetch_add(1) + 1;
+            const uint32_t short_id = serial % 10000000;
+            char final_path_buffer[80];
+            snprintf(final_path_buffer, sizeof(final_path_buffer), "%s/a%07lu.wav",
+                     kAudioSdQueueDir, static_cast<unsigned long>(short_id));
+            final_path = final_path_buffer;
+            temp_path = ReplaceExtension(final_path, ".tmp");
+            struct stat existing = {};
+            if (stat(final_path.c_str(), &existing) != 0 && errno == ENOENT) {
+                break;
+            }
+            final_path.clear();
+            temp_path.clear();
+        }
+        if (final_path.empty()) {
+            return false;
+        }
+        errno = 0;
+        file = fopen(temp_path.c_str(), "wb+");
+        if (file == nullptr) {
+            ESP_LOGW(TAG, "Failed to open background audio segment: %s errno=%d %s",
+                     temp_path.c_str(), errno, strerror(errno));
+            return false;
+        }
+        WriteWavHeader(header, sample_rate, channels, bits_per_sample, 0);
+        if (fwrite(header.data(), 1, header.size(), file) != header.size()) {
+            ESP_LOGW(TAG, "Failed to write background audio segment header: %s", temp_path.c_str());
+            fclose(file);
+            file = nullptr;
+            unlink(temp_path.c_str());
+            return false;
+        }
+        write_buffer.clear();
+        segment_samples = 0;
+        segment_start_drops = audio_ring_drops_.load();
+        segment_start_us = esp_timer_get_time();
+        segment_start_uptime_ms = segment_start_us / 1000;
+        segment_sequence = audio_sequence_.fetch_add(1);
+        return true;
+    };
+
+    while (running_.load()) {
+        size_t item_size = 0;
+        auto* item = static_cast<uint8_t*>(
+            xRingbufferReceive(audio_ringbuf_, &item_size, pdMS_TO_TICKS(kAudioWriterIdleCloseMs)));
+        if (item == nullptr) {
+            if (file != nullptr && segment_samples > 0 && CONFIG_BACKGROUND_CAPTURE_AUDIO_VAD_ENABLE) {
+                close_segment(true);
+            }
+            continue;
+        }
+
+        if (file == nullptr && !open_segment()) {
+            vRingbufferReturnItem(audio_ringbuf_, item);
+            vTaskDelay(pdMS_TO_TICKS(1000));
+            continue;
+        }
+
+        size_t offset = 0;
+        while (offset < item_size && file != nullptr) {
+            const uint32_t remaining_samples = target_samples - segment_samples;
+            const size_t remaining_bytes = remaining_samples * sizeof(int16_t);
+            const size_t write_bytes = std::min(item_size - offset, remaining_bytes);
+            write_buffer.insert(write_buffer.end(), item + offset, item + offset + write_bytes);
+            const bool should_flush =
+                write_buffer.size() >= kAudioSdWriteBatchBytes || write_bytes == remaining_bytes;
+            if (should_flush && !flush_write_buffer()) {
+                ESP_LOGW(TAG, "Failed to write background audio segment data: %s",
+                         temp_path.c_str());
+                close_segment(false);
+                break;
+            }
+            offset += write_bytes;
+            segment_samples += write_bytes / sizeof(int16_t);
+            if (segment_samples >= target_samples) {
+                close_segment(true);
+                if (offset < item_size && !open_segment()) {
+                    break;
+                }
+            }
+        }
+        vRingbufferReturnItem(audio_ringbuf_, item);
+    }
+
+    close_segment(segment_samples > 0);
+    ESP_LOGI(TAG, "Background audio writer task stopped");
+#endif
+}
+
+bool BackgroundCaptureService::FindNextAudioFileOnSd(std::string& path) {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE && CONFIG_BACKGROUND_CAPTURE_AUDIO_ENABLE
+    {
+        std::lock_guard<std::mutex> lock(audio_pending_mutex_);
+        if (!pending_audio_sd_paths_.empty()) {
+            path = pending_audio_sd_paths_.front();
+            ESP_LOGI(TAG, "Found current-boot SD audio file for upload: %s", path.c_str());
+            return true;
+        }
+    }
+
+    SdSpiAccessGuard sd_guard;
+    if (!sd_guard.ok()) {
+        return false;
+    }
+    DIR* dir = opendir(kAudioSdQueueDir);
+    if (dir == nullptr) {
+        return false;
+    }
+
+    std::string best_name;
+    while (struct dirent* entry = readdir(dir)) {
+        const std::string name = entry->d_name;
+        if (name.size() < 5 ||
+            (name.rfind(".wav") != name.size() - 4 && name.rfind(".WAV") != name.size() - 4)) {
+            continue;
+        }
+        if (best_name.empty() || name < best_name) {
+            best_name = name;
+        }
+    }
+    closedir(dir);
+
+    if (best_name.empty()) {
+        return false;
+    }
+    path = std::string(kAudioSdQueueDir) + "/" + best_name;
+    ESP_LOGI(TAG, "Found SD audio file for upload: %s", path.c_str());
+    return true;
+#else
+    (void)path;
+    return false;
+#endif
+}
+
+bool BackgroundCaptureService::FindNextPhotoFileOnSd(std::string& path) {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE
+    std::vector<std::string> paths;
+    if (!FindNextPhotoFilesOnSd(paths, 1)) {
+        return false;
+    }
+    path = std::move(paths.front());
+    ESP_LOGI(TAG, "Found SD photo for upload: %s", path.c_str());
+    return true;
+#else
+    (void)path;
+    return false;
+#endif
+}
+
+bool BackgroundCaptureService::FindNextPhotoFilesOnSd(std::vector<std::string>& paths,
+                                                       size_t limit) {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE
+    paths.clear();
+    if (limit == 0) {
+        return false;
+    }
+    {
+        std::lock_guard<std::mutex> lock(audio_pending_mutex_);
+        for (const auto& pending_path : pending_photo_sd_paths_) {
+            if (std::find(paths.begin(), paths.end(), pending_path) == paths.end()) {
+                paths.push_back(pending_path);
+            }
+            if (paths.size() >= limit) {
+                return true;
+            }
+        }
+    }
+
+    SdSpiAccessGuard sd_guard;
+    if (!sd_guard.ok()) {
+        return false;
+    }
+    DIR* dir = opendir(kPhotoSdQueueDir);
+    if (dir == nullptr) {
+        return false;
+    }
+    std::vector<std::string> names;
+    while (struct dirent* entry = readdir(dir)) {
+        const std::string name = entry->d_name;
+        if (name.size() < 5 ||
+            (name.rfind(".jpg") != name.size() - 4 && name.rfind(".JPG") != name.size() - 4)) {
+            continue;
+        }
+        names.push_back(name);
+    }
+    closedir(dir);
+    std::sort(names.begin(), names.end());
+    for (const auto& name : names) {
+        const std::string persisted_path = std::string(kPhotoSdQueueDir) + "/" + name;
+        if (std::find(paths.begin(), paths.end(), persisted_path) == paths.end()) {
+            paths.push_back(persisted_path);
+        }
+        if (paths.size() >= limit) {
+            break;
+        }
+    }
+    return !paths.empty();
+#else
+    (void)paths;
+    (void)limit;
+    return false;
+#endif
+}
+
+bool BackgroundCaptureService::UploadNextAudioFileFromSd() {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE && CONFIG_BACKGROUND_CAPTURE_AUDIO_ENABLE
+    std::string path;
+    if (!FindNextAudioFileOnSd(path)) {
+        return false;
+    }
+
+    auto forget_pending_path = [this, &path]() {
+        std::lock_guard<std::mutex> lock(audio_pending_mutex_);
+        const auto found =
+            std::find(pending_audio_sd_paths_.begin(), pending_audio_sd_paths_.end(), path);
+        if (found != pending_audio_sd_paths_.end()) {
+            pending_audio_sd_paths_.erase(found);
+        }
+    };
+
+    std::string audio_metadata;
+    {
+        SdSpiAccessGuard sd_guard;
+        if (!sd_guard.ok()) {
+            return false;
+        }
+        struct stat audio_stat = {};
+        errno = 0;
+        if (stat(path.c_str(), &audio_stat) != 0) {
+            const int stat_errno = errno;
+            if (stat_errno == ENOENT) {
+                ESP_LOGW(TAG, "Drop missing audio path from pending queue: %s", path.c_str());
+                forget_pending_path();
+                return true;
+            }
+            ESP_LOGW(TAG, "Failed to stat SD audio file: path=%s errno=%d %s", path.c_str(),
+                     stat_errno, strerror(stat_errno));
+            return false;
+        }
+        ReadSmallTextFile(ReplaceExtension(path, ".txt"), audio_metadata);
+    }
+
+    std::vector<std::pair<std::string, std::string>> fields;
+    BuildAudioUploadFields(capture_count_, fields);
+    AddAudioSegmentTimingFields(audio_metadata, fields);
+#if CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_ENABLE
+    const bool identity_upgraded = UpgradeLegacyMediaIdentity(fields, audio_stream_id_);
+    std::string metadata_stream_id;
+    std::string metadata_boot_id;
+    std::string metadata_sequence;
+    const bool has_reliable_identity =
+        GetUploadField(fields, "boot_id", metadata_boot_id) &&
+        GetUploadField(fields, "stream_id", metadata_stream_id) &&
+        GetUploadField(fields, "sequence", metadata_sequence);
+    if (!has_reliable_identity) {
+        std::string quarantined_path;
+        if (!QuarantineMediaFile(path, ".BAD", quarantined_path)) {
+            audio_retry_needed_ = true;
+            return false;
+        }
+        ESP_LOGW(TAG, "Quarantined legacy audio without reliable identity: %s",
+                 quarantined_path.c_str());
+        forget_pending_path();
+        return true;
+    }
+    if (identity_upgraded) {
+        SdSpiAccessGuard sd_guard;
+        if (!sd_guard.ok() ||
+            !WriteSmallTextFileAtomic(ReplaceExtension(path, ".txt"),
+                                      SerializeUploadFields(fields))) {
+            audio_retry_needed_ = true;
+            return false;
+        }
+        ESP_LOGI(TAG, "Upgraded legacy audio upload identity: %s", path.c_str());
+    }
+    std::string metadata_device_id;
+    if (!GetUploadField(fields, "device_id", metadata_device_id)) {
+        fields.emplace_back("device_id", device_id_);
+    }
+#else
+    std::string sequence;
+    if (!GetUploadField(fields, "sequence", sequence)) {
+        fields.emplace_back("sequence", std::to_string(audio_sequence_.fetch_add(1)));
+    }
+#endif
+
+    std::string audio_wav;
+    {
+        SdSpiAccessGuard sd_guard;
+        if (!sd_guard.ok()) {
+            return false;
+        }
+        FILE* file = fopen(path.c_str(), "rb");
+        if (file == nullptr) {
+            const int open_errno = errno;
+            ESP_LOGW(TAG, "Failed to open SD audio file for upload: path=%s errno=%d %s",
+                     path.c_str(), open_errno, strerror(open_errno));
+            forget_pending_path();
+            return true;
+        }
+
+        fseek(file, 0, SEEK_END);
+        const long file_size = ftell(file);
+        rewind(file);
+        if (file_size <= 0) {
+            fclose(file);
+            unlink(path.c_str());
+            unlink(ReplaceExtension(path, ".txt").c_str());
+            forget_pending_path();
+            return true;
+        }
+
+        audio_wav.resize(static_cast<size_t>(file_size));
+        const size_t read_size = fread(audio_wav.data(), 1, audio_wav.size(), file);
+        fclose(file);
+        if (read_size != audio_wav.size()) {
+            ESP_LOGW(TAG, "Failed to read complete SD audio file: %s", path.c_str());
+            audio_retry_needed_ = true;
+            return false;
+        }
+    }
+
+    const std::string computed_sha256 = Sha256Hex(audio_wav);
+    std::string stored_sha256;
+    std::string stored_content_length;
+    GetUploadField(fields, "sha256", stored_sha256);
+    GetUploadField(fields, "content_length", stored_content_length);
+    if (computed_sha256.empty() || (!stored_sha256.empty() && stored_sha256 != computed_sha256)) {
+        std::string quarantined_path;
+        if (!QuarantineMediaFile(path, ".BAD", quarantined_path)) {
+            audio_retry_needed_ = true;
+            return false;
+        }
+        ESP_LOGE(TAG, "Quarantined audio with SHA-256 mismatch: %s", quarantined_path.c_str());
+        forget_pending_path();
+        return true;
+    }
+    const std::string computed_content_length = std::to_string(audio_wav.size());
+    const bool metadata_needs_update =
+        stored_sha256.empty() || stored_content_length != computed_content_length;
+    SetUploadField(fields, "sha256", computed_sha256);
+    SetUploadField(fields, "content_length", computed_content_length);
+    if (metadata_needs_update) {
+        SdSpiAccessGuard sd_guard;
+        if (!sd_guard.ok() ||
+            !WriteSmallTextFileAtomic(ReplaceExtension(path, ".txt"),
+                                      SerializeUploadFields(fields))) {
+            audio_retry_needed_ = true;
+            return false;
+        }
+    }
+
+    const std::string upload_filename = BuildAudioUploadFilename(fields);
+    const int64_t upload_start_us = esp_timer_get_time();
+#if CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_ENABLE
+    int response_status = 0;
+    const bool upload_ok = UploadBeaverFile("audio/wav", audio_wav, fields, &response_status);
+#else
+    const bool upload_ok = UploadFile(CONFIG_BACKGROUND_CAPTURE_AUDIO_UPLOAD_URL, upload_filename,
+                                      "audio/wav", audio_wav, fields);
+#endif
+    const int64_t upload_done_us = esp_timer_get_time();
+    ESP_LOGI(TAG, "SD audio upload: path=%s filename=%s bytes=%u upload_ms=%u upload=%s",
+             path.c_str(), upload_filename.c_str(), static_cast<unsigned>(audio_wav.size()),
+             static_cast<unsigned>((upload_done_us - upload_start_us) / 1000),
+             upload_ok ? "ok" : "failed");
+
+    if (upload_ok) {
+        // Remove the volatile queue entry first. If cleanup is interrupted, the remaining SD file
+        // can still be rediscovered after restart; deleting the file first could leave a missing
+        // path permanently blocking the in-memory queue.
+        forget_pending_path();
+        SdSpiAccessGuard sd_guard;
+        if (!sd_guard.ok()) {
+            return false;
+        }
+        unlink(path.c_str());
+        unlink(ReplaceExtension(path, ".txt").c_str());
+        return true;
+    }
+#if CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_ENABLE
+    if (response_status == 401) {
+        media_upload_auth_failed_.store(true);
+        ESP_LOGE(TAG, "Stop media uploads after authentication failure; check device token");
+        return false;
+    }
+    if (IsPermanentUploadStatus(response_status)) {
+        std::string quarantined_path;
+        if (QuarantineMediaFile(path, ".BAD", quarantined_path)) {
+            ESP_LOGE(TAG, "Audio upload permanently rejected status=%d path=%s", response_status,
+                     quarantined_path.c_str());
+            forget_pending_path();
+            return true;
+        }
+    }
+#endif
+    audio_retry_needed_ = true;
+    return false;
+#else
+    return false;
+#endif
+}
+
+bool BackgroundCaptureService::UploadNextPhotoFileFromSd() {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE
+    std::string path;
+    if (!FindNextPhotoFileOnSd(path)) {
+        return false;
+    }
+    auto forget_pending_path = [this, &path]() {
+        std::lock_guard<std::mutex> lock(audio_pending_mutex_);
+        const auto found =
+            std::find(pending_photo_sd_paths_.begin(), pending_photo_sd_paths_.end(), path);
+        if (found != pending_photo_sd_paths_.end()) {
+            pending_photo_sd_paths_.erase(found);
+        }
+    };
+
+    std::string metadata;
+    {
+        SdSpiAccessGuard sd_guard;
+        if (!sd_guard.ok()) {
+            photo_retry_needed_ = true;
+            return false;
+        }
+        struct stat photo_stat = {};
+        errno = 0;
+        if (stat(path.c_str(), &photo_stat) != 0) {
+            if (errno == ENOENT) {
+                forget_pending_path();
+                return true;
+            }
+            photo_retry_needed_ = true;
+            return false;
+        }
+        ReadSmallTextFile(ReplaceExtension(path, ".txt"), metadata);
+    }
+
+    std::vector<std::pair<std::string, std::string>> fields;
+    BuildImageUploadFields(capture_count_, fields);
+    AddAudioSegmentTimingFields(metadata, fields);
+    const bool identity_upgraded = UpgradeLegacyMediaIdentity(fields, photo_stream_id_);
+    std::string metadata_stream_id;
+    std::string metadata_boot_id;
+    std::string metadata_sequence;
+    if (!GetUploadField(fields, "boot_id", metadata_boot_id) ||
+        !GetUploadField(fields, "stream_id", metadata_stream_id) ||
+        !GetUploadField(fields, "sequence", metadata_sequence)) {
+        std::string quarantined_path;
+        if (!QuarantineMediaFile(path, ".BAD", quarantined_path)) {
+            photo_retry_needed_ = true;
+            return false;
+        }
+        ESP_LOGW(TAG, "Quarantined photo without reliable identity: %s",
+                 quarantined_path.c_str());
+        forget_pending_path();
+        return true;
+    }
+    if (identity_upgraded) {
+        SdSpiAccessGuard sd_guard;
+        if (!sd_guard.ok() ||
+            !WriteSmallTextFileAtomic(ReplaceExtension(path, ".txt"),
+                                      SerializeUploadFields(fields))) {
+            photo_retry_needed_ = true;
+            return false;
+        }
+        ESP_LOGI(TAG, "Upgraded legacy photo upload identity: %s", path.c_str());
+    }
+    std::string metadata_device_id;
+    if (!GetUploadField(fields, "device_id", metadata_device_id)) {
+        fields.emplace_back("device_id", device_id_);
+    }
+
+    std::string jpeg;
+    {
+        SdSpiAccessGuard sd_guard;
+        if (!sd_guard.ok()) {
+            photo_retry_needed_ = true;
+            return false;
+        }
+        FILE* file = fopen(path.c_str(), "rb");
+        if (file == nullptr) {
+            forget_pending_path();
+            return true;
+        }
+        fseek(file, 0, SEEK_END);
+        const long file_size = ftell(file);
+        rewind(file);
+        if (file_size <= 0) {
+            fclose(file);
+            unlink(path.c_str());
+            unlink(ReplaceExtension(path, ".txt").c_str());
+            forget_pending_path();
+            return true;
+        }
+        jpeg.resize(static_cast<size_t>(file_size));
+        const size_t read_size = fread(jpeg.data(), 1, jpeg.size(), file);
+        fclose(file);
+        if (read_size != jpeg.size()) {
+            photo_retry_needed_ = true;
+            return false;
+        }
+    }
+
+    const std::string computed_sha256 = Sha256Hex(jpeg);
+    std::string stored_sha256;
+    GetUploadField(fields, "sha256", stored_sha256);
+    if (computed_sha256.empty() || (!stored_sha256.empty() && stored_sha256 != computed_sha256)) {
+        std::string quarantined_path;
+        if (!QuarantineMediaFile(path, ".BAD", quarantined_path)) {
+            photo_retry_needed_ = true;
+            return false;
+        }
+        ESP_LOGE(TAG, "Quarantined photo with SHA-256 mismatch: %s", quarantined_path.c_str());
+        forget_pending_path();
+        return true;
+    }
+    SetUploadField(fields, "sha256", computed_sha256);
+    SetUploadField(fields, "content_length", std::to_string(jpeg.size()));
+    std::string upload_filename;
+    if (!GetUploadField(fields, "filename", upload_filename) || upload_filename.empty()) {
+        upload_filename = BuildImageUploadFilename();
+        SetUploadField(fields, "filename", upload_filename);
+    }
+#if CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_ENABLE
+    int response_status = 0;
+    const bool upload_ok = UploadBeaverFile("image/jpeg", jpeg, fields, &response_status);
+#else
+    const bool upload_ok = UploadFile(CONFIG_BACKGROUND_CAPTURE_IMAGE_UPLOAD_URL, upload_filename,
+                                      "image/jpeg", jpeg, fields);
+#endif
+    ESP_LOGI(TAG, "SD photo upload: path=%s filename=%s bytes=%u upload=%s", path.c_str(),
+             upload_filename.c_str(), static_cast<unsigned>(jpeg.size()),
+             upload_ok ? "ok" : "failed");
+    if (!upload_ok) {
+#if CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_ENABLE
+        if (response_status == 401) {
+            media_upload_auth_failed_.store(true);
+            ESP_LOGE(TAG, "Stop media uploads after authentication failure; check device token");
+            return false;
+        }
+        if (IsPermanentUploadStatus(response_status)) {
+            std::string quarantined_path;
+            if (QuarantineMediaFile(path, ".BAD", quarantined_path)) {
+                ESP_LOGE(TAG, "Photo upload permanently rejected status=%d path=%s",
+                         response_status, quarantined_path.c_str());
+                forget_pending_path();
+                return true;
+            }
+        }
+#endif
+        photo_retry_needed_ = true;
+        return false;
+    }
+
+    forget_pending_path();
+    SdSpiAccessGuard sd_guard;
+    if (!sd_guard.ok()) {
+        photo_retry_needed_ = true;
+        return false;
+    }
+    unlink(path.c_str());
+    unlink(ReplaceExtension(path, ".txt").c_str());
+    return true;
+#else
+    return false;
+#endif
+}
+
+bool BackgroundCaptureService::UploadNextPhotoBatchFromSd() {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE && CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_ENABLE
+    std::vector<std::string> paths;
+    if (!FindNextPhotoFilesOnSd(paths, kPhotoUploadBatchSize)) {
+        photo_batch_wait_started_us_ = 0;
+        photo_batch_waiting_count_ = 0;
+        return false;
+    }
+
+    if (paths.size() < kPhotoUploadBatchSize) {
+        const int64_t now_us = esp_timer_get_time();
+        if (photo_batch_wait_started_us_ == 0) {
+            photo_batch_wait_started_us_ = now_us;
+        }
+        const uint32_t waited_ms = static_cast<uint32_t>(
+            std::max<int64_t>(0, now_us - photo_batch_wait_started_us_) / 1000);
+        if (waited_ms < kPhotoBatchPartialFlushMs) {
+            if (photo_batch_waiting_count_ != paths.size()) {
+                photo_batch_waiting_count_ = paths.size();
+                ESP_LOGI(TAG, "Photo batch waiting: queued=%u required=%u max_wait_ms=%u",
+                         static_cast<unsigned>(paths.size()),
+                         static_cast<unsigned>(kPhotoUploadBatchSize),
+                         static_cast<unsigned>(kPhotoBatchPartialFlushMs));
+            }
+            return false;
+        }
+        ESP_LOGI(TAG, "Flush partial photo batch after %u ms: items=%u",
+                 static_cast<unsigned>(waited_ms), static_cast<unsigned>(paths.size()));
+    }
+    photo_batch_wait_started_us_ = 0;
+    photo_batch_waiting_count_ = 0;
+
+    auto upload_single_to_unblock = [this](const char* reason) {
+        photo_batch_healthy_uploads_ = 0;
+        ESP_LOGW(TAG, "Photo batch cannot group queue head (%s); upload one photo to unblock",
+                 reason);
+        return UploadNextPhotoFileFromSd();
+    };
+
+    std::vector<PhotoBatchUploadItem> items;
+    items.reserve(kPhotoUploadBatchSize);
+    std::string batch_device_id;
+    std::string batch_boot_id;
+    std::string batch_stream_id;
+    for (const auto& path : paths) {
+        std::string metadata;
+        long file_size = 0;
+        bool file_ready = false;
+        {
+            SdSpiAccessGuard sd_guard;
+            if (!sd_guard.ok()) {
+                photo_retry_needed_ = true;
+                return false;
+            }
+            struct stat photo_stat = {};
+            file_ready = stat(path.c_str(), &photo_stat) == 0 && photo_stat.st_size > 0 &&
+                         ReadSmallTextFile(ReplaceExtension(path, ".txt"), metadata);
+            if (file_ready) {
+                file_size = photo_stat.st_size;
+            }
+        }
+        if (!file_ready) {
+            return upload_single_to_unblock("file-or-metadata-not-ready");
+        }
+
+        PhotoBatchUploadItem item;
+        item.path = path;
+        BuildImageUploadFields(capture_count_, item.fields);
+        AddAudioSegmentTimingFields(metadata, item.fields);
+        if (UpgradeLegacyMediaIdentity(item.fields, photo_stream_id_)) {
+            return upload_single_to_unblock("legacy-metadata");
+        }
+
+        std::string item_device_id;
+        std::string item_boot_id;
+        std::string item_stream_id;
+        int64_t sequence = -1;
+        if (!GetUploadField(item.fields, "device_id", item_device_id) ||
+            !GetUploadField(item.fields, "boot_id", item_boot_id) ||
+            !GetUploadField(item.fields, "stream_id", item_stream_id) ||
+            !GetUploadFieldInt64(item.fields, "sequence", sequence) || sequence < 0) {
+            return upload_single_to_unblock("invalid-identity");
+        }
+        if (items.empty()) {
+            batch_device_id = item_device_id;
+            batch_boot_id = item_boot_id;
+            batch_stream_id = item_stream_id;
+        } else if (item_device_id != batch_device_id || item_boot_id != batch_boot_id ||
+                   item_stream_id != batch_stream_id) {
+            return upload_single_to_unblock("mixed-streams");
+        }
+
+        std::string stored_sha256;
+        if (!GetUploadField(item.fields, "sha256", stored_sha256) || stored_sha256.empty()) {
+            return upload_single_to_unblock("missing-sha256");
+        }
+        std::string computed_sha256;
+        {
+            SdSpiAccessGuard sd_guard;
+            if (!sd_guard.ok()) {
+                photo_retry_needed_ = true;
+                return false;
+            }
+            computed_sha256 = Sha256File(path);
+        }
+        if (computed_sha256.empty() || computed_sha256 != stored_sha256) {
+            return upload_single_to_unblock("sha256-mismatch");
+        }
+        item.content_length = static_cast<size_t>(file_size);
+        item.sequence = static_cast<uint64_t>(sequence);
+        SetUploadField(item.fields, "content_length", std::to_string(item.content_length));
+        items.emplace_back(std::move(item));
+    }
+
+    std::vector<PhotoBatchAck> acknowledgements;
+    int response_status = 0;
+    if (!UploadBeaverPhotoBatch(items, acknowledgements, &response_status)) {
+        photo_batch_healthy_uploads_ = 0;
+        if (response_status == 401) {
+            media_upload_auth_failed_.store(true);
+            ESP_LOGE(TAG, "Stop media uploads after batch authentication failure");
+        } else if (response_status == 404 || response_status == 405) {
+            photo_batch_mode_ = false;
+            photo_batch_wait_started_us_ = 0;
+            photo_batch_waiting_count_ = 0;
+            concurrent_http_failures_.store(0);
+            concurrent_http_healthy_uploads_.store(0);
+            ESP_LOGW(TAG, "Photo batch endpoint unavailable; return to single-photo uploads");
+        } else {
+            photo_retry_needed_ = true;
+        }
+        return false;
+    }
+
+    bool progressed = false;
+    bool retry_remaining = false;
+    bool all_items_accepted = true;
+    for (const auto& item : items) {
+        const auto ack = std::find_if(
+            acknowledgements.begin(), acknowledgements.end(),
+            [&item](const PhotoBatchAck& candidate) { return candidate.sequence == item.sequence; });
+        if (ack == acknowledgements.end() || ack->retry) {
+            retry_remaining = true;
+            all_items_accepted = false;
+            continue;
+        }
+
+        auto forget_pending_path = [this, &item]() {
+            std::lock_guard<std::mutex> lock(audio_pending_mutex_);
+            const auto found =
+                std::find(pending_photo_sd_paths_.begin(), pending_photo_sd_paths_.end(), item.path);
+            if (found != pending_photo_sd_paths_.end()) {
+                pending_photo_sd_paths_.erase(found);
+            }
+        };
+        if (ack->status == "accepted" || ack->status == "already_accepted") {
+            forget_pending_path();
+            SdSpiAccessGuard sd_guard;
+            if (!sd_guard.ok()) {
+                retry_remaining = true;
+                continue;
+            }
+            unlink(item.path.c_str());
+            unlink(ReplaceExtension(item.path, ".txt").c_str());
+            progressed = true;
+        } else {
+            all_items_accepted = false;
+            std::string quarantined_path;
+            if (QuarantineMediaFile(item.path, ".BAD", quarantined_path)) {
+                forget_pending_path();
+                progressed = true;
+                ESP_LOGE(TAG, "Batched photo permanently rejected: sequence=%llu status=%s",
+                         static_cast<unsigned long long>(item.sequence), ack->status.c_str());
+            } else {
+                retry_remaining = true;
+            }
+        }
+    }
+    photo_retry_needed_ = retry_remaining;
+    if (items.size() == kPhotoUploadBatchSize && all_items_accepted && !retry_remaining) {
+        photo_batch_healthy_uploads_++;
+        if (photo_batch_healthy_uploads_ >= kHealthyPhotoBatchesBeforeSingleProbe) {
+            photo_batch_mode_ = false;
+            photo_batch_healthy_uploads_ = 0;
+            concurrent_http_failures_.store(0);
+            concurrent_http_healthy_uploads_.store(0);
+            ESP_LOGI(TAG,
+                     "Photo batch channel healthy for %u batches; probe single-photo uploads",
+                     static_cast<unsigned>(kHealthyPhotoBatchesBeforeSingleProbe));
+        }
+    } else {
+        photo_batch_healthy_uploads_ = 0;
+    }
+    return progressed;
+#else
+    return UploadNextPhotoFileFromSd();
+#endif
+}
+
+bool BackgroundCaptureService::EncodeAudioWav(std::string& audio_wav) {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE && CONFIG_BACKGROUND_CAPTURE_AUDIO_ENABLE
+    auto& app = Application::GetInstance();
+    auto& audio_service = app.GetAudioService();
+    const bool wake_word_was_running = audio_service.IsWakeWordRunning();
+
+    if (wake_word_was_running) {
+        audio_service.EnableWakeWordDetection(false);
+        vTaskDelay(pdMS_TO_TICKS(120));
+    }
+
+    constexpr uint32_t sample_rate = 16000;
+    constexpr uint16_t channels = 1;
+    constexpr uint16_t bits_per_sample = 16;
+    constexpr int samples_per_chunk = 480;
+    const uint32_t target_samples =
+        std::max<uint32_t>(1, CONFIG_BACKGROUND_CAPTURE_AUDIO_DURATION_MS * sample_rate / 1000);
+
+    audio_wav.clear();
+    audio_wav.reserve(44 + target_samples * sizeof(int16_t));
+    WriteWavHeader(audio_wav, sample_rate, channels, bits_per_sample, 0);
+    std::vector<int16_t> pcm;
+    pcm.reserve(samples_per_chunk * 2);
+
+    bool ok = true;
+    uint32_t captured_samples = 0;
+    while (running_.load() && captured_samples < target_samples) {
+        if (!IsDirectAudioCaptureAllowed()) {
+            break;
+        }
+
+        const int requested_samples =
+            std::min<uint32_t>(samples_per_chunk, target_samples - captured_samples);
+        if (!audio_service.ReadAudioData(pcm, sample_rate, requested_samples)) {
+            ESP_LOGW(TAG, "Failed to read background audio frame");
+            ok = false;
+            break;
+        }
+
+        const size_t requested_size = static_cast<size_t>(requested_samples);
+        if (pcm.size() != requested_size) {
+            const size_t channel_count = pcm.size() / requested_samples;
+            if (channel_count > 1 && pcm.size() == requested_size * channel_count) {
+                for (size_t sample = 0; sample < requested_size; ++sample) {
+                    pcm[sample] = pcm[sample * channel_count];
+                }
+                pcm.resize(requested_samples);
+            }
+        }
+
+        if (pcm.size() > requested_size) {
+            ESP_LOGW(TAG, "Trim background audio frame: got=%u expected=%u",
+                     static_cast<unsigned>(pcm.size()), static_cast<unsigned>(requested_samples));
+            if (pcm.size() >= requested_size * 2) {
+                for (size_t sample = 0; sample < requested_size; ++sample) {
+                    pcm[sample] = pcm[sample * 2];
+                }
+            }
+            pcm.resize(requested_samples);
+        } else if (pcm.empty()) {
+            ESP_LOGW(TAG, "Unexpected empty background audio frame");
+            ok = false;
+            break;
+        } else if (pcm.size() < requested_size) {
+            ESP_LOGW(TAG, "Short background audio frame: got=%u expected=%u",
+                     static_cast<unsigned>(pcm.size()), static_cast<unsigned>(requested_samples));
+        }
+
+        audio_wav.append(reinterpret_cast<const char*>(pcm.data()), pcm.size() * sizeof(int16_t));
+        captured_samples += static_cast<uint32_t>(pcm.size());
+    }
+
+    if (wake_word_was_running && running_.load() &&
+        Application::GetInstance().GetDeviceState() == kDeviceStateIdle) {
+        audio_service.EnableWakeWordDetection(true);
+    }
+
+    const uint32_t data_size =
+        audio_wav.size() > 44 ? static_cast<uint32_t>(audio_wav.size() - 44) : 0;
+    WriteWavHeader(audio_wav, sample_rate, channels, bits_per_sample, data_size);
+    if (captured_samples < target_samples * 9 / 10) {
+        ESP_LOGW(TAG, "Captured background WAV is too short: samples=%u target=%u",
+                 static_cast<unsigned>(captured_samples), static_cast<unsigned>(target_samples));
+        ok = false;
+    }
+    ESP_LOGI(TAG, "Captured background WAV: samples=%u bytes=%u ok=%d",
+             static_cast<unsigned>(captured_samples), static_cast<unsigned>(audio_wav.size()),
+             ok ? 1 : 0);
+    return ok && data_size > 0;
+#else
+    (void)audio_wav;
+    return false;
+#endif
+}
