+struct AudioVadMetrics {
+    uint32_t avg_abs = 0;
+    uint32_t peak_abs = 0;
+};
+
+AudioVadMetrics CalculateAudioVadMetrics(const int16_t* samples, size_t sample_count) {
+    AudioVadMetrics metrics;
+    if (samples == nullptr || sample_count == 0) {
+        return metrics;
+    }
+
+    uint64_t sum_abs = 0;
+    uint32_t peak_abs = 0;
+    for (size_t i = 0; i < sample_count; ++i) {
+        const int32_t sample = samples[i];
+        const uint32_t value = static_cast<uint32_t>(std::abs(sample));
+        sum_abs += value;
+        peak_abs = std::max(peak_abs, value);
+    }
+    metrics.avg_abs = static_cast<uint32_t>(sum_abs / sample_count);
+    metrics.peak_abs = peak_abs;
+    return metrics;
+}
+
+AudioVadMetrics CalculateAudioVadMetricsForChannel(const std::vector<int16_t>& samples,
+                                                   size_t sample_count,
+                                                   size_t channel_count,
+                                                   size_t channel) {
+    AudioVadMetrics metrics;
+    if (sample_count == 0 || channel_count == 0 || channel >= channel_count ||
+        samples.size() < sample_count * channel_count) {
+        return metrics;
+    }
+
+    uint64_t sum_abs = 0;
+    uint32_t peak_abs = 0;
+    for (size_t i = 0; i < sample_count; ++i) {
+        const int32_t sample = samples[i * channel_count + channel];
+        const uint32_t value = static_cast<uint32_t>(std::abs(sample));
+        sum_abs += value;
+        peak_abs = std::max(peak_abs, value);
+    }
+    metrics.avg_abs = static_cast<uint32_t>(sum_abs / sample_count);
+    metrics.peak_abs = peak_abs;
+    return metrics;
+}
