+void BackgroundCaptureService::AudioSdUploaderTaskEntry(void* arg) {
+#if CONFIG_BACKGROUND_CAPTURE_ENABLE && CONFIG_BACKGROUND_CAPTURE_AUDIO_ENABLE
+    auto* service = static_cast<BackgroundCaptureService*>(arg);
+    service->MediaUploaderTask(true);
+    service->audio_sd_uploader_running_.store(false);
+#else
+    (void)arg;
+#endif
