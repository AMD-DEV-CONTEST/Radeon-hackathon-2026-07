+
+static void ConfigureBeijingTimezone() {
+    setenv("TZ", "CST-8", 1);
+    tzset();
+}
+
+static bool IsSystemTimeValid() {
+    ConfigureBeijingTimezone();
+    const time_t now = time(nullptr);
+    struct tm timeinfo{};
+    localtime_r(&now, &timeinfo);
+    return timeinfo.tm_year >= 2025 - 1900;
+}
+
+static void OnSntpTimeSynchronized(struct timeval*) {
+    Application::GetInstance().MarkClockSynchronized();
+}
+
+static void SyncSystemTimeTask(void*) {
+    ConfigureBeijingTimezone();
+    ESP_LOGI(TAG, "Starting SNTP time sync");
+    if (esp_sntp_enabled()) {
+        esp_sntp_stop();
+    }
+    esp_sntp_setoperatingmode(SNTP_OPMODE_POLL);
+    esp_sntp_setservername(0, "pool.ntp.org");
+    esp_sntp_setservername(1, "time.google.com");
+    esp_sntp_setservername(2, "ntp.aliyun.com");
+    esp_sntp_set_time_sync_notification_cb(OnSntpTimeSynchronized);
+    esp_sntp_init();
+
+    for (int i = 0; i < 30; ++i) {
+        if (Application::GetInstance().IsClockSynchronized() && IsSystemTimeValid()) {
+            char buffer[32];
+            const time_t now = time(nullptr);
+            struct tm timeinfo{};
+            localtime_r(&now, &timeinfo);
+            strftime(buffer, sizeof(buffer), "%Y-%m-%d %H:%M:%S", &timeinfo);
+            ESP_LOGI(TAG, "System time synchronized: %s", buffer);
+            vTaskDelete(nullptr);
+            return;
+        }
+        vTaskDelay(pdMS_TO_TICKS(1000));
+    }
+
+    ESP_LOGW(TAG, "SNTP time sync timed out");
+    vTaskDelete(nullptr);
+}
+
+static void StartSystemTimeSync() {
+    static bool sync_task_started = false;
+    if (sync_task_started) {
+        return;
+    }
+    sync_task_started = true;
+    BaseType_t result =
+        xTaskCreate(SyncSystemTimeTask, "time_sync", 4096, nullptr, tskIDLE_PRIORITY + 1, nullptr);
+    if (result != pdPASS) {
+        sync_task_started = false;
+        ESP_LOGW(TAG, "Failed to create SNTP time sync task");
+    }
+}
 
