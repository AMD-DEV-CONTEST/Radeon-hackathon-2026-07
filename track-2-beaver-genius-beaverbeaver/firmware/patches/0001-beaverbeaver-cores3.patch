+std::string GatewayWebSocketUrl() {
+#if CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_ENABLE
+    std::string url = CONFIG_BACKGROUND_CAPTURE_BEAVER_MEMORY_GATEWAY_URL;
+    if (url.rfind("https://", 0) == 0) {
+        url.replace(0, 5, "wss");
+    } else if (url.rfind("http://", 0) == 0) {
+        url.replace(0, 4, "ws");
+    }
+    while (!url.empty() && url.back() == '/') {
+        url.pop_back();
+    }
+    return url + "/v1/device/ws";
+#else
+    return {};
+#endif
+}
+
+std::string BuildAudioUploadFilename(const std::vector<std::pair<std::string, std::string>>& fields) {
+    std::string persisted_filename;
+    if (GetUploadField(fields, "filename", persisted_filename) && !persisted_filename.empty()) {
+        return persisted_filename;
+    }
+    ConfigureBeijingTimezone();
+    const int64_t now_uptime_ms = esp_timer_get_time() / 1000;
+    int64_t upload_uptime_ms = now_uptime_ms;
+    GetUploadFieldInt64(fields, "device_upload_uptime_ms", upload_uptime_ms);
+
+    int64_t record_start_uptime_ms = upload_uptime_ms;
+    const bool has_record_start =
+        GetUploadFieldInt64(fields, "record_start_uptime_ms", record_start_uptime_ms);
+    const int64_t reference_uptime_ms = has_record_start ? now_uptime_ms : upload_uptime_ms;
+    const int64_t record_age_ms =
+        std::max<int64_t>(0, reference_uptime_ms - record_start_uptime_ms);
+
+    if (IsSystemTimeValid()) {
+        const int64_t record_wall_ms = static_cast<int64_t>(time(nullptr)) * 1000 - record_age_ms;
+        time_t record_sec = static_cast<time_t>(record_wall_ms / 1000);
+        int record_ms = static_cast<int>(record_wall_ms % 1000);
+        if (record_ms < 0) {
+            record_ms += 1000;
+            record_sec -= 1;
+        }
+
+        struct tm timeinfo {};
+        localtime_r(&record_sec, &timeinfo);
+        char time_part[32];
+        strftime(time_part, sizeof(time_part), "%Y%m%d_%H%M%S", &timeinfo);
+
+        char filename[64];
+        snprintf(filename, sizeof(filename), "audio_%s_%03d.wav", time_part, record_ms);
+        return filename;
+    }
+
+    return "audio_u" + std::to_string(record_start_uptime_ms) + ".wav";
+}
+
+std::string BuildImageUploadFilename() {
+    ConfigureBeijingTimezone();
+    const int64_t uptime_ms = esp_timer_get_time() / 1000;
+
+    if (IsSystemTimeValid()) {
+        const time_t now_sec = time(nullptr);
+        struct tm timeinfo {};
+        localtime_r(&now_sec, &timeinfo);
+
+        char time_part[32];
+        strftime(time_part, sizeof(time_part), "%Y%m%d_%H%M%S", &timeinfo);
+
+        char filename[64];
+        snprintf(filename, sizeof(filename), "image_%s_%03d.jpg", time_part,
+                 static_cast<int>(uptime_ms % 1000));
+        return filename;
+    }
+
+    return "image_u" + std::to_string(uptime_ms) + ".jpg";
+}
