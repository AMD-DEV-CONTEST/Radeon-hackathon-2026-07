+uint32_t GetMediaUploadTimeoutMs(const std::string& content_type) {
+#if CONFIG_BACKGROUND_CAPTURE_AUDIO_ENABLE
+    if (content_type == "audio/wav") {
+#ifdef CONFIG_BACKGROUND_CAPTURE_AUDIO_UPLOAD_TIMEOUT_MS
+        return CONFIG_BACKGROUND_CAPTURE_AUDIO_UPLOAD_TIMEOUT_MS;
+#else
+        // Compatibility with an existing build directory that has not regenerated sdkconfig
+        // after the dedicated audio timeout option was introduced.
+        return std::min<uint32_t>(CONFIG_BACKGROUND_CAPTURE_UPLOAD_TIMEOUT_MS, 10000);
+#endif
+    }
+#else
+    (void)content_type;
+#endif
+    return CONFIG_BACKGROUND_CAPTURE_UPLOAD_TIMEOUT_MS;
+}
+
+void AddAudioSegmentTimingFields(const std::string& metadata,
+                                 std::vector<std::pair<std::string, std::string>>& fields) {
+    std::istringstream stream(metadata);
+    std::string line;
+    while (std::getline(stream, line)) {
+        const size_t equals = line.find('=');
+        if (equals == std::string::npos || equals == 0) {
+            continue;
+        }
+        // Persisted capture metadata is authoritative. Replacing an existing
+        // field also keeps retries from appending duplicate keys forever.
+        SetUploadField(fields, line.substr(0, equals), line.substr(equals + 1));
+    }
+}
+
+bool ReadSmallTextFile(const std::string& path, std::string& data) {
+    FILE* file = fopen(path.c_str(), "rb");
+    if (file == nullptr) {
+        return false;
+    }
+
+    fseek(file, 0, SEEK_END);
+    const long size = ftell(file);
+    rewind(file);
+    if (size <= 0 || size > 1024) {
+        fclose(file);
+        return false;
+    }
+
+    data.resize(static_cast<size_t>(size));
+    const size_t read_size = fread(data.data(), 1, data.size(), file);
+    fclose(file);
+    return read_size == data.size();
+}
+
+bool QuarantineMediaFile(const std::string& path, const char* extension,
+                         std::string& quarantined_path) {
+    SdSpiAccessGuard sd_guard;
+    if (!sd_guard.ok()) {
+        return false;
+    }
+    const size_t slash = path.find_last_of('/');
+    const std::string directory = slash == std::string::npos ? std::string() : path.substr(0, slash);
+    const std::string metadata_path = ReplaceExtension(path, ".txt");
+    for (int attempt = 0; attempt < 8; ++attempt) {
+        char basename[9];
+        snprintf(basename, sizeof(basename), "Q%07lx",
+                 static_cast<unsigned long>(esp_random() & 0x0fffffff));
+        quarantined_path = directory + "/" + basename + extension;
+        struct stat existing = {};
+        if (stat(quarantined_path.c_str(), &existing) != 0 && errno == ENOENT) {
+            break;
+        }
+        quarantined_path.clear();
+    }
+    if (quarantined_path.empty() || rename(path.c_str(), quarantined_path.c_str()) != 0) {
+        return false;
+    }
+    const std::string target_metadata = ReplaceExtension(quarantined_path, ".txt");
+    if (rename(metadata_path.c_str(), target_metadata.c_str()) != 0 && errno != ENOENT) {
+        ESP_LOGW(TAG, "Quarantined media but metadata rename failed: %s", metadata_path.c_str());
+    }
+    return true;
+}
+
+bool GetUploadFieldInt64(const std::vector<std::pair<std::string, std::string>>& fields,
+                         const char* key, int64_t& value) {
+    for (const auto& field : fields) {
+        if (field.first == key) {
+            char* end = nullptr;
+            const long long parsed = strtoll(field.second.c_str(), &end, 10);
+            if (end != field.second.c_str() && end != nullptr && *end == '\0') {
+                value = parsed;
+                return true;
+            }
+            return false;
+        }
+    }
+    return false;
+}
+
+bool GetUploadField(const std::vector<std::pair<std::string, std::string>>& fields,
+                    const char* key, std::string& value) {
+    for (const auto& field : fields) {
+        if (field.first == key) {
+            value = field.second;
+            return true;
+        }
+    }
+    return false;
+}
+
+bool UpgradeLegacyMediaIdentity(
+    std::vector<std::pair<std::string, std::string>>& fields,
+    const std::string& expected_stream_id) {
+    std::string boot_id;
+    if (GetUploadField(fields, "boot_id", boot_id) && !boot_id.empty()) {
+        return false;
+    }
+
+    std::string legacy_stream_id;
+    std::string sequence;
+    if (!GetUploadField(fields, "stream_id", legacy_stream_id) ||
+        legacy_stream_id.rfind("boot-", 0) != 0 ||
+        !GetUploadField(fields, "sequence", sequence) || sequence.empty()) {
+        return false;
+    }
+
+    // Earlier firmware stored the boot ID in stream_id. Preserve that boot identity while
+    // assigning the media-specific stream ID required by the reliable-upload key.
+    SetUploadField(fields, "boot_id", legacy_stream_id);
+    SetUploadField(fields, "stream_id", expected_stream_id);
+    return true;
+}
