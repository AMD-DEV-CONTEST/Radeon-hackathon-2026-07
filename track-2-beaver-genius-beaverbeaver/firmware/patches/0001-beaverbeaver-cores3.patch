+void SetU16(std::string& out, size_t offset, uint16_t value) {
+    out[offset] = static_cast<char>(value & 0xff);
+    out[offset + 1] = static_cast<char>((value >> 8) & 0xff);
+}
+
+void SetU32(std::string& out, size_t offset, uint32_t value) {
+    out[offset] = static_cast<char>(value & 0xff);
+    out[offset + 1] = static_cast<char>((value >> 8) & 0xff);
+    out[offset + 2] = static_cast<char>((value >> 16) & 0xff);
+    out[offset + 3] = static_cast<char>((value >> 24) & 0xff);
+}
+
+void WriteWavHeader(std::string& out, uint32_t sample_rate, uint16_t channels,
+                    uint16_t bits_per_sample, uint32_t data_size) {
+    if (out.size() < 44) {
+        out.resize(44);
+    }
+    out.replace(0, 4, "RIFF", 4);
+    SetU32(out, 4, 36 + data_size);
+    out.replace(8, 4, "WAVE", 4);
+    out.replace(12, 4, "fmt ", 4);
+    SetU32(out, 16, 16);
+    SetU16(out, 20, 1);
+    SetU16(out, 22, channels);
+    SetU32(out, 24, sample_rate);
+    SetU32(out, 28, sample_rate * channels * bits_per_sample / 8);
+    SetU16(out, 32, channels * bits_per_sample / 8);
+    SetU16(out, 34, bits_per_sample);
+    out.replace(36, 4, "data", 4);
+    SetU32(out, 40, data_size);
+}
+
+uint32_t PercentTimes10(size_t value, size_t total) {
+    if (total == 0) {
+        return 0;
+    }
+    return static_cast<uint32_t>((value * 1000ULL) / total);
+}
