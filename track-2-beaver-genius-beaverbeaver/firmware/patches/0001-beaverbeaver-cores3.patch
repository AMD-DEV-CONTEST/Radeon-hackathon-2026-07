+bool IsSystemTimeValid(std::string* iso_time = nullptr) {
+    if (!Application::GetInstance().IsClockSynchronized()) {
+        return false;
+    }
+    ConfigureBeijingTimezone();
+    const time_t now = time(nullptr);
+    struct tm timeinfo {};
+    localtime_r(&now, &timeinfo);
+    if (timeinfo.tm_year < 2025 - 1900) {
+        return false;
+    }
+
+    if (iso_time != nullptr) {
+        char buffer[32];
+        strftime(buffer, sizeof(buffer), "%Y-%m-%dT%H:%M:%S%z", &timeinfo);
+        *iso_time = buffer;
+    }
+    return true;
+}
