# Beaver Memory gateway
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8788
DEVICE_TOKEN=
# JSON object: each token owns an isolated user runtime. DEVICE_TOKEN is only
# the single-user fallback when this value is empty.
USER_TOKENS_JSON='{"replace-device-token":{"user_id":"demo-user","display_name":"Demo User"}}'
AUTH_COOKIE_SECURE=0
AUDIO_UPLOAD_MAX_BYTES=2097152
DEVICE_UPLOAD_BODY_TIMEOUT_SECONDS=15
PM_WRITE_TOKEN=
FRONTEND_ROOT=
NO_PROXY=127.0.0.1,localhost,::1
no_proxy=127.0.0.1,localhost,::1

# Durable local state (raw evidence is local; inference is remote). All paths
# derive from this root unless their individual override is set.
MEMORY_DATA_ROOT=/var/lib/beaver-memory

# EverOS
EVEROS_BASE_URL=http://127.0.0.1:8001
EVEROS_ROOT=/var/lib/beaver-memory/everos
EVEROS_MULTIMODAL__FILE_URI_ALLOW_DIRS='["/var/lib/beaver-memory"]'
EVEROS_LLM__API_KEY=
EVEROS_MULTIMODAL__API_KEY=
EVEROS_EMBEDDING__API_KEY=
EVEROS_RERANK__API_KEY=
EVEROS_APP_ID=ai-glasses
EVEROS_PROJECT_ID=beaver-memory-cn
EVEROS_USER_ID=owner
EVEROS_TIMEOUT_SECONDS=60

# Qwen3.5-Omni: first-person audio + image scene understanding.
# Qwen-Omni uses streaming OpenAI Chat Completions; Beaver handles SSE.
MEMORY_SCENE_BASE_URL=https://beaver-radeon-gateway.example/llm/v1
MEMORY_SCENE_API_KEY=
MEMORY_SCENE_MODEL=qwen3.5-omni-flash
MEMORY_SCENE_TIMEOUT_SECONDS=60
MEMORY_SCENE_MAX_CONCURRENCY=1
MEMORY_SCENE_MAX_TOKENS=1200
MEMORY_SCENE_MAX_IMAGES=5
MEMORY_SCENE_ATTACH_AUDIO=1
# Official OpenAI/MiMo APIs commonly use input_audio. vLLM all-modal Chat
# Completions deployments commonly expose audio_url; select the server schema.
MEMORY_SCENE_AUDIO_TRANSPORT=input_audio
MEMORY_SCENE_MAX_AUDIO_BYTES=1572864

# External ASR (LiteLLM-proxied DashScope native JSON, not /audio/transcriptions)
ASR_BASE_URL=https://beaver-radeon-gateway.example/asr
ASR_API_KEY=
ASR_MODEL=Qwen/Qwen3-ASR-1.7B
MEMORY_ASR_PROVIDER=custom_http
MEMORY_ASR_BASE_URL=
MEMORY_ASR_API_KEY=
MEMORY_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
MEMORY_ASR_LANGUAGE=auto
MEMORY_ASR_TIMEOUT_SECONDS=120
WINDOW_ASR_FULL_WINDOW_ENABLED=1
WINDOW_ASR_TAIL_GUARD_MS=5000

# Qwen3.7-Flash: text-only cross-window context (thinking disabled)
MEMORY_CONTEXT_ENABLED=1
MEMORY_CONTEXT_BASE_URL=https://beaver-radeon-gateway.example/llm/v1
MEMORY_CONTEXT_API_KEY=
MEMORY_CONTEXT_MODEL=qwen3.7-flash
MEMORY_CONTEXT_TIMEOUT_SECONDS=45
MEMORY_CONTEXT_MAX_TOKENS=3200
MEMORY_CONTEXT_TAIL_CHARS=24000

# Qwen3.7-Flash: commitments and daily review (thinking disabled)
COMMITMENT_EXTRACTION_ENABLED=1
COMMITMENT_EXTRACTION_BASE_URL=https://beaver-radeon-gateway.example/llm/v1
COMMITMENT_EXTRACTION_API_KEY=
COMMITMENT_EXTRACTION_MODEL=qwen3.7-flash
COMMITMENT_EXTRACTION_TIMEOUT_SECONDS=45
DAILY_REVIEW_ENABLED=1
DAILY_REVIEW_SCHEDULER_ENABLED=1
DAILY_REVIEW_TIMEZONE=Asia/Shanghai
DAILY_REVIEW_SCHEDULE_HOUR=22
DAILY_REVIEW_BASE_URL=https://beaver-radeon-gateway.example/llm/v1
DAILY_REVIEW_API_KEY=
DAILY_REVIEW_MODEL=qwen3.7-flash
DAILY_REVIEW_TIMEOUT_SECONDS=60

# External VL embedding and reranking (DashScope native JSON contracts)
MEMORY_SEARCH_EMBEDDING_URL=https://beaver-radeon-gateway.example/embedding
MEMORY_SEARCH_EMBEDDING_MODEL=qwen3-vl-embedding
MEMORY_SEARCH_EMBEDDING_API_KEY=
MEMORY_SEARCH_RERANKER_URL=https://beaver-radeon-gateway.example/rerank
MEMORY_SEARCH_RERANKER_MODEL=qwen3-vl-rerank
MEMORY_SEARCH_RERANKER_API_KEY=
MEMORY_SEARCH_MODEL_TIMEOUT_SECONDS=60

# External YOLOE
OBJECT_PERCEPTION_ENABLED=0
OBJECT_PERCEPTION_BASE_URL=https://example.invalid
OBJECT_PERCEPTION_API_KEY=
OBJECT_PERCEPTION_MODEL=yoloe-26s
OBJECT_PERCEPTION_TIMEOUT_SECONDS=10
OBJECT_PERCEPTION_MAX_MEDIA_BYTES=10485760
OBJECT_PERCEPTION_WAIT_MS=500
OBJECT_PERCEPTION_STALE_MS=10000
OBJECT_PERCEPTION_MAX_CLASSES=120
OBJECT_PERCEPTION_STORE_PATH=/var/lib/beaver-memory/object-perception/jobs.json

# Qwen3.5-Omni: semantic object cards (independent second pass)
OBJECT_CARD_ENABLED=1
OBJECT_CARD_BASE_URL=https://beaver-radeon-gateway.example/llm/v1
OBJECT_CARD_API_KEY=
OBJECT_CARD_MODEL=qwen3.5-omni-flash
OBJECT_CARD_TIMEOUT_SECONDS=45
OBJECT_CARD_MAX_TOKENS=3200
OBJECT_CARD_MAX_IMAGES=6

# External face recognition
IDENTITY_PERCEPTION_ENABLED=0
IDENTITY_BASE_URL=https://example.invalid
IDENTITY_API_KEY=
IDENTITY_MODEL=insightface
IDENTITY_WORKER_TIMEOUT_SECONDS=15
IDENTITY_MAX_MEDIA_BYTES=10485760
IDENTITY_WORKER_RETRY_SECONDS=5
IDENTITY_PROJECTION_WAIT_MS=350

# External speaker/voice recognition
VOICE_PERCEPTION_ENABLED=0
VOICE_BASE_URL=https://example.invalid
VOICE_API_KEY=
VOICE_MODEL=sortformer-wespeaker
VOICE_WORKER_TIMEOUT_SECONDS=120
VOICE_MAX_MEDIA_BYTES=33554432
VOICE_WORKER_RETRY_SECONDS=5
VOICE_PROJECTION_WAIT_MS=350

# Voice responses generated by the Radeon-hosted VoxCPM service.
VOXCPM_TTS_URL=https://beaver-radeon-gateway.example/tts
VOXCPM_PROMPT_WAV=

# Lightweight local VAD only
SPEECH_PRESENCE_ENABLED=1
SPEECH_PRESENCE_DEVICE=cpu
SPEECH_PRESENCE_SILENCE_DBFS=-55
SPEECH_PRESENCE_PROBABILITY_THRESHOLD=0.05
# Optional fourth VAD voter. Enable only when the ten-vad native library is
# installed and its constructor succeeds; FSMN + Silero + AudioSet remain on.
SPEECH_PRESENCE_TEN_VAD_ENABLED=0

# Windowing, retry and media limits
MEMORY_CAPSULE_WINDOW_MS=30000
MEMORY_CAPSULE_FLUSH_MS=300000
MEMORY_CAPSULE_RETRY_MS=60000
MEMORY_IMAGE_LATE_GRACE_MS=10000
MEMORY_SEARCH_UPLOAD_MAX_BYTES=10485760
