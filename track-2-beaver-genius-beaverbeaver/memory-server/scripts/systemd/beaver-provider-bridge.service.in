[Unit]
Description=Beaver Memory external-model protocol bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@@USER@@
WorkingDirectory=@@PROJECT_ROOT@@
EnvironmentFile=@@PROJECT_ROOT@@/.env
ExecStart=@@PROJECT_ROOT@@/scripts/start-provider-bridge.sh
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
