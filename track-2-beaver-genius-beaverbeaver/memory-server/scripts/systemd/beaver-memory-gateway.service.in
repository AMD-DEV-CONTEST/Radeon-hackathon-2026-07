[Unit]
Description=Beaver Memory Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@@USER@@
WorkingDirectory=@@PROJECT_ROOT@@
EnvironmentFile=@@PROJECT_ROOT@@/.env
ExecStart=@@PROJECT_ROOT@@/scripts/start-gateway.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
