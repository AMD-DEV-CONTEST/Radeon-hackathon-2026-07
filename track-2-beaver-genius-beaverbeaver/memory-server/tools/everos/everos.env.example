EVEROS_ROOT=/var/lib/beaver-memory/everos
EVEROS_API__HOST=127.0.0.1
EVEROS_API__PORT=8001
EVEROS_MULTIMODAL__FILE_URI_ALLOW_DIRS='["/var/lib/beaver-memory"]'

EVEROS_LLM__MODEL=qwen3.7-flash
EVEROS_LLM__API_KEY=replace-me
EVEROS_LLM__BASE_URL=https://beaver-radeon-gateway.example/llm/v1

EVEROS_MULTIMODAL__MODEL=qwen3.5-omni-flash
EVEROS_MULTIMODAL__API_KEY=replace-me
EVEROS_MULTIMODAL__BASE_URL=https://beaver-radeon-gateway.example/llm/v1

# Independent memory ASR with its own credential.
MEMORY_ASR_PROVIDER=custom_http
MEMORY_ASR_BASE_URL=https://beaver-radeon-gateway.example/asr
MEMORY_ASR_API_KEY=replace-me
MEMORY_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
MEMORY_ASR_LANGUAGE=auto
MEMORY_ASR_TIMEOUT_SECONDS=120

EVEROS_EMBEDDING__MODEL=qwen3-vl-embedding
EVEROS_EMBEDDING__API_KEY=
EVEROS_EMBEDDING__BASE_URL=http://127.0.0.1:8792/v1
EVEROS_EMBEDDING__BATCH_SIZE=4
EVEROS_EMBEDDING__MAX_CONCURRENT=1

EVEROS_RERANK__PROVIDER=vllm
EVEROS_RERANK__MODEL=qwen3-vl-rerank
EVEROS_RERANK__API_KEY=
EVEROS_RERANK__BASE_URL=http://127.0.0.1:8792/v1
EVEROS_RERANK__BATCH_SIZE=4
EVEROS_RERANK__MAX_CONCURRENT=1

# DeepSeek OpenAI-compatible example:
# Copy these into tools/everos/everos.env when you provide a DeepSeek key.
# Keep model names configurable because DeepSeek may change the recommended
# model list over time.
# DEEPSEEK_API_KEY=replace-me
# EVEROS_LLM__BASE_URL=https://api.deepseek.com
# EVEROS_LLM__API_KEY=${DEEPSEEK_API_KEY}
# EVEROS_LLM__MODEL=<deepseek-openai-compatible-model>

EVEROS_LOG_LEVEL=INFO
EVEROS_LOG_FORMAT=json
TZ=Asia/Shanghai
