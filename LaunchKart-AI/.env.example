# ============================================
# LaunchKart AI 2.0 — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# ---- Application ----
APP_NAME=LaunchKart AI 2.0
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# ---- Security ----
JWT_SECRET_KEY=change-this-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Database ----
DATABASE_URL=sqlite+aiosqlite:///./launchkart_db.sqlite
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ---- ChromaDB ----
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_NAME=launchkart_memory

# ---- Ollama (Local AI Inference) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava:13b
OLLAMA_TEXT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT=120
OLLAMA_MAX_CONCURRENT=4

# ---- AMD GPU / ROCm ----
ROCM_ENABLED=true
GPU_MONITOR_INTERVAL=5
HSA_OVERRIDE_GFX_VERSION=

# ---- File Storage ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/bmp

# ---- Rate Limiting ----
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
