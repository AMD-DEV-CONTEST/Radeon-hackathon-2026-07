{
  "schema": "colorgraph.semantic-label-map/v2",
  "version": "ade20k-landscape-v2",
  "targets": {
    "sky": ["sky"],
    "vegetation": ["tree", "grass", "plant", "flower", "palm", "field"],
    "water": ["water", "sea", "river", "lake", "swimming pool", "waterfall"],
    "mountain": ["mountain", "hill"],
    "rock": ["rock", "stone"],
    "cliff": ["cliff"],
    "land": ["earth", "land", "ground", "dirt", "soil"],
    "sand": ["sand"],
    "snow": ["snow"],
    "road": ["road", "path", "runway"],
    "building": ["building", "house", "skyscraper"]
  }
}
