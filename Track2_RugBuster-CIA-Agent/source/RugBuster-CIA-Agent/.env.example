# Copy to .env and fill in. Never commit the real .env file.

# --- Explorer API keys (per chain, only needed for chains you scan) ---
SNOWTRACE_API_KEY=
BASESCAN_API_KEY=
BSCSCAN_API_KEY=

# --- RPC overrides (public defaults are used if unset) ---
# AVAX_RPC=https://api.avax.network/ext/bc/C/rpc
# BASE_RPC=https://mainnet.base.org
# BNB_RPC=https://bsc-dataseed.binance.org

# --- HMAC permission-control secret (src/auth.py) ---
CIA_HMAC_SECRET=
CIA_HMAC_PREVIOUS_SECRET=

# --- Local LLM (Qwen3-14B QLoRA GGUF) ---
# CIA_LLM_MODEL_PATH=/absolute/path/to/qwen3-14b.Q4_K_M.gguf
# CIA_LLM_MODEL_DIR=models
# CIA_LLM_GGUF_FILE=qwen3-14b.Q4_K_M.gguf
# CIA_LLM_CTX=4096
# CIA_LLM_MAX_TOKENS=512
# CIA_LLM_TEMPERATURE=0.1

# --- GPU / device config (src/gpu_config.py) ---
# CIA_LLM_BACKEND=rocm        # rocm | cuda | cpu — auto-detected if unset
# ROCM_GFX_TARGET=gfx1151     # pin explicitly if rocminfo autodetect is unreliable
# CIA_LLM_GPU_LAYERS=-1       # -1 = offload all layers; lower this on smaller GPUs
