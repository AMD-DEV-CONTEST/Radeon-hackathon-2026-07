{
  "schema_version": "0.1",
  "agent": {
    "id": "us_equity_market_radar",
    "name": "U.S. Equity Market Radar",
    "description": "Tracks major U.S. indexes and market movers to produce sourced market briefs that can be saved or sent with user confirmation.",
    "version": "0.1.1"
  },
  "runtime": {
    "pattern_id": "react_agent",
    "compiled_pattern_id": null,
    "user_config": {},
    "agent_config": {
      "agent_id": "us_equity_market_radar"
    }
  },
  "graph_overrides": {
    "node_wrappers": []
  },
  "bindings": {
    "services": [],
    "node_bindings": [
      {
        "binding_id": "answer_prompt",
        "binding_type": "prompt",
        "target": {
          "node_id": "answer",
          "impl": "cognitive.answer"
        },
        "payload": {
          "prompt_id": "answer_prompt",
          "template": "You are the U.S. Equity Market Radar and cover U.S. equities only. For a market overview, pre-market note, intraday update, closing review, or email brief, first load skill(action='load', name='us-equity-market-briefing', current_system='us_equity_market_radar', reason='Follow the U.S. equity market briefing workflow'). Before stating current indexes or market movers, call get_us_market_snapshot and preserve its observation time, source, status, warnings, and provider diagnostics; never invent current data from model memory. Use the available web-search MCP for public news, filings, context, or cross-checking, and distinguish structured market data from web evidence. When collaboration supplies shared file paths, confirm them with ls/glob and read them with read. Use workspace file tools for deliverables. Call send_market_brief_email only when the user explicitly requests email delivery, and confirm recipients, subject, and body first. Use scheduler only for explicitly requested future monitoring. Query knowledge only when the user asks to apply mounted internal research material. Separate facts, analysis, and risk disclosures. Do not trade, promise returns, or present analysis as deterministic investment advice.",
          "variables": []
        }
      },
      {
        "binding_id": "answer_tool_access",
        "binding_type": "tool_access",
        "target": {
          "node_id": "answer",
          "impl": "cognitive.answer"
        },
        "payload": {
          "allowed_tool_ids": [
            "get_us_market_snapshot",
            "send_market_brief_email",
            "skill",
            "read",
            "write",
            "edit",
            "glob",
            "grep",
            "ls",
            "shell",
            "shell_status",
            "shell_stop",
            "knowledge",
            "scheduler",
            "skillhub"
          ],
          "approval_policy": "allow_all"
        }
      },
      {
        "binding_id": "answer_model_operation",
        "binding_type": "model_operation",
        "target": {
          "node_id": "answer",
          "impl": "cognitive.answer"
        },
        "payload": {
          "operation": "tool_bound_chat",
          "model_role": "main",
          "output_schema": {
            "type": "object",
            "additionalProperties": true
          },
          "write_target": {
            "section": "context"
          },
          "max_attempts": 3,
          "prompt_id": "answer_prompt"
        }
      }
    ],
    "hooks": []
  },
  "tools": [
    {
      "id": "get_us_market_snapshot",
      "description": "Fetches current major U.S. index quotes and leading, declining, and most-active equities from Yahoo Finance. Call it before stating current U.S. market facts; it returns observation time, source, warnings, and provider diagnostics.",
      "schema_error_guidance": "top_n must be an integer from 1 through 20.",
      "entrypoint": "python:tools/get_us_market_snapshot/tool.py:run",
      "input_schema": {
        "type": "object",
        "properties": {
          "top_n": {"type": "integer", "minimum": 1, "maximum": 20, "default": 10}
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": {"type": "string", "enum": ["success", "partial", "error"]},
          "observed_at": {"type": "string"},
          "source": {"type": "string"},
          "indexes": {"type": "array", "items": {"type": "object"}},
          "top_gainers": {"type": "array", "items": {"type": "object"}},
          "top_losers": {"type": "array", "items": {"type": "object"}},
          "most_active": {"type": "array", "items": {"type": "object"}},
          "warnings": {"type": "array", "items": {"type": "string"}},
          "provider_diagnostics": {
            "type": "object",
            "properties": {
              "provider": {"type": "string"},
              "hosts_used": {"type": "array", "items": {"type": "string"}},
              "retry_count": {"type": "integer", "minimum": 0},
              "requests_completed": {"type": "integer", "minimum": 0}
            },
            "required": ["provider", "hosts_used", "retry_count", "requests_completed"],
            "additionalProperties": false
          },
          "message": {"type": "string"}
        },
        "required": ["status", "observed_at", "source", "indexes", "top_gainers", "top_losers", "most_active", "warnings", "provider_diagnostics", "message"],
        "additionalProperties": false
      },
      "resources": {},
      "risk_level": "low",
      "risk_evaluator": {"hard": null, "llm": null, "llm_mode": "disabled"},
      "concurrent": false,
      "permission_scope": "package",
      "permission_tags": ["read_only"],
      "output_compression": {"action_argument": "action", "actions": {}},
      "output_projection": "compress"
    },
    {
      "id": "send_market_brief_email",
      "description": "Sends a confirmed U.S. equity market brief through the user's configured SMTP account. When recipients is omitted, it uses the Resource default. Confirm recipients, subject, and body before calling.",
      "schema_error_guidance": "When supplied, recipients must contain 1 to 10 valid email addresses. subject and body must not be empty.",
      "entrypoint": "python:tools/send_market_brief_email/tool.py:run",
      "input_schema": {
        "type": "object",
        "properties": {
          "recipients": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string", "minLength": 3}},
          "subject": {"type": "string", "minLength": 1, "maxLength": 200},
          "body": {"type": "string", "minLength": 1, "maxLength": 100000}
        },
        "required": ["subject", "body"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": {"type": "string", "enum": ["sent"]},
          "sent_at": {"type": "string"},
          "recipients": {"type": "array", "items": {"type": "string"}},
          "message_id": {"type": "string"}
        },
        "required": ["status", "sent_at", "recipients", "message_id"],
        "additionalProperties": false
      },
      "resources": {"smtp": "smtp_account"},
      "risk_level": "low",
      "risk_evaluator": {"hard": null, "llm": null, "llm_mode": "disabled"},
      "concurrent": false,
      "permission_scope": "package",
      "permission_tags": ["external_communication"],
      "output_compression": {"action_argument": "action", "actions": {}},
      "output_projection": "passthrough"
    }
  ],
  "output": {
    "citations_required": false,
    "format": "markdown"
  },
  "harness": [],
  "metadata": {
    "provenance": {
      "source": "system_package",
      "package_id": "us_equity_market_radar"
    },
    "scope": "us_equity_only"
  }
}
