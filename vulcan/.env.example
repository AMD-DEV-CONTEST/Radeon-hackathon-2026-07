# Copy to .env and fill in. Every value is read from the environment;
# nothing is hardcoded in the source.

# Any OpenAI-compatible endpoint.
# Ollama (development):     http://localhost:11434/v1
# vLLM on Radeon (ROCm):    https://<host>/spaces/<instance-id>/8000/v1
VULCAN_BASE_URL=http://localhost:11434/v1

# Ollama ignores this and accepts any value. The Radeon Cloud vLLM endpoint
# requires the real per-instance key, shown on the instance status page.
VULCAN_API_KEY=local

# Must match what the backend actually serves.
# Ollama: qwen3:4b-instruct        vLLM: Qwen/Qwen3-8B
# (Qwen3-4B-Instruct-2507 was tried on the Radeon and failed to boot twice.)
VULCAN_MODEL=qwen3:4b-instruct

# Embeddings.
#
# A vLLM server started with task=generate (which is what `vllm serve
# Qwen/Qwen3-8B` does) exposes NO /v1/embeddings route, it returns 404. Since
# Radeon Cloud allows one active instance per account, the working split is
# generation on the GPU and embeddings on a local model. Leave the two vars
# below empty to reuse VULCAN_BASE_URL, which is right for a single endpoint
# that serves both (Ollama does).
VULCAN_EMBED_MODEL=mxbai-embed-large
VULCAN_EMBED_BASE_URL=
VULCAN_EMBED_API_KEY=

VULCAN_TEMPERATURE=0.2

# Qwen3 emits a reasoning preamble by default. Turning it off is the single
# largest latency win measured in this project; see docs/spec.md section 4.4.
# true / false / unset to leave the model's own default alone.
VULCAN_ENABLE_THINKING=false

# Cap on agent tool-call rounds per question.
VULCAN_MAX_STEPS=8

# Where the index and memory are written.
VULCAN_DATA_DIR=.vulcan
