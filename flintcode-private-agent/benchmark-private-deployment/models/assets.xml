<?xml version="1.0" encoding="UTF-8"?>
<root name="moving-company-service"
      data_service="sqlite"
      org="example"
      _module_key="root">

  <vehicle_type _name="Vehicle Type"
                _module="Assets"
                _module_key="assets"
                name="string()"
                code="string()"
                display_order="number()"
                _constant="true"
                _identifier="code">
    <_value id="10001" name="Box Truck" code="BOX_TRUCK"
            display_order="1"/>
    <_value id="10002" name="Flatbed" code="FLATBED"
            display_order="2"/>
    <_value id="10003" name="Van" code="VAN"
            display_order="3"/>
    <_value id="10004" name="Trailer" code="TRAILER"
            display_order="4"/>
  </vehicle_type>

  <vehicle _name="Vehicle"
           _module="Assets"
           _module_key="assets"
           vehicle_type="vehicle_type()"
           make="Ford"
           model="Transit"
           year=2022
           license_plate="ABC-1234"
           vin="1FTBW2CM5NKA12345"
           mileage=45000
           fuel_type="diesel"
           status="available"
           last_service_date="2025-05-01"
           next_service_date="2025-08-01"
           create_time="createTime()"
           update_time="updateTime()"/>

  <equipment _name="Equipment"
             _module="Assets"
             _module_key="assets"
             name="Furniture Dolly"
             category="moving"
             serial_number="EQ-001"
             purchase_date="2023-01-15"
             purchase_price=150.00
             condition="good"
             status="available"
             assigned_to="employee()"
             create_time="createTime()"
             update_time="updateTime()"/>

  <consumable _name="Consumable"
              _module="Assets"
              _module_key="assets"
              name="Moving Boxes (Large)"
              category="packing"
              unit="each"
              current_stock=250
              reorder_level=50
              unit_cost=2.50
              supplier="BoxCo Supplies"
              last_restocked="2025-06-01"
              create_time="createTime()"
              update_time="updateTime()"/>

  <maintenance_status _name="Maintenance Status"
                      _module="Assets"
                      _module_key="assets"
                      name="string()"
                      code="string()"
                      display_order="number()"
                      _constant="true"
                      _identifier="code">
    <_value id="11001" name="Scheduled" code="SCHEDULED"
            display_order="1"/>
    <_value id="11002" name="In Progress" code="IN_PROGRESS"
            display_order="2"/>
    <_value id="11003" name="Completed" code="COMPLETED"
            display_order="3"/>
    <_value id="11004" name="Overdue" code="OVERDUE"
            display_order="4"/>
  </maintenance_status>

  <maintenance_schedule _name="Maintenance Schedule"
                        _module="Assets"
                        _module_key="assets"
                        vehicle="vehicle()"
                        maintenance_type="oil_change"
                        status="maintenance_status()"
                        scheduled_date="2025-08-01"
                        completed_date="2025-08-02"
                        cost=120.00
                        notes="Regular oil change and inspection"
                        performed_by="employee()"
                        create_time="createTime()"
                        update_time="updateTime()"/>

</root>
