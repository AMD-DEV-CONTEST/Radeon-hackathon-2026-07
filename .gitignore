# ============================================================
# Bunker — .gitignore
# ============================================================

# ----- Python -----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
wheels/

# ----- Virtual Environments ---------------------------------
venv/
.venv/
.venv310/
env/
ENV/
bunker-env/

# ----- Environment / Secrets --------------------------------
.env
*.env
!.env.example

# ----- Runtime Data (never commit user data) ----------------
data/documents/
data/vector_db/
data/memory/
data/audit/

# Keep the directory structure but ignore contents
!data/documents/.gitkeep
!data/vector_db/.gitkeep
!data/memory/.gitkeep
!data/audit/.gitkeep

# ----- Local session databases -------------------------------
sessions_*.sqlite
*.sqlite3

# ----- Generated DSPy artifacts (compile at build time) ------
artifacts/
!artifacts/.gitkeep

# ----- AI Models (too large for GitHub) ---------------------
models/
*.bin
*.safetensors
*.gguf
*.ggml
*.pt
*.pth
*.ckpt

# ----- Demo / Video Assets ----------------------------------
demo/video_assets/
*.mp4
*.mov
*.avi
*.mkv

# ----- Logs -------------------------------------------------
*.log
logs/

# ----- IDE / Editor -----------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Testing / Coverage -----------------------------------
.pytest_cache/
.pytest/
.pytest_tmp/
.coverage
coverage.xml
htmlcov/
tmp/
.tox/

# ----- ChromaDB runtime files -------------------------------
chroma.sqlite3
*.chroma

# ----- Jupyter (if any notebooks added) ---------------------
.ipynb_checkpoints/
*.ipynb

# ----- Docker runtime ---------------------------------------
*.pid

# ----- Private / Internal Docs (stay on local machine only) -
BUNKER_Handoff_Document.md
