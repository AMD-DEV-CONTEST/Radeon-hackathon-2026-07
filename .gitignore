# ============================================
# Radeon Hackathon 2026-07 — 根 .gitignore
# （submissions/Neoh/ 内的 models/ data/ logs/ 等由该子目录的 .gitignore 覆盖）
# ============================================

# ---- WorkBuddy 本地记忆 / 运行时（含个人记忆，禁止上库）----
.workbuddy/

# ---- 其他 AI 工具的临时规划目录（非项目交付物）----
.trae/

# ---- Radeon Cloud 一键启动运行时产物（非交付物，禁止上库）----
.amd-oneclick-source

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.installed.cfg
*.egg-info/
.venv/
venv/
env/
ENV/

# ---- Node（如有前端）----
node_modules/
package-lock.json
yarn.lock

# ---- 环境变量与密钥（防泄露）----
.env
.env.*
secrets.json
*.pem
*.key
*.p12
*.pfx
config.local.yaml

# ---- 日志（根级，若有）----
*.log
audit.log

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- 临时 ----
*.tmp
*.bak
*.orig
