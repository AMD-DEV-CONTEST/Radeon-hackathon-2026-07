# OmniKernel-ROCm gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# SQLite databases (generated at runtime)
*.db
*.sqlite
*.sqlite3

# Audit logs (generated at runtime)
*.jsonl

# RAG index (generated from corpus)
.index/

# vLLM server logs
vllm_server.log
*.log

# Model weights (too large for git)
models/
*.gguf
*.bin
*.safetensors
*.pt
*.pth

# Patch files generated by the agent
*.patch

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Environment
.env
*.env.local

# Test output
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Demo recordings (too large for git, store elsewhere)
*.mp4
*.webm
*.mov
