# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Local reference material (third-party copies) — never tracked
references/

# Virtual environment
venv/
.venv/
env/

# Environment
.env

# Credentials — never tracked. A token committed to a public repo is public
# forever, even if the commit is later removed.
.gh_token
*.token
*_token
.netrc

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Logs
*.log

# Downloaded model weights (fetch via scripts/download_*_model.py)
models/*.onnx
models/*.pt
models/*.npz

# Generated Whisper encoder weights — 7.4 MiB of int8 blob plus 1.5 MiB of golden
# vectors, rebuilt by scripts/export_whisper_weights.py. The VAD weights next door
# are committed because they are 316 KiB; these are 30x that, and would be rewritten
# in full by every re-export. Run the export before the browser/GPU harness.
frontend/webgpu/whisper/weights/

# Test
.pytest_cache/
.coverage
htmlcov/

# Mypy
.mypy_cache/

# CodeBuddy agent internal directory
.codebuddy/

# Agent scratch space (downloaded archives, Chrome profiles, probe pages)
.agent-tmp/
