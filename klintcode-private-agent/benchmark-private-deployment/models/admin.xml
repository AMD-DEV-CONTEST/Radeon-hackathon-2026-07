<?xml version="1.0" encoding="UTF-8"?>
<root name="moving-company-service"
      data_service="sqlite"
      org="example"
      _module_key="root">

  <contract_type _name="Contract Type"
                 _module="Admin"
                 _module_key="admin"
                 name="string()"
                 code="string()"
                 display_order="number()"
                 _constant="true"
                 _identifier="code">
    <_value id="12001" name="Service Agreement" code="SERVICE_AGREEMENT"
            display_order="1"/>
    <_value id="12002" name="Employment" code="EMPLOYMENT"
            display_order="2"/>
    <_value id="12003" name="Vendor" code="VENDOR"
            display_order="3"/>
    <_value id="12004" name="Insurance" code="INSURANCE"
            display_order="4"/>
  </contract_type>

  <contract _name="Contract"
            _module="Admin"
            _module_key="admin"
            contract_type="contract_type()"
            customer="customer()"
            contract_number="CTR-2025-001"
            title="Annual Moving Service Agreement"
            start_date="2025-01-01"
            end_date="2025-12-31"
            value=25000.00
            status="active"
            signed_date="2025-01-15"
            create_time="createTime()"
            update_time="updateTime()"/>

  <insurance_policy _name="Insurance Policy"
                    _module="Admin"
                    _module_key="admin"
                    vehicle="vehicle()"
                    policy_number="INS-2025-001"
                    provider="SafeMove Insurance"
                    coverage_type="liability"
                    coverage_amount=1000000.00
                    premium_amount=5000.00
                    start_date="2025-01-01"
                    end_date="2025-12-31"
                    status="active"
                    create_time="createTime()"
                    update_time="updateTime()"/>

  <document _name="Document"
            _module="Admin"
            _module_key="admin"
            title="Moving Contract Template"
            document_type="contract"
            file_path="https://example.com/documents/contracts/template.pdf"
            file_size_kb=245
            uploaded_by="employee()"
            contract="contract()"
            version=1
            create_time="createTime()"
            update_time="updateTime()"/>

  <audit_log _name="Audit Log"
             _module="Admin"
             _module_key="admin"
             action_operator="user_account()"
             action="update"
             entity_type="customer"
             entity_id=2001
             old_value="{phone: +1-555-0202}"
             new_value="{phone: +1-555-0299}"
             ip_address="192.168.1.100"
             log_timestamp="2025-06-15T14:30:00"
             create_time="createTime()"
             update_time="updateTime()"/>

</root>
