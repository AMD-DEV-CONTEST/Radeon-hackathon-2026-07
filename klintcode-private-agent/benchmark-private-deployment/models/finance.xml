<?xml version="1.0" encoding="UTF-8"?>
<root name="moving-company-service"
      data_service="sqlite"
      org="example"
      _module_key="root">

  <payment_method _name="Payment Method"
                  _module="Finance"
                  _module_key="finance"
                  name="string()"
                  code="string()"
                  display_order="number()"
                  _constant="true"
                  _identifier="code">
    <_value id="7001" name="Credit Card" code="CREDIT_CARD"
            display_order="1"/>
    <_value id="7002" name="Bank Transfer" code="BANK_TRANSFER"
            display_order="2"/>
    <_value id="7003" name="Cash" code="CASH"
            display_order="3"/>
    <_value id="7004" name="Check" code="CHECK"
            display_order="4"/>
  </payment_method>

  <payment_status _name="Payment Status"
                  _module="Finance"
                  _module_key="finance"
                  name="string()"
                  code="string()"
                  display_order="number()"
                  _constant="true"
                  _identifier="code">
    <_value id="8001" name="Pending" code="PENDING"
            display_order="1"/>
    <_value id="8002" name="Completed" code="COMPLETED"
            display_order="2"/>
    <_value id="8003" name="Failed" code="FAILED"
            display_order="3"/>
    <_value id="8004" name="Refunded" code="REFUNDED"
            display_order="4"/>
  </payment_status>

  <invoice _name="Invoice"
           _module="Finance"
           _module_key="finance"
           customer="customer()"
           move_order="move_order()"
           invoice_number="INV-2025-001"
           invoice_date="2025-06-15"
           due_date="2025-07-15"
           subtotal=1500.00
           tax_amount=120.00
           total_amount=1620.00
           status="sent"
           create_time="createTime()"
           update_time="updateTime()"/>

  <payment _name="Payment"
           _module="Finance"
           _module_key="finance"
           invoice="invoice()"
           payment_method="payment_method()"
           payment_status="payment_status()"
           amount=1620.00
           payment_date="2025-06-20"
           transaction_id="TXN-98765"
           notes="Full payment received"
           create_time="createTime()"
           update_time="updateTime()"/>

  <expense_category _name="Expense Category"
                    _module="Finance"
                    _module_key="finance"
                    name="string()"
                    code="string()"
                    display_order="number()"
                    _constant="true"
                    _identifier="code">
    <_value id="9001" name="Fuel" code="FUEL"
            display_order="1"/>
    <_value id="9002" name="Equipment" code="EQUIPMENT"
            display_order="2"/>
    <_value id="9003" name="Labor" code="LABOR"
            display_order="3"/>
    <_value id="9004" name="Insurance" code="INSURANCE"
            display_order="4"/>
  </expense_category>

  <expense _name="Expense"
           _module="Finance"
           _module_key="finance"
           expense_category="expense_category()"
           move_order="move_order()"
           description="Diesel fuel for truck"
           amount=85.50
           expense_date="2025-06-15"
           receipt_number="REC-001"
           approved_by="employee()"
           create_time="createTime()"
           update_time="updateTime()"/>

  <vat_record _name="VAT Record"
              _module="Finance"
              _module_key="finance"
              invoice="invoice()"
              vat_rate=8.0
              vat_amount=120.00
              tax_period="2025-Q2"
              filing_status="pending"
              create_time="createTime()"
              update_time="updateTime()"/>

  <financial_summary _name="Financial Summary"
                     _module="Finance"
                     _module_key="finance"
                     invoice="invoice()"
                     summary_date="2025-06-15"
                     period_type="monthly"
                     total_revenue=45000.00
                     total_expenses=32000.00
                     gross_profit=13000.00
                     outstanding_invoices=8500.00
                     outstanding_expenses=2200.00
                     create_time="createTime()"
                     update_time="updateTime()"/>

</root>
