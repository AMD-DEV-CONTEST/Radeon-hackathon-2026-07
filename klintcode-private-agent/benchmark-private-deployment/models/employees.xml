<?xml version="1.0" encoding="UTF-8"?>
<root name="moving-company-service"
      data_service="sqlite"
      org="example"
      _module_key="root">

  <job_title _name="Job Title"
             _module="Employees"
             _module_key="employees"
             name="string()"
             code="string()"
             hourly_rate=25.00
             display_order="number()"
             _constant="true"
             _identifier="code">
    <_value id="2001" name="Driver" code="DRIVER"
            hourly_rate=28.00 display_order="1"/>
    <_value id="2002" name="Mover" code="MOVER"
            hourly_rate=22.00 display_order="2"/>
    <_value id="2003" name="Team Lead" code="TEAM_LEAD"
            hourly_rate=32.00 display_order="3"/>
    <_value id="2004" name="Foreman" code="FOREMAN"
            hourly_rate=35.00 display_order="4"/>
    <_value id="2005" name="Office Staff" code="OFFICE_STAFF"
            hourly_rate=20.00 display_order="5"/>
  </job_title>

  <employee _name="Employee"
            _module="Employees"
            _module_key="employees"
            first_name="John"
            last_name="Smith"
            email="john.smith@movingco.com"
            phone="+1-555-0101"
            job_title="job_title()"
            hire_date="2023-03-15"
            is_active=true
            create_time="createTime()"
            update_time="updateTime()"
            _audit_mask_fields="email,phone"/>

  <leave_type _name="Leave Type"
              _module="Employees"
              _module_key="employees"
              name="string()"
              code="string()"
              is_paid=true
              max_days_per_year=20
              display_order="number()"
              _constant="true"
              _identifier="code">
    <_value id="3001" name="Annual Leave" code="ANNUAL"
            is_paid=true max_days_per_year="20" display_order="1"/>
    <_value id="3002" name="Sick Leave" code="SICK"
            is_paid=true max_days_per_year="10" display_order="2"/>
    <_value id="3003" name="Personal Leave" code="PERSONAL"
            is_paid=false max_days_per_year="5" display_order="3"/>
  </leave_type>

  <leave_request _name="Leave Request"
                 _module="Employees"
                 _module_key="employees"
                 employee="employee()"
                 leave_type="leave_type()"
                 start_date="2025-07-01"
                 end_date="2025-07-05"
                 reason="Family vacation"
                 status="approved"
                 approved_by="employee()"
                 create_time="createTime()"
                 update_time="updateTime()"/>

  <job_assignment _name="Job Assignment"
                  _module="Employees"
                  _module_key="employees"
                  employee="employee()"
                  move_order="move_order()"
                  role_on_move="Team Lead"
                  assigned_date="2025-06-10"
                  status="assigned"
                  create_time="createTime()"
                  update_time="updateTime()"/>

  <worked_hours _name="Worked Hours"
                _module="Employees"
                _module_key="employees"
                employee="employee()"
                job_assignment="job_assignment()"
                work_date="2025-06-15"
                start_time="08:00"
                end_time="16:00"
                break_minutes=30
                total_hours=7.5
                overtime_hours=0
                create_time="createTime()"
                update_time="updateTime()"/>

  <payroll_calculation _name="Payroll Calculation"
                       _module="Employees"
                       _module_key="employees"
                       employee="employee()"
                       pay_period_start="2025-06-01"
                       pay_period_end="2025-06-15"
                       regular_hours=80
                       overtime_hours=5
                       regular_pay=2240.00
                       overtime_pay=210.00
                       bonus_amount=150.00
                       deductions=450.00
                       net_pay=2150.00
                       status="processed"
                       create_time="createTime()"
                       update_time="updateTime()"/>

  <bonus _name="Bonus"
         _module="Employees"
         _module_key="employees"
         employee="employee()"
         bonus_type="performance"
         amount=150.00
         reason="Exceeded customer satisfaction targets"
         awarded_date="2025-06-15"
         create_time="createTime()"
         update_time="updateTime()"/>

</root>
