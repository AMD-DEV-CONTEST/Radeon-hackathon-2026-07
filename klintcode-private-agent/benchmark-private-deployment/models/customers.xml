<?xml version="1.0" encoding="UTF-8"?>
<root name="moving-company-service"
      data_service="sqlite"
      org="example"
      _module_key="root">

  <customer_type _name="Customer Type"
                 _module="Customers"
                 _module_key="customers"
                 name="string()"
                 code="string()"
                 display_order="number()"
                 _constant="true"
                 _identifier="code">
    <_value id="4001" name="Private" code="PRIVATE"
            display_order="1"/>
    <_value id="4002" name="Corporate" code="CORPORATE"
            display_order="2"/>
  </customer_type>

  <customer _name="Customer"
            _module="Customers"
            _module_key="customers"
            customer_type="customer_type()"
            company_name="Acme Corp"
            first_name="Jane"
            last_name="Doe"
            email="jane.doe@example.com"
            phone="+1-555-0202"
            address="address()"
            tax_id="12-3456789"
            account_manager="employee()"
            create_time="createTime()"
            update_time="updateTime()"
            _audit_mask_fields="email,phone,address,tax_id,company_name,first_name,last_name"/>

  <customer_contact _name="Customer Contact"
                    _module="Customers"
                    _module_key="customers"
                    customer="customer()"
                    contact_name="Bob Manager"
                    contact_email="bob@acmecorp.com"
                    contact_phone="+1-555-0203"
                    role="Office Manager"
                    is_primary=true
                    create_time="createTime()"
                    update_time="updateTime()"/>

  <billing_info _name="Billing Info"
                _module="Customers"
                _module_key="customers"
                customer="customer()"
                billing_address="address()"
                payment_terms="Net 30"
                credit_limit=10000.00
                current_balance=2500.00
                preferred_payment_method="bank_transfer"
                create_time="createTime()"
                update_time="updateTime()"/>

  <customer_history _name="Customer History"
                    _module="Customers"
                    _module_key="customers"
                    customer="customer()"
                    move_order="move_order()"
                    interaction_type="move_completed"
                    interaction_date="2025-06-15"
                    notes="Completed office relocation"
                    satisfaction_score=4.5
                    create_time="createTime()"
                    update_time="updateTime()"/>

</root>
