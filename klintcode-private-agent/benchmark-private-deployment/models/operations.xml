<?xml version="1.0" encoding="UTF-8"?>
<root name="moving-company-service"
      data_service="sqlite"
      org="example"
      _module_key="root">

  <address _name="Address"
           _module="Operations"
           _module_key="operations"
           street="123 Main Street"
           city="Springfield"
           state="IL"
           postal_code="62701"
           country="US"
           latitude=39.7817
           longitude=-89.6501
           create_time="createTime()"
           update_time="updateTime()"/>

  <route _name="Route"
         _module="Operations"
         _module_key="operations"
         origin="address()"
         destination="address()"
         estimated_distance_km=45.5
         estimated_duration_minutes=60
         notes="Highway route preferred"
         create_time="createTime()"
         update_time="updateTime()"/>

  <time_slot _name="Time Slot"
             _module="Operations"
             _module_key="operations"
             slot_date="2025-06-15"
             start_time="08:00"
             end_time="12:00"
             max_capacity=5
             current_bookings=2
             is_available=true
             create_time="createTime()"
             update_time="updateTime()"/>

  <move_status _name="Move Status"
               _module="Operations"
               _module_key="operations"
               name="string()"
               code="string()"
               color="string()"
               display_order="number()"
               progress="number()"
               _constant="true"
               _identifier="code">
    <_value id="1001" name="Quoted" code="QUOTED"
            color="#F59E0B" display_order="1" progress="10"/>
    <_value id="1002" name="Booked" code="BOOKED"
            color="#3B82F6" display_order="2" progress="25"/>
    <_value id="1003" name="In Progress" code="IN_PROGRESS"
            color="#8B5CF6" display_order="3" progress="60"/>
    <_value id="1004" name="Completed" code="COMPLETED"
            color="#16A34A" display_order="4" progress="100"/>
    <_value id="1005" name="Cancelled" code="CANCELLED"
            color="#6B7280" display_order="5" progress="0"/>
  </move_status>

  <move_order _name="Move Order"
              _module="Operations"
              _module_key="operations"
              customer="customer()"
              status="move_status()"
              origin_address="address()"
              destination_address="address()"
              route="route()"
              time_slot="time_slot()"
              move_date="2025-06-15"
              crew_size=3
              special_instructions="Handle piano with care"
              total_volume_cubic_feet=800
              create_time="createTime()"
              update_time="updateTime()"/>

  <fulfillment_event _name="Fulfillment Event"
                     _module="Operations"
                     _module_key="operations"
                     move_order="move_order()"
                     event_type="pickup_started"
                     event_time="2025-06-15T08:00:00"
                     location="address()"
                     notes="Crew arrived on time"
                     performed_by="employee()"
                     create_time="createTime()"
                     update_time="updateTime()"/>

</root>
