<?xml version="1.0" encoding="UTF-8"?>
<root name="moving-company-service"
      data_service="sqlite"
      org="example"
      _module_key="root">

  <service_category _name="Service Category"
                    _module="Products"
                    _module_key="products"
                    name="string()"
                    code="string()"
                    display_order="number()"
                    _constant="true"
                    _identifier="code">
    <_value id="5001" name="Moving" code="MOVING"
            display_order="1"/>
    <_value id="5002" name="Cleaning" code="CLEANING"
            display_order="2"/>
    <_value id="5003" name="Box Rental" code="BOX_RENTAL"
            display_order="3"/>
    <_value id="5004" name="Additional" code="ADDITIONAL"
            display_order="4"/>
  </service_category>

  <service _name="Service"
           _module="Products"
           _module_key="products"
           service_category="service_category()"
           name="Local Moving"
           description="Full service local moving within city limits"
           base_price=500.00
           unit="per_move"
           is_active=true
           create_time="createTime()"
           update_time="updateTime()"/>

  <service_config _name="Service Config"
                  _module="Products"
                  _module_key="products"
                  service="service()"
                  config_key="max_distance_km"
                  config_value="50"
                  description="Maximum distance for local move pricing"
                  create_time="createTime()"
                  update_time="updateTime()"/>

  <pricing_rule _name="Pricing Rule"
                _module="Products"
                _module_key="products"
                service="service()"
                rule_name="Weekend Surcharge"
                rule_type="percentage"
                value=15.0
                condition="day_of_week IN (SAT, SUN)"
                priority=1
                is_active=true
                create_time="createTime()"
                update_time="updateTime()"/>

  <move_line_item _name="Move Line Item"
                  _module="Products"
                  _module_key="products"
                  move_order="move_order()"
                  service="service()"
                  quantity=1
                  unit_price=500.00
                  discount_amount=0
                  line_total=500.00
                  notes="Standard local move"
                  create_time="createTime()"
                  update_time="updateTime()"/>

</root>
