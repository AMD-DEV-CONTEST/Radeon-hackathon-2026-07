<?xml version="1.0" encoding="UTF-8"?>
<root


      name="platform-modules"
      cfg_mask_china_mobile="false"
      data_service="sqlite"
      org="doublechaintech"
      _module_key="platform">
  
  <user _name="User"
        _module="Platform"
        _module_key="platform"
        username="john_doe"
        email="john@example.com"
        password_hash="hashed_password_123"
        create_time="createTime()"
        update_time="updateTime()"
        _audit_mask_fields="password_hash"/>
  
  <role _name="Role"
        _module="Platform"
        _module_key="platform"
        name="admin"
        description="System administrator"
        create_time="createTime()"
        update_time="updateTime()"/>
  
  <permission _name="Permission"
              _module="Platform"
              _module_key="platform"
              name="manage_users"
              description="Can manage user accounts"
              create_time="createTime()"
              update_time="updateTime()"/>
  
  <user_role _name="UserRole"
             _module="Platform"
             _module_key="platform"
             user="user()"
             role="role()"
             assigned_at="createTime()"
             create_time="createTime()"
             update_time="updateTime()"/>
  
  <role_permission _name="RolePermission"
                   _module="Platform"
                   _module_key="platform"
                   role="role()"
                   permission="permission()"
                   granted_at="createTime()"
                   create_time="createTime()"
                   update_time="updateTime()"/>
  
  <authentication_log _name="AuthenticationLog"
                      _module="Platform"
                      _module_key="platform"
                      user="user()"
                      login_time="createTime()"
                      ip_address="192.168.1.100"
                      success="true"
                      auth_method="magic_link"
                      create_time="createTime()"
                      update_time="updateTime()"/>
  
  <activity_log _name="ActivityLog"
                _module="Platform"
                _module_key="platform"
                user="user()"
                action="updated_profile"
                entity_type="user"
                entity_id="12345"
                changes_json="{'email': 'new@example.com'}"
                timestamp="createTime()"
                create_time="createTime()"
                update_time="updateTime()"/>
  
  <notification _name="Notification"
                _module="Platform"
                _module_key="platform"
                recipient="user()"
                subject="Welcome to Moving Company"
                body="Thank you for signing up"
                notification_type="email"
                status="sent"
                scheduled_time="createTime()"
                sent_time="createTime()"
                create_time="createTime()"
                update_time="updateTime()"/>
  
  <api_endpoint _name="ApiEndpoint"
                _module="Platform"
                _module_key="platform"
                path="/api/v1/users"
                method="GET"
                description="Get user list"
                version="v1"
                active="true"
                create_time="createTime()"
                update_time="updateTime()"/>
  
  <webhook _name="Webhook"
           _module="Platform"
           _module_key="platform"
           url="https://example.com/webhook"
           event_type="invoice_paid"
           secret_key="webhook_secret_123"
           active="true"
           create_time="createTime()"
           update_time="updateTime()"
           _audit_mask_fields="secret_key"/>
</root>