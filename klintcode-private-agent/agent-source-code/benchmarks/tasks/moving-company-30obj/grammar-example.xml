<?xml version="1.0" encoding="UTF-8"?>
<root


      name="moving-company-service"
      cfg_mask_china_mobile="false"
      data_service="sqlite"
      org="doublechaintech"
      _module_key="root">
  
  <!-- Split into modules using _include for 10+ objects -->
  <_include file="operations.xml" />
  <_include file="employees.xml" />
  <_include file="customers.xml" />
  
  <!-- Objects in small models can also be defined inline -->
  <company _name="Company"
             _module="Core"
             _module_key="core"
             name="Fast Movers"
             founded="1998"
             create_time="createTime()"
             update_time="updateTime()"/>
             
  <department _name="Department"
              _module="Core"
              _module_key="core"
              name="Logistics"
              budget="50000.00"
              company="company()"
              create_time="createTime()"
              update_time="updateTime()"/>
</root>
