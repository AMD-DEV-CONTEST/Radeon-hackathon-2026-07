<?xml version="1.0" encoding="UTF-8"?>
<root


      name="online-bookstore-service"
      data_service="sqlite"
      org="doublechaintech"
      _module_key="root">

  <bookstore _name="Bookstore"
             _module="Core"
             _module_key="core"
             name="City Books"
             address="123 Main St"
             phone="13800138000"
             create_time="createTime()"
             update_time="updateTime()"/>

  <book_category _name="Book Category"
                 _module="Core"
                 _module_key="core"
                 id="id()" name="string()" code="string()"
                 _constant="true" _identifier="code"
                 bookstore="bookstore()">
    <_value id="1001" name="Fiction" code="FICTION"/>
    <_value id="1002" name="Non-Fiction" code="NON_FICTION"/>
  </book_category>
</root>
