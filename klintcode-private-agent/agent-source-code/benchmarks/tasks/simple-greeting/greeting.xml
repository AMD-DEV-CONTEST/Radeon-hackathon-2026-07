<?xml version="1.0" encoding="UTF-8"?>
<root name="simple-greeting-service"
      cfg_mask_china_mobile="false"
      data_service="sqlite"
      org="doublechaintech"
      _module_key="root">

  <greeting _name="Greeting"
            _module="Core"
            _module_key="core"
            message="Hello, World!"
            language="English"
            greeting_type="greetingType()"
            create_time="createTime()"
            update_time="updateTime()"/>

  <greeting_type _name="GreetingType"
                 _module="Core"
                 _module_key="core"
                 name="Formal"
                 description="A formal greeting"
                 create_time="createTime()"
                 update_time="updateTime()"/>
</root>
