<?xml version="1.0" encoding="UTF-8"?>
<root name="school-management-service"
      cfg_mask_china_mobile="false"
      data_service="sqlite"
      org="doublechaintech"
      _module_key="root">

  <platform _name="Platform"
            _module="Core"
            _module_key="core"
            name="Default Platform"
            create_time="createTime()"
            update_time="updateTime()"/>

  <school_type _name="SchoolType"
               _module="Core"
               _module_key="core"
               platform="platform()"
               name="Primary"
               code="PRIMARY"
               create_time="createTime()"
               update_time="updateTime()"/>

  <school _name="School"
          _module="Core"
          _module_key="core"
          name="Springfield Elementary"
          platform="platform()"
          school_type="school_type()"
          address="123 Main St"
          create_time="createTime()"
          update_time="updateTime()"/>

</root>
