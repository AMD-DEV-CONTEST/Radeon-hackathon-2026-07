[Unit]
Description=UnionAgents Go Gateway
After=network.target ua-orchestrator.service
Wants=ua-orchestrator.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/unionagents-go
EnvironmentFile=/root/unionagents-go/.env
ExecStart=/root/unionagents-go/bin/gateway
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ua-gateway

[Install]
WantedBy=multi-user.target
