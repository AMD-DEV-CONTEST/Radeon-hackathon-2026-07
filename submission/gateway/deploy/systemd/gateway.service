[Unit]
Description=UAS Streaming Gateway
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/UnionAgents
EnvironmentFile=/etc/unionagents/gateway.env
ExecStart=/root/UnionAgents/.venv/bin/python -m uvicorn streaming_gateway.main:app \
    --host 0.0.0.0 --port 8001 --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
