# UnionAgents Go — Environment Variables
# Copy to /opt/unionagents-go/.env and fill in values

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=unionagents
DB_SSLMODE=disable

# Orchestrator
ORCHESTRATOR_PORT=8000

# Gateway
GATEWAY_PORT=8001

# Auth (Gateway)
AUTH_ENABLED=1
AUTH_USERNAME=admin
AUTH_PASSWORD=change_me
AUTH_SECRET=change_me_to_random_64_chars
AUTH_TOKEN_TTL=86400

# Client endpoints (default: Cloudflare → H6 → JD-ECS)
# Emergency fallback: wss://111.228.42.18:3389/ws (direct JD-ECS, bypasses Cloudflare/H6)
# GATEWAY_URL=https://api.upser.pro
# GATEWAY_WS_URL=wss://api.upser.pro
# UA_GATEWAY_URL=wss://api.upser.pro/ws
# UA_ORCHESTRATOR_URL=https://api.upser.pro

# Optional: RAG service for ILS enrichment
# RAG_SERVICE_URL=http://127.0.0.1:8010
