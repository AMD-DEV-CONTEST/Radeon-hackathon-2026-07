.env
.env.*
*.log
*.mp4
*.mov
*.avi
*.pt
*.onnx
*.npz
*.tar.gz
.omc
.Trash*
persistence

# Repo-root build-context protection (track2 and other non-track3 projects)
track2-*
radeon_ssh
radeon_ssh/
