[Unit]
Description=Paddler LLM load balancer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cesarops
ExecStart=/home/cesarops/paddler/paddler balancer --inference-addr 0.0.0.0:8061 --management-addr 0.0.0.0:8060 --web-admin-panel-addr 0.0.0.0:8062
Restart=on-failure
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
