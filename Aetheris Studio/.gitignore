# Environments
.env
# The whole runtime data directory, not just auth_local.json: this is where
# the app's own SQLite database (chat history), settings.json, and the
# skills library actually live once the app runs -- real user data and
# local state, never something to commit.
core/data/
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Cache and temporary files
__pycache__/
*.py[cod]
*$py.class
.chromadb/
chromadb/
chromaDB/
.pytest_cache/
.mypy_cache/
.flet_gui.lock

# Text files (excluding requirements and Flutter's own CMakeLists.txt --
# the blanket *.txt rule below was silently excluding every desktop
# platform's build config from git, windows/ included; a fresh clone
# could never build either target. Caught while adding the linux/ scaffold.)
*.txt
!requirements.txt
!aetheris_ui/windows/CMakeLists.txt
!aetheris_ui/windows/**/CMakeLists.txt
!aetheris_ui/linux/CMakeLists.txt
!aetheris_ui/linux/**/CMakeLists.txt

# Specific folders requested to be ignored
Learning/
learning/

# Large models and folders (> 1GB)
ollama/
ollama_models/
Aetheris/
external_datasets/
.agents/
__pycache__/
.aider*

# Flutter (Fase 4.5): build artifacts, not source
dist/
aetheris_ui/build/
aetheris_ui/.dart_tool/
aetheris_ui/windows/flutter/ephemeral/

# VTE runtime artifacts: compiled kernel cache (.hsaco) and generated HIP
# source (Codegen), both rebuilt fresh on first run -- not source to track.
cache/
logs/
