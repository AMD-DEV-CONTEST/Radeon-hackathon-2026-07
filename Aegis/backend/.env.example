# --- App ---
APP_NAME=Aegis
ENVIRONMENT=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=false

# --- Security ---
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- Database (Postgres + pgvector) ---
DATABASE_URL=postgresql+asyncpg://aegis:aegis@localhost:5432/aegis
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis (cache + Celery broker) ---
REDIS_URL=redis://localhost:6379/0

# --- Local inference (vLLM on ROCm, OpenAI-compatible endpoint) ---
INFERENCE_BASE_URL=http://localhost:8001/v1
INFERENCE_MODEL=Qwen2.5-14B-Instruct
INFERENCE_API_KEY=not-needed-local
INFERENCE_TIMEOUT_SECONDS=120
INFERENCE_MAX_CONCURRENCY=8

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120
