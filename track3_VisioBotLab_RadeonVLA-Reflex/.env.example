# Copy to .env (gitignored) and adjust. Shell scripts auto-load .env via scripts/lib.sh.

# Backend: cpu | gpu | amdgpu
BACKEND=cpu

# Recording
EPISODES=200
SUITE=basic
# TASK=banana_white_left
REPO_ID=visiobot/radeonvla_basic
DATASET_ROOT=datasets/radeonvla_basic
SEED=0
# DR=1
# DR_REBUILD_EVERY=20
# OVERWRITE=0
# DISCARD_INCOMPLETE=0

# Training / remote
# HIP_VISIBLE_DEVICES=0
# DEVICE=cuda
# TRAIN_STEPS=10000
# BATCH_SIZE=4
# EVAL_PER_TASK=10
# TRAIN_OUTPUT=outputs/train/smolvla_radeonvla_reflex
# SOURCE_COMMIT=0123456789abcdef0123456789abcdef01234567
# SKIP_RECORD=0
# SKIP_TRAIN=0
# CKPT=outputs/train/smolvla_radeonvla_reflex/checkpoints/010000/pretrained_model
# HF_ENDPOINT=https://hf-mirror.com  # use only when huggingface.co is unreachable

# Optional Docker/Python package mirror for restricted networks
# BASE_IMAGE=docker.m.daocloud.io/rocm/dev-ubuntu-24.04:7.2.1-complete@sha256:3db551c4e1229aac1857ac44fcb6141bb749f41348eb572452f11279153c13c3
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn

# Optional: force a specific Python
# PYTHON=python3.12
