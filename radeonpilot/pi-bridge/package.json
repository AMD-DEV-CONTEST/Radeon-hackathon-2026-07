{
  "name": "@radeonpilot/pi-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Localhost-only HTTP bridge that orchestrates Pi Agent Harness GPU-ops sessions against a local ROCm model endpoint.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "postinstall": "node scripts/secure-upstream-deps.mjs",
    "start": "node src/server.mjs",
    "test": "node --test",
    "check": "node --check src/*.mjs scripts/*.mjs test/*.mjs",
    "check:runtime-deps": "node scripts/secure-upstream-deps.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "brace-expansion": "5.0.9",
    "undici": "8.9.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "undici": "8.9.0"
  }
}
