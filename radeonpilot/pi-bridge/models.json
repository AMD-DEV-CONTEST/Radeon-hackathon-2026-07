{
  "providers": {
    "radeon-local": {
      "name": "Radeon Local ROCm Endpoint",
      "baseUrl": "$VLLM_BASE_URL",
      "apiKey": "$PI_API_KEY",
      "api": "openai-completions",
      "authHeader": true,
      "models": [
        {
          "id": "qwen3-8b",
          "name": "Qwen3-8B Local (ROCm)",
          "reasoning": false,
          "input": ["text"],
          "cost": {
            "input": 0,
            "output": 0,
            "cacheRead": 0,
            "cacheWrite": 0
          },
          "contextWindow": 32768,
          "maxTokens": 4096,
          "compat": {
            "supportsDeveloperRole": false,
            "supportsReasoningEffort": false,
            "supportsUsageInStreaming": true,
            "maxTokensField": "max_tokens"
          }
        }
      ]
    }
  }
}
