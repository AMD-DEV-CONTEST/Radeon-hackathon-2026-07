# RadeonPilot environment template. Copy to .env and export in the shell.
# All defaults are localhost-only; the application refuses non-loopback endpoints.

# demo = labelled synthetic (no GPU); pi = real multi-agent over local ROCm endpoint
RADEONPILOT_MODE=demo

# Local OpenAI-compatible model endpoint (vLLM or llama-server)
VLLM_BASE_URL=http://127.0.0.1:8000/v1
RADEONPILOT_MODEL=qwen3-8b

# Host PID of the model endpoint process, required for Radeon attestation
VLLM_PID=

# Pi bridge
PI_BRIDGE_URL=http://127.0.0.1:8787
PI_BRIDGE_HOST=127.0.0.1
PI_BRIDGE_PORT=8787
PI_MODEL_ID=qwen3-8b
PI_PROVIDER_ID=radeon-local
PI_API_KEY=local-radeon

# Paths
RADEONPILOT_KNOWLEDGE=data/knowledge
RADEONPILOT_DB=runtime/radeonpilot.sqlite3
RADEONPILOT_PORT=7860

# Optional ROCm tool overrides
ROCM_SMI_BIN=rocm-smi
AMD_SMI_BIN=amd-smi
ROCM_VERSION=
