# Keep the Docker build context lean (source code only; no weights/datasets/outputs).
# Build context is the repo root (docker-compose sets context: ..).

# Never ship large generated artifacts
datasets/
outputs/
models/
*.mp4
*.png

# Model weights & caches
.huggingface/
.cache/

# VCS / IDE
.git/
.gitignore
.idea/
.vscode/
.mimocode/

# Reference/extracted demo sources (large, not needed in image)
franka_fruit_pick_demo-main_extracted/
genesis-world-main_extracted/

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/

# Docs are fine to include; keep compose drafts out
docs/compose/plans/
docs/compose/specs/
docs/compose/reports/
