# Kido Dev Backend — Environment Variables Template
# Copy this to .env and fill in your real values
# ═══════════════════════════════════════════════════════════════

# ── Deployment Mode ───────────────────────────────────────────
# local  — Both frontend & backend on localhost (no tunnel needed)
# ngrok  — Backend exposed via ngrok tunnel to the internet
# cloud  — Deployed to cloud platform (Railway / Render / etc.)
DEPLOY_MODE=local

# ── Inference Engine ──────────────────────────────────────────
# ollama       — Ollama running locally (recommended for local dev)
# vllm         — vLLM or OpenAI-compatible server (AMD ROCm GPU)
# transformers — HuggingFace transformers pipeline (local weights)
# auto         — Try ollama → vllm → transformers in order
INFERENCE_MODE=ollama

# Ollama Config (when INFERENCE_MODE=ollama or auto)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# vLLM / AMD ROCm Config (when INFERENCE_MODE=vllm)
QWEN_HOST=http://localhost:8001
QWEN_MODEL=qwen2.5-1.5b
QWEN_MODEL_PATH=/workspace/workspace/KidoDev/models/qwen2.5-1.5b

# ── Database ──────────────────────────────────────────────────
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ── Server ────────────────────────────────────────────────────
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
