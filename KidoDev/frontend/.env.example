# Kido Dev Frontend — Environment Variables Template
# ═══════════════════════════════════════════════════════════════
# Copy this to .env and choose your deployment mode.
#
# MODE SWITCHING:
#   Local dev  → copy .env.local   to .env  (or use defaults below)
#   Ngrok      → copy .env.ngrok   to .env
#   Cloud      → copy .env.cloud   to .env
# ═══════════════════════════════════════════════════════════════

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Agentic AI Backend URL ────────────────────────────────────
# Local Development : http://localhost:8000
# Ngrok Tunnel      : https://your-subdomain.ngrok-free.dev
# Cloud Deployment  : https://your-backend.railway.app
VITE_AGENT_BACKEND_URL=http://localhost:8000
VITE_BACKEND_WS_URL=ws://localhost:8000
