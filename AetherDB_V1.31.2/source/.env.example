# ==============================================================
# .env.example — 环境变量配置模板
# 复制此文件为 .env 到项目根目录，填入实际值后生效
# ==============================================================

# ===================== API 密钥 =====================
# 代码读取优先级:
#   ADMIN_API_KEY → NOVEL_ADMIN_KEY → 自动生成随机密钥
#   USER_API_KEY  → NOVEL_API_KEY  → 自动生成随机密钥
# 留空则每次启动自动生成，服务端终端会打印出来
ADMIN_API_KEY=
USER_API_KEY=

# ===================== LLM 抽取器配置 =====================
# 以下变量对应 config.local.yaml / config.example.yaml 中 extractor 段的字段。
# 当前抽取器配置主要来自本地配置文件 / 传入字典，并非直接读环境变量，
# 但在此列出作为参考，方便在 .env 中统一管理。

# LLM 后端类型: openai_compatible 或 ollama
EXTRACTOR_BACKEND=openai_compatible

# OpenAI 兼容后端
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat

# Ollama 后端
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=localhost:11434

# ===================== 本地向量模型 =====================
# BGE-M3 是默认的多语言向量模型。留空时使用项目本地目录
# app_data/models/bge-m3；也可指向用户自行管理的外部模型目录。
AETHERDB_EMBEDDING_PROVIDER=bge-m3
AETHERDB_MODEL_ROOT=
# 可选模型包的受管存储根。留空时使用 app_data/models。
# 若希望模型包管理器在外部磁盘管理 BGE-M3，请同时将
# AETHERDB_MODEL_ROOT 指向该目录下的 bge-m3 子目录。
AETHERDB_MODEL_PACKAGE_ROOT=
