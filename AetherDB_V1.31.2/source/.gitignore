# ==============================================================
# .gitignore — 世界观数据库管理系统
# ==============================================================

# ===================== Agent / AI 相关（不提交）=====================
.agents/
.agent/
.codex/
.claude/
CODEX_PROJECT_CONTEXT.md
AGENTS.md

# ===================== 敏感配置与凭据（不提交）=====================
.env
.env.*
!.env.example
!**/.env.example
api_keys.json*
.api_keys.json
config.local.yaml
!config.example.yaml
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.pub

# ===================== 数据库（不提交，自动创建）=====================
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
app_data/
chroma_db/

# ===================== Python 构建缓存与虚拟环境 ====================
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# ===================== 本地模型权重与桌面打包模型（不提交）=====================
models/
*.onnx
*.onnx_data
*.safetensors
*.gguf
*.pt
*.pth

# ===================== Frontend dependencies/build output ====================
.pnpm-store/
frontend/node_modules/
frontend/dist/
frontend/node_modules/.vite-temp/
frontend/src-tauri/backend/generated/*
!frontend/src-tauri/backend/generated/.gitkeep

# ===================== 日志（不提交）=====================
logs/
*.log

# ===================== 本地临时文件与备份（不提交）=====================
_start_temp.py
tmp_content.py
backup_project.ps1
backup/
backups/
local_agent_runs/
.codex-remote-attachments/
output/

# ===================== IDE / 操作系统元文件 ====================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# ===================== 备份内容（用户使用备份API产生的本地备份，不提交）=====================
备份内容/
