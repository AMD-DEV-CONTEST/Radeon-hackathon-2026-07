# ==========================================
# GachaDesk 环境变量示例文件 / Environment Variables Template
# ==========================================
# 使用说明 / Usage:
#   1. 复制本文件为 .env:  cp .env.example .env
#   2. 填入真实值后启动应用:  python app.py
#   3. .env 文件已被 .gitignore 忽略,不会提交到仓库
#      Copy this file to .env and fill in real values before launching.
#      The .env file is git-ignored and will NOT be committed.

# ------------------------------------------
# ModelScope 相关 / ModelScope Configuration
# ------------------------------------------

# ModelScope API Token(必填)/ ModelScope API Token (required)
# 获取地址 / Get it from: https://modelscope.cn/my/myaccesstoken
MODELSCOPE_API_TOKEN=your_modelscope_api_token_here

# 模型缓存目录(可选,留空使用默认路径)/ Model cache directory (optional, empty = default)
MODELSCOPE_CACHE_DIR=
