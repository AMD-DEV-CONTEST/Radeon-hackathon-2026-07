{
  "name": "local-dev-evidence-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Dev Evidence Agent — verify what was actually built from git/tests/AI sessions on AMD ROCm local LLMs",
  "bin": {
    "ldea": "./dist/cli.js"
  },
  "scripts": {
