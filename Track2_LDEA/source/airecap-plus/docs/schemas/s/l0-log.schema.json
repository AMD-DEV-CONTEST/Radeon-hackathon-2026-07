{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airecap.local/schemas/s/l0-log.schema.json",
  "title": "L0 Event log file / export (S-tier)",
  "description": "Ordered append-only stream for one or more sessions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "events"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "s/1.0"
    },
    "workspace_id": {
      "type": "string",
      "description": "Optional workspace / repo identity"
    },
    "events": {
      "type": "array",
      "items": { "$ref": "l0-event.schema.json" }
    }
  }
}
