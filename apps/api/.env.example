# apps/api — M0 本地开发配置 (sqlite, 无外部服务)
# M2 切 Postgres 时替换 DATABASE_URL / TIMESCALE_URL / REDIS_URL / MINIO_*

DATABASE_URL=sqlite:///./botversex_dev.db
TIMESCALE_URL=sqlite:///./botversex_timeseries_dev.db

REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

ENCRYPTION_KEY=8Be4BbRe8qpLdzb9MtNziKBSsvrModgEPr9LqktiA9A=
JWT_SECRET=dev-jwt-secret-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

REALTIME_SERVICE_URL=http://localhost:8002

# BotverseX Copilot LLM provider (openai_compatible | anthropic | disabled)
COPILOT_PROVIDER=openai_compatible
COPILOT_MODEL=deepseek-chat
COPILOT_API_KEY=
COPILOT_BASE_URL=https://api.deepseek.com/v1
