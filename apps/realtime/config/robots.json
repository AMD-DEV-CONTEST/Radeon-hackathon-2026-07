    {
      "runtime_id": "lekiwi",
      "robot_type": "lekiwi",
      "display_name": "LeKiwi 移动机械臂",
      "transport": {
        "kind": "lekiwi_host_client",
        "host": {
          "device": "raspberry_pi_or_orin",
          "remote_ip_env": "LEKIWI_REMOTE_IP",
          "command_port": 5555,
          "observation_port": 5556,
          "watchdog_timeout_ms": 500
        },
        "motor_bus": {
          "type": "feetech_serial",
          "motor_type": "sts3215",
          "port": "/dev/ttyACM0",
          "arm_motor_ids": [
            1,
            2,
            3,
            4,
            5,
            6
          ],
          "base_motor_ids": [
            7,
            8,
            9
          ]
        },
        "leader_arm": {
          "type": "so101_leader",
          "port": "/dev/ttyACM1"
        }
      },
      "service": {
        "kind": "zmq",
        "host_command": "python -m lerobot.robots.lekiwi.lekiwi_host --robot.id=botversex-lekiwi",
        "command_port": 5555,
        "observation_port": 5556
      },
      "urdf_url": "/api/urdf/lekiwi/lekiwi.urdf?v=official-cad-1",
      "joint_names": [
        "arm_shoulder_pan.pos",
        "arm_shoulder_lift.pos",
        "arm_elbow_flex.pos",
        "arm_wrist_flex.pos",
        "arm_wrist_roll.pos",
        "arm_gripper.pos",
        "x.vel",
        "y.vel",
        "theta.vel"
      ],
      "capabilities": {
        "state_stream": true,
        "teleop": true,
        "recording": true,
        "calibration": true,
        "motor_mode": false,
        "local_moves": true,
        "camera": true,
        "inference": true,
        "joints_live": true,
        "mobile": true,
        "bimanual": false
      },
      "capability_tags": [
        "teleop",
        "record",
        "calibrate",
        "inference",
        "joints_live",
        "camera",
        "mobile"
      ],
      "dependencies": {
        "python_modules": [
          "lerobot",
          "zmq",
          "feetech_servo_sdk"
        ],
        "binaries": [
          "lerobot-teleoperate",
          "lerobot-record",
          "lerobot-calibrate"
        ],
        "policy": "workspace_venv",
        "install_hint": "在 LeKiwi 的树莓派/Orin 上运行 lekiwi_host；BotverseX Local Agent 通过 ZMQ 5555/5556 连接。官方底盘与机械臂共用一条 Feetech STS3215 总线（ID 1-9），不是 Damiao CAN。"
      },
      "ui": {
        "route": "/robots/lekiwi"
      }
    },
