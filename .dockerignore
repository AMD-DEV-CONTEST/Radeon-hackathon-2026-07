# Mirrors .gitignore for the Docker build context. Keeps the image small
# AND prevents secrets (data/, .env*) from ever being copied into a layer.

# Runtime state — never bake into the image; bind-mounted at runtime.
data/

# Local environment overrides — only .env.example ships in source.
.env
.env.local
.env.*.local

# VCS
.git/
.gitignore
.github/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/

# Tests + CI
tests/

# Heavy repo assets not needed by the running app — only the static UI ships.
Radeon-Cloud-User Guide/

# Freebuff preview internals
.freebuff/*.log
.freebuff/*.pid
