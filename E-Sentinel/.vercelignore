# .vercelignore — files excluded from Vercel deployment uploads.
# Vercel respects .gitignore, but these are extra safeguards for files
# that are untracked yet should NEVER ship to a production build.

# Docs (we ship code, not Word/HTML proposals)
*.docx
*.html
!src/**/*.html
!public/**/*.html

# Workspace tooling — Claude Code, agent helpers, Lark skill bundles
.claude/
.agents/
skills/
skills-lock.json

# Local-only writeups
DEMO-SCRIPT.md
DEMO-TELEPROMPTER.md
PROJECT-JIXING.md
RESUME.md
SAAS_PLAN.md
TEST-REPORT-24-PANELS.md
VOICEOVER.md
CODE-VERIFICATION-WORKSHEET.md
TESTING.md
RELEASE.md

# Scripts are dev-only — don't ship to serverless image
convert_to_docx.py

# Supabase CLI temp state
supabase/.temp/

# Local mocks / test fixtures
__mocks__/
coze/

# Test artifacts
coverage/
*.tsbuildinfo
