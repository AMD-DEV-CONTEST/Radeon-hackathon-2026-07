# ===========================================
# Super Desktop Assistant - 环境变量
# 复制为 .env 并填入实际值
#
# config.json 控制供应商和模型分配
# 本文件只放 API Key（不进版本控制）
# ===========================================

# --- 本地推理 (vLLM / Ollama) ---
# vLLM: 默认 http://127.0.0.1:8000/v1，API Key 可为任意值
VLLM_API_KEY=not-needed
# Ollama: 默认 http://127.0.0.1:11434/v1，API Key 可为任意值
OLLAMA_API_KEY=not-needed

# --- SD WebUI / Forge (本地生图) ---
# 设置后优先使用，不需要 API Key
# SDWEBUI_URL=http://127.0.0.1:7860

# --- 本地 TTS 服务 (可选) ---
# 如 GPT-SoVITS, CosyVoice 等的 HTTP API
# LOCAL_TTS_URL=http://127.0.0.1:9880/tts

# --- 本地 faster-whisper 设置 ---
# WHISPER_MODEL_SIZE=small      # tiny, base, small, medium, large-v3
# WHISPER_COMPUTE_TYPE=int8     # int8 (CPU), float16 (GPU), int8_float16 (混合)
# EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural  # edge-tts 默认音色

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here

# --- DeepSeek ---
DEEPSEEK_API_KEY=sk-your-key-here

# --- 通义千问 (阿里云) ---
QWEN_API_KEY=sk-your-key-here

# --- 智谱 AI ---
ZHIPU_API_KEY=your-key-here

# --- 硅基流动 (模型超市) ---
SILICONFLOW_API_KEY=sk-your-key-here

# --- 小米米墨 MIMO ---
MIMO_API_KEY=your-mimo-key-here

# --- Gradio ---
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false
