    "RewardVector",
    "ModelCard",
    "AgencyEvalRecord"
  ],
  "endpoints": [
    {
      "method": "GET",
      "path": "/v1/health",
      "purpose": "truth-bounded control-plane health"
    },
    {
      "method": "POST",
      "path": "/v1/runs",
      "purpose": "idempotent run creation"
    },
    {
      "method": "GET",
      "path": "/v1/runs/{run_id}",
      "purpose": "run status"
    },
    {
      "method": "GET",
      "path": "/v1/runs/{run_id}/events",
      "purpose": "SSE event stream"
    },
    {
      "method": "POST",
      "path": "/v1/runs/{run_id}/approvals",
      "purpose": "named human decision"
    },
    {
      "method": "GET/POST",
      "path": "/v1/runs/{run_id}/publication-receipts",
      "purpose": "manual publication attestations"
    },
    {
      "method": "POST",
      "path": "/v1/runs/{run_id}/multimodal-deliverables",
      "purpose": "rights-cleared run-bound WAV/MP4 registration with immutable execution receipt"
    },
    {
      "method": "POST",
      "path": "/v1/runs/{run_id}/multimodal-deliverables/{registration_id}/reviews",
      "purpose": "named human review against a frozen multimodal rubric"
    },
    {
      "method": "GET",
      "path": "/v1/runs/{run_id}/bundle",
      "purpose": "approved evidence bundle"
    },
    {
      "method": "GET",
      "path": "/v1/model-cards",
      "purpose": "model cards"
    },
    {
      "method": "GET",
      "path": "/v1/evals/leaderboard",
      "purpose": "evidence-labeled eval leaderboard"
    }
  ],
  "human_release_required": true,
  "schema": "ProofLaunchSubmissionApiContractV1",
  "single_port": true,
  "state_changing_external_actions": false,
  "static_ui_same_port": true,
  "truth_boundary": "The API mechanics do not prove model training, Radeon execution, product quality, publication, or causal business outcomes.",
