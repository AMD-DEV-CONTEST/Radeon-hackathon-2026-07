{
  "bind_default": "127.0.0.1:8765",
  "bundle_files": [
    "events.jsonl",
    "evidence-ledger.json",
    "request.json",
    "run.json"
  ],
  "contracts": [
    "AgencyLaunchRequest",
    "CampaignWorldState",
    "DistillationEpisode",
