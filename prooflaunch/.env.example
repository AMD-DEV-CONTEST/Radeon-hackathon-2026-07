# ProofLaunch core replay requires no external API key.

# Optional authenticated local control-plane values. Replace locally; never
# commit real values.
PROOFLAUNCH_TENANT_TOKEN=
PROOFLAUNCH_APPROVAL_TOKEN=
PROOFLAUNCH_MEMORY_CAPSULE_SECRET=

# Optional local-model and deterministic-generation tuning.
PROOFLAUNCH_GEMMA_PROFILE=local
PROOFLAUNCH_IMAGE_STEPS=30
PROOFLAUNCH_RUN_LABEL=local-evaluation

# Optional offline mode after model snapshots are already available.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
HF_HUB_DISABLE_TELEMETRY=1
MEM0_TELEMETRY=0

# Competition Radeon access keys, GitHub tokens, provider keys, reviewer token
# maps, and customer credentials are intentionally not represented here.
