<mujoco model="combo ramp tunnel obstacle">
  <!-- Route v0.1: up-ramp + elevated tunnel + down-ramp as one fixture.
       Platform top 0.25 m; ramps rise 0.25 over 1.28 m (11 deg); tunnel
       walls/roof reuse the source tunnel cross-section (0.8 m passage,
       0.82 m clearance) translated to sit on the platform. Collision is
       x-symmetric so travel direction does not matter. -->
  <asset>
    <mesh name="combo_tunnel_mesh"
      file="../../../quadrupedal-agility/tsc/resources/obstacles/tunnel/meshes/base_link.STL"/>
  </asset>
  <worldbody>
    <body name="combo_tunnel">
      <geom name="combo_tunnel_visual" type="mesh" mesh="combo_tunnel_mesh"
        quat="0 0 0 1" contype="0" conaffinity="0" group="2"
        pos="-1 0 0.25" rgba="0.28 0.62 0.82 1"/>
      <geom name="combo_platform" type="box" pos="0 0 0.115"
        size="1.5 0.8 0.115" friction="1 0.005 0.0001"
        rgba="0.55 0.57 0.60 1"/>
      <geom name="combo_ramp_east" type="box" pos="2.135 0 0.1005"
        quat="0.99535 0 0.09634 0" size="0.70 0.8 0.025"
        friction="1 0.005 0.0001" rgba="0.55 0.57 0.60 1"/>
      <geom name="combo_ramp_west" type="box" pos="-2.135 0 0.1005"
        quat="0.99535 0 -0.09634 0" size="0.70 0.8 0.025"
        friction="1 0.005 0.0001" rgba="0.55 0.57 0.60 1"/>
      <geom name="combo_tunnel_left_wall" type="box"
        pos="0 0.4175 0.63" size="1 0.0175 0.40" friction="1 0.005 0.0001"
        rgba="0.55 0.57 0.60 1"/>
      <geom name="combo_tunnel_right_wall" type="box"
        pos="0 -0.4175 0.63" size="1 0.0175 0.40" friction="1 0.005 0.0001"
        rgba="0.55 0.57 0.60 1"/>
      <geom name="combo_tunnel_roof" type="box"
        pos="0 0 1.0475" size="1 0.40 0.0175" friction="1 0.005 0.0001"
        rgba="0.55 0.57 0.60 1"/>
    </body>
  </worldbody>
</mujoco>
