# JupyterLab base URL of the Radeon instance. Without it, dukaan runs the whole
# pipeline against a CPU mock and writes real files, so nothing here is needed
# to try the tool out.
DUKAAN_INSTANCE=https://your-host.example.com/instances/your-instance-id

# Optional. Defaults shown.
# DUKAAN_REMOTE_DIR=dukaan
# DUKAAN_OUT=out
# DUKAAN_WIDTH=768
# DUKAAN_HEIGHT=768
# DUKAAN_FRAMES=49
# DUKAAN_FPS=25
# DUKAAN_SEED=7
# DUKAAN_STRENGTH=0.7
# DUKAAN_REFINE=
# DUKAAN_JOB_TIMEOUT=1800
